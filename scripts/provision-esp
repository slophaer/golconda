#!/bin/sh
# provision-esp DISK [--hostname NAME] [--authorized-keys FILE] [--credential NAME=FILE]...
# Write bootstrap credentials onto the ESP of the disk image DISK, in place. Each becomes
# loader/credentials/NAME.cred, encrypted with the null key (docs/design/boot.md, "Bootstrap
# credentials"). DISK must be a writable copy: a path in /nix/store is refused.
#   --hostname NAME          the system.hostname and firstboot.hostname credentials
#   --authorized-keys FILE   the ssh.authorized_keys.root credential
#   --credential NAME=FILE   any other credential, its value read from FILE
# golconda-esp-credentials.service removes the credentials after the first boot. The ESP is neither
# encrypted nor signed: whoever can write it can add a credential. Exit: 0 on success, 1 on a
# failure, 2 on a usage error.
set -eu

usage() { sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//p}' "$0"; }
# die_usage MESSAGE: the message, the usage, exit 2
die_usage() {
  echo "provision-esp: $1" >&2
  usage >&2
  exit 2
}

DISK=""
# one "NAME FILE" pair per line
CREDS=""
add_cred() {
  CREDS="$CREDS$1 $2
"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --hostname)
      [ $# -ge 2 ] || die_usage "--hostname needs a name"
      HN_FILE=$(mktemp)
      printf %s "$2" > "$HN_FILE"
      TMP_FILES="${TMP_FILES:-} $HN_FILE"
      add_cred system.hostname "$HN_FILE"
      # systemd-firstboot writes /etc/hostname from this one, so later boots keep the name
      add_cred firstboot.hostname "$HN_FILE"
      shift 2 ;;
    --authorized-keys)
      [ $# -ge 2 ] || die_usage "--authorized-keys needs a file"
      add_cred ssh.authorized_keys.root "$2"
      shift 2 ;;
    --credential)
      [ $# -ge 2 ] || die_usage "--credential needs NAME=FILE"
      case "$2" in
        ?*=?*) add_cred "${2%%=*}" "${2#*=}" ;;
        *) die_usage "--credential wants NAME=FILE: $2" ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) die_usage "unknown option $1" ;;
    *)
      [ -z "$DISK" ] || die_usage "unexpected argument $1"
      DISK="$1"
      shift ;;
  esac
done

[ -n "$DISK" ] || die_usage "disk image required"
[ -f "$DISK" ] || { echo "provision-esp: disk image not found: $DISK" >&2; exit 1; }
[ -n "$CREDS" ] || die_usage "no credential given"

case "$(realpath "$DISK")" in
  /nix/store/*|*/nix/store/*)
    echo "provision-esp: $DISK is in the Nix store (read-only); provision a copy: cp --sparse=always" >&2
    exit 1 ;;
esac
[ -w "$DISK" ] || { echo "provision-esp: $DISK is not writable" >&2; exit 1; }

# Golconda's systemd-creds (262), not the host's: an older one sends a null-key request to the
# host's credentials service, which refuses it without authentication.
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
. "$SCRIPT_DIR/tools.sh"
TOOLS=$(tools_path "$(dirname "$SCRIPT_DIR")" systemd mtools util-linux cpython) || {
  echo "provision-esp: cannot build the tools (packages: systemd mtools util-linux cpython); the nix-build error is above" >&2
  exit 1
}
PATH="$TOOLS:$PATH"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK" ${TMP_FILES:-}' EXIT

# the ESP's byte offset from the GPT
OFFSET=$(sfdisk --json "$DISK" | python3 -c '
import json, sys
t = json.load(sys.stdin)["partitiontable"]
if t.get("label") != "gpt":
    sys.exit("not a GPT disk")
ss = t.get("sectorsize", 512)
for p in t["partitions"]:
    if p["type"].upper() == "C12A7328-F81F-11D2-BA4B-00A0C93EC93B":
        print(p["start"] * ss)
        sys.exit(0)
sys.exit("no ESP in the GPT")
') || { echo "provision-esp: cannot find the ESP in $DISK (no GPT partition of type C12A7328-F81F-11D2-BA4B-00A0C93EC93B)" >&2; exit 1; }

IMG="$DISK@@$OFFSET"
export MTOOLS_SKIP_CHECK=1

mmd -i "$IMG" -D s ::loader 2>/dev/null || true
mmd -i "$IMG" -D s ::loader/credentials 2>/dev/null || true

printf %s "$CREDS" | while read -r NAME FILE; do
  [ -f "$FILE" ] || { echo "provision-esp: credential file not found: $FILE" >&2; exit 1; }
  systemd-creds encrypt --with-key=null --name="$NAME" "$FILE" "$WORK/$NAME.cred"
  mcopy -i "$IMG" -D o "$WORK/$NAME.cred" "::loader/credentials/$NAME.cred"
  echo "wrote loader/credentials/$NAME.cred"
done

mdir -i "$IMG" ::loader/credentials
