#!/bin/sh
# verify [-C DIR] [--image ATTR] [--boot-args ARGS | --boot-set ARGS...] [--jobs N]
#        [--no-boot] [--lint-only] [--each-commit BASE]
# Lint, build an image and the checks that build it again, and boot it (docs/reference/boot-test.md).
# A failed lint or image stops the run. The tree must be clean, without untracked files.
#   -C DIR             verify the tree in DIR (default: this repository)
#   --image ATTR       the image under packages.<system> (default image-smoke-test)
#   --boot-set ARGS    one boot with boot-test's flags after the disk and --keys; repeat it for
#                      several. Default: the lines of tests/boot/matrix, which names @image, @next
#   --boot-args ARGS   one boot, in place of the sets
#   --jobs N           boot at most N sets at once (default: MemAvailable / 2.5 GiB)
#   --no-boot | --lint-only    build the image only | lint only
#   --each-commit BASE lint each commit of BASE..HEAD; build and boot the last
set -u
self=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)/$(basename "$0")
dir=$(dirname "$self")/..
image="image-smoke-test"
boot=1
boot_args=
jobs=
lint_only=0
each=
boot_sets=
usage() { sed -n '2,/^set -u$/{/^set -u$/d;s/^# \{0,1\}//p}' "$self"; }
# arg OPTION VALUE...: refuse an option without a value
arg() { [ $# -ge 2 ] || { echo "verify: $1 needs a value" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
  case "$1" in
  -h | --help) usage; exit 0 ;;
  -C) arg "$@"; dir=$2; shift 2 ;;
  --image) arg "$@"; image=$2; shift 2 ;;
  --boot-args) arg "$@"; boot_args=$2; shift 2 ;;
  --boot-set) arg "$@"; boot_sets="$boot_sets${boot_sets:+
}$2"; shift 2 ;;
  --jobs)
    arg "$@"
    case $2 in '' | *[!0-9]* | 0) echo "verify: --jobs needs a number above 0" >&2; exit 2 ;; esac
    jobs=$2; shift 2 ;;
  --no-boot) boot=0; shift ;;
  --lint-only) lint_only=1; shift ;;
  --each-commit) arg "$@"; each=$2; shift 2 ;;
  *) echo "verify: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done
cd "$dir" || exit 2
system=${GOLCONDA_SYSTEM:-$(uname -m)-linux}
if [ $lint_only = 0 ] && [ -z "$boot_sets" ] && [ -z "$boot_args" ]; then
  boot_sets=$(grep -v -e '^#' -e '^[[:space:]]*$' tests/boot/matrix) ||
    { echo "verify: no boot set in $(pwd)/tests/boot/matrix" >&2; exit 2; }
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "verify: $(pwd) has uncommitted changes; commit or stash them first" >&2
  exit 1
fi
# Nix reads the checkout's files where they lie: an untracked file can enter the build, and so can
# an ignored one in modules/ or packages/, which the module walk and the package sources read
# whole. Ignored files elsewhere (result links, docs/book) stay out of it.
untracked=$({
  git ls-files --others --exclude-standard
  git ls-files --others -- modules packages
} | sort -u)
if [ -n "$untracked" ]; then
  echo "verify: $(pwd) has files git does not track, which the build can read; commit, move or remove them first:" >&2
  printf '%s\n' "$untracked" | sed 's/^/  /' >&2
  exit 1
fi

if [ -n "$each" ]; then
  tmp=$(mktemp -d)
  wt=$tmp/verify-each
  git worktree add -q --detach "$wt" HEAD || exit 1
  trap 'git worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$tmp"' EXIT
  last=$(git rev-parse HEAD)
  results=
  rc=0
  for c in $(git rev-list --reverse "$each..HEAD"); do
    git -C "$wt" checkout -q --detach "$c"
    line="$(git log -1 --format='%h %s' "$c")"
    echo "== commit $line"
    if [ "$c" = "$last" ]; then
      set -- -C "$wt" --image "$image"
      [ -z "$boot_args" ] || set -- "$@" --boot-args "$boot_args"
      [ -z "$jobs" ] || set -- "$@" --jobs "$jobs"
      while IFS= read -r bs; do
        [ -z "$bs" ] || set -- "$@" --boot-set "$bs"
      done <<EOF
$boot_sets
EOF
      [ $boot = 1 ] || set -- "$@" --no-boot
      [ $lint_only = 1 ] && set -- "$@" --lint-only
    else
      set -- -C "$wt" --lint-only
    fi
    if "$self" "$@"; then r=PASS; else r=FAIL; rc=1; fi
    results="$results$r $line
"
  done
  printf '== summary\n%s' "$results"
  exit $rc
fi

pin=$(nix-instantiate --eval --strict -E \
  '(builtins.fromTOML (builtins.readFile ./pins/repkgs/sources.toml)).pin.rev' 2>/dev/null |
  tr -d '"' | cut -c1-7)
echo "verify $(git rev-parse --short HEAD), repkgs ${pin:-unknown}"

summary=
# step NAME COMMAND...: run, time, and record PASS or FAIL(code); false on failure
step() {
  name=$1
  shift
  echo "== $name: $*"
  start=$(date +%s)
  "$@"
  code=$?
  if [ $code = 0 ]; then r=PASS; else r="FAIL($code)"; fi
  line="$r $name $(($(date +%s) - start))s"
  echo "$line"
  summary="$summary$line
"
  [ $code = 0 ]
}
# bg NAME COMMAND...: step in the background, its output in $steps/N; "PID:N" goes to $bgs
bgs=
nbg=0
bg() {
  nbg=$((nbg + 1))
  step "$@" >"$steps/$nbg" 2>&1 &
  bgs="$bgs $!:$nbg"
}
# join LIST: wait for the steps of LIST (from $bgs), print the output of each and add its last
# line, PASS or FAIL, to the summary; false when one failed
join() {
  ok=0
  for p in $1; do
    wait "${p%%:*}" || ok=1
    cat "$steps/${p#*:}"
    summary="$summary$(tail -n 1 "$steps/${p#*:}")
"
  done
  [ $ok = 0 ]
}
# the checks that do not feed a boot; finish waits for them
checks=
finish() {
  if [ -n "$checks" ]; then
    join "$checks" || set -- 1
    checks=
  fi
  printf '== summary\n%s' "$summary"
  exit "$1"
}

step lint nix-shell -A "devShells.$system.default" --run ./scripts/lint || finish 1
if ! git diff --quiet; then
  echo "verify: the lint step changed files; commit them or find out why:"
  git diff --stat
  finish 1
fi
[ $lint_only = 1 ] && finish 0

# A boot set may start with @image=ATTR: the image it boots (default: --image's).
# set_image SET: the set's image; set_flags SET: its boot-test flags, without the @image word
set_image() {
  case "$1" in
  @image=*) a=${1%% *}; echo "${a#@image=}" ;;
  *) echo "$image" ;;
  esac
}
set_flags() {
  case "$1" in
  @image=*" "*) echo "${1#* }" ;;
  @image=*) ;;
  *) echo "$1" ;;
  esac
}
# link ATTR: the image's out-link (result-verify for --image's, else result-verify-ATTR); its next
# image's is that with -next. label NAME ATTR: the step's name, NAME for --image's, else NAME:ATTR
link() { if [ "$1" = "$image" ]; then echo result-verify; else echo "result-verify-$1"; fi; }
label() { if [ "$2" = "$image" ]; then echo "$1"; else echo "$1:$2"; fi; }
# add LIST WORD: LIST with WORD at its end, once
add() { case " $1 " in *" $2 "*) echo "$1" ;; *) echo "$1${1:+ }$2" ;; esac; }

# nexts_of ATTR FLAGS: the images the @next words of FLAGS name, one "ATTR_NEXT:OUTLINK:STEP_LABEL"
# per word: ATTR_NEXT for @next=ATTR_NEXT, ATTR-next for @next
nexts_of() {
  for w in $2; do
    case $w in
    @next=*) w=${w#@next=}; echo "$w:result-verify-$w:image-next:$w" ;;
    @next) echo "$1-next:$(link "$1")-next:$(label image-next "$1")" ;;
    esac
  done
}
# add_nexts ATTR FLAGS: $nexts with the images FLAGS' @next words name
add_nexts() {
  for nx in $(nexts_of "$1" "$2"); do nexts=$(add "$nexts" "$nx"); done
}
# the images to build, each once, and the next images a set's @next needs
images=
nexts=
if [ -z "$boot_sets" ]; then
  images=$image
  add_nexts "$image" "$boot_args"
else
  while IFS= read -r bs; do
    a=$(set_image "$bs")
    images=$(add "$images" "$a")
    add_nexts "$a" "$(set_flags "$bs")"
  done <<EOF
$boot_sets
EOF
fi
# Every build starts at once, one nix-build for each out-link. The boots wait for the images,
# the next images and the tools; the checks run beside the boots.
steps=$(mktemp -d)
trap 'rm -rf "$steps"' EXIT
for a in $images; do
  bg "$(label image "$a")" nix-build -A "packages.$system.$a" -o "$(link "$a")"
done
case "$boot_args
$boot_sets" in *--certify*) certify=1 ;; *) certify=0 ;; esac
if [ $boot = 1 ]; then
  # @next in the boot flags is the next release's image (<image>-next, the one boot-test --next
  # installs, of the set's own image): build it too and put its path there
  for nx in $nexts; do
    attr=${nx%%:*}; rest=${nx#*:}
    bg "${rest#*:}" nix-build -A "packages.$system.$attr" -o "${rest%%:*}"
  done
  if [ -n "$nexts" ] || [ $certify = 1 ]; then
    # --next and --certify push admin vars with golconda, age and age-keygen
    bg golconda-cli nix-build -A "packages.$system.golconda-cli" -o result-verify-golconda-cli
    bg age nix-build -A "packages.$system.age" -o result-verify-age
  fi
fi
need=$bgs
bgs=
# the test image's initrd, built again from the same derivation, is the same bytes
bg initrd-reproducible nix-build -A "packages.$system.initrd-reproducible" \
  -o result-verify-initrd-reproducible
# the test image's release, signed again from the same unsigned output, is the same bytes
bg disk-reproducible nix-build -A "packages.$system.disk-reproducible" \
  -o result-verify-disk-reproducible
# the PKCS#11 signer gives the same release as the key files; a key set without PK.key and
# KEK.key signs the same release (nix/default.nix)
for a in pkcs11-signed-same release-without-pk-kek; do
  bg "$a" nix-build -A "packages.$system.$a" -o "result-verify-$a"
done
checks=$bgs
join "$need" || finish 1
[ $boot = 1 ] || finish 0
if [ -n "$nexts" ] || [ $certify = 1 ]; then
  BOOT_TEST_GOLCONDA=$(realpath result-verify-golconda-cli)/bin/golconda
  PATH=$(realpath result-verify-age)/bin:$PATH
  export BOOT_TEST_GOLCONDA PATH
fi
# boot_cmd ATTR FLAGS: three lines for boot-test, the image's disk, its keys and FLAGS with each
# @next word replaced by its image's path
boot_cmd() {
  img=$(realpath "$(link "$1")") || return 1
  flags=
  for w in $2; do
    case $w in
    @next | @next=*)
      nx=$(nexts_of "$1" "$w"); rest=${nx#*:}
      w=$(realpath "${rest%%:*}") || return 1
      ;;
    esac
    flags="$flags${flags:+ }$w"
  done
  realpath "$img/disk/disk.raw" && realpath "$img/keys" && printf '%s\n' "$flags"
}
if [ -z "$boot_sets" ]; then
  cmd=$(boot_cmd "$image" "$boot_args") || finish 1
  { read -r disk; read -r keys; read -r flags; } <<EOF
$cmd
EOF
  # shellcheck disable=SC2086 # flags is a list of flags
  step boot ./scripts/boot-test "$disk" --keys "$keys" $flags || finish 1
  finish 0
fi

# boot_set N: boot-test with $logs/boot-N.cmd (boot_cmd's lines); the exit code and the seconds it
# took go to $logs/boot-N.rc
boot_set() {
  start=$(date +%s)
  { read -r disk; read -r keys; read -r flags; } <"$logs/boot-$1.cmd"
  # shellcheck disable=SC2086 # flags is a list of flags
  ./scripts/boot-test "$disk" --keys "$keys" $flags >"$logs/boot-$1.log" 2>&1
  echo "$? $(($(date +%s) - start))" >"$logs/boot-$1.rc"
}
# shown SET: the set as the summary names it, with its image: @image=ATTR FLAGS
shown() {
  f=$(set_flags "$1")
  echo "@image=$(set_image "$1")${f:+ $f}"
}
cache=${BOOT_TEST_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/golconda-boot-test}
mkdir -p "$cache"
find "$cache" -maxdepth 1 -name 'verify.*' -mtime +7 -exec rm -rf {} + 2>/dev/null
logs=$(mktemp -d "$cache/verify.XXXXXX")
# every set's command first, so a path that does not resolve stops the run before any boot
n=0
while IFS= read -r bs; do
  n=$((n + 1))
  boot_cmd "$(set_image "$bs")" "$(set_flags "$bs")" >"$logs/boot-$n.cmd" || { rm -rf "$logs"; finish 1; }
done <<EOF
$boot_sets
EOF
# at most $jobs boots at a time: each takes a line from the FIFO on descriptor 3 before it starts,
# and puts it back when it ends
[ -n "$jobs" ] ||
  jobs=$(awk '/^MemAvailable:/ { n = int($2 / (2.5 * 1024 * 1024)); print (n < 1 ? 1 : n) }' /proc/meminfo)
echo "== boots: $n sets, at most $jobs at a time"
mkfifo "$logs/jobs" || finish 1
exec 3<>"$logs/jobs"
rm "$logs/jobs"
i=0
while [ $i -lt "$jobs" ]; do echo; i=$((i + 1)); done >&3
n=0
boots=
bad=0
while IFS= read -r bs; do
  n=$((n + 1))
  echo "== boot[$n]: $(shown "$bs")"
  { read -r _ <&3; boot_set "$n"; echo >&3; } &
  boots="$boots $!"
done <<EOF
$boot_sets
EOF
join "$checks" || bad=1
checks=
for p in $boots; do wait "$p"; done
exec 3>&-
i=0
while IFS= read -r bs; do
  i=$((i + 1))
  read -r code secs <"$logs/boot-$i.rc" || { code=1; secs=0; }
  # the names of the checks that passed ("PASS: NAME"; not the "PASS: N, FAIL: M" totals)
  passed=$(sed -n '/^PASS: [0-9]*, FAIL: [0-9]*$/d; s/^PASS: \([^ ]*\).*/\1/p' "$logs/boot-$i.log" 2>/dev/null |
    tr '\n' ' ')
  passed="  passed boot[$i] ($(echo "$passed" | wc -w)): ${passed% }"
  if [ "$code" = 0 ]; then
    r=PASS
    where=
    rm -f "$logs/boot-$i.log"
  else
    r="FAIL($code)"
    where=" (log $logs/boot-$i.log)"
    bad=1
    grep '^FAIL' "$logs/boot-$i.log"
    tail -n 20 "$logs/boot-$i.log"
  fi
  rm -f "$logs/boot-$i.rc" "$logs/boot-$i.cmd"
  line="$r boot[$i] ${secs}s $(shown "$bs")$where
$passed"
  echo "$line"
  summary="$summary$line
"
done <<EOF
$boot_sets
EOF
rmdir "$logs" 2>/dev/null
finish $bad
