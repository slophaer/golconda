#!/bin/sh
# scripts/verify: is this commit good? Lint (scripts/lint in the dev shell: iets, the checks, the
# treefmt check among them), build an image, build the test image's initrd a second time
# (packages.<system>.initrd-reproducible: the same bytes), boot it with scripts/boot-test; stop at
# the first failure. Run it through the build queue on a shared host (qbuild -g vm verify --
# scripts/verify); a step's output goes to stdout.
#
#   scripts/verify [-C DIR] [--image ATTR] [--boot-args ARGS | --boot-set ARGS...] [--no-boot]
#                  [--lint-only] [--each-commit BASE]
#
#   -C DIR              verify the tree in DIR (default: this repository)
#   --image ATTR        the image under packages.<system> (default image-smoke-test); the out-link
#                       is result-verify. A boot set may name another (@image below)
#   --boot-args ARGS    scripts/boot-test's flags after the disk and --keys (default
#                       "--secure-boot --ssh-test --tpm --timeout 300": a reboot on a loaded
#                       host can outlast boot-test's own default). @next in the flags (and in
#                       --boot-set) stands for the next release's image: verify builds
#                       <image>-next too (image-smoke-test-next for the default image,
#                       image-smoke-test-nosb-next for image-smoke-test-nosb; out-link
#                       result-verify-next) and puts its path there, as in "--next @next". It
#                       also builds golconda-cli and age, which --next needs
#                       (BOOT_TEST_GOLCONDA, PATH)
#   --boot-set ARGS     one boot of a list (repeat it): all sets boot at the same time, each with
#                       its own log, and the summary has one line per set with its result, time,
#                       image and ARGS ("PASS boot[N] 300s @image=ATTR ARGS"), and a line with the
#                       names of the checks that passed ("  passed boot[N] (COUNT): NAME ...").
#                       The run fails when any set fails. A set that fails keeps its log (the line
#                       names it); a set that passes removes it. Replaces --boot-args. The VMs
#                       need about 2 GiB each.
#                       A set that starts with the word @image=ATTR boots packages.<system>.ATTR
#                       instead of --image's, as in "@image=image-smoke-test-nosb --ssh-test
#                       --next @next": verify builds each image the sets name once (out-link
#                       result-verify-ATTR, step image:ATTR), and @next in the set is the next
#                       image of the set's own image (ATTR-next, result-verify-ATTR-next, step
#                       image-next:ATTR). So one run boots the Secure Boot sets and the nosb sets.
#                       @next=ATTR instead names the next image, packages.<system>.ATTR (out-link
#                       result-verify-ATTR, step image-next:ATTR), for a next release that is no
#                       <image>-next, as in "--next @next=image-smoke-test-rotated --rotate"
#   --no-boot           build the image, do not boot it
#   --lint-only         lint only
#   --each-commit BASE  every commit in BASE..HEAD, in a scratch worktree: lint each, and build and
#                       boot the last; one PASS or FAIL line per commit
#
# The tree must be clean: the result belongs to one commit and one repkgs pin, named on the first
# line. With BOOT_TEST_STORE_ROOT set (a chroot store, nix --store local?root=DIR), the dev shell is
# realised in the host store first (nix-shell runs it from /nix/store, the daemon builds it under
# its root), and the image's links into /nix/store are followed under that root.
#
# The logs of --boot-set are in $BOOT_TEST_CACHE/verify.XXXXXX (default
# ${XDG_CACHE_HOME:-$HOME/.cache}/golconda-boot-test, which is also where scripts/boot-test keeps
# the work directory of a failed run); verify removes its own directories older than 7 days.
set -u
self=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)/$(basename "$0")
dir=$(dirname "$self")/..
image="image-smoke-test"
boot=1
boot_args="--secure-boot --ssh-test --tpm --timeout 300"
lint_only=0
each=
boot_sets=
usage() {
  sed -n '2,/^set -u$/{/^set -u$/d;s/^# \{0,1\}//p}' "$self" >&2
  exit 2
}
while [ $# -gt 0 ]; do
  case "$1" in
  -C) dir=${2:?}; shift 2 ;;
  --image) image=${2:?}; shift 2 ;;
  --boot-args) boot_args=${2?}; shift 2 ;;
  --boot-set) boot_sets="$boot_sets${boot_sets:+
}${2?}"; shift 2 ;;
  --no-boot) boot=0; shift ;;
  --lint-only) lint_only=1; shift ;;
  --each-commit) each=${2:?}; shift 2 ;;
  *) usage ;;
  esac
done
cd "$dir" || exit 2
system=${GOLCONDA_SYSTEM:-$(uname -m)-linux}

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "verify: $(pwd) has uncommitted changes; commit or stash them first" >&2
  exit 1
fi

if [ -n "$each" ]; then
  wt=$(mktemp -d)/verify-each
  git worktree add -q --detach "$wt" HEAD || exit 1
  trap 'git worktree remove --force "$wt" >/dev/null 2>&1' EXIT
  last=$(git rev-parse HEAD)
  results=
  rc=0
  for c in $(git rev-list --reverse "$each..HEAD"); do
    git -C "$wt" checkout -q --detach "$c"
    line="$(git log -1 --format='%h %s' "$c")"
    echo "== commit $line"
    if [ "$c" = "$last" ]; then
      set -- -C "$wt" --image "$image" --boot-args "$boot_args"
      while IFS= read -r bs; do
        [ -z "$bs" ] || set -- "$@" --boot-set "$bs"
      done <<EOF
$boot_sets
EOF
      [ $boot = 1 ] || set -- "$@" --no-boot
      [ $lint_only = 1 ] && set -- "$@" --lint-only
    else
      set -- -C "$wt" --lint-only
    fi
    if "$self" "$@"; then r=PASS; else r=FAIL; rc=1; fi
    results="$results$r $line
"
  done
  printf '== summary\n%s' "$results"
  exit $rc
fi

pin=$(nix-instantiate --eval --strict -E \
  '(builtins.fromTOML (builtins.readFile ./pins/repkgs/sources.toml)).pin.rev' 2>/dev/null |
  tr -d '"' | cut -c1-7)
echo "verify $(git rev-parse --short HEAD), repkgs ${pin:-unknown}"

summary=
# step NAME COMMAND...: run, time, and record PASS or FAIL(code); false on failure
step() {
  name=$1
  shift
  echo "== $name: $*"
  start=$(date +%s)
  "$@"
  code=$?
  if [ $code = 0 ]; then r=PASS; else r="FAIL($code)"; fi
  line="$r $name $(($(date +%s) - start))s"
  echo "$line"
  summary="$summary$line
"
  [ $code = 0 ]
}
finish() {
  printf '== summary\n%s' "$summary"
  exit "$1"
}

shell=devShells.$system.default
if [ -n "${BOOT_TEST_STORE_ROOT:-}" ]; then
  (unset NIX_REMOTE; nix-shell -A "$shell" --run true) >/dev/null ||
    { echo "verify: the dev shell does not build in the host store" >&2; exit 1; }
fi
step lint nix-shell -A "$shell" --run ./scripts/lint || finish 1
if ! git diff --quiet; then
  echo "verify: the lint step changed files; commit them or find out why:"
  git diff --stat
  finish 1
fi
[ $lint_only = 1 ] && finish 0

# A boot set may start with @image=ATTR: the image it boots (default: --image's).
# set_image SET: the set's image; set_flags SET: its boot-test flags, without the @image word
set_image() {
  case "$1" in
  @image=*) a=${1%% *}; echo "${a#@image=}" ;;
  *) echo "$image" ;;
  esac
}
set_flags() {
  case "$1" in
  @image=*" "*) echo "${1#* }" ;;
  @image=*) ;;
  *) echo "$1" ;;
  esac
}
# link ATTR: the image's out-link (result-verify for --image's, else result-verify-ATTR); its next
# image's is that with -next. label NAME ATTR: the step's name, NAME for --image's, else NAME:ATTR
link() { if [ "$1" = "$image" ]; then echo result-verify; else echo "result-verify-$1"; fi; }
label() { if [ "$2" = "$image" ]; then echo "$1"; else echo "$1:$2"; fi; }
# add LIST WORD: LIST with WORD at its end, once
add() { case " $1 " in *" $2 "*) echo "$1" ;; *) echo "$1${1:+ }$2" ;; esac; }

# next_of ATTR FLAGS: the next image FLAGS name, "ATTR_NEXT:OUTLINK:STEP_LABEL": ATTR_NEXT for
# @next=ATTR_NEXT, else ATTR-next
next_of() {
  case $2 in
  *@next=*) w=${2#*@next=}; w=${w%% *}; echo "$w:result-verify-$w:image-next:$w" ;;
  *) echo "$1-next:$(link "$1")-next:$(label image-next "$1")" ;;
  esac
}
# the images to build, each once, and the next images a set's @next needs
images=
nexts=
if [ -z "$boot_sets" ]; then
  images=$image
  case $boot_args in *@next*) nexts=$(next_of "$image" "$boot_args") ;; esac
else
  while IFS= read -r bs; do
    a=$(set_image "$bs")
    images=$(add "$images" "$a")
    case $(set_flags "$bs") in *@next*) nexts=$(add "$nexts" "$(next_of "$a" "$(set_flags "$bs")")") ;; esac
  done <<EOF
$boot_sets
EOF
fi
for a in $images; do
  step "$(label image "$a")" nix-build -A "packages.$system.$a" -o "$(link "$a")" || finish 1
done
# the test image's initrd, built again from the same derivation, is the same bytes
step initrd-reproducible nix-build -A "packages.$system.initrd-reproducible" \
  -o result-verify-initrd-reproducible || finish 1
[ $boot = 1 ] || finish 0
# resolve PATH: PATH with every symlink on the way followed, a target in /nix/store looked up
# under $BOOT_TEST_STORE_ROOT (boot-test itself follows only a final link)
resolve() {
  python3 - "${BOOT_TEST_STORE_ROOT:-}" "$1" <<'PY'
import os, sys
root, path = sys.argv[1], os.path.abspath(sys.argv[2])
parts, cur, hops = path.strip("/").split("/"), "/", 0
while parts:
    nxt = os.path.join(cur, parts.pop(0))
    if os.path.islink(nxt):
        hops += 1
        if hops > 64:
            sys.exit("verify: symlink loop at " + nxt)
        t = os.readlink(nxt)
        if t.startswith("/nix/store/") and root:
            t = root + t
        parts = os.path.normpath(os.path.join(cur, t)).strip("/").split("/") + parts
        cur = "/"
    else:
        cur = nxt
print(cur)
PY
}
# @next in the boot flags is the next release's image (<image>-next, the one boot-test --next
# installs, of the set's own image): build it too and put its path there
for nx in $nexts; do
  attr=${nx%%:*}; rest=${nx#*:}
  step "${rest#*:}" nix-build -A "packages.$system.$attr" -o "${rest%%:*}" || finish 1
done
if [ -n "$nexts" ]; then
  # --next pushes admin vars with golconda, age and age-keygen
  step golconda-cli nix-build -A "packages.$system.golconda-cli" -o result-verify-golconda-cli || finish 1
  step age nix-build -A "packages.$system.age" -o result-verify-age || finish 1
  BOOT_TEST_GOLCONDA=$(resolve result-verify-golconda-cli)/bin/golconda
  PATH=$(resolve result-verify-age)/bin:$PATH
  export BOOT_TEST_GOLCONDA PATH
fi
# boot_cmd ATTR FLAGS: three lines for boot-test, the image's disk, its keys and FLAGS with @next
# replaced
boot_cmd() {
  img=$(resolve "$(link "$1")") || return 1
  flags=$2
  case $flags in
  *@next*)
    nx=$(next_of "$1" "$flags"); rest=${nx#*:}
    next=$(resolve "${rest%%:*}") || return 1
    flags=$(printf '%s\n' "$flags" | sed "s|@next=[^ ]*|$next|g; s|@next|$next|g")
    ;;
  esac
  resolve "$img/disk/disk.raw" && resolve "$img/keys" && printf '%s\n' "$flags"
}
if [ -z "$boot_sets" ]; then
  cmd=$(boot_cmd "$image" "$boot_args") || finish 1
  { read -r disk; read -r keys; read -r flags; } <<EOF
$cmd
EOF
  # shellcheck disable=SC2086 # flags is a list of flags
  step boot ./scripts/boot-test "$disk" --keys "$keys" $flags || finish 1
  finish 0
fi

# boot_set N: boot-test with $logs/boot-N.cmd (boot_cmd's lines); the exit code and the seconds it
# took go to $logs/boot-N.rc
boot_set() {
  start=$(date +%s)
  { read -r disk; read -r keys; read -r flags; } <"$logs/boot-$1.cmd"
  # shellcheck disable=SC2086 # flags is a list of flags
  ./scripts/boot-test "$disk" --keys "$keys" $flags >"$logs/boot-$1.log" 2>&1
  echo "$? $(($(date +%s) - start))" >"$logs/boot-$1.rc"
}
# shown SET: the set as the summary names it, with its image: @image=ATTR FLAGS
shown() {
  f=$(set_flags "$1")
  echo "@image=$(set_image "$1")${f:+ $f}"
}
cache=${BOOT_TEST_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/golconda-boot-test}
mkdir -p "$cache"
find "$cache" -maxdepth 1 -name 'verify.*' -mtime +7 -exec rm -rf {} + 2>/dev/null
logs=$(mktemp -d "$cache/verify.XXXXXX")
# every set's command first, so a path that does not resolve stops the run before any boot
n=0
while IFS= read -r bs; do
  n=$((n + 1))
  boot_cmd "$(set_image "$bs")" "$(set_flags "$bs")" >"$logs/boot-$n.cmd" || { rm -rf "$logs"; finish 1; }
done <<EOF
$boot_sets
EOF
n=0
while IFS= read -r bs; do
  n=$((n + 1))
  echo "== boot[$n]: $(shown "$bs")"
  boot_set "$n" &
done <<EOF
$boot_sets
EOF
wait
i=0
bad=0
while IFS= read -r bs; do
  i=$((i + 1))
  read -r code secs <"$logs/boot-$i.rc" || { code=1; secs=0; }
  # the names of the checks that passed ("PASS: NAME"; not the "PASS: N, FAIL: M" totals)
  passed=$(sed -n '/^PASS: [0-9]*, FAIL: [0-9]*$/d; s/^PASS: \([^ ]*\).*/\1/p' "$logs/boot-$i.log" 2>/dev/null |
    tr '\n' ' ')
  passed="  passed boot[$i] ($(echo "$passed" | wc -w)): ${passed% }"
  if [ "$code" = 0 ]; then
    r=PASS
    where=
    rm -f "$logs/boot-$i.log"
  else
    r="FAIL($code)"
    where=" (log $logs/boot-$i.log)"
    bad=1
    grep '^FAIL' "$logs/boot-$i.log"
    tail -n 20 "$logs/boot-$i.log"
  fi
  rm -f "$logs/boot-$i.rc" "$logs/boot-$i.cmd"
  line="$r boot[$i] ${secs}s $(shown "$bs")$where
$passed"
  echo "$line"
  summary="$summary$line
"
done <<EOF
$boot_sets
EOF
rmdir "$logs" 2>/dev/null
finish $bad
