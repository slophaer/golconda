#!/bin/sh
# make-keys [--auth-only] [--reuse-pk-kek OLD] DIR
# Make a deployment key set in DIR for `golconda release build`, and the PK and KEK keys in
# DIR.private, for offline media: no release reads them. With --auth-only, write the enrolment
# files (secureboot/auth) of the set in DIR again, with the keys in DIR.private: for a newer dbx,
# or a set without them.
#   --reuse-pk-kek OLD  a db rotation: copy OLD's PK.crt and KEK.crt, make no PK or KEK key, sign
#                       the enrolment files with the keys in OLD.private, and copy OLD's release
#                       key, which cannot change. The script cannot tell a rotation from a new
#                       deployment, so a rotation names the old set.
# DIR and DIR.private must be new or empty and outside any git work tree. The script makes them
# 0700 and each file 0600, and prints the paths and fingerprints, never key material. The layout
# is in docs/reference/release.md.
set -eu

usage() { sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//p}' "$0"; }

old=""
auth_only=0
while [ $# -gt 0 ]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    --auth-only)
      auth_only=1
      shift
      ;;
    --reuse-pk-kek)
      [ $# -ge 2 ] || {
        echo "make-keys: --reuse-pk-kek needs the old key directory" >&2
        exit 2
      }
      old=$2
      shift 2
      ;;
    -*)
      echo "make-keys: unknown option $1" >&2
      usage >&2
      exit 2
      ;;
    *) break ;;
  esac
done
[ $# -eq 1 ] || {
  usage >&2
  exit 2
}
if [ -n "$old" ]; then
  old=$(realpath -m -- "$old")
  for f in secureboot/PK.crt secureboot/KEK.crt release/index.key release/index.pgp .private/PK.key .private/KEK.key; do
    case $f in .private/*) p=$old$f ;; *) p=$old/$f ;; esac
    [ -f "$p" ] || {
      echo "make-keys: --reuse-pk-kek $old: no $p (the PK and KEK keys are in $old.private)" >&2
      exit 2
    }
  done
fi

# absolute, as lib.mkImage needs it; -s: a symlink stays one, and is refused below
dir=$(realpath -ms -- "$1")
# the PK and KEK keys, beside the set: the operator moves them to offline media
private=$dir.private
# Not in a git work tree: Nix reads a checkout's files where they lie, and a file there that
# reaches the store is world-readable. The nearest directory that exists decides.
at=$dir
while [ ! -d "$at" ]; do at=$(dirname "$at"); done
if command -v git >/dev/null && [ "$(git -C "$at" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
  echo "make-keys: $dir is in the git work tree $(git -C "$at" rev-parse --show-toplevel);" >&2
  echo "make-keys: keep the key set outside any checkout (for example /srv/golconda-keys)" >&2
  exit 2
fi

# Golconda's own openssl and gpg (scripts/tools.sh), not the caller's: the gpg is the one systemd-pull
# uses on the image, so the release key is made and checked by the same GnuPG; and
# golconda-enrol-auth, which signs the enrolment files with Microsoft's objects
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
. "$SCRIPT_DIR/tools.sh"
TOOLS=$(tools_path "$(dirname "$SCRIPT_DIR")" openssl gnupg golconda-enrol-auth) || {
  echo "make-keys: cannot build the tools (packages: openssl gnupg golconda-enrol-auth); the nix-build error is above" >&2
  exit 1
}
PATH="$TOOLS:$PATH"
# no configuration: the certificates carry only the extensions named below (openssl.cnf's [req]
# would add its v3_ca ones; lib/image/keys.nu does the same)
export OPENSSL_CONF=/dev/null

# run_openssl ARGS...: openssl prints key-generation progress on stderr; keep it in $work, and
# print it only on failure
run_openssl() {
  if ! openssl "$@" 2>"$work/openssl.log"; then
    echo "make-keys: openssl failed:" >&2
    cat "$work/openssl.log" >&2
    exit 1
  fi
}

# signing_set WORK SET: WORK/secureboot with SET's PK.crt and KEK.crt and links to the keys in
# SET.private, the layout golconda-enrol-auth --signing-keys reads
signing_set() {
  mkdir -p "$1/secureboot"
  cp "$2/secureboot/PK.crt" "$2/secureboot/KEK.crt" "$1/secureboot/"
  ln -s "$2.private/PK.key" "$2.private/KEK.key" "$1/secureboot/"
}

# private_modes: DIR.private 0700, its keys 0600
private_modes() {
  chmod 700 "$private"
  chmod 600 "$private/PK.key" "$private/KEK.key"
}

# keypair DIR NAME [-addext EXT]...: a self-signed CA pair DIR/NAME.key and DIR/NAME.crt, with
# the extensions of a Secure Boot key and the ones given
keypair() {
  d=$1
  n=$2
  shift 2
  run_openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 \
    -subj "/CN=golconda deployment $n $(date -u +%Y%m%d)" \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,digitalSignature,keyCertSign,cRLSign" \
    "$@" -addext "subjectKeyIdentifier=hash" \
    -keyout "$d/$n.key" -out "$d/$n.crt"
}

if [ "$auth_only" = 1 ]; then
  sb=$dir/secureboot
  [ -f "$sb/db.crt" ] || {
    echo "make-keys: --auth-only: $dir is not a key set (no secureboot/db.crt)" >&2
    exit 1
  }
  umask 077
  # written beside the set from copies of its certificates, then swapped in: the old files stay
  # until the new ones are written and checked
  work=$(mktemp -d "$sb/.auth.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  if [ -n "$old" ]; then
    for k in PK KEK; do
      if [ -e "$sb/$k.crt" ]; then
        cmp -s "$sb/$k.crt" "$old/secureboot/$k.crt" || {
          echo "make-keys: $sb/$k.crt is not $old's $k.crt: that set's keys cannot sign this set" >&2
          exit 1
        }
      else
        cp "$old/secureboot/$k.crt" "$sb/$k.crt"
      fi
    done
  elif [ ! -e "$sb/PK.crt" ] && [ ! -e "$sb/KEK.crt" ]; then
    if [ -L "$private" ] || { [ -e "$private" ] && [ -n "$(find "$private" -mindepth 1 -maxdepth 1 -print -quit)" ]; }; then
      echo "make-keys: $private exists and is not empty; it is where the new PK and KEK keys go" >&2
      exit 1
    fi
    mkdir -p "$private"
    keypair "$work" PK
    keypair "$work" KEK
    mv "$work/PK.key" "$work/KEK.key" "$private/"
    mv "$work/PK.crt" "$work/KEK.crt" "$sb/"
    private_modes
    echo "made $sb/PK.crt, KEK.crt and $private/PK.key, KEK.key"
    echo "move $private to offline media: only scripts/make-keys --auth-only and --reuse-pk-kek read it"
  elif [ ! -f "$private/PK.key" ] || [ ! -f "$private/KEK.key" ]; then
    echo "make-keys: $sb has PK.crt or KEK.crt but $private has not both keys: bring it back from" >&2
    echo "make-keys: offline media, or name the set whose .private holds them: scripts/make-keys --auth-only --reuse-pk-kek DIR $dir" >&2
    exit 1
  fi
  mkdir "$work/secureboot"
  cp "$sb/PK.crt" "$sb/KEK.crt" "$sb/db.crt" "$work/secureboot/"
  signing_set "$work/sign" "${old:-$dir}"
  if ! golconda-enrol-auth --keys "$work" --signing-keys "$work/sign" >"$work/log" 2>&1; then
    echo "make-keys: golconda-enrol-auth failed:" >&2
    cat "$work/log" >&2
    exit 1
  fi
  rm -rf "$sb/auth"
  mv "$work/secureboot/auth" "$sb/auth"
  find "$sb" -type f -exec chmod 600 {} +
  find "$sb" -type d -exec chmod 700 {} +
  echo "wrote $sb/auth/microsoft (PK, KEK, db, dbx) and $sb/auth/golconda (PK, KEK, db)"
  echo "signed by the PK and KEK keys in ${old:-$dir}.private; keep them on offline media"
  exit 0
fi

if [ -L "$dir" ]; then
  echo "make-keys: $dir is a symlink; give the key set a directory of its own" >&2
  exit 1
fi
if [ -e "$dir" ] && [ ! -d "$dir" ]; then
  echo "make-keys: $dir exists and is not a directory" >&2
  exit 1
fi
if [ -d "$dir" ] && [ -n "$(find "$dir" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
  echo "make-keys: $dir is not empty; give a new directory" >&2
  exit 1
fi
if [ -z "$old" ]; then
  if [ -L "$private" ] || { [ -e "$private" ] && [ ! -d "$private" ]; }; then
    echo "make-keys: $private exists and is not a directory; the PK and KEK keys go there" >&2
    exit 1
  fi
  if [ -d "$private" ] && [ -n "$(find "$private" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "make-keys: $private is not empty; the PK and KEK keys go there" >&2
    exit 1
  fi
fi

umask 077
mkdir -p "$dir"
chmod 700 "$dir"
# generate beside the final names, so a failed run leaves no half key set behind
stage=$(mktemp -d "$dir/.new-keys.XXXXXX")
work=$stage
trap 'rm -rf "$stage"' EXIT
trap 'exit 1' HUP INT TERM

mkdir "$stage/secureboot" "$stage/pcr"
keypair "$stage/secureboot" db -addext "extendedKeyUsage=codeSigning"
# the PK and the KEK: self-signed, as the db certificate, without codeSigning; they sign only the
# Secure Boot variables (PK signs PK and KEK, KEK signs db and dbx). A rotation copies the old
# set's certificates and leaves their keys there.
for k in PK KEK; do
  if [ -n "$old" ]; then
    cp "$old/secureboot/$k.crt" "$stage/secureboot/$k.crt"
    continue
  fi
  keypair "$stage/secureboot" "$k"
done
# the enrolment files, signed now by this set's PK and KEK keys (or the old set's), so that no
# release needs them; their output on failure only
[ -z "$old" ] || signing_set "$stage/sign" "$old"
if ! golconda-enrol-auth --keys "$stage" ${old:+--signing-keys "$stage/sign"} >"$stage/enrol.log" 2>&1; then
  echo "make-keys: golconda-enrol-auth failed:" >&2
  cat "$stage/enrol.log" >&2
  exit 1
fi
run_openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$stage/pcr/pcr.key"
run_openssl pkey -in "$stage/pcr/pcr.key" -pubout -out "$stage/pcr/pcr.pub"

# the release key, in a scratch home that goes with its agent (a short path: the agent's socket);
# a rotation copies the old set's. It is made at 00:00 UTC the day before: a machine's clock is at
# least 00:00 UTC of its release date, and gpg refuses a key made after its clock
# (docs/design/updates.md).
mkdir "$stage/release" "$stage/g"
gpg_run() {
  if ! GNUPGHOME="$stage/g" gpg --batch "$@" 2>"$stage/gpg.log"; then
    echo "make-keys: gpg failed:" >&2
    cat "$stage/gpg.log" >&2
    exit 1
  fi
}
if [ -n "$old" ]; then
  cp "$old/release/index.key" "$old/release/index.pgp" "$stage/release/"
else
  made=$(($(date -u +%s) / 86400 * 86400 - 86400))
  gpg_run --faked-system-time "$made!" --passphrase '' --quick-gen-key "golconda release index $(date -u +%Y%m%d) <index@golconda.invalid>" ed25519 sign never
  gpg_run --export --output "$stage/release/index.pgp"
  gpg_run --pinentry-mode loopback --passphrase '' --armor --export-secret-keys --output "$stage/release/index.key"
fi
index_fpr=$(GNUPGHOME="$stage/g" gpg --batch --with-colons --show-keys "$stage/release/index.pgp" | awk -F: '$1 == "fpr" { print $10; exit }')
GNUPGHOME="$stage/g" gpgconf --kill gpg-agent 2>/dev/null || true

if [ -z "$old" ]; then
  mkdir -p "$private"
  mv "$stage/secureboot/PK.key" "$stage/secureboot/KEK.key" "$private/"
  private_modes
fi
mv "$stage/secureboot" "$stage/pcr" "$stage/release" "$dir"
trap - EXIT HUP INT TERM
rm -rf "$stage"
find "$dir/secureboot" "$dir/pcr" "$dir/release" -type f -exec chmod 600 {} +
find "$dir/secureboot" "$dir/pcr" "$dir/release" -type d -exec chmod 700 {} +

fp() { openssl x509 -in "$dir/secureboot/$1.crt" -outform der | sha256sum | cut -d ' ' -f 1; }
fingerprint=$(fp db)
cat <<EOF
deployment key set: $dir
  $dir/secureboot/db.key  (0600)  signs systemd-boot, each UKI and each verity root hash
  $dir/secureboot/db.crt  (0600)  the certificate for those signatures; enrol it in the firmware db
$(if [ -n "$old" ]; then
  echo "  $dir/secureboot/PK.crt, KEK.crt (0600)  copies of $old's: its keys signed this set"
else
  echo "  $private/PK.key  (0600)  signed PK.auth and KEK.auth; later, a new PK or KEK"
  echo "  $private/KEK.key (0600)  signed db.auth and dbx.auth; later, db and dbx updates"
  echo "  $dir/secureboot/PK.crt, KEK.crt (0600)  their certificates: firmware PK and KEK"
fi)
  $dir/secureboot/auth/microsoft/  PK, KEK, db, dbx with Microsoft's keys (/system.secureBootMicrosoftKeys)
  $dir/secureboot/auth/golconda/   PK, KEK, db with this set's certificates only
  $dir/pcr/pcr.key        (0600)  signs the PCR 11 policy (.pcrsig) in each UKI
  $dir/pcr/pcr.pub        (0600)  the public half, embedded in each UKI as .pcrpkey
  $dir/release/index.key  (0600)  signs each release's SHA256SUMS (OpenPGP, Ed25519)
  $dir/release/index.pgp  (0600)  the public half, the image's keyring for Verify=yes
db.crt sha256 (DER): $fingerprint
PK.crt sha256 (DER): $(fp PK)
KEK.crt sha256 (DER): $(fp KEK)
release key fingerprint: $index_fpr
keep the private keys out of the store: docs/reference/release.md
$([ -n "$old" ] || echo "move $private to offline media: only scripts/make-keys --auth-only and --reuse-pk-kek read it")
EOF
