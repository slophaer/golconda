#!/bin/sh
# scripts/boot-test: VM boot test for Golconda images.
#
# Usage: boot-test <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS]
#                  [--ssh-test] [--next DIR [--rotate]]
#
# The script boots the image in QEMU with:
#   - a 40 GiB qcow2 overlay (room for root partition)
#   - OVMF firmware (UEFI)
#   - optional Secure Boot with keys enrolled from --keys
#   - optional TPM 2.0 via swtpm
#   - SMBIOS type 11 credential: system.hostname=boot-test
#   - user-mode networking with hostfwd to SSH (host port $BOOT_TEST_SSH_PORT, default 10022)
#   - serial console logged to a file
#
# --keys DIR: the throwaway keys directory (from image-smoke-test's keys symlink
#   or the path to golconda-throwaway-keys directly).
#
# QEMU runs in the background; the checks run while the guest is up, then the
# harness stops it. Without --ssh-test the harness waits for multi-user.target.
#
# Markers checked (each prints PASS/FAIL, only on positive evidence):
#   - multi-user-reached: multi-user.target reached
#   - sshd-active: sshd.service started (Listening on port)
#   - var-sshd-hostkey: the host key var finished (it needs a writable root)
#   - boot-complete: boot-complete.target reached
#
# With --ssh-test: logs in with tests/fixtures/snakeoil-ssh and checks
#   ssh-login, hostname (must be "boot-test", the SMBIOS credential),
#   systemctl --failed (no failed units), varlinkctl list-interfaces.
# With --secure-boot: boots OVMFFull and checks that the firmware enforces Secure Boot.
# With --ssh-test: also checks the boot loader (docs/design/bootloader.md): the ESP's two
#   copies of systemd-boot are the signed file in /usr, loader/loader.conf is the one
#   systemd-boot reads and the copy in /usr, golconda-loader-update.service ran after the boot
#   was blessed, and systemd-boot-update.service stayed off.
# With --next DIR (implies --ssh-test): DIR is the next release's image-smoke output
#   (DIR/disk/release, DIR/keys). The harness copies the release into the guest over ssh and
#   installs it with systemd-sysupdate-update.service from /run/sysupdate.d definitions that
#   read the copy, reboots into it, and checks that golconda-loader-update.service put the new
#   loader on the ESP, and that no /etc/systemd/system link names the old systemd store path or
#   dangles (golconda-etc-links.service). Then the recovery checks: bootctl list shows both slots, a damaged loader
#   is reinstalled by hand, `bootctl set-oneshot` and `bootctl set-default` boot the other slot
#   and back, and `bootctl reboot-to-firmware` reaches the firmware's menu.
# With --next DIR --rotate: DIR is signed with a new db key. Its certificate is enrolled in db
#   beside the old one before the first boot; after the update the harness stops QEMU, rewrites
#   the variable store (db: the new certificate only; dbx: the old one), boots again and checks
#   the new chain, then boots the original disk with the rotated store, which firmware must
#   refuse.
# BOOT_TEST_STORE_ROOT: the root of a chroot store (nix --store 'local?root=DIR'); a symlink
#   into /nix/store under DIR is followed there.
# With --ssh-test --tpm: also checks that the host key is sealed with the TPM
#   (credential header), reboots the guest in the same QEMU (swtpm keeps its
#   state) and checks the second boot: a new boot id, sshd active, the same
#   host key (unsealed, not regenerated).
#
# Exit: 0 if all markers pass, 1 otherwise.

set -eu

# --- bootstrap: re-exec under nix-shell if tools are missing ---
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "$0")")"
  REPO_DIR="$(dirname "$SCRIPT_DIR")"
  # Get the dev pin path from npins/sources.json via nix-instantiate
  DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/nix/sources.nix).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
  if [ -z "$DEV_PIN" ] || [ ! -d "$DEV_PIN" ]; then
    echo "Error: cannot find nixpkgs-dev-only pin" >&2
    exit 1
  fi
  # nix-shell sets its own TMPDIR and removes it on exit: keep the work directory outside
  BOOT_TEST_TMPDIR="${TMPDIR:-/tmp}"
  export BOOT_TEST_TMPDIR
  exec nix-shell -I "nixpkgs=$DEV_PIN" -p qemu OVMF swtpm openssh python3Packages.virt-firmware --run "$0 $*"
fi

# --- argument parsing ---
# the host port for the guest's sshd: set BOOT_TEST_SSH_PORT when another VM uses 10022
SSH_PORT=${BOOT_TEST_SSH_PORT:-10022}
DISK=""
KEYS_DIR=""
SECURE_BOOT=0
TPM=0
TIMEOUT=120
SSH_TEST=0
NEXT=""
ROTATE=0

usage() {
  echo "Usage: $0 <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS] [--ssh-test] [--next DIR [--rotate]]"
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keys) KEYS_DIR="$2"; shift 2 ;;
    --secure-boot) SECURE_BOOT=1; shift ;;
    --tpm) TPM=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --ssh-test) SSH_TEST=1; shift ;;
    --next) NEXT="$2"; SSH_TEST=1; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --help|-h) usage ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      if [ -z "$DISK" ]; then
        DISK="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
      fi
      shift
      ;;
  esac
done

if [ -z "$DISK" ]; then
  echo "Error: disk image required" >&2
  usage
fi

if [ ! -f "$DISK" ]; then
  echo "Error: disk image not found: $DISK" >&2
  exit 1
fi

if [ -z "$KEYS_DIR" ]; then
  echo "Error: --keys DIR required" >&2
  usage
fi

if [ ! -d "$KEYS_DIR" ]; then
  echo "Error: keys directory not found: $KEYS_DIR" >&2
  exit 1
fi

# real_path PATH: PATH with its symlinks followed; a target in /nix/store is looked up under
# $BOOT_TEST_STORE_ROOT, so a chroot store's outputs resolve on the host
real_path() {
  rp=$1
  while [ -L "$rp" ]; do
    rt=$(readlink "$rp")
    case $rt in
      /nix/store/*) rp=${BOOT_TEST_STORE_ROOT:-}$rt ;;
      /*) rp=$rt ;;
      *) rp=$(dirname "$rp")/$rt ;;
    esac
  done
  echo "$rp"
}

if [ "$ROTATE" = 1 ] && { [ -z "$NEXT" ] || [ "$SECURE_BOOT" = 0 ]; }; then
  echo "Error: --rotate needs --next and --secure-boot" >&2
  exit 1
fi
if [ -n "$NEXT" ]; then
  NEXT_RELEASE=$(real_path "$NEXT/disk")/release
  NEXT_KEYS=$(real_path "$NEXT/keys")
  if [ ! -f "$NEXT_RELEASE/SHA256SUMS" ] || [ ! -f "$NEXT_KEYS/secureboot/db.crt" ]; then
    echo "Error: $NEXT has no disk/release/SHA256SUMS or keys/secureboot/db.crt" >&2
    exit 1
  fi
fi

# --- working directory ---
WORKDIR="${BOOT_TEST_TMPDIR:-${TMPDIR:-/tmp}}/boot-test-$$"
mkdir -p "$WORKDIR"
KEEP_WORKDIR=1  # Keep on failure

cleanup() {
  if [ -n "${QEMU_PID:-}" ]; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  if [ -n "${SWTPM_PID:-}" ]; then
    kill "$SWTPM_PID" 2>/dev/null || true
  fi
  if [ "$KEEP_WORKDIR" = 0 ]; then
    rm -rf "$WORKDIR"
  else
    echo "Work directory kept: $WORKDIR"
  fi
}
trap cleanup EXIT

# --- prepare disk overlay ---
OVERLAY="$WORKDIR/disk.qcow2"
SERIAL_LOG="$WORKDIR/serial.log"
QEMU_OUT="$WORKDIR/qemu.out"
VARS="$WORKDIR/vars.fd"

# --- find OVMF ---
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/nix/sources.nix).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
# OVMF.fd has neither Secure Boot nor TPM support. OVMFFull.fd has both, and it is
# built with SMM, so QEMU gets smm=on below. --tpm needs the TPM measurement, or
# systemd-stub does not pass the UKI's PCR public key on and credentials are sealed
# without the signed PCR 11 policy. --secure-boot needs a firmware that enforces.
OVMF_ATTR=OVMF.fd
if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
  OVMF_ATTR=OVMFFull.fd
fi
OVMF_DIR=$(nix-build -I "nixpkgs=$DEV_PIN" '<nixpkgs>' -A "$OVMF_ATTR" --no-out-link 2>/dev/null)/FV

if [ ! -d "$OVMF_DIR" ]; then
  echo "Error: cannot find OVMF.fd" >&2
  exit 1
fi

cp "$OVMF_DIR/OVMF_VARS.fd" "$VARS"
chmod u+w "$VARS"

# --- enroll Secure Boot keys ---
enroll_keys() {
  DB_CERT="$KEYS_DIR/secureboot/db.crt"
  if [ ! -f "$DB_CERT" ]; then
    echo "Error: db.crt not found: $DB_CERT" >&2
    exit 1
  fi
  
  echo "Enrolling Secure Boot keys..."
  # virt-fw-vars 25.12 wants an owner GUID with every entry; one fixed GUID is fine
  # for a throwaway test key (the GUID names the entry, it does not verify anything)
  GUID=11111111-2222-3333-4444-555555555555
  # --rotate: step 1 of the rotation, the new db certificate beside the old one
  DB_NEXT=""
  if [ "$ROTATE" = 1 ]; then
    DB_NEXT="--add-db $GUID $NEXT_KEYS/secureboot/db.crt"
  fi
  # shellcheck disable=SC2086
  virt-fw-vars \
    --input "$VARS" \
    --output "$VARS.new" \
    --set-pk "$GUID" "$DB_CERT" \
    --add-kek "$GUID" "$DB_CERT" \
    --add-db "$GUID" "$DB_CERT" \
    $DB_NEXT \
    --secure-boot
  mv "$VARS.new" "$VARS"
  echo "Secure Boot keys enrolled"
}

# --- start TPM ---
start_tpm() {
  TPM_DIR="$WORKDIR/tpm"
  mkdir -p "$TPM_DIR"
  
  swtpm socket \
    --tpm2 \
    --tpmstate dir="$TPM_DIR" \
    --ctrl type=unixio,path="$TPM_DIR/swtpm-sock" \
    &
  SWTPM_PID=$!
  
  for _ in 1 2 3 4 5; do
    if [ -S "$TPM_DIR/swtpm-sock" ]; then
      break
    fi
    sleep 0.2
  done
  
  if [ ! -S "$TPM_DIR/swtpm-sock" ]; then
    echo "Error: swtpm socket not created" >&2
    exit 1
  fi
  
  echo "TPM started (pid $SWTPM_PID)"
}

# --- SSH test setup ---
setup_ssh_test() {
  SSH_DIR="$WORKDIR/ssh"
  mkdir -p "$SSH_DIR"
  
  # Use the committed test SSH key from the repo
  TEST_KEY="$REPO_DIR/tests/fixtures/snakeoil-ssh"
  if [ ! -f "$TEST_KEY" ]; then
    echo "Error: test SSH key not found: $TEST_KEY" >&2
    exit 1
  fi
  
  # Copy the test key to the work directory
  cp "$TEST_KEY" "$SSH_DIR/user"
  chmod 600 "$SSH_DIR/user"
  
  echo "Using test SSH key: $TEST_KEY"
}

# --- run QEMU ---
start_qemu() {
  # a later QEMU run (--rotate) boots the same overlay again
  if [ ! -f "$OVERLAY" ]; then
    qemu-img create -q -f qcow2 -b "$DISK" -F raw "$OVERLAY" 40G
  fi

  # the --tpm and --next runs reboot the guest in the same QEMU (swtpm keeps its state)
  NO_REBOOT=-no-reboot
  if [ "$TPM" = 1 ] || [ -n "$NEXT" ]; then
    NO_REBOOT=""
  fi

  QEMU_ARGS="-machine q35,accel=kvm:tcg \
    -cpu max \
    -m 2G \
    -smp 2 \
    -drive if=pflash,format=raw,readonly=on,file=$OVMF_DIR/OVMF_CODE.fd \
    -drive if=pflash,format=raw,file=$VARS \
    -drive file=$OVERLAY,format=qcow2,if=virtio \
    -serial file:$SERIAL_LOG \
    -display none \
    $NO_REBOOT \
    -smbios type=11,value=io.systemd.credential:system.hostname=boot-test \
    -netdev user,id=net0,hostfwd=tcp::$SSH_PORT-:22 \
    -device virtio-net-pci,netdev=net0"
  
  if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
    QEMU_ARGS="$QEMU_ARGS \
      -machine smm=on -global driver=cfi.pflash01,property=secure,value=on"
  fi
  if [ "$TPM" = 1 ]; then
    QEMU_ARGS="$QEMU_ARGS \
      -chardev socket,id=chrtpm,path=$WORKDIR/tpm/swtpm-sock \
      -tpmdev emulator,id=tpm0,chardev=chrtpm \
      -device tpm-tis,tpmdev=tpm0"
  fi
  
  echo "Starting QEMU (timeout ${TIMEOUT}s)..."
  : > "$SERIAL_LOG"
  # shellcheck disable=SC2086
  timeout "$TIMEOUT" qemu-system-x86_64 $QEMU_ARGS > "$QEMU_OUT" 2>&1 &
  QEMU_PID=$!
}

qemu_running() {
  kill -0 "$QEMU_PID" 2>/dev/null
}

# wait until multi-user.target is reached or QEMU exits (the timeout ends it)
wait_for_boot() {
  while qemu_running; do
    if grep -qi "Reached target.*Multi.User" "$SERIAL_LOG" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

stop_qemu() {
  if qemu_running; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  wait "$QEMU_PID" 2>/dev/null || true
  echo "QEMU stopped"
}

# --- check markers (positive evidence only) ---
check_markers() {
  PASS=0
  FAIL=0
  
  echo ""
  echo "=== Marker checks (serial log) ==="
  
  # multi-user-reached: look for "Reached target Multi-User System"
  if grep -qi "Reached target.*Multi.User" "$SERIAL_LOG" 2>/dev/null; then
    echo "PASS: multi-user-reached"
    PASS=$((PASS + 1))
  else
    echo "FAIL: multi-user-reached (not found in log)"
    FAIL=$((FAIL + 1))
  fi
  
  # sshd-active: look for sshd listening
  if grep -qi "sshd.*Listening\|Started.*sshd\|Started.*OpenSSH" "$SERIAL_LOG" 2>/dev/null; then
    echo "PASS: sshd-active"
    PASS=$((PASS + 1))
  else
    echo "FAIL: sshd-active (not found in log)"
    FAIL=$((FAIL + 1))
  fi
  
  # var-sshd-hostkey: the host key var generated and sealed. This is the proof that
  # the root was writable when the unit ran (docs/design/boot.md). The serial console
  # colours the unit name, so match across the escape sequence.
  if grep -qi "Finished.*Generate var sshd-hostkey" "$SERIAL_LOG" 2>/dev/null; then
    echo "PASS: var-sshd-hostkey"
    PASS=$((PASS + 1))
  else
    echo "FAIL: var-sshd-hostkey (not found in log)"
    FAIL=$((FAIL + 1))
  fi

  # boot-complete: boot-complete.target reached
  if grep -qi "Reached target.*Boot Complete\|boot-complete.target" "$SERIAL_LOG" 2>/dev/null; then
    echo "PASS: boot-complete"
    PASS=$((PASS + 1))
  else
    echo "FAIL: boot-complete (not found in log)"
    FAIL=$((FAIL + 1))
  fi
  
  # no-firstboot-prompt: must NOT see the interactive prompt
  if grep -qi "Please enter" "$SERIAL_LOG" 2>/dev/null; then
    echo "FAIL: no-firstboot-prompt (interactive prompt appeared)"
    FAIL=$((FAIL + 1))
  else
    # Positive evidence: firstboot completed without prompting
    if grep -qi "systemd-firstboot\|First Boot" "$SERIAL_LOG" 2>/dev/null; then
      echo "PASS: no-firstboot-prompt (firstboot ran without prompting)"
      PASS=$((PASS + 1))
    else
      echo "INFO: no-firstboot-prompt (firstboot masked, did not run)"
      PASS=$((PASS + 1))
    fi
  fi
  
  echo ""
  echo "=== Summary ==="
  echo "PASS: $PASS, FAIL: $FAIL"
  
  if [ "$FAIL" -gt 0 ]; then
    return 1
  fi
  return 0
}

# --- SSH tests ---
# ssh takes the first value of an option: the host key options are separate
NO_HOSTKEY_CHECK="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
SSH_OPTS="-F /dev/null \
  -o ConnectTimeout=2 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 \
  -o BatchMode=yes -o LogLevel=ERROR -p $SSH_PORT"

guest() {
  # shellcheck disable=SC2086
  ssh $SSH_OPTS $NO_HOSTKEY_CHECK -i "$WORKDIR/ssh/user" root@localhost "$@"
}

# wait for an ssh login while QEMU runs; $1: the boot id it must differ from
wait_for_ssh() {
  SSH_LAST=""
  while qemu_running; do
    if BOOT_ID=$(guest cat /proc/sys/kernel/random/boot_id 2>/dev/null) \
      && [ -n "$BOOT_ID" ] && [ "$BOOT_ID" != "${1:-}" ]; then
      return 0
    fi
    # shellcheck disable=SC2086
    SSH_LAST=$(ssh $SSH_OPTS $NO_HOSTKEY_CHECK -v -i "$WORKDIR/ssh/user" root@localhost true 2>&1) || true
    sleep 2
  done
  return 1
}

# one check: $1 name, $2 0 for PASS; counts into PASS/FAIL
verdict() {
  if [ "$2" = 0 ]; then
    echo "PASS: $1"
    PASS=$((PASS + 1))
  else
    echo "FAIL: $1"
    FAIL=$((FAIL + 1))
  fi
}

test_ssh() {
  echo ""
  echo "=== SSH tests ==="
  echo "Waiting for SSH..."
  if ! wait_for_ssh ""; then
    echo "last attempt (ssh -v), while QEMU still ran:"
    echo "$SSH_LAST" | tail -15
    verdict "ssh-login (no login before the timeout)" 1
    return 1
  fi
  verdict "ssh-login" 0
  FIRST_BOOT_ID=$BOOT_ID
  # remember the host key the server presents, for the second boot
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o UserKnownHostsFile="$WORKDIR/known_hosts" -o StrictHostKeyChecking=accept-new \
    -i "$WORKDIR/ssh/user" root@localhost true 2>/dev/null || true

  echo ""
  echo "=== hostname ==="
  HN=$(guest hostname 2>&1) || true
  echo "$HN"
  RC=0; [ "$HN" = "boot-test" ] || RC=1
  verdict "hostname (system.hostname credential applied)" $RC

  echo ""
  echo "=== systemctl --failed ==="
  FAILED=$(guest systemctl --failed --no-pager 2>&1) || true
  echo "$FAILED"
  RC=0; echo "$FAILED" | grep -q "^0 loaded units listed" || RC=1
  verdict "no-failed-units" $RC

  echo ""
  echo "=== varlinkctl list-interfaces ==="
  RC=0
  IFACES=$(guest varlinkctl list-interfaces /run/systemd/io.systemd.Manager 2>&1) || RC=1
  echo "$IFACES"
  echo "$IFACES" | grep -q "^io.systemd.Manager$" || RC=1
  verdict "varlinkctl-list-interfaces" $RC

  echo ""
  echo "=== bootctl list ==="
  guest bootctl list --no-pager 2>&1 || true

  test_loader "first boot" 1

  if [ "$SECURE_BOOT" = 1 ]; then
    echo ""
    echo "=== secure boot state ==="
    SB=$(guest bootctl status 2>&1) || true
    echo "$SB" | grep -i "secure boot" || true
    RC=0; echo "$SB" | grep -qi "Secure Boot: enabled" || RC=1
    verdict "secure-boot-enabled (firmware is enforcing)" $RC
  fi

  if [ "$TPM" = 1 ]; then
    echo ""
    echo "=== /etc/credstore.encrypted (TPM sealed credentials) ==="
    guest ls -la /etc/credstore.encrypted/ 2>&1 || true
    # the sealing key type is the first 16 bytes of the credential (systemd creds-util.h,
    # CRED_AES256_GCM_BY_*); the file is base64, so decode its first 24 characters
    HDR=$(guest "head -c 24 /etc/credstore.encrypted/sshd-hostkey.key | base64 -d | od -An -tx1 -N4" \
      2>/dev/null | tr -d ' \n') || true
    case "$HDR" in
      5a1c6a86 | 55b9ed1d) KIND="host key only"; RC=1 ;;
      058469da) KIND="null key"; RC=1 ;;
      0c7cc07b | d4062dfb) KIND="TPM2" ; RC=0 ;;
      93a89409 | ef4ac136 | 14142588 | 2a1f877a) KIND="host key + TPM2"; RC=0 ;;
      faf7eb93 | 5e2d5c76) KIND="TPM2 + signed PCR policy"; RC=0 ;;
      af4950a8 | adbc4ca3 | afbfeaac | 16e49294) KIND="host key + TPM2 + signed PCR policy"; RC=0 ;;
      *) KIND="unknown"; RC=1 ;;
    esac
    echo "sshd-hostkey.key sealed with: $KIND (header id ${HDR:-none}...)"
    verdict "hostkey-sealed-with-tpm2" $RC
  fi
  return 0
}

# --- the boot loader on the ESP (docs/design/bootloader.md) ---
# The harness runs qemu-system-x86_64, so the names are x64's.
USR_LOADER=/usr/lib/systemd/boot/efi/systemd-bootx64.efi.signed
ESP_PRIMARY=/boot/EFI/systemd/systemd-bootx64.efi
ESP_REMOVABLE=/boot/EFI/BOOT/BOOTX64.EFI
ESP_FALLBACK=/boot/EFI/systemd/systemd-boot-fallbackx64.efi

# guest_hash FILE: the sha256 of a file in the guest, empty when it is missing
guest_hash() {
  guest "sha256sum < $1" 2>/dev/null | cut -c1-64
}

# shellcheck disable=SC2016 # $IMAGE_VERSION is the guest's
guest_version() {
  guest '. /usr/lib/os-release && echo "$IMAGE_VERSION"' 2>/dev/null
}

# test_loader LABEL COUNTED: on a counted boot (COUNTED=1) golconda-loader-update.service ran
# after bless-boot, on a blessed one (0) it did not; the ESP's two copies of systemd-boot are
# /usr's signed file, and the loader.conf in effect is /usr's
test_loader() {
  echo ""
  echo "=== boot loader ($1) ==="
  LU=""
  if [ "$2" = 1 ]; then
    # it runs after systemd-bless-boot.service, which waits for the health units (the network
    # one waits up to 60 s)
    LW=0
    while [ "$LW" -lt 120 ] && qemu_running; do
      LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
      [ "$LU" = active ] && break
      LW=$((LW + 2))
      sleep 2
    done
    guest journalctl -b -u golconda-loader-update.service -o cat --no-pager 2>&1 || true
    RC=0; [ "$LU" = active ] || RC=1
    verdict "loader-update-ran (golconda-loader-update.service after bless-boot: $LU)" $RC
  else
    LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
    RC=0; [ "$LU" != active ] || RC=1
    verdict "loader-update-not-run (a blessed entry has no counter: $LU)" $RC
  fi

  USR=$(guest_hash "$USR_LOADER")
  PRI=$(guest_hash "$ESP_PRIMARY")
  REM=$(guest_hash "$ESP_REMOVABLE")
  echo "$USR_LOADER: $USR"
  echo "$ESP_PRIMARY: $PRI"
  echo "$ESP_REMOVABLE: $REM"
  RC=0
  { [ -n "$USR" ] && [ "$USR" = "$PRI" ] && [ "$USR" = "$REM" ]; } || RC=1
  verdict "loader-matches-usr (both ESP copies are the signed loader in /usr)" $RC

  # bootctl reads loader.conf where systemd-boot does, at the ESP's root
  CONF_LINE=$(guest bootctl status --no-pager 2>&1 | grep "config:") || true
  echo "$CONF_LINE"
  guest cat /boot/loader/loader.conf 2>&1 || true
  RC=0
  echo "$CONF_LINE" | grep -q "/loader/loader.conf$" || RC=1
  [ "$(guest_hash /boot/loader/loader.conf)" = "$(guest_hash /usr/lib/golconda/loader.conf)" ] || RC=1
  verdict "loader-conf-in-effect (ESP loader/loader.conf = /usr/lib/golconda/loader.conf)" $RC

  CR=$(guest systemctl show -P ConditionResult systemd-boot-update.service 2>&1) || true
  RC=0; [ "$CR" = no ] || RC=1
  verdict "boot-update-off (systemd-boot-update.service ConditionResult=$CR)" $RC
}

# reboot_guest: reboot in the same QEMU and wait for a login with a new boot id
reboot_guest() {
  PREV_BOOT_ID=$BOOT_ID
  guest systemctl reboot 2>&1 || true
  if ! wait_for_ssh "$PREV_BOOT_ID"; then
    verdict "ssh-after-reboot (no login before the timeout)" 1
    return 1
  fi
}

SCP_OPTS="-F /dev/null -q -o BatchMode=yes -o LogLevel=ERROR -P $SSH_PORT"

# test_etc_links: the links the first boot wrote under /etc/systemd/system named the old
# release's systemd store path. golconda-etc-links.service rewrote them in this boot's initrd,
# so no link may name a store path, and none may dangle (docs/design/updates.md).
test_etc_links() {
  echo ""
  echo "=== /etc/systemd/system links after the update ==="
  COUNTS=$(
    guest '
      n=0; s=0; d=0
      for f in /etc/systemd/system/* /etc/systemd/system/*/*; do
        [ -L "$f" ] || continue
        n=$((n + 1))
        case "$(readlink "$f")" in *nix/store*) s=$((s + 1)) ;; esac
        [ -e "$f" ] || d=$((d + 1))
      done
      echo "$n $s $d"'
  ) || COUNTS="0 0 0"
  echo "links, store-path targets, dangling: $COUNTS"
  # shellcheck disable=SC2086
  set -- $COUNTS
  RC=0
  [ "${1:-0}" -gt 0 ] || RC=1
  [ "${2:-1}" = 0 ] || RC=1
  [ "${3:-1}" = 0 ] || RC=1
  verdict "etc-links-stable ($1 links, $2 naming a store path, $3 dangling)" $RC
}

# --- --next: install the next release, boot it, check its loader, then recovery ---
test_next() {
  echo ""
  echo "=== update to the next release ==="
  NEXT_NAME=$(basename "$(ls "$NEXT_RELEASE"/*.efi)" .efi)
  NEXT_VERSION=${NEXT_NAME##*_}
  IMAGE_ID=${NEXT_NAME%_*}
  OLD_VERSION=$(guest_version)
  OLD_LOADER=$(guest_hash "$ESP_REMOVABLE")
  echo "running $OLD_VERSION, installing $NEXT_VERSION from $NEXT_RELEASE"
  guest mkdir -p /var/tmp/next /run/sysupdate.d
  for f in "$NEXT_RELEASE"/*; do
    # shellcheck disable=SC2086
    scp $SCP_OPTS $NO_HOSTKEY_CHECK -i "$WORKDIR/ssh/user" "$(real_path "$f")" \
      "root@localhost:/var/tmp/next/$(basename "$f")"
  done
  # the image's own definitions, reading the copy instead of the update server: a file in
  # /run/sysupdate.d hides the one of the same name in /usr/lib/sysupdate.d
  for n in $(guest ls /usr/lib/sysupdate.d); do
    guest cat "/usr/lib/sysupdate.d/$n" \
      | sed 's|^Path=http.*|Path=/var/tmp/next|; s|^Type=url-file$|Type=regular-file|' \
      | guest "cat > /run/sysupdate.d/$n"
  done
  RC=0
  guest systemctl start --wait systemd-sysupdate-update.service || RC=1
  guest journalctl -b -u systemd-sysupdate-update.service -o cat --no-pager 2>&1 \
    | grep "Successfully installed" || true
  verdict "sysupdate-installed ($NEXT_VERSION)" $RC
  guest rm -rf /var/tmp/next /run/sysupdate.d

  echo "Rebooting into $NEXT_VERSION..."
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "boots-next ($OLD_VERSION -> $V)" $RC
  test_etc_links
  test_loader "$NEXT_VERSION, its first good boot" 1
  NEW_LOADER=$(guest_hash "$ESP_REMOVABLE")
  if [ "$NEW_LOADER" != "$OLD_LOADER" ]; then
    FB=$(guest_hash "$ESP_FALLBACK")
    echo "$ESP_FALLBACK: $FB"
    RC=0; [ "$FB" = "$OLD_LOADER" ] || RC=1
    verdict "loader-replaced (the previous loader kept as $ESP_FALLBACK)" $RC
  else
    echo "INFO: $NEXT_VERSION carries the loader bytes of $OLD_VERSION; nothing replaced"
  fi
  if [ "$ROTATE" = 1 ]; then
    RC=0; [ "$NEW_LOADER" != "$OLD_LOADER" ] || RC=1
    verdict "loader-signed-again (a new db key gives new loader bytes)" $RC
  fi

  test_recovery
}

# --- the recovery paths of docs/design/bootloader.md, on a machine with two slots ---
test_recovery() {
  OLD_ENTRY=${IMAGE_ID}_${OLD_VERSION}.efi
  NEXT_ENTRY=${IMAGE_ID}_${NEXT_VERSION}.efi

  echo ""
  echo "=== recovery: bootctl list ==="
  L=$(guest bootctl list --no-pager 2>&1) || true
  echo "$L" | grep -E " (title|id|source|tries):" || true
  RC=0
  { echo "$L" | grep -q "id: $OLD_ENTRY" && echo "$L" | grep -q "id: $NEXT_ENTRY"; } || RC=1
  verdict "bootctl-list-both-slots" $RC

  echo ""
  echo "=== recovery: reinstall a damaged loader ==="
  guest "echo damaged > $ESP_REMOVABLE && sync"
  echo "$ESP_REMOVABLE damaged: $(guest_hash "$ESP_REMOVABLE")"
  RC=0
  guest /usr/lib/golconda/golconda-loader-update || RC=1
  [ "$(guest_hash "$ESP_REMOVABLE")" = "$(guest_hash "$USR_LOADER")" ] || RC=1
  verdict "loader-reinstall (golconda-loader-update by hand; the boots below start from it)" $RC

  echo ""
  echo "=== recovery: bootctl set-oneshot (the other slot, once) ==="
  guest bootctl set-oneshot "$OLD_ENTRY"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$OLD_VERSION" ] || RC=1
  verdict "set-oneshot-other-slot (running $V)" $RC
  # a blessed entry has no counter: bless-boot does not run, so golconda-loader-update does not
  # either, and the ESP keeps the newer release's loader
  LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
  RC=0
  { [ "$LU" != active ] && [ "$(guest_hash "$ESP_REMOVABLE")" = "$NEW_LOADER" ]; } || RC=1
  verdict "other-slot-keeps-loader (golconda-loader-update.service: $LU)" $RC
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "oneshot-is-once (running $V)" $RC

  echo ""
  echo "=== recovery: bootctl set-default (the other slot, until cleared) ==="
  guest bootctl set-default "$OLD_ENTRY"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$OLD_VERSION" ] || RC=1
  verdict "set-default-other-slot (running $V)" $RC
  # ssh joins its arguments into one command line: the empty argument must be quoted there
  guest "bootctl set-default ''"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "set-default-cleared (running $V)" $RC

  echo ""
  echo "=== recovery: the firmware menu ==="
  FW_MARK=$(wc -c < "$SERIAL_LOG")
  guest bootctl reboot-to-firmware true 2>&1 || true
  guest bootctl reboot-to-firmware 2>&1 || true
  guest systemctl reboot 2>&1 || true
  FW=1
  FW_WAIT=0
  while [ "$FW_WAIT" -lt 45 ] && qemu_running; do
    if tail -c +"$((FW_MARK + 1))" "$SERIAL_LOG" | grep -aq "EFI Firmware Setup"; then
      FW=0
      break
    fi
    FW_WAIT=$((FW_WAIT + 1))
    sleep 1
  done
  # OVMF draws its menu with cursor moves; the item texts are plain runs
  tail -c +"$((FW_MARK + 1))" "$SERIAL_LOG" \
    | grep -ao "Please select boot device:\|EFI Firmware Setup\|UEFI [A-Za-z0-9 ]*Device" | sort -u || true
  verdict "reboot-to-firmware (OVMF's boot menu on the serial console)" $FW
}

# db_certs LOG: the db certificates the kernel loaded, "<CN>: <key id>", one per line
db_certs() {
  tr -d '\033' < "$1" | grep -a "integrity: Loaded X.509 cert" \
    | sed "s/.*Loaded X.509 cert '\(.*\)'.*/\1/" | tr ' ' '_' | sort -u
}

# --- --rotate: db holds the new key only, dbx the old; boot the new chain, refuse the old ---
test_rotate() {
  echo ""
  echo "=== key rotation: db = the new certificate, dbx += the old one ==="
  stop_qemu
  virt-fw-vars --input "$VARS" --output "$VARS.new" \
    --delete db --add-db "$GUID" "$NEXT_KEYS/secureboot/db.crt" \
    --add-dbx-cert "$GUID" "$KEYS_DIR/secureboot/db.crt" 2>&1 | grep -v "^INFO: \\(reading\\|var store\\|writing\\)" || true
  mv "$VARS.new" "$VARS"

  SERIAL_LOG=$WORKDIR/serial-rotated.log
  SAVED_TIMEOUT=$TIMEOUT
  TIMEOUT=240
  start_qemu
  TIMEOUT=$SAVED_TIMEOUT
  if ! wait_for_ssh ""; then
    verdict "boots-after-rotation (no login before the timeout)" 1
    return 1
  fi
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "boots-after-rotation (running $V)" $RC
  SB=$(guest bootctl status 2>&1 | grep "Secure Boot:") || true
  echo "$SB"
  RC=0; echo "$SB" | grep -q "enabled" || RC=1
  verdict "secure-boot-enabled-after-rotation" $RC
  # the kernel loads db into its .platform keyring, which the verity signature is checked
  # against, and logs each certificate
  BEFORE=$(db_certs "$FIRST_SERIAL_LOG")
  AFTER=$(db_certs "$SERIAL_LOG")
  echo "db certificates the kernel loaded before the rotation:"
  echo "$BEFORE"
  echo "after:"
  echo "$AFTER"
  RC=0
  [ -n "$AFTER" ] || RC=1
  [ "$(echo "$AFTER" | wc -l)" -lt "$(echo "$BEFORE" | wc -l)" ] || RC=1
  for c in $AFTER; do echo "$BEFORE" | grep -qxF "$c" || RC=1; done
  verdict "kernel-db-rotated (the kernel keeps the new certificate only)" $RC
  test_loader "after the rotation" 0
  FAILED=$(guest systemctl --failed --no-pager 2>&1) || true
  echo "$FAILED"
  RC=0; echo "$FAILED" | grep -q "^0 loaded units listed" || RC=1
  verdict "no-failed-units-after-rotation" $RC
  stop_qemu

  echo ""
  echo "=== negative control: the original disk under the rotated keys ==="
  OVERLAY=$WORKDIR/disk-original.qcow2
  SERIAL_LOG=$WORKDIR/serial-original.log
  TIMEOUT=45
  start_qemu
  TIMEOUT=$SAVED_TIMEOUT
  wait "$QEMU_PID" 2>/dev/null || true
  tr -d '\033' < "$SERIAL_LOG" | grep -a "Access Denied\|Linux version" | sort -u || true
  RC=0
  tr -d '\033' < "$SERIAL_LOG" | grep -aq "Access Denied" || RC=1
  ! grep -aq "Linux version" "$SERIAL_LOG" || RC=1
  verdict "old-loader-refused (dbx holds the old db certificate; no kernel started)" $RC
}

# --- second boot, TPM: the host key is unsealed, not regenerated ---
test_reboot() {
  echo ""
  echo "=== Reboot test (TPM credential unsealing) ==="
  echo "host key of the first boot: $(ssh-keygen -lf "$WORKDIR/known_hosts" 2>/dev/null)"
  echo "Rebooting..."
  guest systemctl reboot 2>&1 || true

  if ! wait_for_ssh "$FIRST_BOOT_ID"; then
    verdict "ssh-after-reboot (no login before the timeout)" 1
    return 1
  fi
  verdict "ssh-after-reboot (boot id $FIRST_BOOT_ID -> $BOOT_ID)" 0

  # StrictHostKeyChecking=yes refuses a host key that is not the first boot's
  RC=0
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o UserKnownHostsFile="$WORKDIR/known_hosts" -o StrictHostKeyChecking=yes \
    -i "$WORKDIR/ssh/user" root@localhost true || RC=1
  verdict "hostkey-unchanged (unsealed from the TPM, not regenerated)" $RC

  ACTIVE=$(guest systemctl is-active sshd.service 2>&1) || true
  echo "sshd.service: $ACTIVE"
  RC=0; [ "$ACTIVE" = "active" ] || RC=1
  verdict "sshd-active-after-reboot" $RC

  echo ""
  echo "=== systemctl --failed (second boot) ==="
  guest systemctl --failed --no-pager 2>&1 || true
  return 0
}

# --- main ---
main() {
  echo "Boot test for: $DISK"
  echo "Keys: $KEYS_DIR"
  echo "Secure Boot: $SECURE_BOOT"
  echo "TPM: $TPM"
  echo "Timeout: ${TIMEOUT}s"
  echo "Work directory: $WORKDIR"
  echo ""

  if [ "$SECURE_BOOT" = 1 ]; then
    enroll_keys
  fi

  if [ "$TPM" = 1 ]; then
    start_tpm
  fi

  if [ "$SSH_TEST" = 1 ]; then
    setup_ssh_test
  fi

  start_qemu
  FIRST_SERIAL_LOG=$SERIAL_LOG
  wait_for_boot || true

  RESULT=0
  if [ "$SSH_TEST" = 1 ]; then
    PASS=0
    FAIL=0
    test_ssh || RESULT=1
    if [ "$TPM" = 1 ] && [ "$RESULT" = 0 ]; then
      test_reboot || RESULT=1
    fi
    if [ -n "$NEXT" ] && [ "$RESULT" = 0 ]; then
      test_next || RESULT=1
    fi
    if [ "$ROTATE" = 1 ] && [ "$RESULT" = 0 ]; then
      test_rotate || RESULT=1
    fi
    SSH_PASS=$PASS
    SSH_FAIL=$FAIL
  fi
  stop_qemu
  # the markers are the first QEMU run's
  SERIAL_LOG=$FIRST_SERIAL_LOG

  echo ""
  echo "=== Serial log (last 100 lines) ==="
  tail -100 "$SERIAL_LOG"

  check_markers || RESULT=1

  if [ "$SSH_TEST" = 1 ]; then
    echo "SSH checks: PASS: $SSH_PASS, FAIL: $SSH_FAIL"
    if [ "$SSH_FAIL" -gt 0 ]; then
      RESULT=1
    fi
  fi

  if [ "$RESULT" = 0 ]; then
    KEEP_WORKDIR=0  # Clean up on success
    echo ""
    echo "=== ALL TESTS PASSED ==="
  else
    echo ""
    echo "=== SOME TESTS FAILED ==="
    echo "Serial log: $SERIAL_LOG"
  fi

  exit "$RESULT"
}

main
