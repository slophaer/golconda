#!/bin/sh
# Usage: boot-test <disk.raw> --keys DIR [--secure-boot [--auto-enrol [--no-microsoft-keys]]]
#          [--tpm [--secure-boot-off]] [--timeout SECONDS] [--allow-tcg]
#          [--ssh-test [--esp-creds | --imds | --certify]] [--factory-reset]
#          [--next DIR [--later DIR | --rotate | --tamper-index | --fail-health | --fail-initrd |
#           --fail-panic | --fail-pid1 | --fail-watchdog | --fail-blessed --later DIR]]
# Boot a Golconda image in QEMU (OVMF, KVM) and check it. Exit 0 when every check passes, else 1.
#   (no flag)          the first boot: the markers on the serial console
#   --ssh-test         log in over ssh and check the running system
#   --secure-boot      enrol the keys of --keys DIR, boot with Secure Boot on
#   --auto-enrol       enrol nothing: systemd-boot enrols the ESP's keys
#   --tpm              swtpm: the host key is sealed, and unseals after a reboot
#   --secure-boot-off  3 power-ons with Secure Boot off must halt, then Secure Boot on again
#   --esp-creds        provision through the ESP, not SMBIOS
#   --imds             fake Hetzner Cloud's metadata endpoint
#   --certify          certify the host in its first boot (golconda vars certify)
#   --factory-reset    reset the state partition, check the reset boot
#   --next DIR         install the release of DIR over HTTP, boot it, the recovery paths
#   --later DIR        then install DIR into the first release's slot, boot it
#   --rotate           DIR has a new db key: rotate db and dbx
#   --tamper-index     a changed index, then a changed artifact: no update installs
#   --fail-health, --fail-initrd, --fail-panic, --fail-pid1, --fail-watchdog
#                      each try of DIR fails: the old release must boot after the third
#   --fail-blessed --later DIR   the blessed release crashes: the failed-boot counter
# Manual: docs/reference/boot-test.md

set -eu

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# the work directories of all runs, and scripts/verify's logs: not /tmp, whose contents a queue task
# or a reboot may drop with the logs of a failed run
BOOT_TEST_CACHE=${BOOT_TEST_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/golconda-boot-test}

# --- argument parsing ---
# SSH_PORT, the host port for the guest's sshd, is claimed below (claim_ssh_port)
# QEMU's user network, for every mode: 169.254.169.0/24, so that Hetzner's metadata address (--imds)
# is on the guest's link. Its gateway, 169.254.169.2 (QEMU's "host", as 10.0.2.2 is on the default
# network), is the update source the test images name: http://169.254.169.2:8074/. Only
# 169.254.169.254 is locked by systemd-imds; the rest of the network is not.
GUEST_NET=169.254.169.0/24
UPDATE_ADDR=169.254.169.2
# the guest's port for the release HTTP server: the test image's updateSource uses 8074
HTTP_PORT=8074
DISK=""
KEYS_DIR=""
SECURE_BOOT=0
AUTO_ENROL=0
MICROSOFT_KEYS=1
TPM=0
TIMEOUT=120
SSH_TEST=0
NEXT=""
ROTATE=0
FAIL_HEALTH=0
FAIL_INITRD=0
FAIL_BLESSED=0
LATER=""
FAIL_PANIC=0
FAIL_PID1=0
FAIL_WATCHDOG=0
TAMPER_INDEX=0
FACTORY_RESET=0
ESP_CREDS=0
IMDS=0
CERTIFY=0
SECURE_BOOT_OFF=0
ALLOW_TCG=0
STUB_CMDLINE=""
# --imds: Hetzner's metadata address, and the user data's IPv6 address and .network credential
# (boot-test.d/http.sh serves them; no host port is opened)
IMDS_ADDR=169.254.169.254
IMDS_IPV6=2001:db8:5eed::1
IMDS_NET_CRED=60-imds-ipv6

# the parts: functions and constants, no processes start when they are sourced; boot-test.d/guest.sh
# reads SSH_PORT above
# shellcheck source=boot-test.d/log.sh
. "$SCRIPT_DIR/boot-test.d/log.sh"
# shellcheck source=boot-test.d/vm.sh
. "$SCRIPT_DIR/boot-test.d/vm.sh"
# shellcheck source=boot-test.d/http.sh
. "$SCRIPT_DIR/boot-test.d/http.sh"
# shellcheck source=boot-test.d/tls.sh
. "$SCRIPT_DIR/boot-test.d/tls.sh"
# shellcheck source=boot-test.d/guest.sh
. "$SCRIPT_DIR/boot-test.d/guest.sh"
# shellcheck source=boot-test.d/checks.sh
. "$SCRIPT_DIR/boot-test.d/checks.sh"
# shellcheck source=boot-test.d/modes.sh
. "$SCRIPT_DIR/boot-test.d/modes.sh"
# shellcheck source=boot-test.d/update.sh
. "$SCRIPT_DIR/boot-test.d/update.sh"

# usage [CODE]: print the lines above set -eu, and exit (default 1)
usage() {
  sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//p}' "$0"
  exit "${1:-1}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keys) KEYS_DIR="$2"; shift 2 ;;
    --secure-boot) SECURE_BOOT=1; shift ;;
    --auto-enrol) AUTO_ENROL=1; shift ;;
    --no-microsoft-keys) MICROSOFT_KEYS=0; shift ;;
    --tpm) TPM=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --ssh-test) SSH_TEST=1; shift ;;
    --next) NEXT="$2"; SSH_TEST=1; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --fail-health) FAIL_HEALTH=1; shift ;;
    --fail-initrd) FAIL_INITRD=1; shift ;;
    --fail-blessed) FAIL_BLESSED=1; shift ;;
    --later) LATER="$2"; shift 2 ;;
    --fail-panic) FAIL_PANIC=1; shift ;;
    --fail-pid1) FAIL_PID1=1; shift ;;
    --fail-watchdog) FAIL_WATCHDOG=1; shift ;;
    --tamper-index) TAMPER_INDEX=1; shift ;;
    --factory-reset) FACTORY_RESET=1; shift ;;
    --esp-creds) ESP_CREDS=1; shift ;;
    --imds) IMDS=1; shift ;;
    --certify) CERTIFY=1; shift ;;
    --secure-boot-off) SECURE_BOOT_OFF=1; shift ;;
    --allow-tcg) ALLOW_TCG=1; shift ;;
    --help|-h) usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      if [ -z "$DISK" ]; then
        DISK="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
      fi
      shift
      ;;
  esac
done

if [ -z "$DISK" ]; then
  echo "Error: disk image required" >&2
  usage
fi

if [ ! -f "$DISK" ]; then
  echo "Error: disk image not found: $DISK" >&2
  exit 1
fi

if [ -z "$KEYS_DIR" ]; then
  echo "Error: --keys DIR required" >&2
  usage
fi

if [ ! -d "$KEYS_DIR" ]; then
  echo "Error: keys directory not found: $KEYS_DIR" >&2
  exit 1
fi

if [ "$ALLOW_TCG" = 0 ] && ! { [ -c /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; }; then
  echo "Error: cannot open /dev/kvm, and QEMU needs KVM; --allow-tcg runs it on TCG, which is much slower" >&2
  exit 1
fi

# --- the virtual machine's tools: Golconda's own packages (scripts/tools.sh) ---
# qemu-system (qemu-system-x86_64, qemu-img), swtpm, virt-firmware (virt-fw-vars), openssh (ssh,
# ssh-keygen), cpython (python3) and gnupg (gpgv, for golconda release check) come first on PATH,
# whatever the caller's PATH has; OVMF is
# the edk2 build in qemu-system's share/qemu (prebuilt by the QEMU project, in its release tarball)
. "$SCRIPT_DIR/tools.sh"
if ! TOOLS=$(tools_path "$REPO_DIR" qemu-system swtpm virt-firmware openssh cpython gnupg) ||
  ! OVMF=$(tools_outs "$REPO_DIR" qemu-system)/share/qemu; then
  echo "Error: cannot build the boot test's tools (packages.<system>.qemu-system and the rest)" >&2
  exit 1
fi
PATH="$TOOLS:$PATH"


if [ "$ESP_CREDS" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --esp-creds needs --ssh-test: the checks log in with the generated key" >&2
  exit 1
fi
if [ "$ESP_CREDS" = 1 ] && [ "$SECURE_BOOT" = 1 ] && [ "$TPM" = 1 ]; then
  echo "Error: --esp-creds cannot run with --secure-boot and --tpm: that guest refuses null-key credentials (docs/design/boot.md)" >&2
  exit 1
fi
if [ "$IMDS" = 1 ] && { [ "$SSH_TEST" = 0 ] || [ "$ESP_CREDS" = 1 ]; }; then
  echo "Error: --imds needs --ssh-test (the checks run over ssh) and excludes --esp-creds (both set the host name and the root key)" >&2
  exit 1
fi
if [ "$IMDS" = 1 ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to serve the fake IMDS endpoint, and it is not on PATH" >&2
    exit 1
  fi
fi
if [ "$FACTORY_RESET" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --factory-reset needs --ssh-test: the reset is requested over ssh, and only the test image carries the test key" >&2
  exit 1
fi
if [ "$FACTORY_RESET" = 1 ] && { [ -n "$NEXT" ] || [ "$ROTATE" = 1 ] || [ "$FAIL_HEALTH" = 1 ]; }; then
  echo "Error: --factory-reset is a boot of its own; do not combine it with --next, --rotate or --fail-health" >&2
  exit 1
fi

if [ "$CERTIFY" = 1 ] && { [ "$SSH_TEST" = 0 ] || [ -n "$NEXT" ] || [ "$ESP_CREDS" = 1 ] || [ "$IMDS" = 1 ]; }; then
  echo "Error: --certify needs --ssh-test, and is a first boot of its own: not with --next, --esp-creds or --imds" >&2
  exit 1
fi
if [ "$SECURE_BOOT_OFF" = 1 ] && { [ "$SECURE_BOOT" = 0 ] || [ "$TPM" = 0 ] || [ "$SSH_TEST" = 0 ] ||
  [ "$((ROTATE + FAIL_HEALTH + FAIL_INITRD + FAIL_BLESSED + FAIL_PANIC + FAIL_PID1 + FAIL_WATCHDOG + TAMPER_INDEX))" != 0 ] ||
  [ "$AUTO_ENROL" = 1 ] || [ "$FACTORY_RESET" = 1 ] || [ "$CERTIFY" = 1 ] ||
  [ "$ESP_CREDS" = 1 ] || [ "$IMDS" = 1 ]; }; then
  echo "Error: --secure-boot-off needs --secure-boot, --tpm and --ssh-test, and takes --next alone of the update modes: not with --rotate, --fail-*, --tamper-index, --auto-enrol, --factory-reset, --certify, --esp-creds or --imds" >&2
  exit 1
fi

if [ "$FAIL_INITRD" = 1 ] && { [ -z "$NEXT" ] || [ "$FAIL_HEALTH" = 1 ] || [ "$ROTATE" = 1 ] || [ "$TAMPER_INDEX" = 1 ]; }; then
  echo "Error: --fail-initrd needs --next, and is a fallback of its own: not with --fail-health, --rotate or --tamper-index" >&2
  exit 1
fi
if [ "$FAIL_BLESSED" = 1 ] && { [ -z "$NEXT" ] || [ -z "$LATER" ] || [ "$FAIL_HEALTH" = 1 ] || [ "$FAIL_INITRD" = 1 ] || [ "$ROTATE" = 1 ] || [ "$TAMPER_INDEX" = 1 ]; }; then
  echo "Error: --fail-blessed needs --next and --later, and ends on a halted machine: not with --fail-health, --fail-initrd, --rotate or --tamper-index" >&2
  exit 1
fi
if [ -n "$LATER" ]; then
  LATER_RELEASE=$(real_path "$LATER/disk")/release
  if [ -z "$NEXT" ] || [ "$((ROTATE + TAMPER_INDEX + FAIL_HEALTH + FAIL_INITRD + FAIL_PANIC + FAIL_PID1 + FAIL_WATCHDOG + SECURE_BOOT_OFF))" != 0 ] ||
    [ ! -f "$LATER_RELEASE/SHA256SUMS" ]; then
    echo "Error: --later needs --next, alone or with --fail-blessed, and $LATER must have disk/release/SHA256SUMS" >&2
    exit 1
  fi
fi
if [ "$((FAIL_PANIC + FAIL_PID1 + FAIL_WATCHDOG))" -gt 0 ] && { [ -z "$NEXT" ] || [ "$((FAIL_PANIC + FAIL_PID1 + FAIL_WATCHDOG + FAIL_BLESSED + FAIL_HEALTH + FAIL_INITRD + ROTATE + TAMPER_INDEX))" != 1 ]; }; then
  echo "Error: --fail-panic, --fail-pid1 and --fail-watchdog need --next, and each is a fallback of its own: not with each other, --fail-health, --fail-initrd, --fail-blessed, --rotate or --tamper-index" >&2
  exit 1
fi
if [ "$FAIL_HEALTH" = 1 ] && { [ -z "$NEXT" ] || [ "$ROTATE" = 1 ]; }; then
  echo "Error: --fail-health needs --next, and is a fallback of its own: not with --rotate" >&2
  exit 1
fi
if [ "$TAMPER_INDEX" = 1 ] && { [ -z "$NEXT" ] || [ "$FAIL_HEALTH" = 1 ] || [ "$ROTATE" = 1 ]; }; then
  echo "Error: --tamper-index needs --next, and the update never installs: not with --fail-health or --rotate" >&2
  exit 1
fi
if [ "$AUTO_ENROL" = 1 ] && { [ "$SECURE_BOOT" = 0 ] || [ "$SSH_TEST" = 0 ] || [ "$ROTATE" = 1 ]; }; then
  echo "Error: --auto-enrol needs --secure-boot and --ssh-test (the checks read the EFI variables over ssh), and not --rotate (which enrols)" >&2
  exit 1
fi
if [ "$MICROSOFT_KEYS" = 0 ] && [ "$AUTO_ENROL" = 0 ]; then
  echo "Error: --no-microsoft-keys needs --auto-enrol" >&2
  exit 1
fi
if [ "$ROTATE" = 1 ] && { [ -z "$NEXT" ] || [ "$SECURE_BOOT" = 0 ]; }; then
  echo "Error: --rotate needs --next and --secure-boot" >&2
  exit 1
fi
if [ -n "$NEXT" ]; then
  NEXT_RELEASE=$(real_path "$NEXT/disk")/release
  NEXT_KEYS=$(real_path "$NEXT/keys")
  if [ ! -f "$NEXT_RELEASE/SHA256SUMS" ] || [ ! -f "$NEXT_KEYS/secureboot/db.crt" ]; then
    echo "Error: $NEXT has no disk/release/SHA256SUMS or keys/secureboot/db.crt" >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to serve $NEXT_RELEASE over HTTP, and it is not on PATH" >&2
    exit 1
  fi
fi
if [ -n "$NEXT" ] || [ "$CERTIFY" = 1 ]; then
  # --next and --certify push the host certificate and the revocation list with `golconda vars` and
  # age, as an operator would (docs/design/trust.md)
  GOLCONDA=${BOOT_TEST_GOLCONDA:-golconda}
  for tool in "$GOLCONDA" age age-keygen ssh-keygen; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Error: --next and --certify push admin vars with $tool, and it is not on PATH (BOOT_TEST_GOLCONDA names the golconda binary)" >&2
      exit 1
    fi
  done
fi

# --- working directory ---
mkdir -p "$BOOT_TEST_CACHE"
WORKDIR=$(mktemp -d "$BOOT_TEST_CACHE/run.XXXXXX")
KEEP_WORKDIR=1  # Keep on failure

cleanup() {
  if [ -n "${QEMU_PID:-}" ]; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  if [ -n "${SWTPM_PID:-}" ]; then
    kill "$SWTPM_PID" 2>/dev/null || true
  fi
  if [ "$KEEP_WORKDIR" = 0 ]; then
    rm -rf "$WORKDIR"
  else
    echo "Work directory kept: $WORKDIR"
  fi
}
trap cleanup EXIT

# QEMU's -netdev option is split at commas and spaces
case $WORKDIR in
  *[,\ ]*) echo "Error: the work directory $WORKDIR has a comma or a space; set BOOT_TEST_CACHE" >&2; exit 1 ;;
esac
claim_ssh_port
init_ssh_opts

# --- prepare disk overlay ---
OVERLAY="$WORKDIR/disk.qcow2"
SERIAL_LOG="$WORKDIR/serial.log"
QEMU_OUT="$WORKDIR/qemu.out"
VARS="$WORKDIR/vars.fd"

# --- the firmware ---
# The plain build has neither Secure Boot nor SMM. The secure one has both, with SMM, so QEMU gets
# smm=on below. Both share one empty variable store (edk2-i386-vars.fd). --tpm needs the TPM measurement, or
# systemd-stub does not pass the UKI's PCR public key on and credentials are sealed without the
# signed PCR 11 policy. --secure-boot needs a firmware that enforces.
OVMF_CODE=$OVMF/edk2-x86_64-code.fd
if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
  OVMF_CODE=$OVMF/edk2-x86_64-secure-code.fd
fi
OVMF_VARS=$OVMF/edk2-i386-vars.fd

if [ ! -f "$OVMF_CODE" ] || [ ! -f "$OVMF_VARS" ]; then
  echo "Error: no $OVMF_CODE or $OVMF_VARS" >&2
  exit 1
fi

cp "$OVMF_VARS" "$VARS"
chmod u+w "$VARS"


# --- main ---
main() {
  echo "Boot test for: $DISK"
  echo "Keys: $KEYS_DIR"
  echo "Secure Boot: $SECURE_BOOT (auto-enrol: $AUTO_ENROL)"
  echo "TPM: $TPM"
  echo "Factory reset: $FACTORY_RESET"
  echo "ESP credentials: $ESP_CREDS"
  echo "IMDS: $IMDS"
  echo "Certify: $CERTIFY"
  echo "Timeout: ${TIMEOUT}s"
  echo "Work directory: $WORKDIR"
  echo ""

  if [ "$SECURE_BOOT" = 1 ] && [ "$AUTO_ENROL" = 0 ]; then
    enroll_keys
  fi

  if [ "$TPM" = 1 ]; then
    start_tpm
  fi

  if [ "$SSH_TEST" = 1 ]; then
    setup_ssh_test
    setup_certs
  fi

  if [ -n "$NEXT" ]; then
    if ! start_http_server; then
      exit 1
    fi
  fi
  if [ "$IMDS" = 1 ]; then
    start_imds_server || exit 1
  fi
  if [ "$SSH_TEST" = 1 ]; then
    start_tls_servers || exit 1
  fi

  start_qemu
  FIRST_SERIAL_LOG=$SERIAL_LOG
  RESULT=0
  wait_for_boot || RESULT=1
  if [ "$SSH_TEST" = 1 ]; then
    PASS=0
    FAIL=0
    test_ssh || RESULT=1
    if [ "$AUTO_ENROL" = 1 ]; then
      check_auto_enrol || RESULT=1
    fi
    if [ "$CERTIFY" = 1 ] && [ "$RESULT" = 0 ]; then
      test_certify || RESULT=1
    fi
    if [ "$TPM" = 1 ] && [ "$RESULT" = 0 ]; then
      test_reboot || RESULT=1
      if [ "$CERTIFY" = 1 ] && [ "$RESULT" = 0 ]; then
        test_certify_after_reboot
      fi
    fi
    if [ "$ESP_CREDS" = 1 ] && [ "$RESULT" = 0 ]; then
      test_esp_reboot || RESULT=1
      # after the reset only the harness's user certificate logs in
      GUEST_EXTRA_ID="-i $SSH_DIR/cert-admin"
    fi
    if [ "$FACTORY_RESET" = 1 ] && [ "$RESULT" = 0 ]; then
      test_factory_reset || RESULT=1
      if [ "$ESP_CREDS" = 1 ] && [ "$RESULT" = 0 ]; then
        test_esp_after_reset || RESULT=1
      fi
      if [ "$CERTIFY" = 1 ] && [ "$RESULT" = 0 ]; then
        test_recertify_after_reset || RESULT=1
      fi
    elif [ -n "$NEXT" ] && [ "$RESULT" = 0 ]; then
      test_next || RESULT=1
    fi
    if [ "$ROTATE" = 1 ] && [ "$RESULT" = 0 ]; then
      test_rotate || RESULT=1
    fi
    if [ "$SECURE_BOOT_OFF" = 1 ] && [ "$RESULT" = 0 ]; then
      test_secure_boot_off || RESULT=1
    fi
    # last: the machine does not boot after it
    if [ "$AUTO_ENROL" = 1 ] && qemu_running; then
      test_no_reenrol || RESULT=1
    fi
    SSH_PASS=$PASS
    SSH_FAIL=$FAIL
  fi
  stop_qemu
  # the markers are the first QEMU run's
  SERIAL_LOG=$FIRST_SERIAL_LOG

  echo ""
  echo "=== Serial log (last 100 lines) ==="
  tail -100 "$SERIAL_LOG"

  check_markers || RESULT=1

  if [ "$SSH_TEST" = 1 ]; then
    echo "SSH checks: PASS: $SSH_PASS, FAIL: $SSH_FAIL"
    if [ "$SSH_FAIL" -gt 0 ]; then
      RESULT=1
    fi
  fi

  if [ "$RESULT" = 0 ]; then
    KEEP_WORKDIR=0  # Clean up on success
    echo ""
    echo "=== ALL TESTS PASSED ==="
  else
    echo ""
    echo "=== SOME TESTS FAILED ==="
    echo "Serial log: $SERIAL_LOG"
  fi

  exit "$RESULT"
}

main
