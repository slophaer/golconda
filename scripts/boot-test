#!/bin/sh
# scripts/boot-test: VM boot test for Golconda images.
#
# Usage: boot-test <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS]
#                  [--ssh-test [--esp-creds]] [--next DIR [--rotate | --fail-health]] [--factory-reset] [--machine-id-credential]
#
# The script boots the image in QEMU with:
#   - a 40 GiB qcow2 overlay (room for root partition)
#   - OVMF firmware (UEFI)
#   - optional Secure Boot with keys enrolled from --keys
#   - optional TPM 2.0 via swtpm
#   - SMBIOS type 11 credential: system.hostname=boot-test (not with --esp-creds)
#   - user-mode networking with hostfwd to SSH (host port $BOOT_TEST_SSH_PORT, default 10022)
#   - serial console logged to a file
#
# --keys DIR: the throwaway keys directory (from image-smoke-test's keys symlink
#   or the path to golconda-throwaway-keys directly).
#
# QEMU runs in the background; the checks run while the guest is up, then the
# harness stops it. The harness waits for every required serial success marker.
#
# Markers checked (each prints PASS/FAIL, only on positive evidence):
#   - multi-user-reached: multi-user.target reached
#   - sshd-active: sshd.service started (Listening on port)
#   - var-sshd-hostkey: the host key var finished (it needs a writable root)
#   - boot-complete: boot-complete.target reached
#   - no-prompt: nothing on the serial console asked for input
#
# With --ssh-test: logs in with tests/fixtures/snakeoil-ssh and checks
#   ssh-login, hostname (must be "boot-test", the SMBIOS credential),
#   systemctl --failed (no failed units), varlinkctl list-interfaces.
# With --esp-creds (needs --ssh-test): provisions through the ESP instead of SMBIOS and the image's
#   test key (docs/design/boot.md, "Bootstrap credentials"). The harness copies the disk into the
#   work directory, generates an ssh key pair there, and runs scripts/provision-esp on the copy with
#   --hostname esp-test and --authorized-keys <the new .pub>. It passes no SMBIOS hostname. The ssh
#   checks log in with the new key, hostname must be "esp-test", and esp-authorized-keys checks that
#   /root/.ssh/authorized_keys in the guest holds the new key. With --secure-boot and --tpm the
#   null-key credentials are refused (creds-util.c, relaxed policy): the run is expected to fail.
#   BOOT_TEST_ESP_NO_KEY=1 leaves the key out of the ESP (a negative control: the login must fail).
# With --secure-boot: boots OVMFFull and checks that the firmware enforces Secure Boot.
# With --ssh-test: also checks the boot loader (docs/design/bootloader.md): the ESP's two
#   copies of systemd-boot are the signed file in /usr, loader/loader.conf is the one
#   systemd-boot reads and the copy in /usr, golconda-loader-update.service ran after the boot
#   was blessed, and systemd-boot-update.service stayed off.
# With --next DIR (implies --ssh-test): DIR is the next release's image-smoke output
#   (DIR/disk/release, DIR/keys). The harness checks that release directory against
#   docs/design/releases.md (four SHA256SUMS lines, fixed order, digests match), resolves its
#   symlinks into $WORKDIR/http, serves that directory on 127.0.0.1:$BOOT_TEST_HTTP_PORT with
#   python3 -m http.server, and installs it with systemd-sysupdate-update.service. The guest reads
#   its own /usr/lib/sysupdate.d/*.transfer (Type=url-file, Path=http://10.0.2.2:PORT/), so it
#   fetches SHA256SUMS and the artifacts over HTTP; the harness rewrites no definition. Then it
#   reboots into the release, and checks that golconda-loader-update.service put the new loader on
#   the ESP, that no /etc/systemd/system link names the old systemd store path or dangles
#   (golconda-etc-links.service), and that the updated system has no failed unit. Then the
#   recovery checks: bootctl list shows both slots, a damaged loader
#   is reinstalled by hand, `bootctl set-oneshot` and `bootctl set-default` boot the other slot
#   and back, and `bootctl reboot-to-firmware` reaches the firmware's menu.
# With --next DIR --fail-health: prove the three-boot fallback. The harness masks a health unit
#   in /etc, so boot-complete.target cannot be reached, the candidate is never blessed and every
#   boot of it loses one try. It reboots three times, checking after each that the counter fell,
#   then checks that the fourth boot runs the old release with the candidate at "tries: 0 left".
#   The mask is in /etc on the state partition, so it holds for every slot; the harness removes it
#   at the end. A mask instead of a cut link keeps every boot clean and ssh reachable.
#   This mode skips the loader and recovery checks: no boot of the candidate is blessed.
# With --next DIR --rotate: DIR is signed with a new db key. Its certificate is enrolled in db
#   beside the old one before the first boot; after the update the harness stops QEMU, rewrites
#   the variable store (db: the new certificate only; dbx: the old one), boots again and checks
#   the new chain, then boots the original disk with the rotated store, which firmware must
#   refuse.
# With --factory-reset (needs --ssh-test and the test image; a boot of its own): writes a marker
#   in /var, reads /etc/machine-id, runs `systemctl start factory-reset.target` in the guest and
#   waits for the reset boot. It checks that the marker is gone (state-gone), the machine id
#   stayed (machine-id-kept: it is the SMBIOS UUID) while the host key is new (hostkey-new), the
#   var units ran again and multi-user.target was reached
#   (first-boot-rerun, multi-user-after-reset), and that bootctl list still shows the same entries
#   (slots-kept). The reset rewrites the root partition only; the ESP and the /usr slots stay.
#   It prints the serial log of the reset boot. The mode is two boots (the first boot and the
#   reset boot), so give a --timeout large enough, such as 480, and do not combine it with --next.
# BOOT_TEST_TAMPER_INDEX=1 (with --next): serve SHA256SUMS with one byte added, so its signature
#   (SHA256SUMS.gpg) no longer matches; the update must fail (the signed index's negative control).
# BOOT_TEST_HTTP_PORT: the host port for the release HTTP server (default 8074). The test image's
#   updateSource is http://10.0.2.2:8074/, so another port needs an image built for it.
# BOOT_TEST_STORE_ROOT: the root of a chroot store (nix --store 'local?root=DIR'); a symlink
#   into /nix/store under DIR is followed there.
# With --ssh-test --tpm: also checks that the host key is sealed with the TPM
#   (credential header), reboots the guest in the same QEMU (swtpm keeps its
#   state) and checks the second boot: a new boot id, sshd active, the same
#   host key (unsealed, not regenerated).
#
# Exit: 0 if all markers pass, 1 otherwise.

set -eu

# --- bootstrap: re-exec under nix-shell if tools are missing ---
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "$0")")"
  REPO_DIR="$(dirname "$SCRIPT_DIR")"
  # Get the dev pin path from npins/sources.json via nix-instantiate
  DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/nix/sources.nix).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
  if [ -z "$DEV_PIN" ] || [ ! -d "$DEV_PIN" ]; then
    echo "Error: cannot find nixpkgs-dev-only pin" >&2
    exit 1
  fi
  # nix-shell sets its own TMPDIR and removes it on exit: keep the work directory outside
  BOOT_TEST_TMPDIR="${TMPDIR:-/tmp}"
  export BOOT_TEST_TMPDIR
  exec nix-shell -I "nixpkgs=$DEV_PIN" -p qemu OVMF swtpm openssh python3 python3Packages.virt-firmware --run "$0 $*"
fi

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
. "$SCRIPT_DIR/boot-test-log.sh"

# --- argument parsing ---
# the host port for the guest's sshd: set BOOT_TEST_SSH_PORT when another VM uses 10022
SSH_PORT=${BOOT_TEST_SSH_PORT:-10022}
# the host port for the release HTTP server: the test image's updateSource uses 8074
HTTP_PORT=${BOOT_TEST_HTTP_PORT:-8074}
DISK=""
KEYS_DIR=""
SECURE_BOOT=0
TPM=0
TIMEOUT=120
SSH_TEST=0
NEXT=""
ROTATE=0
FAIL_HEALTH=0
MID_CRED=0
FACTORY_RESET=0
ESP_CREDS=0

usage() {
  echo "Usage: $0 <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS] [--ssh-test [--esp-creds]] [--next DIR [--rotate | --fail-health]] [--factory-reset] [--machine-id-credential]"
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keys) KEYS_DIR="$2"; shift 2 ;;
    --secure-boot) SECURE_BOOT=1; shift ;;
    --tpm) TPM=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --ssh-test) SSH_TEST=1; shift ;;
    --next) NEXT="$2"; SSH_TEST=1; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --fail-health) FAIL_HEALTH=1; shift ;;
    --machine-id-credential) MID_CRED=1; shift ;;
    --factory-reset) FACTORY_RESET=1; shift ;;
    --esp-creds) ESP_CREDS=1; shift ;;
    --help|-h) usage ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      if [ -z "$DISK" ]; then
        DISK="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
      fi
      shift
      ;;
  esac
done

# the machine id the guest must have: the -uuid QEMU gives, or the credential
if [ "$MID_CRED" = 1 ]; then
  EXPECT_MACHINE_ID=0a1b2c3d4e5f40718293a4b5c6d7e8f9
  MACHINE_ID_SOURCE="system.machine_id credential"
else
  EXPECT_MACHINE_ID=6f1a2c3e0b4d4e5f8a9b0c1d2e3f4a5b
  MACHINE_ID_SOURCE="SMBIOS UUID"
fi

if [ -z "$DISK" ]; then
  echo "Error: disk image required" >&2
  usage
fi

if [ ! -f "$DISK" ]; then
  echo "Error: disk image not found: $DISK" >&2
  exit 1
fi

if [ -z "$KEYS_DIR" ]; then
  echo "Error: --keys DIR required" >&2
  usage
fi

if [ ! -d "$KEYS_DIR" ]; then
  echo "Error: keys directory not found: $KEYS_DIR" >&2
  exit 1
fi

# real_path PATH: PATH with its symlinks followed; a target in /nix/store is looked up under
# $BOOT_TEST_STORE_ROOT, so a chroot store's outputs resolve on the host
real_path() {
  rp=$1
  while [ -L "$rp" ]; do
    rt=$(readlink "$rp")
    case $rt in
      /nix/store/*) rp=${BOOT_TEST_STORE_ROOT:-}$rt ;;
      /*) rp=$rt ;;
      *) rp=$(dirname "$rp")/$rt ;;
    esac
  done
  echo "$rp"
}

# http_port_in_use PORT: true when 127.0.0.1:PORT is already bound
http_port_in_use() {
  python3 - "$1" <<'EOF'
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(0)
sys.exit(1)
EOF
}

# http_answers PORT: true when 127.0.0.1:PORT accepts a connection
http_answers() {
  python3 - "$1" <<'EOF'
import socket, sys
try:
    socket.create_connection(("127.0.0.1", int(sys.argv[1])), 1).close()
except OSError:
    sys.exit(1)
EOF
}

if [ "$ESP_CREDS" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --esp-creds needs --ssh-test: the checks log in with the generated key" >&2
  exit 1
fi
if [ "$FACTORY_RESET" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --factory-reset needs --ssh-test: the reset is requested over ssh, and only the test image carries the test key" >&2
  exit 1
fi
if [ "$FACTORY_RESET" = 1 ] && { [ -n "$NEXT" ] || [ "$ROTATE" = 1 ] || [ "$FAIL_HEALTH" = 1 ]; }; then
  echo "Error: --factory-reset is a boot of its own; do not combine it with --next, --rotate or --fail-health" >&2
  exit 1
fi

if [ "$FAIL_HEALTH" = 1 ] && [ "$TPM" = 1 ]; then
  echo "Error: --fail-health cannot run with --tpm: PID 1 refuses its null-key ESP credential with Secure Boot and a TPM2" >&2
  exit 1
fi
if [ "$FAIL_HEALTH" = 1 ] && [ -z "$NEXT" ]; then
  echo "Error: --fail-health needs --next" >&2
  exit 1
fi
if [ "$ROTATE" = 1 ] && { [ -z "$NEXT" ] || [ "$SECURE_BOOT" = 0 ]; }; then
  echo "Error: --rotate needs --next and --secure-boot" >&2
  exit 1
fi
if [ -n "$NEXT" ]; then
  NEXT_RELEASE=$(real_path "$NEXT/disk")/release
  NEXT_KEYS=$(real_path "$NEXT/keys")
  if [ ! -f "$NEXT_RELEASE/SHA256SUMS" ] || [ ! -f "$NEXT_KEYS/secureboot/db.crt" ]; then
    echo "Error: $NEXT has no disk/release/SHA256SUMS or keys/secureboot/db.crt" >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to serve $NEXT_RELEASE over HTTP, and it is not on PATH" >&2
    exit 1
  fi
  if http_port_in_use "$HTTP_PORT"; then
    echo "Error: 127.0.0.1:$HTTP_PORT is already in use; set BOOT_TEST_HTTP_PORT to a free port, and use a test image whose updateSource names that port (the image's default is 8074)" >&2
    exit 1
  fi
fi

# --- working directory ---
WORKDIR="${BOOT_TEST_TMPDIR:-${TMPDIR:-/tmp}}/boot-test-$$"
mkdir -p "$WORKDIR"
KEEP_WORKDIR=1  # Keep on failure

cleanup() {
  if [ -n "${QEMU_PID:-}" ]; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  if [ -n "${SWTPM_PID:-}" ]; then
    kill "$SWTPM_PID" 2>/dev/null || true
  fi
  if [ -n "${HTTP_PID:-}" ]; then
    kill "$HTTP_PID" 2>/dev/null || true
    wait "$HTTP_PID" 2>/dev/null || true
  fi
  if [ "$KEEP_WORKDIR" = 0 ]; then
    rm -rf "$WORKDIR"
  else
    echo "Work directory kept: $WORKDIR"
  fi
}
trap cleanup EXIT

# --- prepare disk overlay ---
OVERLAY="$WORKDIR/disk.qcow2"
SERIAL_LOG="$WORKDIR/serial.log"
QEMU_OUT="$WORKDIR/qemu.out"
VARS="$WORKDIR/vars.fd"

# --- find OVMF ---
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/nix/sources.nix).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
# OVMF.fd has neither Secure Boot nor TPM support. OVMFFull.fd has both, and it is
# built with SMM, so QEMU gets smm=on below. --tpm needs the TPM measurement, or
# systemd-stub does not pass the UKI's PCR public key on and credentials are sealed
# without the signed PCR 11 policy. --secure-boot needs a firmware that enforces.
OVMF_ATTR=OVMF.fd
if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
  OVMF_ATTR=OVMFFull.fd
fi
OVMF_DIR=$(nix-build -I "nixpkgs=$DEV_PIN" '<nixpkgs>' -A "$OVMF_ATTR" --no-out-link 2>/dev/null)/FV

if [ ! -d "$OVMF_DIR" ]; then
  echo "Error: cannot find OVMF.fd" >&2
  exit 1
fi

cp "$OVMF_DIR/OVMF_VARS.fd" "$VARS"
chmod u+w "$VARS"

# --- enroll Secure Boot keys ---
enroll_keys() {
  DB_CERT="$KEYS_DIR/secureboot/db.crt"
  if [ ! -f "$DB_CERT" ]; then
    echo "Error: db.crt not found: $DB_CERT" >&2
    exit 1
  fi
  
  echo "Enrolling Secure Boot keys..."
  # virt-fw-vars 25.12 wants an owner GUID with every entry; one fixed GUID is fine
  # for a throwaway test key (the GUID names the entry, it does not verify anything)
  GUID=11111111-2222-3333-4444-555555555555
  # --rotate: step 1 of the rotation, the new db certificate beside the old one
  DB_NEXT=""
  if [ "$ROTATE" = 1 ]; then
    DB_NEXT="--add-db $GUID $NEXT_KEYS/secureboot/db.crt"
  fi
  # shellcheck disable=SC2086
  virt-fw-vars \
    --input "$VARS" \
    --output "$VARS.new" \
    --set-pk "$GUID" "$DB_CERT" \
    --add-kek "$GUID" "$DB_CERT" \
    --add-db "$GUID" "$DB_CERT" \
    $DB_NEXT \
    --secure-boot
  mv "$VARS.new" "$VARS"
  echo "Secure Boot keys enrolled"
}

# --- start TPM ---
start_tpm() {
  TPM_DIR="$WORKDIR/tpm"
  mkdir -p "$TPM_DIR"
  
  swtpm socket \
    --tpm2 \
    --tpmstate dir="$TPM_DIR" \
    --ctrl type=unixio,path="$TPM_DIR/swtpm-sock" \
    &
  SWTPM_PID=$!
  
  for _ in 1 2 3 4 5; do
    if [ -S "$TPM_DIR/swtpm-sock" ]; then
      break
    fi
    sleep 0.2
  done
  
  if [ ! -S "$TPM_DIR/swtpm-sock" ]; then
    echo "Error: swtpm socket not created" >&2
    exit 1
  fi
  
  echo "TPM started (pid $SWTPM_PID)"
}

# --- ESP credentials (--esp-creds) ---
# setup_esp_creds: copy the disk, make a key pair, write the credentials onto the copy's ESP
setup_esp_creds() {
  ssh-keygen -q -t ed25519 -N "" -C boot-test-esp -f "$SSH_DIR/user"
  cp --sparse=always "$DISK" "$WORKDIR/disk.raw"
  chmod u+w "$WORKDIR/disk.raw"
  DISK="$WORKDIR/disk.raw"
  if [ -n "${BOOT_TEST_ESP_NO_KEY:-}" ]; then
    "$SCRIPT_DIR/provision-esp" "$DISK" --hostname esp-test || exit 1
  else
    "$SCRIPT_DIR/provision-esp" "$DISK" --hostname esp-test --authorized-keys "$SSH_DIR/user.pub" || exit 1
  fi
  echo "Provisioned the ESP of $DISK; new key: $SSH_DIR/user"
}

# --- SSH test setup ---
setup_ssh_test() {
  SSH_DIR="$WORKDIR/ssh"
  mkdir -p "$SSH_DIR"
  
  if [ "$ESP_CREDS" = 1 ]; then
    setup_esp_creds
    return
  fi

  # Use the committed test SSH key from the repo
  TEST_KEY="$REPO_DIR/tests/fixtures/snakeoil-ssh"
  if [ ! -f "$TEST_KEY" ]; then
    echo "Error: test SSH key not found: $TEST_KEY" >&2
    exit 1
  fi
  
  # Copy the test key to the work directory
  cp "$TEST_KEY" "$SSH_DIR/user"
  chmod 600 "$SSH_DIR/user"
  
  echo "Using test SSH key: $TEST_KEY"
}

# --- the release HTTP server (--next) ---
# start_http_server: serve the release directory on the host, where the image's url-file source
# expects it. QEMU user networking maps 10.0.2.2 to the host loopback.
start_http_server() {
  HTTP_ROOT="$WORKDIR/http"
  HTTP_LOG="$WORKDIR/http.log"
  mkdir -p "$HTTP_ROOT"
  # The release directory holds symlinks into the store, and a chroot store's /nix/store is not
  # the host's: resolve each file the way the rest of this script does, then copy the bytes.
  for f in "$NEXT_RELEASE"/*; do
    if ! cp "$(real_path "$f")" "$HTTP_ROOT/$(basename "$f")"; then
      echo "Error: cannot copy $f into $HTTP_ROOT" >&2
      return 1
    fi
  done

  # the negative control of the signed index: one byte more in SHA256SUMS, the signature unchanged
  if [ "${BOOT_TEST_TAMPER_INDEX:-0}" = 1 ]; then
    chmod u+w "$HTTP_ROOT/SHA256SUMS"
    printf '\n' >> "$HTTP_ROOT/SHA256SUMS"
    echo "BOOT_TEST_TAMPER_INDEX=1: served SHA256SUMS has one byte more than its signature covers"
  fi

  echo "Serving $NEXT_RELEASE on http://127.0.0.1:$HTTP_PORT/ (the guest uses http://10.0.2.2:$HTTP_PORT/)"
  python3 -m http.server "$HTTP_PORT" --bind 127.0.0.1 --directory "$HTTP_ROOT" \
    > "$HTTP_LOG" 2>&1 &
  HTTP_PID=$!

  WAIT=0
  while [ "$WAIT" -lt 50 ]; do
    if ! kill -0 "$HTTP_PID" 2>/dev/null; then
      echo "Error: the HTTP server on 127.0.0.1:$HTTP_PORT exited; its log:" >&2
      cat "$HTTP_LOG" >&2 || true
      return 1
    fi
    if http_answers "$HTTP_PORT"; then
      echo "HTTP server ready (pid $HTTP_PID)"
      return 0
    fi
    WAIT=$((WAIT + 1))
    sleep 0.2
  done

  echo "Error: the HTTP server on 127.0.0.1:$HTTP_PORT did not answer within 10 s; its log:" >&2
  cat "$HTTP_LOG" >&2 || true
  return 1
}

# --- run QEMU ---
start_qemu() {
  # a later QEMU run (--rotate) boots the same overlay again
  if [ ! -f "$OVERLAY" ]; then
    qemu-img create -q -f qcow2 -b "$DISK" -F raw "$OVERLAY" 40G
  fi

  # the --tpm, --next and --factory-reset runs reboot the guest in the same QEMU
  NO_REBOOT=-no-reboot
  if [ "$TPM" = 1 ] || [ -n "$NEXT" ] || [ "$FACTORY_RESET" = 1 ]; then
    NO_REBOOT=""
  fi

  SMBIOS_HOSTNAME="-smbios type=11,value=io.systemd.credential:system.hostname=boot-test"
  # network.hosts: a tmpfiles credential into /etc, which is read-only; lib/image/etc.nu moves it
  # to /run/golconda/etc/hosts. Binary (base64), because the value has a space.
  SMBIOS_HOSTNAME="$SMBIOS_HOSTNAME -smbios type=11,value=io.systemd.credential.binary:network.hosts=$(printf '192.0.2.10 boot-test-hosts\n' | base64 -w0)"
  if [ "$ESP_CREDS" = 1 ]; then
    SMBIOS_HOSTNAME=""
  fi

  # The machine's SMBIOS UUID, as a cloud VM has one: /etc is read-only, so PID 1 takes the
  # machine id from it (machine-id(5)), and the vars' host secret is bound to that id. Without
  # it the id is random at every boot and a sealed credential no longer opens after a reboot.
  # --machine-id-credential: a board without a UUID; the id comes from the system.machine_id
  # credential, which wins over the firmware (the UKI says systemd.machine_id=firmware)
  if [ "$MID_CRED" = 1 ]; then
    MACHINE_UUID="-smbios type=11,value=io.systemd.credential:system.machine_id=$EXPECT_MACHINE_ID"
  else
    MACHINE_UUID="-uuid 6f1a2c3e-0b4d-4e5f-8a9b-0c1d2e3f4a5b"
  fi
  QEMU_ARGS="-machine q35,accel=kvm:tcg \
    $MACHINE_UUID \
    -cpu max \
    -m 2G \
    -smp 2 \
    -drive if=pflash,format=raw,readonly=on,file=$OVMF_DIR/OVMF_CODE.fd \
    -drive if=pflash,format=raw,file=$VARS \
    -drive file=$OVERLAY,format=qcow2,if=virtio \
    -serial file:$SERIAL_LOG \
    -display none \
    $NO_REBOOT \
    $SMBIOS_HOSTNAME \
    -netdev user,id=net0,hostfwd=tcp::$SSH_PORT-:22 \
    -device virtio-net-pci,netdev=net0"
  
  if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
    QEMU_ARGS="$QEMU_ARGS \
      -machine smm=on -global driver=cfi.pflash01,property=secure,value=on"
  fi
  if [ "$TPM" = 1 ]; then
    QEMU_ARGS="$QEMU_ARGS \
      -chardev socket,id=chrtpm,path=$WORKDIR/tpm/swtpm-sock \
      -tpmdev emulator,id=tpm0,chardev=chrtpm \
      -device tpm-tis,tpmdev=tpm0"
  fi
  
  echo "Starting QEMU (timeout ${TIMEOUT}s)..."
  : > "$SERIAL_LOG"
  # shellcheck disable=SC2086
  timeout "$TIMEOUT" qemu-system-x86_64 $QEMU_ARGS > "$QEMU_OUT" 2>&1 &
  QEMU_PID=$!
}

qemu_running() {
  kill -0 "$QEMU_PID" 2>/dev/null
}

stop_qemu() {
  if qemu_running; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  wait "$QEMU_PID" 2>/dev/null || true
  echo "QEMU stopped"
}

# --- SSH tests ---
# ssh takes the first value of an option: the host key options are separate
NO_HOSTKEY_CHECK="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
SSH_OPTS="-F /dev/null \
  -o ConnectTimeout=2 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 \
  -o BatchMode=yes -o LogLevel=ERROR -p $SSH_PORT"

guest() {
  # shellcheck disable=SC2086
  ssh $SSH_OPTS $NO_HOSTKEY_CHECK -i "$WORKDIR/ssh/user" root@localhost "$@"
}

# wait for an ssh login while QEMU runs; $1: the boot id it must differ from
wait_for_ssh() {
  SSH_LAST=""
  while qemu_running; do
    if BOOT_ID=$(guest cat /proc/sys/kernel/random/boot_id 2>/dev/null) \
      && [ -n "$BOOT_ID" ] && [ "$BOOT_ID" != "${1:-}" ]; then
      return 0
    fi
    # shellcheck disable=SC2086
    SSH_LAST=$(ssh $SSH_OPTS $NO_HOSTKEY_CHECK -v -i "$WORKDIR/ssh/user" root@localhost true 2>&1) || true
    sleep 2
  done
  return 1
}

# one check: $1 name, $2 0 for PASS; counts into PASS/FAIL
verdict() {
  if [ "$2" = 0 ]; then
    echo "PASS: $1"
    PASS=$((PASS + 1))
  else
    echo "FAIL: $1"
    FAIL=$((FAIL + 1))
  fi
}

test_ssh() {
  echo ""
  echo "=== SSH tests ==="
  echo "Waiting for SSH..."
  if ! wait_for_ssh ""; then
    echo "last attempt (ssh -v), while QEMU still ran:"
    echo "$SSH_LAST" | tail -15
    verdict "ssh-login (no login before the timeout)" 1
    return 1
  fi
  verdict "ssh-login" 0
  FIRST_BOOT_ID=$BOOT_ID
  # remember the host key the server presents, for the second boot
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o UserKnownHostsFile="$WORKDIR/known_hosts" -o StrictHostKeyChecking=accept-new \
    -i "$WORKDIR/ssh/user" root@localhost true 2>/dev/null || true

  echo ""
  echo "=== hostname ==="
  HN=$(guest hostname 2>&1) || true
  echo "$HN"
  EXPECT_HN=boot-test
  if [ "$ESP_CREDS" = 1 ]; then
    EXPECT_HN=esp-test
  fi
  RC=0; [ "$HN" = "$EXPECT_HN" ] || RC=1
  verdict "hostname (system.hostname credential applied)" $RC

  if [ "$ESP_CREDS" = 1 ]; then
    echo ""
    echo "=== authorized_keys (ESP credential) ==="
    AK=$(guest cat /root/.ssh/authorized_keys 2>&1) || true
    echo "$AK"
    RC=0; echo "$AK" | grep -qF "$(cut -d' ' -f1,2 "$WORKDIR/ssh/user.pub")" || RC=1
    verdict "esp-authorized-keys (ssh.authorized_keys.root credential written to /root/.ssh)" $RC
  fi

  echo ""
  echo "=== systemctl --failed ==="
  FAILED=$(guest systemctl --failed --no-pager 2>&1) || true
  echo "$FAILED"
  RC=0; echo "$FAILED" | grep -q "^0 loaded units listed" || RC=1
  verdict "no-failed-units" $RC

  echo ""
  echo "=== varlinkctl list-interfaces ==="
  RC=0
  IFACES=$(guest varlinkctl list-interfaces /run/systemd/io.systemd.Manager 2>&1) || RC=1
  echo "$IFACES"
  echo "$IFACES" | grep -q "^io.systemd.Manager$" || RC=1
  verdict "varlinkctl-list-interfaces" $RC

  echo ""
  echo "=== bootctl list ==="
  guest bootctl list --no-pager 2>&1 || true

  test_loader "first boot" 1

  # the hardware database is compiled into /usr (packages/hwdb, linked by /base), so nothing writes one
  # to /etc and lookups answer: the IMDS entry for Hetzner Cloud's DMI vendor
  echo ""
  echo "=== hwdb ==="
  RC=0
  Q=$(guest systemd-hwdb query dmi:bvnHetzner: 2>&1) || RC=1
  echo "$Q"
  echo "$Q" | grep -q "^IMDS_VENDOR=hetzner-cloud$" || RC=1
  # PCI and USB names: virtio-net's vendor, and the root hub's
  P=$(guest systemd-hwdb query pci:v00001AF4d00001000 2>&1) || RC=1
  U=$(guest systemd-hwdb query usb:v1D6Bp0002 2>&1) || RC=1
  echo "$P"; echo "$U"
  echo "$P" | grep -q "^ID_VENDOR_FROM_DATABASE=Red Hat, Inc.$" || RC=1
  echo "$U" | grep -q "^ID_VENDOR_FROM_DATABASE=Linux Foundation$" || RC=1
  guest test -e /usr/lib/udev/hwdb.bin || RC=1
  guest test ! -e /etc/udev/hwdb.bin || RC=1
  verdict "hwdb (/usr/lib/udev/hwdb.bin answers for DMI, PCI and USB; none in /etc)" $RC

  # /etc is the image's confext (lib/etc.nix): an overlay, read-only, merged from
  # /usr/lib/confexts/golconda; the machine id is mounted over the empty file
  echo ""
  echo "=== read-only /etc ==="
  RC=0
  M=$(guest cat /proc/self/mounts 2>/dev/null | awk '$2 == "/etc" { print $3, $4 }' | tail -1)
  echo "/etc: ${M:-not a mount}"
  case "$M" in "overlay ro,"*) ;; *) RC=1 ;; esac
  guest systemd-confext status 2>&1 | grep golconda || RC=1
  guest "touch /etc/boot-test 2>&1" | grep -q 'Read-only file system' || RC=1
  ID=$(guest cat /etc/machine-id 2>/dev/null) || RC=1
  echo "machine-id: ${ID:-none}"
  # PID 1 took it from the SMBIOS UUID QEMU gives (-uuid), or from the credential
  [ "$ID" = "$EXPECT_MACHINE_ID" ] || RC=1
  verdict "etc-read-only (/etc is the confext overlay, ro; machine-id $EXPECT_MACHINE_ID from the $MACHINE_ID_SOURCE)" $RC

  # no shadow: every account is locked and has no password, so passwd says !* (not x)
  RC=0
  guest "test ! -e /etc/shadow && test ! -e /etc/gshadow" || RC=1
  R=$(guest "head -1 /etc/passwd" 2>/dev/null) || RC=1
  echo "passwd: $R"
  [ "$R" = "root:!*:0:0:Super User:/root:/bin/sh" ] || RC=1
  verdict "no-shadow (no /etc/shadow; root is locked in passwd, and ssh login works)" $RC

  # a tmpfiles credential into /etc still works: /etc/hosts links to /run/golconda/etc/hosts
  if [ "$ESP_CREDS" != 1 ]; then
    RC=0
    H=$(guest cat /etc/hosts 2>&1) || RC=1
    echo "/etc/hosts -> $(guest readlink /etc/hosts 2>&1): $H"
    [ "$H" = "192.0.2.10 boot-test-hosts" ] || RC=1
    Q=$(guest resolvectl query --legend=no boot-test-hosts 2>&1) || RC=1
    echo "resolvectl: $Q"
    echo "$Q" | grep -q '192.0.2.10' || RC=1
    verdict "hosts-credential (network.hosts reaches /etc/hosts through /run)" $RC
  fi

  # an empty /etc/machine-id is not a first boot (machine-id(5)): systemd-firstboot is skipped
  # by its condition, so it can neither prompt nor write
  RC=0
  FB=$(guest systemctl show -P ConditionResult systemd-firstboot.service 2>&1) || RC=1
  echo "systemd-firstboot ConditionResult=${FB:-none}"
  [ "$FB" = "no" ] || RC=1
  verdict "firstboot-skipped (not a first boot; no prompt on the serial console)" $RC

  # the signed index's keyring is the key set's release key and nothing else: systemd's own vendor
  # keyring (image vendors' keys) is not in the image (packages/systemd)
  echo ""
  echo "=== /usr/lib/systemd/import-pubring.pgp ==="
  RC=0
  WANT=$(sha256sum "$(real_path "$KEYS_DIR/release/index.pgp")" 2>/dev/null | cut -c1-64) || WANT=""
  GOT=$(guest sha256sum /usr/lib/systemd/import-pubring.pgp 2>/dev/null | cut -c1-64) || GOT=""
  echo "image: ${GOT:-missing}; key set: ${WANT:-missing}"
  [ -n "$WANT" ] && [ "$GOT" = "$WANT" ] || RC=1
  verdict "index-keyring (the image's keyring is the key set's release/index.pgp)" $RC

  if [ "$SECURE_BOOT" = 1 ]; then
    echo ""
    echo "=== secure boot state ==="
    SB=$(guest bootctl status 2>&1) || true
    echo "$SB" | grep -i "secure boot" || true
    RC=0; echo "$SB" | grep -qi "Secure Boot: enabled" || RC=1
    verdict "secure-boot-enabled (firmware is enforcing)" $RC
  fi

  if [ "$TPM" = 1 ]; then
    echo ""
    echo "=== /var/lib/golconda/credstore.encrypted (TPM sealed credentials) ==="
    guest ls -la /var/lib/golconda/credstore.encrypted/ 2>&1 || true
    # the sealing key type is the first 16 bytes of the credential (systemd creds-util.h,
    # CRED_AES256_GCM_BY_*); the file is base64, so decode its first 24 characters
    HDR=$(guest "head -c 24 /var/lib/golconda/credstore.encrypted/sshd-hostkey.key | base64 -d | od -An -tx1 -N4" \
      2>/dev/null | tr -d ' \n') || true
    case "$HDR" in
      5a1c6a86 | 55b9ed1d) KIND="host key only"; RC=1 ;;
      058469da) KIND="null key"; RC=1 ;;
      0c7cc07b | d4062dfb) KIND="TPM2" ; RC=0 ;;
      93a89409 | ef4ac136 | 14142588 | 2a1f877a) KIND="host key + TPM2"; RC=0 ;;
      faf7eb93 | 5e2d5c76) KIND="TPM2 + signed PCR policy"; RC=0 ;;
      af4950a8 | adbc4ca3 | afbfeaac | 16e49294) KIND="host key + TPM2 + signed PCR policy"; RC=0 ;;
      *) KIND="unknown"; RC=1 ;;
    esac
    echo "sshd-hostkey.key sealed with: $KIND (header id ${HDR:-none}...)"
    verdict "hostkey-sealed-with-tpm2" $RC
  fi
  return 0
}

# --- the boot loader on the ESP (docs/design/bootloader.md) ---
# The harness runs qemu-system-x86_64, so the names are x64's.
USR_LOADER=/usr/lib/systemd/boot/efi/systemd-bootx64.efi.signed
ESP_PRIMARY=/boot/EFI/systemd/systemd-bootx64.efi
ESP_REMOVABLE=/boot/EFI/BOOT/BOOTX64.EFI
ESP_FALLBACK=/boot/EFI/systemd/systemd-boot-fallbackx64.efi

# guest_hash FILE: the sha256 of a file in the guest, empty when it is missing
guest_hash() {
  guest "sha256sum < $1" 2>/dev/null | cut -c1-64
}

# shellcheck disable=SC2016 # $IMAGE_VERSION is the guest's
guest_version() {
  guest '. /usr/lib/os-release && echo "$IMAGE_VERSION"' 2>/dev/null
}

# test_loader LABEL COUNTED: on a counted boot (COUNTED=1) golconda-loader-update.service ran
# after bless-boot, on a blessed one (0) it did not; the ESP's two copies of systemd-boot are
# /usr's signed file, and the loader.conf in effect is /usr's
test_loader() {
  echo ""
  echo "=== boot loader ($1) ==="
  LU=""
  if [ "$2" = 1 ]; then
    # it runs after systemd-bless-boot.service, which waits for the health units (the network
    # one waits up to 60 s)
    LW=0
    while [ "$LW" -lt 120 ] && qemu_running; do
      LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
      [ "$LU" = active ] && break
      LW=$((LW + 2))
      sleep 2
    done
    guest journalctl -b -u golconda-loader-update.service -o cat --no-pager 2>&1 || true
    RC=0; [ "$LU" = active ] || RC=1
    verdict "loader-update-ran (golconda-loader-update.service after bless-boot: $LU)" $RC
  else
    LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
    RC=0; [ "$LU" != active ] || RC=1
    verdict "loader-update-not-run (a blessed entry has no counter: $LU)" $RC
  fi

  USR=$(guest_hash "$USR_LOADER")
  PRI=$(guest_hash "$ESP_PRIMARY")
  REM=$(guest_hash "$ESP_REMOVABLE")
  echo "$USR_LOADER: $USR"
  echo "$ESP_PRIMARY: $PRI"
  echo "$ESP_REMOVABLE: $REM"
  RC=0
  { [ -n "$USR" ] && [ "$USR" = "$PRI" ] && [ "$USR" = "$REM" ]; } || RC=1
  verdict "loader-matches-usr (both ESP copies are the signed loader in /usr)" $RC

  # bootctl reads loader.conf where systemd-boot does, at the ESP's root
  CONF_LINE=$(guest bootctl status --no-pager 2>&1 | grep "config:") || true
  echo "$CONF_LINE"
  guest cat /boot/loader/loader.conf 2>&1 || true
  RC=0
  echo "$CONF_LINE" | grep -q "/loader/loader.conf$" || RC=1
  [ "$(guest_hash /boot/loader/loader.conf)" = "$(guest_hash /usr/lib/golconda/loader.conf)" ] || RC=1
  verdict "loader-conf-in-effect (ESP loader/loader.conf = /usr/lib/golconda/loader.conf)" $RC

  CR=$(guest systemctl show -P ConditionResult systemd-boot-update.service 2>&1) || true
  RC=0; [ "$CR" = no ] || RC=1
  verdict "boot-update-off (systemd-boot-update.service ConditionResult=$CR)" $RC
}

# reboot_guest: reboot in the same QEMU and wait for a login with a new boot id
reboot_guest() {
  PREV_BOOT_ID=$BOOT_ID
  guest systemctl reboot 2>&1 || true
  if ! wait_for_ssh "$PREV_BOOT_ID"; then
    verdict "ssh-after-reboot (no login before the timeout)" 1
    return 1
  fi
}

# test_release_index: the release directory a server publishes, as docs/design/releases.md states
# it: four lines in the fixed order usr, verity, signature, UKI; the digest of each file; no line
# for the index itself.
test_release_index() {
  echo ""
  echo "=== release index ($NEXT_RELEASE/SHA256SUMS) ==="
  RC=0
  N=0
  while read -r digest name; do
    [ -n "$digest" ] || continue
    N=$((N + 1))
    # the release directory holds symlinks into the store, absolute or in $BOOT_TEST_STORE_ROOT
    got=$(sha256sum "$(real_path "$NEXT_RELEASE/$name")" 2>/dev/null | cut -c1-64) || got=""
    OK=ok
    [ "$got" = "$digest" ] || OK="digest mismatch"
    echo "$N: $name ($OK)"
    [ "$OK" = ok ] || RC=1
    case "$N:$name" in
      1:"$NEXT_NAME".usr.*.raw) ;;
      2:"$NEXT_NAME".usr-verity.*.raw) ;;
      3:"$NEXT_NAME".usr-verity-sig.raw) ;;
      4:"$NEXT_NAME".efi) ;;
      *) RC=1 ;;
    esac
  done < "$NEXT_RELEASE/SHA256SUMS"
  [ "$N" = 4 ] || RC=1
  verdict "release-index (4 lines: usr, verity, signature, UKI; digests match)" $RC
}

# test_etc_links: /etc is the read-only confext of the running release (lib/etc.nix): its
# extension-release names the version that runs (the new one after an update, the old one after
# --fail-health's fallback), so /etc follows the slot. No boot is a
# first boot, so no preset wrote enable links under /etc/systemd/system, and none can dangle
# when systemd's store path changes (docs/design/updates.md).
# The host key the first release sealed must still open: sshd presents the key in known_hosts
# (recorded at the first login), so the new release unsealed the old credential (with --tpm:
# TPM2 and the signed PCR 11 policy, which both releases share).
test_etc_links() {
  echo ""
  echo "=== /etc after the update ==="
  RUNNING=$(guest_version)
  ER=$(guest cat /etc/extension-release.d/extension-release.golconda 2>&1) || true
  echo "$ER"
  N=$(guest 'n=0; for f in /etc/systemd/system/* /etc/systemd/system/*/*; do [ -L "$f" ] && n=$((n + 1)); done; echo $n' 2>/dev/null) || N=""
  echo "links under /etc/systemd/system: ${N:-no answer}"
  RC=0
  [ -n "$RUNNING" ] && echo "$ER" | grep -qx "VERSION_ID=$RUNNING" || RC=1
  [ "$N" = 0 ] || RC=1
  verdict "etc-follows-update (/etc is the running ${RUNNING:-?}'s confext; ${N:-?} enable links in /etc)" $RC

  RC=0
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o UserKnownHostsFile="$WORKDIR/known_hosts" -o StrictHostKeyChecking=yes \
    -i "$WORKDIR/ssh/user" root@localhost true 2>/dev/null || RC=1
  verdict "hostkey-unsealed-after-update (sshd of ${RUNNING:-?} presents the first boot's host key)" $RC
}

# test_units_after_update: the updated system starts clean. This is the boot the first boot's
# /etc links would break, so it is the one that has to have no failed unit.
test_units_after_update() {
  echo ""
  echo "=== systemctl --failed ($NEXT_VERSION) ==="
  FAILED=$(guest systemctl --failed --no-pager 2>&1) || true
  echo "$FAILED"
  RC=0; echo "$FAILED" | grep -q "^0 loaded units listed" || RC=1
  verdict "no-failed-units-after-update" $RC
}

# test_fail_health: the three-boot fallback of docs/design/boot.md. A network.network credential
# on the ESP gives the guest its slirp address with Scope=link and no DHCP: ssh still reaches it,
# but networkd never calls the link routable, so golconda-health-network.service fails,
# boot-complete.target is not reached, the candidate is never blessed and every boot of it loses a
# try. /etc is read-only and /run does not survive a reboot; the ESP does, and systemd-stub hands
# its credentials to every boot of every slot until the harness removes the file at the end. The
# credential is null-key, which PID 1 accepts with Secure Boot on only when there is no TPM2, so
# --fail-health refuses --tpm (docs/design/boot.md, Bootstrap credentials).
FAIL_CRED=network.network.00-boot-test-no-route
FAIL_CRED_FILE=/boot/loader/credentials/$FAIL_CRED.cred
test_fail_health() {
  echo ""
  echo "=== the fallback: $NEXT_VERSION fails its health check three times ==="
  RC=0
  guest "mkdir -p /boot/loader/credentials && printf '[Match]\\nName=en*\\n\\n[Network]\\nDHCP=no\\n\\n[Address]\\nAddress=10.0.2.15/24\\nScope=link\\n' | systemd-creds encrypt --with-key=null --name=$FAIL_CRED - $FAIL_CRED_FILE" || RC=1
  guest test -s "$FAIL_CRED_FILE" || RC=1
  verdict "health-check-broken (an ESP network credential: link-scoped address, never routable)" $RC

  i=1
  while [ "$i" -le 3 ]; do
    echo "--- attempt $i of 3: boot $NEXT_VERSION ---"
    if ! reboot_guest; then
      verdict "boots-next-attempt-$i (no login before the timeout)" 1
      return 1
    fi
    V=$(guest_version)
    BC=$(guest systemctl is-active boot-complete.target 2>&1 || true)
    TRIES=$(guest bootctl list --no-pager 2>/dev/null | grep -o "tries: [0-9]* left; [0-9]* done" | head -1)
    LU=$(guest systemctl is-active golconda-loader-update.service 2>&1 || true)
    echo "$V, boot-complete.target: $BC, $TRIES, loader update: $LU"
    RC=0
    [ "$V" = "$NEXT_VERSION" ] || RC=1
    [ "$BC" != "active" ] || RC=1
    [ "$TRIES" = "tries: $((3 - i)) left; $i done" ] || RC=1
    [ "$LU" != "active" ] || RC=1
    verdict "attempt-$i-unblessed ($NEXT_VERSION, $TRIES, boot-complete $BC, loader $LU)" $RC
    i=$((i + 1))
  done

  echo "--- attempt 4: the counter is exhausted ---"
  # lift the credential, so the fallback boot is a normal one and the checks below mean what they say
  guest "rm -f $FAIL_CRED_FILE" || true
  if ! reboot_guest; then
    verdict "fallback-to-old-slot (no login after the fourth boot)" 1
    return 1
  fi
  V=$(guest_version)
  echo "running $V"
  RC=0; [ "$V" = "$OLD_VERSION" ] || RC=1
  verdict "fallback-to-old-slot ($NEXT_VERSION failed 3 times, $V boots)" $RC
  L=$(guest bootctl list --no-pager 2>&1) || true
  echo "$L" | grep -E " (title|version|tries):" || true
  RC=0; echo "$L" | grep -q "tries: 0 left; 3 done" || RC=1
  verdict "counter-exhausted (the candidate has tries: 0 left; 3 done)" $RC
  RC=0; echo "$L" | grep "$OLD_VERSION" | grep -q "(selected)" || RC=1
  verdict "old-slot-selected ($OLD_VERSION is the entry systemd-boot picked)" $RC
}

# --- --next: install the next release, boot it, check its loader, then recovery ---
test_next() {
  echo ""
  echo "=== update to the next release ==="
  NEXT_NAME=$(basename "$(ls "$NEXT_RELEASE"/*.efi)" .efi)
  NEXT_VERSION=${NEXT_NAME##*_}
  IMAGE_ID=${NEXT_NAME%_*}
  test_release_index
  OLD_VERSION=$(guest_version)
  OLD_LOADER=$(guest_hash "$ESP_REMOVABLE")
  echo "running $OLD_VERSION, installing $NEXT_VERSION from http://10.0.2.2:$HTTP_PORT/"

  echo ""
  echo "=== the guest's own sysupdate definition ==="
  DEF=$(guest cat /usr/lib/sysupdate.d/10-usr.transfer 2>&1) || true
  echo "$DEF"
  RC=0
  echo "$DEF" | grep -q '^Type=url-file$' || RC=1
  echo "$DEF" | grep -q "^Path=http://10.0.2.2:$HTTP_PORT/$" || RC=1
  verdict "http-source (10-usr.transfer: Type=url-file, Path=http://10.0.2.2:$HTTP_PORT/)" $RC

  echo ""
  echo "=== systemd-sysupdate-update.service ==="
  RC=0
  guest systemctl start --wait systemd-sysupdate-update.service || RC=1
  JOURNAL=$(guest journalctl -b -u systemd-sysupdate-update.service -o cat --no-pager 2>&1) || true
  echo "$JOURNAL" | grep "Successfully installed" || true
  # sysupdate logs "Successfully installed '<source URL>' ... as '<target>' ...": for a url-file
  # source the source is the http URL, not a local path
  RC_FETCH=0
  echo "$JOURNAL" | grep -q "Successfully installed 'http://10.0.2.2:$HTTP_PORT/" || RC_FETCH=1
  verdict "http-fetch (the journal names the release over http, not a local file)" $RC_FETCH
  # Verify=yes: systemd-pull fetches the index's signature and gpg checks it before any payload
  RC_SIG=0
  grep -q '"GET /SHA256SUMS.gpg HTTP/1.[01]" 200' "$HTTP_LOG" || RC_SIG=1
  verdict "index-signed (the guest fetched SHA256SUMS.gpg)" $RC_SIG
  verdict "sysupdate-installed ($NEXT_VERSION)" $RC
  if [ "$RC" != 0 ]; then
    echo "HTTP server log (last 20 lines):"
    tail -20 "$HTTP_LOG" 2>/dev/null || true
    echo "sysupdate journal (gpg lines):"
    echo "$JOURNAL" | grep -i "gpg\|signature\|verif" | tail -10 || true
  fi

  echo "Rebooting into $NEXT_VERSION..."
  if [ "$FAIL_HEALTH" = 1 ]; then
    # no blessed boot of the candidate, so no loader and no recovery checks here
    test_fail_health || return 1
    test_etc_links
    test_units_after_update
    return 0
  fi
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "boots-next ($OLD_VERSION -> $V)" $RC
  test_etc_links
  test_units_after_update
  test_loader "$NEXT_VERSION, its first good boot" 1
  NEW_LOADER=$(guest_hash "$ESP_REMOVABLE")
  if [ "$NEW_LOADER" != "$OLD_LOADER" ]; then
    FB=$(guest_hash "$ESP_FALLBACK")
    echo "$ESP_FALLBACK: $FB"
    RC=0; [ "$FB" = "$OLD_LOADER" ] || RC=1
    verdict "loader-replaced (the previous loader kept as $ESP_FALLBACK)" $RC
  else
    echo "INFO: $NEXT_VERSION carries the loader bytes of $OLD_VERSION; nothing replaced"
  fi
  if [ "$ROTATE" = 1 ]; then
    RC=0; [ "$NEW_LOADER" != "$OLD_LOADER" ] || RC=1
    verdict "loader-signed-again (a new db key gives new loader bytes)" $RC
  fi

  test_recovery
}

# --- --factory-reset: the request and the reset boot (docs/design/recovery.md) ---
# The reset is requested with `systemctl start factory-reset.target`: the target sets the
# FactoryResetRequest EFI variable, and systemd-repart deletes and recreates the FactoryReset=
# root partition on the next boot (systemd-factory-reset(8), systemd-repart(8)). The ESP and the
# /usr slots must stay, and first boot must run again.
test_factory_reset() {
  echo ""
  echo "=== factory reset ==="
  # shellcheck disable=SC2016 # $IMAGE_ID is the guest's
  IMG_ID=$(guest '. /usr/lib/os-release && echo "$IMAGE_ID"' 2>/dev/null) || true
  if [ "$IMG_ID" != "boot-test" ]; then
    verdict "factory-reset-test-image (IMAGE_ID=${IMG_ID:-empty}; --factory-reset needs the test image)" 1
    return 1
  fi
  verdict "factory-reset-test-image (IMAGE_ID=boot-test)" 0

  # /etc is read-only: the state marker goes to /var, on the root partition the reset deletes
  MARK=/var/lib/boot-test-factory-reset
  HOSTKEY_PUB=/var/lib/golconda/vars/sshd-hostkey/pub/key.pub
  OLD_MACHINE_ID=$(guest cat /etc/machine-id 2>/dev/null) || true
  OLD_HOSTKEY=$(guest cat "$HOSTKEY_PUB" 2>/dev/null) || true
  OLD_VERSION=$(guest_version)
  OLD_ENTRIES=$(guest bootctl list --no-pager 2>/dev/null \
    | sed -n 's/^[[:space:]]*id: //p' | sed 's/+[0-9]*-[0-9]*\.efi$/.efi/' | sort) || true
  echo "machine id before: ${OLD_MACHINE_ID:-no answer}"
  echo "running ${OLD_VERSION:-no answer}; boot entries:"
  echo "${OLD_ENTRIES:-no answer}"
  if [ -z "$OLD_MACHINE_ID" ] || [ -z "$OLD_VERSION" ] || [ -z "$OLD_ENTRIES" ]; then
    verdict "factory-reset-before (could not read /etc/machine-id, IMAGE_VERSION or bootctl list)" 1
    return 1
  fi

  RC=0
  guest "printf 'factory-reset-test\n' > $MARK" || RC=1
  MARK_BACK=$(guest cat "$MARK" 2>/dev/null) || MARK_BACK=""
  [ "$MARK_BACK" = factory-reset-test ] || RC=1
  verdict "state-marker-written ($MARK is readable before the reset)" $RC
  [ "$RC" = 0 ] || return 1

  RESET_MARK=$(wc -c < "$SERIAL_LOG")
  PREV_BOOT_ID=$BOOT_ID
  echo "Requesting the reset: systemctl start factory-reset.target"
  # the target's systemd-factory-reset-reboot.service has SuccessAction=reboot, so this command
  # can end with the connection closing; the reset boot is what the wait below looks for
  guest systemctl start factory-reset.target 2>&1 || true
  if ! wait_for_ssh "$PREV_BOOT_ID"; then
    verdict "factory-reset-boot (no login with a new boot id before the timeout)" 1
    return 1
  fi
  echo "reset boot: $PREV_BOOT_ID -> $BOOT_ID"

  RESET_LOG="$WORKDIR/serial-reset.log"
  tail -c +"$((RESET_MARK + 1))" "$SERIAL_LOG" > "$RESET_LOG"

  # state-gone: the guest itself must say the marker is absent, so an ssh failure cannot pass
  PRESENT=$(guest "if [ -e $MARK ]; then echo present; else echo absent; fi" 2>/dev/null) || PRESENT=""
  RC=0; [ "$PRESENT" = absent ] || RC=1
  verdict "state-gone ($MARK: ${PRESENT:-no answer})" $RC

  # the machine id is the hardware's (the SMBIOS UUID; /etc is read-only), so a reset keeps it;
  # the machine's new identity is its host key, which the reset boot generates again
  NEW_MACHINE_ID=$(guest cat /etc/machine-id 2>/dev/null) || true
  RC=0
  { [ -n "$NEW_MACHINE_ID" ] && [ "$NEW_MACHINE_ID" = "$OLD_MACHINE_ID" ]; } || RC=1
  verdict "machine-id-kept ($OLD_MACHINE_ID -> ${NEW_MACHINE_ID:-no answer})" $RC
  NEW_HOSTKEY=$(guest cat "$HOSTKEY_PUB" 2>/dev/null) || true
  RC=0
  { [ -n "$OLD_HOSTKEY" ] && [ -n "$NEW_HOSTKEY" ] && [ "$NEW_HOSTKEY" != "$OLD_HOSTKEY" ]; } || RC=1
  verdict "hostkey-new (the reset boot generated another ssh host key)" $RC

  RC=0; grep -qi "Finished.*Generate var sshd-hostkey" "$RESET_LOG" || RC=1
  verdict "first-boot-rerun (the var units ran again on the reset boot)" $RC

  RC=0; grep -qi "Reached target.*Multi.User" "$RESET_LOG" || RC=1
  verdict "multi-user-after-reset (the reset boot reached multi-user.target)" $RC

  NEW_VERSION=$(guest_version)
  NEW_ENTRIES=$(guest bootctl list --no-pager 2>/dev/null \
    | sed -n 's/^[[:space:]]*id: //p' | sed 's/+[0-9]*-[0-9]*\.efi$/.efi/' | sort) || true
  echo "after the reset: running ${NEW_VERSION:-no answer}; boot entries:"
  echo "${NEW_ENTRIES:-no answer}"
  RC=0
  { [ -n "$NEW_ENTRIES" ] && [ "$NEW_ENTRIES" = "$OLD_ENTRIES" ] && [ "$NEW_VERSION" = "$OLD_VERSION" ]; } || RC=1
  verdict "slots-kept (bootctl list entries, ignoring the boot counter, and IMAGE_VERSION unchanged)" $RC

  echo ""
  echo "=== serial log of the reset boot (last 100 lines) ==="
  tail -100 "$RESET_LOG"
}

# --- the recovery paths of docs/design/bootloader.md, on a machine with two slots ---
test_recovery() {
  OLD_ENTRY=${IMAGE_ID}_${OLD_VERSION}.efi
  NEXT_ENTRY=${IMAGE_ID}_${NEXT_VERSION}.efi

  echo ""
  echo "=== recovery: bootctl list ==="
  L=$(guest bootctl list --no-pager 2>&1) || true
  echo "$L" | grep -E " (title|id|source|tries):" || true
  RC=0
  { echo "$L" | grep -q "id: $OLD_ENTRY" && echo "$L" | grep -q "id: $NEXT_ENTRY"; } || RC=1
  verdict "bootctl-list-both-slots" $RC

  echo ""
  echo "=== recovery: reinstall a damaged loader ==="
  guest "echo damaged > $ESP_REMOVABLE && sync"
  echo "$ESP_REMOVABLE damaged: $(guest_hash "$ESP_REMOVABLE")"
  RC=0
  guest /usr/lib/golconda/golconda-loader-update || RC=1
  [ "$(guest_hash "$ESP_REMOVABLE")" = "$(guest_hash "$USR_LOADER")" ] || RC=1
  verdict "loader-reinstall (golconda-loader-update by hand; the boots below start from it)" $RC

  echo ""
  echo "=== recovery: bootctl set-oneshot (the other slot, once) ==="
  guest bootctl set-oneshot "$OLD_ENTRY"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$OLD_VERSION" ] || RC=1
  verdict "set-oneshot-other-slot (running $V)" $RC
  # a blessed entry has no counter: bless-boot does not run, so golconda-loader-update does not
  # either, and the ESP keeps the newer release's loader
  LU=$(guest systemctl is-active golconda-loader-update.service 2>/dev/null) || true
  RC=0
  { [ "$LU" != active ] && [ "$(guest_hash "$ESP_REMOVABLE")" = "$NEW_LOADER" ]; } || RC=1
  verdict "other-slot-keeps-loader (golconda-loader-update.service: $LU)" $RC
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "oneshot-is-once (running $V)" $RC

  echo ""
  echo "=== recovery: bootctl set-default (the other slot, until cleared) ==="
  guest bootctl set-default "$OLD_ENTRY"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$OLD_VERSION" ] || RC=1
  verdict "set-default-other-slot (running $V)" $RC
  # ssh joins its arguments into one command line: the empty argument must be quoted there
  guest "bootctl set-default ''"
  reboot_guest || return 1
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "set-default-cleared (running $V)" $RC

  echo ""
  echo "=== recovery: the firmware menu ==="
  FW_MARK=$(wc -c < "$SERIAL_LOG")
  guest bootctl reboot-to-firmware true 2>&1 || true
  guest bootctl reboot-to-firmware 2>&1 || true
  guest systemctl reboot 2>&1 || true
  FW=1
  FW_WAIT=0
  while [ "$FW_WAIT" -lt 45 ] && qemu_running; do
    if tail -c +"$((FW_MARK + 1))" "$SERIAL_LOG" | grep -aq "EFI Firmware Setup"; then
      FW=0
      break
    fi
    FW_WAIT=$((FW_WAIT + 1))
    sleep 1
  done
  # OVMF draws its menu with cursor moves; the item texts are plain runs
  tail -c +"$((FW_MARK + 1))" "$SERIAL_LOG" \
    | grep -ao "Please select boot device:\|EFI Firmware Setup\|UEFI [A-Za-z0-9 ]*Device" | sort -u || true
  verdict "reboot-to-firmware (OVMF's boot menu on the serial console)" $FW
}

# db_certs LOG: the db certificates the kernel loaded, "<CN>: <key id>", one per line
db_certs() {
  tr -d '\033' < "$1" | grep -a "integrity: Loaded X.509 cert" \
    | sed "s/.*Loaded X.509 cert '\(.*\)'.*/\1/" | tr ' ' '_' | sort -u
}

# --- --rotate: db holds the new key only, dbx the old; boot the new chain, refuse the old ---
test_rotate() {
  echo ""
  echo "=== key rotation: db = the new certificate, dbx += the old one ==="
  stop_qemu
  virt-fw-vars --input "$VARS" --output "$VARS.new" \
    --delete db --add-db "$GUID" "$NEXT_KEYS/secureboot/db.crt" \
    --add-dbx-cert "$GUID" "$KEYS_DIR/secureboot/db.crt" 2>&1 | grep -v "^INFO: \\(reading\\|var store\\|writing\\)" || true
  mv "$VARS.new" "$VARS"

  SERIAL_LOG=$WORKDIR/serial-rotated.log
  SAVED_TIMEOUT=$TIMEOUT
  TIMEOUT=240
  start_qemu
  TIMEOUT=$SAVED_TIMEOUT
  if ! wait_for_ssh ""; then
    verdict "boots-after-rotation (no login before the timeout)" 1
    return 1
  fi
  V=$(guest_version)
  RC=0; [ "$V" = "$NEXT_VERSION" ] || RC=1
  verdict "boots-after-rotation (running $V)" $RC
  SB=$(guest bootctl status 2>&1 | grep "Secure Boot:") || true
  echo "$SB"
  RC=0; echo "$SB" | grep -q "enabled" || RC=1
  verdict "secure-boot-enabled-after-rotation" $RC
  # the kernel loads db into its .platform keyring, which the verity signature is checked
  # against, and logs each certificate
  BEFORE=$(db_certs "$FIRST_SERIAL_LOG")
  AFTER=$(db_certs "$SERIAL_LOG")
  echo "db certificates the kernel loaded before the rotation:"
  echo "$BEFORE"
  echo "after:"
  echo "$AFTER"
  RC=0
  [ -n "$AFTER" ] || RC=1
  [ "$(echo "$AFTER" | wc -l)" -lt "$(echo "$BEFORE" | wc -l)" ] || RC=1
  for c in $AFTER; do echo "$BEFORE" | grep -qxF "$c" || RC=1; done
  verdict "kernel-db-rotated (the kernel keeps the new certificate only)" $RC
  test_loader "after the rotation" 0
  FAILED=$(guest systemctl --failed --no-pager 2>&1) || true
  echo "$FAILED"
  RC=0; echo "$FAILED" | grep -q "^0 loaded units listed" || RC=1
  verdict "no-failed-units-after-rotation" $RC
  stop_qemu

  echo ""
  echo "=== negative control: the original disk under the rotated keys ==="
  OVERLAY=$WORKDIR/disk-original.qcow2
  SERIAL_LOG=$WORKDIR/serial-original.log
  TIMEOUT=45
  start_qemu
  TIMEOUT=$SAVED_TIMEOUT
  wait "$QEMU_PID" 2>/dev/null || true
  tr -d '\033' < "$SERIAL_LOG" | grep -a "Access Denied\|Linux version" | sort -u || true
  RC=0
  tr -d '\033' < "$SERIAL_LOG" | grep -aq "Access Denied" || RC=1
  ! grep -aq "Linux version" "$SERIAL_LOG" || RC=1
  verdict "old-loader-refused (dbx holds the old db certificate; no kernel started)" $RC
}

# --- second boot, TPM: the host key is unsealed, not regenerated ---
test_reboot() {
  echo ""
  echo "=== Reboot test (TPM credential unsealing) ==="
  echo "host key of the first boot: $(ssh-keygen -lf "$WORKDIR/known_hosts" 2>/dev/null)"

  # An attacker with root plants a confext directory on the state partition, so that it would
  # persist into every later boot's /etc (a unit, a pam.d file). systemd-confext merges
  # directories from /var/lib/confexts without any signature; the initrd must hide it. The plant
  # first undoes the guard mount at runtime, as root can.
  PLANT=/var/lib/confexts/boot-test-planted
  RC=0
  guest "systemd-umount /var/lib/confexts >/dev/null 2>&1; mkdir -p $PLANT/etc/extension-release.d && cp /etc/extension-release.d/extension-release.golconda $PLANT/etc/extension-release.d/extension-release.boot-test-planted && echo planted > $PLANT/etc/boot-test-planted && test -s $PLANT/etc/boot-test-planted" || RC=1
  verdict "confext-planted ($PLANT, a valid confext for this image and version)" $RC

  echo "Rebooting..."
  guest systemctl reboot 2>&1 || true

  if ! wait_for_ssh "$FIRST_BOOT_ID"; then
    verdict "ssh-after-reboot (no login before the timeout)" 1
    return 1
  fi
  verdict "ssh-after-reboot (boot id $FIRST_BOOT_ID -> $BOOT_ID)" 0

  # StrictHostKeyChecking=yes refuses a host key that is not the first boot's
  RC=0
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o UserKnownHostsFile="$WORKDIR/known_hosts" -o StrictHostKeyChecking=yes \
    -i "$WORKDIR/ssh/user" root@localhost true || RC=1
  verdict "hostkey-unchanged (unsealed from the TPM, not regenerated)" $RC

  ACTIVE=$(guest systemctl is-active sshd.service 2>&1) || true
  echo "sshd.service: $ACTIVE"
  RC=0; [ "$ACTIVE" = "active" ] || RC=1
  verdict "sshd-active-after-reboot" $RC

  echo "confexts merged: $(guest systemd-confext status 2>&1 | tr -s ' \n' ' ')"
  RC=0
  guest "test ! -e /etc/boot-test-planted" || RC=1
  guest systemd-confext status 2>&1 | grep -q boot-test-planted && RC=1
  verdict "confext-planted-refused (the planted confext did not reach /etc)" $RC

  echo ""
  echo "=== systemctl --failed (second boot) ==="
  guest systemctl --failed --no-pager 2>&1 || true
  return 0
}

# --- main ---
main() {
  echo "Boot test for: $DISK"
  echo "Keys: $KEYS_DIR"
  echo "Secure Boot: $SECURE_BOOT"
  echo "TPM: $TPM"
  echo "Factory reset: $FACTORY_RESET"
  echo "ESP credentials: $ESP_CREDS"
  echo "Timeout: ${TIMEOUT}s"
  echo "Work directory: $WORKDIR"
  echo ""

  if [ "$SECURE_BOOT" = 1 ]; then
    enroll_keys
  fi

  if [ "$TPM" = 1 ]; then
    start_tpm
  fi

  if [ "$SSH_TEST" = 1 ]; then
    setup_ssh_test
  fi

  if [ -n "$NEXT" ]; then
    if ! start_http_server; then
      exit 1
    fi
  fi

  start_qemu
  FIRST_SERIAL_LOG=$SERIAL_LOG
  RESULT=0
  wait_for_boot || RESULT=1
  if [ "$SSH_TEST" = 1 ]; then
    PASS=0
    FAIL=0
    test_ssh || RESULT=1
    if [ "$TPM" = 1 ] && [ "$RESULT" = 0 ]; then
      test_reboot || RESULT=1
    fi
    if [ "$FACTORY_RESET" = 1 ] && [ "$RESULT" = 0 ]; then
      test_factory_reset || RESULT=1
    elif [ -n "$NEXT" ] && [ "$RESULT" = 0 ]; then
      test_next || RESULT=1
    fi
    if [ "$ROTATE" = 1 ] && [ "$RESULT" = 0 ]; then
      test_rotate || RESULT=1
    fi
    SSH_PASS=$PASS
    SSH_FAIL=$FAIL
  fi
  stop_qemu
  # the markers are the first QEMU run's
  SERIAL_LOG=$FIRST_SERIAL_LOG

  echo ""
  echo "=== Serial log (last 100 lines) ==="
  tail -100 "$SERIAL_LOG"

  check_markers || RESULT=1

  if [ "$SSH_TEST" = 1 ]; then
    echo "SSH checks: PASS: $SSH_PASS, FAIL: $SSH_FAIL"
    if [ "$SSH_FAIL" -gt 0 ]; then
      RESULT=1
    fi
  fi

  if [ "$RESULT" = 0 ]; then
    KEEP_WORKDIR=0  # Clean up on success
    echo ""
    echo "=== ALL TESTS PASSED ==="
  else
    echo ""
    echo "=== SOME TESTS FAILED ==="
    echo "Serial log: $SERIAL_LOG"
  fi

  exit "$RESULT"
}

main
