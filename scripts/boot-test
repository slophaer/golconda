#!/bin/sh
# scripts/boot-test: VM boot test for Golconda images.
#
# Usage: boot-test <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS]
#                  [--ssh-test [--esp-creds | --imds]]
#                  [--next DIR [--rotate | --fail-health | --tamper-index]] [--factory-reset]
#
# The script boots the image in QEMU with:
#   - a 40 GiB qcow2 overlay (room for root partition)
#   - OVMF firmware (UEFI)
#   - optional Secure Boot with keys enrolled from --keys
#   - optional TPM 2.0 via swtpm
#   - SMBIOS type 11 credential: system.hostname=boot-test (not with --esp-creds or --imds)
#   - user-mode networking with hostfwd to SSH (127.0.0.1:$BOOT_TEST_SSH_PORT; without it, the
#     first free port from 10022 up, printed)
#   - serial console logged to a file
#
# --keys DIR: the throwaway keys directory (from image-smoke-test's keys symlink
#   or the path to golconda-throwaway-keys directly).
#
# QEMU runs in the background; the checks run while the guest is up, then the
# harness stops it. The harness waits for every required serial success marker.
#
# Markers checked (each prints PASS/FAIL, only on positive evidence):
#   - multi-user-reached: multi-user.target reached
#   - sshd-active: sshd.service started (Listening on port)
#   - var-sshd-hostkey: the host key var finished (it needs a writable root)
#   - boot-complete: boot-complete.target reached
#   - no-firstboot-prompt: systemd-firstboot.service finished, and no prompt appeared
#
# With --ssh-test: logs in with tests/fixtures/snakeoil-ssh and checks
#   ssh-login, hostname (must be "boot-test", the SMBIOS credential),
#   systemctl --failed (no failed units), varlinkctl list-interfaces, the loader, hwdb,
#   ipe-denies-copy (a copy of /usr/bin/sh in /var/tmp is refused, and IPE logs it), index-keyring.
#   With the test image it also logs in with certificates from tests/fixtures/snakeoil-user-ca
#   (cert-login, cert-wrong-principal-refused).
# With --next: before the update it pushes the host certificate (the guest's host key signed by
#   tests/fixtures/snakeoil-host-ca) and a revocation list with `golconda vars`
#   (packages.<system>.golconda-cli; set BOOT_TEST_GOLCONDA, and put age and age-keygen on PATH),
#   and the next release, which turns both on, must present the certificate, refuse the revoked
#   certificate, and take a second revocation list pushed while it runs.
# With --tpm: the host key is sealed to TPM2 and the signed PCR 11 policy; after a reboot, and
#   with --next after the update or --fail-health's fallback, it is the first boot's key, its
#   credential has the first boot's bytes, and sshd runs (hostkey-unchanged).
# With --esp-creds (needs --ssh-test): provisions through the ESP instead of SMBIOS and the image's
#   test key (docs/design/boot.md, "Bootstrap credentials"). The harness copies the disk into the
#   work directory, generates an ssh key pair there, and runs scripts/provision-esp on the copy with
#   --hostname esp-test and --authorized-keys <the new .pub>. It passes no SMBIOS hostname. The ssh
#   checks log in with the new key, hostname must be "esp-test", and esp-authorized-keys checks that
#   /root/.ssh/authorized_keys in the guest holds the new key. With --secure-boot and --tpm the
#   null-key credentials are refused (creds-util.c, relaxed policy): the run is expected to fail.
#   BOOT_TEST_ESP_NO_KEY=1 leaves the key out of the ESP (a negative control: the login must fail).
#   Without --imds, the ssh checks also check imds-import-inactive: the test image has /imds, and
#   QEMU's DMI names no cloud, so neither systemd-imds-early-network.service (only the generator
#   pulls it) nor systemd-imds-import.service ever starts.
# With --imds (needs --ssh-test; not with --esp-creds or --next): fakes Hetzner Cloud for /imds
#   (docs/features/provisioning.md), and the guest finds the endpoint as on Hetzner: by hwdb and
#   the image's own data, with no imds.* credential. SMBIOS type 0 says the BIOS vendor is Hetzner
#   (40-imds.hwdb matches dmi:bvnHetzner:*). QEMU's user network is 169.254.169.0/24 (not
#   10.0.2.0/24, so --next, whose update source is 10.0.2.2, cannot run with it), and a QEMU
#   guestfwd serves http://169.254.169.254/ on the guest's link from a stdio HTTP server in the work
#   directory, in Hetzner's layout: /hetzner/v1/metadata/hostname and the other keys,
#   /hetzner/v1/metadata/public-keys (a JSON array), /hetzner/v1/userdata. No system.hostname
#   credential is given. The server answers imds-test, and user data that lists the credentials
#   imds-canary, login.motd, ssh.authorized_keys.root (a key pair made in the work directory) and
#   network.network.60-imds-ipv6 (the static address 2001:db8:5eed::1/64, as Hetzner gives one:
#   QEMU's router advertisements name only fec0::/64). QEMU's DHCP server offers the host name
#   dhcp-test.
#   Checks: imds-hostname (systemd's import ran, pulled in by the generator, and the host name and
#   /etc/hostname are imds-test), imds-hetzner-layout (the guest has no imds.* credential, asked
#   for the host name and the user data at Hetzner's paths, and got no 404),
#   imds-ssh-key (the user data's key logs in; /root/.ssh/authorized_keys is 0600),
#   imds-userdata-credential (/run/credstore/imds-canary holds the value, and tmpfiles wrote
#   login.motd to /etc/motd.d), imds-ipv6 (the user data's .network file configures the link: it
#   has the global address 2001:db8:5eed::1), imds-dhcp-hostname (the lease holds dhcp-test,
#   /imds's UseHostname=no drop-in reaches 85-imds-early.network, and after a renewal the host
#   name is still imds-test) and imds-no-ordering-cycle (the import before sysinit.target made no
#   ordering cycle).
# With --secure-boot: boots OVMFFull and checks that the firmware enforces Secure Boot.
# With --ssh-test: also checks the boot loader (docs/design/bootloader.md): the ESP's two
#   copies of systemd-boot are the signed file in /usr, loader/loader.conf is the one
#   systemd-boot reads and the copy in /usr, golconda-loader-update.service ran after the boot
#   was blessed, and systemd-boot-update.service stayed off.
# With --next DIR (implies --ssh-test): DIR is the next release's image-smoke output
#   (DIR/disk/release, DIR/keys). The harness checks that release directory against
#   docs/design/releases.md (four SHA256SUMS lines, fixed order, digests match), resolves its
#   symlinks into $WORKDIR/http, serves that directory to the guest at 10.0.2.2:$BOOT_TEST_HTTP_PORT
#   (a QEMU guestfwd to a stdio HTTP server in $WORKDIR; no host port), and installs it with
#   systemd-sysupdate-update.service. The guest reads
#   its own /usr/lib/sysupdate.d/*.transfer (Type=url-file, Path=http://10.0.2.2:PORT/), so it
#   fetches SHA256SUMS and the artifacts over HTTP; the harness rewrites no definition. Then it
#   reboots into the release, and checks that golconda-loader-update.service put the new loader on
#   the ESP, that no /etc/systemd/system link names the old systemd store path or dangles
#   (golconda-etc-links.service), and that the updated system has no failed unit. Then the
#   recovery checks: bootctl list shows both slots, a damaged loader
#   is reinstalled by hand, `bootctl set-oneshot` and `bootctl set-default` boot the other slot
#   and back, and `bootctl reboot-to-firmware` reaches the firmware's menu.
# With --next DIR --fail-health: prove the three-boot fallback. The harness masks a health unit
#   in /etc, so boot-complete.target cannot be reached, the candidate is never blessed and every
#   boot of it loses one try. It reboots three times, checking after each that the counter fell,
#   then checks that the fourth boot runs the old release with the candidate at "tries: 0 left".
#   The mask is in /etc on the state partition, so it holds for every slot; the harness removes it
#   at the end. A mask instead of a cut link keeps every boot clean and ssh reachable.
#   This mode skips the loader and recovery checks: no boot of the candidate is blessed.
# With --next DIR --rotate: DIR is signed with a new db key. Its certificate is enrolled in db
#   beside the old one before the first boot; after the update the harness stops QEMU, rewrites
#   the variable store (db: the new certificate only; dbx: the old one), boots again and checks
#   the new chain, then boots the original disk with the rotated store, which firmware must
#   refuse.
# With --factory-reset (needs --ssh-test and the test image; a boot of its own): writes a marker
#   in /etc, reads /etc/machine-id, runs `systemctl start factory-reset.target` in the guest and
#   waits for the reset boot. It checks that the marker is gone (state-gone), the machine id
#   changed (machine-id-new), first boot ran again and multi-user.target was reached
#   (first-boot-rerun, multi-user-after-reset), and that bootctl list still shows the same entries
#   (slots-kept). The reset rewrites the root partition only; the ESP and the /usr slots stay.
#   It prints the serial log of the reset boot. The mode is two boots (the first boot and the
#   reset boot), so give a --timeout large enough, such as 480, and do not combine it with --next.
# With --next DIR --tamper-index: the signed index's negative control. The server sends SHA256SUMS
#   with one byte added, so its signature (SHA256SUMS.gpg) no longer matches, and the run passes
#   when the update is refused: index-signed (the guest fetched the signature), sysupdate-refused
#   (the service failed, its journal names the signature check and no install, and the next
#   release is on neither a partition nor the ESP), boots-old (after a reboot the old release
#   still runs), hostkey-unchanged with --tpm and no-failed-units-after-refused-update. It skips
#   http-fetch, sysupdate-installed and every check that needs the installed release. An update
#   that installs, or any other failure, fails the run.
# BOOT_TEST_HTTP_PORT: the port the guest uses for the release server (default 8074): the test
#   image's updateSource is http://10.0.2.2:8074/, so another port needs an image built for it.
#   It is a guest-side address only; runs at the same time all use 8074.
# BOOT_TEST_CACHE: where the work directories are (default ${XDG_CACHE_HOME:-$HOME/.cache}/
#   golconda-boot-test, run.XXXXXX). A run that passes removes its directory; one that fails keeps
#   it, with the serial logs and the guest's journals, and prints its path.
# Runs at the same time: every run has its own work directory (mktemp), its own ssh port (a flock
#   in $BOOT_TEST_PORT_LOCKS, default $XDG_RUNTIME_DIR/boot-test-ports-UID), swtpm socket, firmware
#   variables, disk overlay and keys, and its own update server; nothing else is shared.
# BOOT_TEST_STORE_ROOT: the root of a chroot store (nix --store 'local?root=DIR'); a symlink
#   into /nix/store under DIR is followed there.
# With --ssh-test --tpm: also checks that the host key is sealed with the TPM
#   (credential header), reboots the guest in the same QEMU (swtpm keeps its
#   state) and checks the second boot: a new boot id, sshd active, the same
#   host key (unsealed, not regenerated).
#
# Exit: 0 if all markers pass, 1 otherwise.
#
# The files: this one has the usage above, the bootstrap, the command line, the work directory,
# the firmware (the only place that names the nixpkgs pin, docs/design/principles.md) and main.
# It sources the parts beside it:
#   boot-test-log.sh     the serial markers and check_markers
#   boot-test-vm.sh      Secure Boot keys, swtpm, the guest's credentials, QEMU
#   boot-test-http.sh    the update server (--next), the fake IMDS endpoint (--imds)
#   boot-test-guest.sh   ssh, wait_for_ssh, verdict, guest_hash, reboot_guest
#   boot-test-checks.sh  the shared checks (one function each; every mode calls them)
#   boot-test-modes.sh   the first boot's ssh checks, the TPM reboot, --factory-reset
#   boot-test-update.sh  --next: the update, --fail-health, the recovery paths, --rotate

set -eu

# --- bootstrap: re-exec under nix-shell if tools are missing ---
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "$0")")"
  REPO_DIR="$(dirname "$SCRIPT_DIR")"
  # Get the dev pin path from pins/nixpkgs-dev-only via nix-instantiate
  DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/pins).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
  if [ -z "$DEV_PIN" ] || [ ! -d "$DEV_PIN" ]; then
    echo "Error: cannot find nixpkgs-dev-only pin" >&2
    exit 1
  fi
  exec nix-shell -I "nixpkgs=$DEV_PIN" -p qemu OVMF swtpm openssh python3 python3Packages.virt-firmware --run "$0 $*"
fi

SCRIPT_DIR="$(dirname "$(realpath "$0")")"

# the work directories of all runs, and scripts/verify's logs: not /tmp, whose contents a queue task
# or a reboot may drop with the logs of a failed run
BOOT_TEST_CACHE=${BOOT_TEST_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/golconda-boot-test}

# --- argument parsing ---
# SSH_PORT, the host port for the guest's sshd, is claimed below (claim_ssh_port)
# the guest's port for the release HTTP server: the test image's updateSource uses 8074
HTTP_PORT=${BOOT_TEST_HTTP_PORT:-8074}
DISK=""
KEYS_DIR=""
SECURE_BOOT=0
TPM=0
TIMEOUT=120
SSH_TEST=0
NEXT=""
ROTATE=0
FAIL_HEALTH=0
TAMPER_INDEX=0
FACTORY_RESET=0
ESP_CREDS=0
IMDS=0
# --imds: QEMU's user network, Hetzner's metadata address on it, and the user data's IPv6 address
# and .network credential (boot-test-http.sh serves them; no host port is opened)
IMDS_NET=169.254.169.0/24
IMDS_ADDR=169.254.169.254
IMDS_IPV6=2001:db8:5eed::1
IMDS_NET_CRED=60-imds-ipv6

# the parts: functions and constants, no processes start when they are sourced; boot-test-guest.sh
# reads SSH_PORT above
# shellcheck source=boot-test-log.sh
. "$SCRIPT_DIR/boot-test-log.sh"
# shellcheck source=boot-test-vm.sh
. "$SCRIPT_DIR/boot-test-vm.sh"
# shellcheck source=boot-test-http.sh
. "$SCRIPT_DIR/boot-test-http.sh"
# shellcheck source=boot-test-guest.sh
. "$SCRIPT_DIR/boot-test-guest.sh"
# shellcheck source=boot-test-checks.sh
. "$SCRIPT_DIR/boot-test-checks.sh"
# shellcheck source=boot-test-modes.sh
. "$SCRIPT_DIR/boot-test-modes.sh"
# shellcheck source=boot-test-update.sh
. "$SCRIPT_DIR/boot-test-update.sh"

usage() {
  echo "Usage: $0 <disk.raw> --keys DIR [--secure-boot] [--tpm] [--timeout SECONDS] [--ssh-test [--esp-creds | --imds]] [--next DIR [--rotate | --fail-health | --tamper-index]] [--factory-reset]"
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --keys) KEYS_DIR="$2"; shift 2 ;;
    --secure-boot) SECURE_BOOT=1; shift ;;
    --tpm) TPM=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --ssh-test) SSH_TEST=1; shift ;;
    --next) NEXT="$2"; SSH_TEST=1; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --fail-health) FAIL_HEALTH=1; shift ;;
    --tamper-index) TAMPER_INDEX=1; shift ;;
    --factory-reset) FACTORY_RESET=1; shift ;;
    --esp-creds) ESP_CREDS=1; shift ;;
    --imds) IMDS=1; shift ;;
    --help|-h) usage ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      ;;
    *)
      if [ -z "$DISK" ]; then
        DISK="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
      fi
      shift
      ;;
  esac
done

if [ -z "$DISK" ]; then
  echo "Error: disk image required" >&2
  usage
fi

if [ ! -f "$DISK" ]; then
  echo "Error: disk image not found: $DISK" >&2
  exit 1
fi

if [ -z "$KEYS_DIR" ]; then
  echo "Error: --keys DIR required" >&2
  usage
fi

if [ ! -d "$KEYS_DIR" ]; then
  echo "Error: keys directory not found: $KEYS_DIR" >&2
  exit 1
fi


if [ "$ESP_CREDS" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --esp-creds needs --ssh-test: the checks log in with the generated key" >&2
  exit 1
fi
if [ "$IMDS" = 1 ] && { [ "$SSH_TEST" = 0 ] || [ "$ESP_CREDS" = 1 ] || [ -n "$NEXT" ]; }; then
  echo "Error: --imds needs --ssh-test (the checks run over ssh), excludes --esp-creds (both set the host name and the root key) and --next (its network has no 10.0.2.2, the update source)" >&2
  exit 1
fi
if [ "$IMDS" = 1 ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to serve the fake IMDS endpoint, and it is not on PATH" >&2
    exit 1
  fi
fi
if [ "$FACTORY_RESET" = 1 ] && [ "$SSH_TEST" = 0 ]; then
  echo "Error: --factory-reset needs --ssh-test: the reset is requested over ssh, and only the test image carries the test key" >&2
  exit 1
fi
if [ "$FACTORY_RESET" = 1 ] && { [ -n "$NEXT" ] || [ "$ROTATE" = 1 ] || [ "$FAIL_HEALTH" = 1 ]; }; then
  echo "Error: --factory-reset is a boot of its own; do not combine it with --next, --rotate or --fail-health" >&2
  exit 1
fi

if [ "$FAIL_HEALTH" = 1 ] && [ -z "$NEXT" ]; then
  echo "Error: --fail-health needs --next" >&2
  exit 1
fi
if [ "$TAMPER_INDEX" = 1 ] && { [ -z "$NEXT" ] || [ "$FAIL_HEALTH" = 1 ] || [ "$ROTATE" = 1 ]; }; then
  echo "Error: --tamper-index needs --next, and the update never installs: not with --fail-health or --rotate" >&2
  exit 1
fi
if [ "$ROTATE" = 1 ] && { [ -z "$NEXT" ] || [ "$SECURE_BOOT" = 0 ]; }; then
  echo "Error: --rotate needs --next and --secure-boot" >&2
  exit 1
fi
if [ -n "$NEXT" ]; then
  NEXT_RELEASE=$(real_path "$NEXT/disk")/release
  NEXT_KEYS=$(real_path "$NEXT/keys")
  if [ ! -f "$NEXT_RELEASE/SHA256SUMS" ] || [ ! -f "$NEXT_KEYS/secureboot/db.crt" ]; then
    echo "Error: $NEXT has no disk/release/SHA256SUMS or keys/secureboot/db.crt" >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required to serve $NEXT_RELEASE over HTTP, and it is not on PATH" >&2
    exit 1
  fi
  # the next release reads the host certificate and the revocation list: the harness pushes them
  # with `golconda vars` and age, as an operator would (docs/design/trust.md)
  GOLCONDA=${BOOT_TEST_GOLCONDA:-golconda}
  for tool in "$GOLCONDA" age age-keygen ssh-keygen; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Error: --next pushes admin vars with $tool, and it is not on PATH (BOOT_TEST_GOLCONDA names the golconda binary)" >&2
      exit 1
    fi
  done
fi

# --- working directory ---
mkdir -p "$BOOT_TEST_CACHE"
WORKDIR=$(mktemp -d "$BOOT_TEST_CACHE/run.XXXXXX")
KEEP_WORKDIR=1  # Keep on failure

cleanup() {
  if [ -n "${QEMU_PID:-}" ]; then
    kill "$QEMU_PID" 2>/dev/null || true
  fi
  if [ -n "${SWTPM_PID:-}" ]; then
    kill "$SWTPM_PID" 2>/dev/null || true
  fi
  if [ "$KEEP_WORKDIR" = 0 ]; then
    rm -rf "$WORKDIR"
  else
    echo "Work directory kept: $WORKDIR"
  fi
}
trap cleanup EXIT

# QEMU's -netdev option is split at commas and spaces
case $WORKDIR in
  *[,\ ]*) echo "Error: the work directory $WORKDIR has a comma or a space; set BOOT_TEST_CACHE" >&2; exit 1 ;;
esac
claim_ssh_port
init_ssh_opts

# --- prepare disk overlay ---
OVERLAY="$WORKDIR/disk.qcow2"
SERIAL_LOG="$WORKDIR/serial.log"
QEMU_OUT="$WORKDIR/qemu.out"
VARS="$WORKDIR/vars.fd"

# --- find OVMF ---
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
DEV_PIN=$(nix-instantiate --eval -E "(import $REPO_DIR/pins).nixpkgs-dev-only" 2>/dev/null | tr -d '"')
# OVMF.fd has neither Secure Boot nor TPM support. OVMFFull.fd has both, and it is
# built with SMM, so QEMU gets smm=on below. --tpm needs the TPM measurement, or
# systemd-stub does not pass the UKI's PCR public key on and credentials are sealed
# without the signed PCR 11 policy. --secure-boot needs a firmware that enforces.
OVMF_ATTR=OVMF.fd
if [ "$TPM" = 1 ] || [ "$SECURE_BOOT" = 1 ]; then
  OVMF_ATTR=OVMFFull.fd
fi
OVMF_DIR=$(nix-build -I "nixpkgs=$DEV_PIN" '<nixpkgs>' -A "$OVMF_ATTR" --no-out-link 2>/dev/null)/FV

if [ ! -d "$OVMF_DIR" ]; then
  echo "Error: cannot find OVMF.fd" >&2
  exit 1
fi

cp "$OVMF_DIR/OVMF_VARS.fd" "$VARS"
chmod u+w "$VARS"


# --- main ---
main() {
  echo "Boot test for: $DISK"
  echo "Keys: $KEYS_DIR"
  echo "Secure Boot: $SECURE_BOOT"
  echo "TPM: $TPM"
  echo "Factory reset: $FACTORY_RESET"
  echo "ESP credentials: $ESP_CREDS"
  echo "IMDS: $IMDS"
  echo "Timeout: ${TIMEOUT}s"
  echo "Work directory: $WORKDIR"
  echo ""

  if [ "$SECURE_BOOT" = 1 ]; then
    enroll_keys
  fi

  if [ "$TPM" = 1 ]; then
    start_tpm
  fi

  if [ "$SSH_TEST" = 1 ]; then
    setup_ssh_test
    setup_certs
  fi

  if [ -n "$NEXT" ]; then
    if ! start_http_server; then
      exit 1
    fi
  fi
  if [ "$IMDS" = 1 ]; then
    start_imds_server || exit 1
  fi

  start_qemu
  FIRST_SERIAL_LOG=$SERIAL_LOG
  RESULT=0
  wait_for_boot || RESULT=1
  if [ "$SSH_TEST" = 1 ]; then
    PASS=0
    FAIL=0
    test_ssh || RESULT=1
    if [ "$TPM" = 1 ] && [ "$RESULT" = 0 ]; then
      test_reboot || RESULT=1
    fi
    if [ "$FACTORY_RESET" = 1 ] && [ "$RESULT" = 0 ]; then
      test_factory_reset || RESULT=1
    elif [ -n "$NEXT" ] && [ "$RESULT" = 0 ]; then
      test_next || RESULT=1
    fi
    if [ "$ROTATE" = 1 ] && [ "$RESULT" = 0 ]; then
      test_rotate || RESULT=1
    fi
    SSH_PASS=$PASS
    SSH_FAIL=$FAIL
  fi
  stop_qemu
  # the markers are the first QEMU run's
  SERIAL_LOG=$FIRST_SERIAL_LOG

  echo ""
  echo "=== Serial log (last 100 lines) ==="
  tail -100 "$SERIAL_LOG"

  check_markers || RESULT=1

  if [ "$SSH_TEST" = 1 ]; then
    echo "SSH checks: PASS: $SSH_PASS, FAIL: $SSH_FAIL"
    if [ "$SSH_FAIL" -gt 0 ]; then
      RESULT=1
    fi
  fi

  if [ "$RESULT" = 0 ]; then
    KEEP_WORKDIR=0  # Clean up on success
    echo ""
    echo "=== ALL TESTS PASSED ==="
  else
    echo ""
    echo "=== SOME TESTS FAILED ==="
    echo "Serial log: $SERIAL_LOG"
  fi

  exit "$RESULT"
}

main
