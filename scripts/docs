#!/bin/sh
# Write the generated module pages (docs/reference/modules/generated/, not
# committed), then build the book, or serve it with `scripts/docs serve`.
# Run from anywhere, inside the dev shell.
set -eu
cd "$(dirname "$0")/.."
out=docs/reference/modules/generated
mkdir -p "$out"
for f in $(iets eval --raw -E 'builtins.concatStringsSep " " (builtins.attrNames (import ./default.nix).docs-pages)'); do
  iets eval --raw -E "(import ./default.nix).docs-pages.\"$f\"" > "$out/$f"
done
exec mdbook "${1:-build}" docs
