#!/bin/sh
# Write the generated module pages (docs/reference/modules/generated/, not
# committed), check that the module list in the committed docs/SUMMARY.md is
# current, then build the book, or serve it with `scripts/docs serve`. Run from
# anywhere, inside the dev shell (iets). mdbook and its diagram preprocessor are ours
# (packages/mdbook, packages/mdbook-pele), through scripts/tools.sh.
set -eu
cd "$(dirname "$0")/.."
. scripts/tools.sh
PATH="$(tools_path . mdbook mdbook-pele):$PATH"
out=docs/reference/modules/generated
# Delete the old pages first: a removed module's page must not linger in the book.
rm -rf "$out"
mkdir -p "$out"

# Write the generated module and type pages
for f in $(iets eval --raw -E 'builtins.concatStringsSep " " (builtins.attrNames (import ./default.nix).docs-pages)'); do
  iets eval --raw -E "(import ./default.nix).docs-pages.\"$f\"" > "$out/$f"
done

# docs/SUMMARY.md is committed. Only its module list follows the modules, so fail
# with a diff when a module was added or removed and the list was not updated.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
iets eval --raw -E '(import ./default.nix).docs-summary' > "$tmp/want"
grep 'reference/modules/generated/' docs/SUMMARY.md > "$tmp/have" || true
if ! diff -u "$tmp/have" "$tmp/want"; then
  echo "docs/SUMMARY.md: replace its lines that link reference/modules/generated/ with the + lines above" >&2
  exit 1
fi
rm -rf "$tmp"

exec mdbook "${1:-build}" docs
