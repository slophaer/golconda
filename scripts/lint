#!/bin/sh
# Strict evaluation lint with iets (levels in iets.toml), then the sandboxed
# checks. Run from the repo root, inside the dev shell.
#
# eval-jobs walks the derivation outputs; the adios tree under `modules` is not
# a set of derivations (and recursing into it does not terminate), so it is
# exercised by the pure-Nix module tests in nix/tests.nix instead.
set -eu
cd "$(dirname "$0")/.."
# A /nix/store literal in modules/ or lib/ is a relocation bug: the image's store is
# /usr/nix/store and a store path comes from a derivation, never from typed text.
# `/usr/nix/store` and `$out/nix/store` are relative to something, so a preceding word
# character or `)` excuses them; a comment line and a line marked `store-path-ok` pass.
if hits=$(grep -rnE '(^|[^A-Za-z0-9_)])/nix/store' modules lib --include='*.nix' --include='*.nu' \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' | grep -v 'store-path-ok'); then
  echo "lint: /nix/store literal (a relocation bug; take paths from derivations, or mark the line 'store-path-ok'):" >&2
  echo "$hits" >&2
  exit 1
fi
# Leftover merge conflicts, also in the shapes treefmt leaves when it reformats the
# markers (escaped `\<<`, spaced `> > >`).
if hits=$(git ls-files -z | xargs -0 grep -nE \
  '^(<{7}|={7}$|>{7}|[|]{7})|\\<<\\<<|^(> ){6}>|parent of [0-9a-f]{7} ' 2>/dev/null); then
  echo "lint: merge conflict markers:" >&2
  echo "$hits" >&2
  exit 1
fi
# eval-jobs prints one JSON line per job and exits 0 even when jobs failed (a lint finding is
# an error): fail on any job that carries one
jobs=$(iets eval-jobs --force-recurse --no-instantiate \
  --expr 'let f = import ./default.nix; in { inherit (f) packages checks devShells formatter; }')
if failed=$(printf '%s\n' "$jobs" | grep '"error":'); then
  echo "lint: eval-jobs reported errors:" >&2
  printf '%s\n' "$failed" | head -20 >&2
  exit 1
fi
iets eval --expr 'import ./nix/tests.nix { }' > /dev/null
# The eval tests read packages as data only (tests/eval/harness.nix): again in restricted
# read-only mode, where only this tree and the adios pin can be read, so a test that brings a
# real package (the repkgs pin, a store path) back fails here. tests/real-packages has those.
adios=$(sed -n 's|^url = "\(.*/\)archive/.*|\1|p' pins/adios/sources.toml)
nix-instantiate --readonly-mode --option restrict-eval true --option allowed-uris "$adios" \
  -I golconda="$PWD" --eval --strict -E 'import <golconda/nix/tests.nix> { }' > /dev/null
# configuration errors must carry their message (tests/errors/run.sh)
tests/errors/run.sh
# scripts/make-keys: layout, modes, certificate extensions (builds its tools through the daemon)
tests/make-keys/run.sh
# the flake template: `nix flake update golconda` moves the lock, and the flake evaluates (no build)
tests/flake-template/run.sh
# The pinned iets cannot resolve outputs of dynamic package-test derivations.
# Keep its strict evaluation above; the patched Nix client builds native checks.
# --keep-going: every check runs. Without it nix stops at the first failing check, cancels the
# others, and its last error names them all as failed (a cancelled check-boot-log looked flaky).
# The output is kept, so a failure ends with the names of the checks whose builder failed.
log=$(mktemp)
trap 'rm -f "$log" "$log.rc"' EXIT
{
  rc=0
  nix-build --keep-going --no-out-link --expr '(import ./default.nix).checks.${builtins.currentSystem}' 2>&1 || rc=$?
  echo "$rc" >"$log.rc"
} | tee "$log"
rc=$(cat "$log.rc")
if [ "$rc" != 0 ]; then
  # nix: "error: Cannot build '/nix/store/<hash>-check-NAME.drv'.", then "Reason: builder failed"
  failed=$(awk '/Cannot build .*\.drv/ { d = $0; next } d != "" && /Reason: builder failed/ { print d } { d = "" }' "$log" |
    sed "s|.*/nix/store/[a-z0-9]*-\([^']*\)\.drv.*|\1|" | sort -u)
  echo "lint: the checks whose builder failed (their logs are above):" >&2
  printf '%s\n' "${failed:-(none found; read the nix errors above)}" | sed 's/^/  /' >&2
  exit "$rc"
fi
