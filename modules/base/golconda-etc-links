#!/usr/bin/sh
# golconda-etc-links: rewrite the enable links under /etc/systemd/system to the
# stable /usr/lib/systemd/system/<unit> path, so they survive a systemd store
# path change in an update.
#
# PID 1 runs `preset-all` when /etc is empty (first boot) and writes links such
# as /etc/systemd/system/multi-user.target.wants/getty@tty1.service with the
# absolute target /usr/nix/store/<hash>-systemd/lib/systemd/system/getty@.service.
# An update replaces /usr, including systemd and its store path, so those links
# dangle after the update, and PID 1 then fails to load every unit they name.
# golconda-etc-links.service runs it in the initrd, in the switch-root
# transaction after /sysroot/usr is mounted, so the next PID 1 starts with the
# rewritten links. Service environments may have no PATH, so every command is
# absolute.
#
# $1 (or GOLCONDA_ROOT) is the root to edit; empty or / for the running system.
# The unit test uses GOLCONDA_ROOT.
#
# It only rewrites a link when the target is absolute and the target's file name
# exists below <root>/usr/lib/systemd/system. Masks (/dev/null), links inside
# /etc and relative links stay as they are.
#
# Each rewrite is printed. A link it cannot read or rewrite is named on stderr,
# the other links are still rewritten, and the script exits 1, so the unit
# fails and the journal says which link failed.
set -u

root="${1:-${GOLCONDA_ROOT:-}}"
[ "$root" = "/" ] && root=""

# The service environment may have no PATH; the image has both at /usr/bin. The
# test runs on a host that may not, so fall back to PATH there.
readlink=/usr/bin/readlink
ln=/usr/bin/ln
[ -x "$readlink" ] || readlink=readlink
[ -x "$ln" ] || ln=ln
etc="$root/etc/systemd/system"
unitdir="$root/usr/lib/systemd/system"
failed=0

[ -d "$etc" ] || exit 0

rewrite() {
  link="$1"
  [ -L "$link" ] || return 0

  if ! target="$("$readlink" "$link")"; then
    echo "golconda-etc-links: cannot read the link $link" >&2
    failed=1
    return 0
  fi
  case "$target" in
    /dev/null|/etc/*|/run/*|/usr/local/*) return 0 ;; # a mask or an admin unit: leave it
    /*) ;;
    *) return 0 ;; # relative: it names something inside /etc, not a store path
  esac

  name="${target##*/}"
  [ -e "$unitdir/$name" ] || return 0

  stable="/usr/lib/systemd/system/$name"
  [ "$target" = "$stable" ] && return 0

  if "$ln" -sfn "$stable" "$link"; then
    echo "golconda-etc-links: $link: $target -> $stable"
  else
    echo "golconda-etc-links: cannot rewrite $link from $target to $stable" >&2
    failed=1
  fi
}

# The directories PID 1 and `systemctl enable` write: the unit directory itself
# (aliases) and the .wants/.requires/.upholds directories below it.
for dir in "$etc" "$etc"/*.wants "$etc"/*.requires "$etc"/*.upholds; do
  [ -d "$dir" ] || continue
  for link in "$dir"/*; do
    [ -L "$link" ] || continue
    rewrite "$link"
  done
done

exit "$failed"
