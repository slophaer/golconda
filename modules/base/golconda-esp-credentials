#!/bin/sh
# golconda-esp-credentials: remove the bootstrap credentials from the ESP once this boot imported
# them (docs/design/boot.md, "Bootstrap credentials").
#
# The ESP is neither encrypted nor signed, so a credential left there grants again what it
# granted once, such as root's ssh key after a factory reset. An ESP credential holds for one
# boot. The service runs after the units that apply the first boot's credentials (systemd-firstboot,
# systemd-sysusers, systemd-tmpfiles-setup), which write to the state partition what must outlive
# the boot; this boot keeps its copies in /run/credentials. It logs each file it removes.
# GOLCONDA_ESP overrides the ESP's path, for the test (tests/esp-credentials).
set -eu

if [ -n "${GOLCONDA_ESP:-}" ]; then
  esp=$GOLCONDA_ESP
elif ! esp=$(bootctl --print-esp-path 2>/dev/null); then
  echo "no ESP found: nothing to remove"
  exit 0
fi

removed=0
for f in "$esp"/loader/credentials/*.cred "$esp"/EFI/Linux/*.extra.d/*.cred; do
  [ -f "$f" ] || continue
  rm -f "$f"
  echo "removed ${f#"$esp"/} from the ESP"
  removed=$((removed + 1))
done
if [ "$removed" -gt 0 ]; then
  sync
fi
echo "$removed bootstrap credential(s) removed from the ESP"
