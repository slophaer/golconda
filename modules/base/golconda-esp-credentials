#!/bin/sh
# golconda-esp-credentials: remove the bootstrap credentials from the ESP once this boot imported
# them (docs/design/boot.md, "Bootstrap credentials").
#
# systemd-stub passes every loader/credentials/*.cred, and every *.cred beside a UKI in its
# <uki>.extra.d/, to the initrd at every boot, and PID 1 imports them. The ESP is not encrypted
# and not signed: a credential left there grants again what it granted once, such as root's ssh
# key after a factory reset or on a machine that moved to certificates, and whoever can write the
# ESP can put one there. So an ESP credential holds for one boot: golconda-esp-credentials.service
# runs this after the units that apply the first boot's credentials (systemd-firstboot,
# systemd-sysusers, systemd-tmpfiles-setup), and the next boot imports none. What must outlive the
# boot is written to the state partition by then: /etc/hostname (from firstboot.hostname),
# /root/.ssh/authorized_keys. This boot keeps its copies in /run/credentials.
#
# It logs each file it removes. GOLCONDA_ESP overrides the ESP's path (bootctl --print-esp-path),
# for the test (tests/esp-credentials).
set -eu

if [ -n "${GOLCONDA_ESP:-}" ]; then
  esp=$GOLCONDA_ESP
elif ! esp=$(bootctl --print-esp-path 2>/dev/null); then
  echo "no ESP found: nothing to remove"
  exit 0
fi

removed=0
for f in "$esp"/loader/credentials/*.cred "$esp"/EFI/Linux/*.extra.d/*.cred; do
  [ -f "$f" ] || continue
  rm -f "$f"
  echo "removed ${f#"$esp"/} from the ESP"
  removed=$((removed + 1))
done
if [ "$removed" -gt 0 ]; then
  sync
fi
echo "$removed bootstrap credential(s) removed from the ESP"
