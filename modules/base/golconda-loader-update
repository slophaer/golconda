#!/bin/sh
# golconda-loader-update: put this release's signed systemd-boot and loader.conf on the ESP, and
# remove the Secure Boot enrolment files once Secure Boot is on.
#
# golconda-loader-update.service runs it after systemd-bless-boot.service has marked a counted
# boot good, so only a release that booted and passed the health gate installs its loader. An
# administrator runs it by hand to reinstall a damaged loader (docs/design/bootloader.md).
#
# It compares content, not versions: a release signed with a new db key carries the same
# systemd-boot version in other bytes, which `bootctl update` skips. The firmware has just
# accepted this release's UKI, and the image builder signs the loader in /usr with the same key
# (lib/image/loader.nix), so the loader it writes is one this firmware starts.
#
# Each file is copied beside its destination, flushed and renamed over it. The previous primary
# copy stays as EFI/systemd/systemd-boot-fallback<arch>.efi, the name bootctl uses, for a start
# from the firmware's boot menu.
set -eu

src=
for f in /usr/lib/systemd/boot/efi/systemd-boot*.efi.signed; do src=$f; done
if [ ! -f "$src" ]; then
  echo "no signed systemd-boot in /usr/lib/systemd/boot/efi" >&2
  exit 1
fi
conf=/usr/lib/golconda/loader.conf
name=${src##*/}
name=${name%.signed} # systemd-bootx64.efi
arch=${name#systemd-boot}
arch=${arch%.efi} # x64
# the removable-media name (lib/image/disk.nix removableMediaName)
case $arch in
  x64) removable=BOOTX64.EFI ;;
  aa64) removable=BOOTAA64.EFI ;;
  riscv64) removable=BOOTRISCV64.EFI ;;
  *)
    echo "no removable-media name for $arch" >&2
    exit 1
    ;;
esac
esp=$(bootctl --print-esp-path)

same() {
  [ -f "$2" ] && [ "$(sha256sum <"$1")" = "$(sha256sum <"$2")" ]
}

# put SRC DEST: DEST gets SRC's content, or stays as it is when it has it already
put() {
  if same "$1" "$2"; then
    echo "$2: up to date"
    return 0
  fi
  mkdir -p "${2%/*}"
  cp "$1" "$2.new"
  sync
  mv -f "$2.new" "$2"
  sync
  echo "$2: installed from $1"
}

primary=$esp/EFI/systemd/$name
if [ -f "$primary" ] && ! same "$src" "$primary"; then
  put "$primary" "$esp/EFI/systemd/systemd-boot-fallback$arch.efi"
fi
put "$src" "$primary"
# the file firmware starts: last, so an interrupted run leaves it whole
put "$src" "$esp/EFI/BOOT/$removable"
put "$conf" "$esp/loader/loader.conf"

# The first disk's ESP carries the Secure Boot enrolment files and a loader.conf armed to enrol
# them (image/loader.nix firstConf); the line above disarmed it. Once the firmware enforces
# Secure Boot the files have done their work: remove them, so nothing on the ESP is left to
# enrol. Without Secure Boot they stay, unread.
auto=$esp/loader/keys/auto
# The SecureBoot variable: 4 bytes of attributes, then 1 when Secure Boot is on. Read whole:
# efivarfs reports size 0 and cannot seek, so `od -j` fails there.
secure_boot_on() {
  # shellcheck disable=SC2046 # one word per byte
  set -- $(od -An -tu1 </sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null)
  [ "${5:-}" = 1 ]
}
if [ -d "$auto" ] && secure_boot_on; then
  rm -rf "$auto"
  rmdir "$esp/loader/keys" 2>/dev/null || true
  sync
  echo "$auto: removed (Secure Boot is on)"
fi
