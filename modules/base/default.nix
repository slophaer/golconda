#! The base system: what every Golconda image contains.
#!
#! Always implicit, with `/network` and `/security`: `/system` merges this
#! fragment first, before any other module's fragment. A configuration need
#! not declare it.
#!
#! Packages: systemd, dbus-broker, dash (linked as /usr/bin/sh; the image
#! has no bash), uutils-coreutils, tpm2-tss (only systemd's dlopen reaches
#! it), e2fsprogs (mkfs.ext4 and fsck.ext4 for the root partition systemd-repart
#! makes at first boot), cacert (Mozilla's roots, one bundle), tzdata
#! (/usr/share/zoneinfo) and the kernel (consumed later by the UKI builder).
#! No GNU coreutils.
#!
#! Units enabled: dbus.socket (wanted by sockets.target), dbus-broker.service
#! (as the dbus.service alias), systemd-networkd, systemd-resolved,
#! systemd-timesyncd. The `dbus.socket` unit is written as a file, not as a
#! typed unit: dbus-broker does not ship it.
#!
#! Boot health: `golconda-health-network.service` fails unless networkd has a
#! link with a routable address, and boot-complete.target requires it (the
#! `.requires` link) and is ordered after it. A candidate that boots without a
#! usable network therefore does not reach boot-complete.target and is not
#! blessed (docs/design/boot.md).
#!
#! Links, besides the `/usr/bin` links of the packages' `bin` lists:
#! - farm links for systemd's own directories (`/usr/lib/systemd`,
#!   `/usr/lib/udev`, `/usr/lib/sysusers.d`, `/usr/lib/tmpfiles.d`);
#! - dlopen links: every soname systemd opens at run time, in `/usr/lib`;
#! - `/usr/bin` links for the util-linux and e2fsprogs executables that mount
#!   units, systemd-fsck and udev rules exec (the whole packages would bring
#!   100 more tools).
#! - `/usr/share/ca-certificates/ca-bundle.crt`: cacert's Mozilla bundle, the
#!   one CA file of the image;
#! - `/usr/share/zoneinfo`: tzdata's zone database, the one time zone source.
#!
#! Files: the timesyncd and journald drop-ins, and
#! `/usr/lib/repart.d/30-root.conf` (the root partition systemd-repart makes
#! at first boot, rendered from `image/repart.nix`). Tmpfiles lines: `L /bin`, `L /sbin` and `L /lib`, the
#! merged-`/usr` links on the root partition.
#! `L /etc/ssl/cert.pem` and `L /etc/ssl/certs/ca-certificates.crt`, the
#! paths OpenSSL and curl read by default: `openssl version -d` says
#! OPENSSLDIR=/etc/ssl, so OpenSSL reads /etc/ssl/cert.pem, and curl is built
#! with CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt. Both link the one
#! bundle in /usr, so an update carries it and /etc holds no copy.
#! `L /etc/localtime` is the factory's line: it links `/usr/share/zoneinfo/<timezone>`, UTC by default.
#!
#! Unit drop-ins (a link to /dev/null cannot mask a unit the systemd farm
#! already ships): systemd-firstboot.service runs without prompts (no local
#! login, so no root password; it still applies `firstboot.*` credentials),
#! ldconfig.service skips without /usr/bin/ldconfig, modprobe@.service skips
#! without /usr/bin/modprobe (monolithic kernel, no kmod).
#!
#! Locale: C.UTF-8 via /usr/lib/locale.conf (PID 1 reads it before /etc
#! exists, so the factory cannot provide it).
#!
#! Options: `/base.ntp` (NTP servers for timesyncd), `/base.journalMaxUse`
#! (journal retention).
{ types, ... }:
let
  inherit (builtins) concatStringsSep foldl';
  inherit (types) listOf string;

  lines = l: concatStringsSep "\n" l + "\n";

  # systemd's fallback NTP pool (from timesyncd.c)
  defaultNtp = [
    "0.pool.ntp.org"
    "1.pool.ntp.org"
    "2.pool.ntp.org"
    "3.pool.ntp.org"
  ];

  # Convert a list of { path; target; kind; } to the new attrset format
  linksToAttrs =
    list:
    foldl' (
      acc: l:
      acc
      // {
        ${l.path} = {
          inherit (l) target kind;
        };
      }
    ) { } list;
in
{
  name = "base";

  inputs.pkgs.path = "/pkgs";

  options = {
    ntp = {
      type = listOf string;
      default = defaultNtp;
      description = "NTP server pool for systemd-timesyncd. Default: systemd's fallback pool.";
    };
    journalMaxUse = {
      type = string;
      default = "512M";
      description = "SystemMaxUse= for journald: maximum disk space the journal may use.";
    };
  };

  impl =
    { options, results }:
    let
      set = results.pkgs.target;
      p = set.pkgs;

      # timesyncd drop-in
      timesyncdConf = lines [
        "# Generated by Golconda (/base)"
        "[Time]"
        "NTP=${concatStringsSep " " options.ntp}"
      ];

      # journald drop-in
      journaldConf = lines [
        "# Generated by Golconda (/base)"
        "[Journal]"
        "SystemMaxUse=${options.journalMaxUse}"
      ];

      # Boot health, network half. systemd-bless-boot clears the boot counter when
      # boot-complete.target is reached, and the stock target needs only sysinit.target:
      # a candidate that boots but cannot be reached over the network would be blessed
      # and stay preferred. This unit fails unless networkd has a link with a routable
      # address, so a candidate that fails it keeps its counter and loses an attempt.
      # It is pulled in by boot-complete.target.requires (see requiresLinks) and ordered
      # by Before=, the same shape as systemd's own boot-check-no-failures.service.
      healthNetworkUnit = lines [
        "# Generated by Golconda (/base), docs/design/boot.md"
        "[Unit]"
        "Description=Golconda health: the network stack is up"
        "Documentation=man:systemd-networkd-wait-online(8)"
        "After=systemd-networkd.service"
        "Before=boot-complete.target"
        ""
        "[Service]"
        "Type=oneshot"
        "RemainAfterExit=yes"
        # routable: carrier and a routable address (networkctl(1)), not only a link-local one
        "ExecStart=/usr/lib/systemd/systemd-networkd-wait-online --any --operational-state=routable --timeout=60"
        "TimeoutStartSec=90"
      ];

      # Initrd step, in the switch-root transaction after the new /usr is mounted: rewrite
      # the old /etc/systemd/system enable links (absolute systemd store paths from the
      # previous release's first boot) to /usr/lib/systemd/system/<unit>. The next PID 1
      # then starts with working links. Root runs it only to skip it by the initrd condition.
      etcLinksUnit = lines [
        "# Generated by Golconda (/base), docs/design/updates.md"
        "[Unit]"
        "Description=Golconda: make /etc/systemd/system links independent of systemd's store path"
        "DefaultDependencies=no"
        "ConditionPathExists=/etc/initrd-release"
        "Wants=sysroot-usr.mount"
        "After=sysroot.mount sysroot-usr.mount"
        "Before=initrd-switch-root.service"
        ""
        "[Service]"
        "Type=oneshot"
        "RemainAfterExit=yes"
        "ExecStart=/usr/libexec/golconda-etc-links /sysroot"
      ];

      # The .requires links: boot-complete.target starts the health units and, because
      # each one is Before= it, is not reached when one fails. A failed Required= unit
      # fails the target's job, and systemd-bless-boot.service (Requires= the target,
      # After= it) then does not run. Nothing else is added: systemd-boot decrements the
      # counter on every attempt by itself.
      requiresLinks = [
        {
          path = "/usr/lib/systemd/system/boot-complete.target.requires/golconda-health-network.service";
          target = "../golconda-health-network.service";
          kind = "explicit";
        }
      ];

      # repart.d: the root partition, made by systemd-repart in the initrd at first boot
      # (docs/design/layout.md); the image's own partitions are the image builder's
      # (lib/image/disk.nix renders the rest of image/repart.nix)
      rootRepart = (import ../lib/ini.nix).render (import ../../image/repart.nix)."30-root";

      # locale.conf: PID 1 reads /usr/lib/locale.conf before /etc exists
      # (the factory uses tmpfiles, which runs after PID 1 sets the locale)
      localeConf = "LANG=C.UTF-8\n";

      # D-Bus system bus configuration. dbus-broker reads /usr/share/dbus-1/system.conf but
      # does not ship it; this is the policy of the reference bus/system.conf.in (dbus 1.16):
      # every user may connect; no one owns a name or calls a method unless a policy file in
      # system.d allows it (systemd's, linked below, for network1, resolve1, login1, ...).
      # <user>, <listen> and <auth> are for dbus-daemon: dbus-broker takes its socket from
      # dbus.socket and ignores them.
      # <servicedir> is required: dbus-broker compiles in no default, so without it an
      # on-demand name (org.freedesktop.timedate1, for one) is "not activatable" and
      # timedatectl fails. The directory is the farm link to systemd's
      # share/dbus-1/system-services below; each file there names its unit
      # (SystemdService=), and systemd starts it on the first call.
      dbusSystemConf = ''
        <!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
          "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
        <busconfig>
          <type>system</type>
          <user>messagebus</user>
          <auth>EXTERNAL</auth>
          <listen>unix:path=/run/dbus/system_bus_socket</listen>

          <policy context="default">
            <allow user="*"/>
            <deny own="*"/>
            <deny send_type="method_call"/>
            <allow send_type="signal"/>
            <allow send_requested_reply="true" send_type="method_return"/>
            <allow send_requested_reply="true" send_type="error"/>
            <allow receive_type="method_call"/>
            <allow receive_type="method_return"/>
            <allow receive_type="error"/>
            <allow receive_type="signal"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Introspectable"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Properties"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Containers1"/>
            <deny send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus" send_member="UpdateActivationEnvironment"/>
            <deny send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Debug.Stats"/>
            <deny send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.systemd1.Activator"/>
          </policy>

          <policy user="root">
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.systemd1.Activator"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Monitoring"/>
            <allow send_destination="org.freedesktop.DBus" send_interface="org.freedesktop.DBus.Debug.Stats"/>
          </policy>

          <servicedir>/usr/share/dbus-1/system-services</servicedir>
          <includedir>system.d</includedir>
          <includedir>/etc/dbus-1/system.d</includedir>
          <include ignore_missing="yes">/etc/dbus-1/system-local.conf</include>
        </busconfig>
      '';

      # dbus.socket unit: dbus-broker needs the socket but doesn't ship it;
      # the socket activates dbus-broker.service (the dbus.service alias)
      dbusSocketUnit = lines [
        "# D-Bus system bus socket for dbus-broker"
        "[Unit]"
        "Description=D-Bus System Message Bus Socket"
        "Documentation=man:dbus-broker-launch(1)"
        "DefaultDependencies=no"
        "Before=sockets.target"
        ""
        "[Socket]"
        "ListenStream=/run/dbus/system_bus_socket"
        "SocketMode=0666"
        ""
        "[Install]"
        "WantedBy=sockets.target"
      ];

      # Explicit links for dbus-broker: the service from the package, and
      # the dbus.service alias pointing to dbus-broker.service.
      dbusUnitLinks = [
        {
          path = "/usr/lib/systemd/system/dbus-broker.service";
          target = "${p.dbus-broker}/lib/systemd/system/dbus-broker.service";
          kind = "explicit";
        }
        # dbus.service alias points to dbus-broker.service
        {
          path = "/usr/lib/systemd/system/dbus.service";
          target = "dbus-broker.service";
          kind = "explicit";
        }
      ];

      # Unit enablement: .wants links for static enablement.
      # dbus.socket wanted by sockets.target; systemd-networkd, systemd-resolved,
      # systemd-timesyncd enabled via their target's .wants directories.
      wantsLinks = [
        # dbus
        {
          path = "/usr/lib/systemd/system/sockets.target.wants/dbus.socket";
          target = "../dbus.socket";
          kind = "explicit";
        }
        # networkd
        {
          path = "/usr/lib/systemd/system/multi-user.target.wants/systemd-networkd.service";
          target = "../systemd-networkd.service";
          kind = "explicit";
        }
        {
          path = "/usr/lib/systemd/system/sockets.target.wants/systemd-networkd.socket";
          target = "../systemd-networkd.socket";
          kind = "explicit";
        }
        # resolved
        {
          path = "/usr/lib/systemd/system/multi-user.target.wants/systemd-resolved.service";
          target = "../systemd-resolved.service";
          kind = "explicit";
        }
        # timesyncd
        {
          path = "/usr/lib/systemd/system/sysinit.target.wants/systemd-timesyncd.service";
          target = "../systemd-timesyncd.service";
          kind = "explicit";
        }
        # in the switch-root transaction: rewrite the /etc enable links before switch-root
        {
          path = "/usr/lib/systemd/system/initrd-switch-root.target.wants/golconda-etc-links.service";
          target = "../golconda-etc-links.service";
          kind = "explicit";
        }
      ];

      # Drop-ins for units the systemd farm ships: a mask link would collide
      # with the farm, and a condition says the real reason.
      dropIn = text: {
        inherit text;
        mode = "0644";
      };
      # the same [Unit] lines as a drop-in for each of the units
      unitConditions =
        conds: units:
        builtins.listToAttrs (
          map (u: {
            name = "/usr/lib/systemd/system/${u}.d/golconda.conf";
            value = dropIn (lines ([ "[Unit]" ] ++ conds));
          }) units
        );
      unitDropIns = {
        # no local login: never prompt; credentials (firstboot.*) still apply
        "/usr/lib/systemd/system/systemd-firstboot.service.d/golconda.conf" = dropIn ''
          [Service]
          ExecStart=
          ExecStart=systemd-firstboot --mute-console=yes
        '';
        "/usr/lib/systemd/system/ldconfig.service.d/golconda.conf" = dropIn ''
          [Unit]
          ConditionPathExists=/usr/bin/ldconfig
        '';
        "/usr/lib/systemd/system/modprobe@.service.d/golconda.conf" = dropIn ''
          [Unit]
          ConditionPathExists=/usr/bin/modprobe
        '';
        # no local login: the image has no agetty, and the gettys would restart without end
        "/usr/lib/systemd/system/getty@.service.d/golconda.conf" = dropIn ''
          [Unit]
          ConditionPathExists=/usr/bin/agetty
        '';
        "/usr/lib/systemd/system/serial-getty@.service.d/golconda.conf" = dropIn ''
          [Unit]
          ConditionPathExists=/usr/bin/agetty
        '';
      }
      # The initrd is built from /base too (lib/image/initrd.nix), with the .wants links above,
      # and it reaches sockets.target and sysinit.target. sysusers does not run there, so these
      # daemons fail at step USER, hit their start limit and stay failed after switch-root.
      //
        unitConditions
          [ "ConditionPathExists=!/etc/initrd-release" ]
          [
            "systemd-networkd.service"
            "systemd-networkd.socket"
            "systemd-timesyncd.service"
          ]
      # systemd's preset enables the sysupdate timers; without a transfer definition (no
      # /system.updateSource) the services fail with "No transfer definitions found"
      //
        unitConditions
          [
            "ConditionDirectoryNotEmpty=|/usr/lib/sysupdate.d"
            "ConditionDirectoryNotEmpty=|/etc/sysupdate.d"
            "ConditionDirectoryNotEmpty=|/run/sysupdate.d"
          ]
          [ "systemd-sysupdate.service" "systemd-sysupdate-reboot.service" ]
      # systemd-coredump --check-requirements needs PIDFD_INFO_COREDUMP_SIGNAL (kernel 6.19);
      # on an older kernel the ExecCondition skips the units, but they are started again
      # until the start limit marks coredumpd failed
      //
        unitConditions
          [ "ConditionKernelVersion=>=6.19" ]
          [
            "systemd-coredumpd.service"
            "systemd-coredump-register.service"
          ];

      # The one CA file of the image: cacert's Mozilla bundle. /etc carries only
      # symlinks to it, made at boot by the tmpfiles lines below: OpenSSL's
      # OPENSSLDIR is /etc/ssl, so its default cert file is /etc/ssl/cert.pem, and
      # libcurl is built with CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt.
      # The file stays in /usr, so an image update replaces it; a later p11-kit
      # trust extract may replace the links, but not this file.
      caBundleLinks = [
        {
          path = "/usr/share/ca-certificates/ca-bundle.crt";
          target = "${p.cacert}/etc/ssl/certs/ca-bundle.crt";
          kind = "explicit";
        }
      ];
      caBundleTmpfiles = [
        "L /etc/ssl/cert.pem - - - - /usr/share/ca-certificates/ca-bundle.crt"
        "L /etc/ssl/certs/ca-certificates.crt - - - - /usr/share/ca-certificates/ca-bundle.crt"
      ];

      # The zone database: /etc/localtime (the factory's tmpfiles line) links
      # /usr/share/zoneinfo/<timezone>, UTC by default. One directory link: the
      # zone files are data that no $ORIGIN rule reaches.
      zoneinfoLinks = [
        {
          path = "/usr/share/zoneinfo";
          target = "${p.tzdata}/share/zoneinfo";
          kind = "explicit";
        }
      ];

      # PAM modules: Linux-PAM loads a relative module name from /usr/lib/security/, and the
      # factory's stacks name <package>/<module>. Each package's module directory is one
      # directory link: repkgs writes DT_NEEDED as $ORIGIN/../../../<dep>/lib/..., $ORIGIN is
      # the directory of the path PAM opens, and only a directory link makes `..` reach the
      # store (a file link breaks pam_unix's libcrypt; merged copies break $ORIGIN/../libpam).
      pamLinks = [
        {
          path = "/usr/lib/security/linux-pam";
          target = "${p.linux-pam}/lib/security";
          kind = "explicit";
        }
        {
          path = "/usr/lib/security/systemd";
          target = "${p.systemd}/lib/security";
          kind = "explicit";
        }
      ];

      # dash is /bin/sh (/bin -> usr/bin is made by the image builder).
      shLinks = [
        {
          path = "/usr/bin/sh";
          target = "${p.dash}/bin/dash";
          kind = "explicit";
        }
      ];

      # Farm links: directories the image builder expands file by file, subdirectories
      # included: systemd's lib/systemd (PID 1, the executor, udevd, every daemon,
      # libsystemd-shared, the units with their static .wants/, generators, presets, catalog),
      # lib/udev (rules, hwdb, the id helpers), sysusers.d, tmpfiles.d; all by systemd's
      # compiled-in /usr/lib/... paths.
      farmLinks = [
        {
          path = "/usr/lib/systemd";
          target = "${p.systemd}/lib/systemd";
          kind = "farm";
        }
        {
          path = "/usr/lib/udev";
          target = "${p.systemd}/lib/udev";
          kind = "farm";
        }
        {
          path = "/usr/lib/sysusers.d";
          target = "${p.systemd}/lib/sysusers.d";
          kind = "farm";
        }
        {
          path = "/usr/lib/tmpfiles.d";
          target = "${p.systemd}/lib/tmpfiles.d";
          kind = "farm";
        }
        # NvPCR definitions: systemd-pcrextend (pcrproduct, pcrlogin@) and cryptsetup look
        # them up in /usr/lib/nvpcr
        {
          path = "/usr/lib/nvpcr";
          target = "${p.systemd}/lib/nvpcr";
          kind = "farm";
        }
        # D-Bus: systemd's bus policies (system.conf includes system.d) and the activation
        # files that map a bus name to its unit (SystemdService=)
        {
          path = "/usr/share/dbus-1/system.d";
          target = "${p.systemd}/share/dbus-1/system.d";
          kind = "farm";
        }
        {
          path = "/usr/share/dbus-1/system-services";
          target = "${p.systemd}/share/dbus-1/system-services";
          kind = "farm";
        }
      ];

      # dlopen: libraries systemd opens by soname (its ELF .note.dlopen, every one the fork
      # enables; libbz2 is static there); the builder checks they resolve. Their packages are
      # in the closure as systemd's dependencies, except tpm2-tss, which only dlopen reaches.
      dlopenSonames = {
        "libsystemd.so.0" = p.systemd;
        "libnss_systemd.so.2" = p.systemd; # glibc NSS modules, by name too
        "libnss_myhostname.so.2" = p.systemd;
        "libacl.so.1" = p.acl;
        "libarchive.so.13" = p.libarchive;
        "libblkid.so.1" = p.util-linux;
        "libfdisk.so.1" = p.util-linux;
        "libmount.so.1" = p.util-linux;
        "libcrypto.so.3" = p.openssl;
        "libssl.so.3" = p.openssl;
        "libcryptsetup.so.12" = p.cryptsetup;
        "libcurl.so.4" = p.curl;
        "liblz4.so.1" = p.lz4;
        "liblzma.so.5" = p.xz;
        "libzstd.so.1" = p.zstd;
        "libz.so.1" = p.zlib;
        "libp11-kit.so.0" = p.p11-kit;
        "libpam.so.0" = p.linux-pam;
        "libpcre2-8.so.0" = p.pcre2;
        "libseccomp.so.2" = p.libseccomp;
        "libtss2-esys.so.0" = p.tpm2-tss;
        "libtss2-mu.so.0" = p.tpm2-tss;
        "libtss2-rc.so.0" = p.tpm2-tss;
        "libtss2-tcti-device.so.0" = p.tpm2-tss;
      };
      dlopenLinks = map (so: {
        path = "/usr/lib/${so}";
        target = "${dlopenSonames.${so}}/lib/${so}";
        kind = "dlopen";
      }) (builtins.attrNames dlopenSonames);

      # mount units and systemd-fsck exec these from util-linux (in the closure as systemd's
      # library dependency; the whole package would bring 100 more tools). blkid: lvm2's
      # 13-dm-disk.rules probes a dm device with it, and without ID_FS_USAGE systemd's
      # 99-systemd.rules keeps a CRYPT-* device (dm-verity's /usr) at SYSTEMD_READY=0 forever.
      toolLinks =
        map
          (b: {
            path = "/usr/bin/${b}";
            target = "${p.util-linux}/bin/${b}";
            kind = "explicit";
          })
          [
            "mount"
            "umount"
            "fsck"
            "blkid"
          ]
        ++ [
          {
            path = "/usr/bin/fsck.ext4";
            target = "${p.e2fsprogs}/bin/fsck.ext4";
            kind = "explicit";
          }
        ];
    in
    {
      packages = [
        p.systemd
        p.dbus-broker
        p.dash
        p.uutils-coreutils
        p.tpm2-tss # dlopen only (see dlopenSonames): nothing else brings it into the closure
        p.e2fsprogs # mkfs.ext4 and fsck.ext4: repart makes the root partition at first boot
        p.cacert # the one CA bundle: /usr/share/ca-certificates/ca-bundle.crt
        p.tzdata # the zone database: /usr/share/zoneinfo
        p.linux-kernel # kernel; UKI builder consumes it
      ];

      units = {
        "golconda-health-network.service" = healthNetworkUnit;
        "golconda-etc-links.service" = etcLinksUnit;
      };

      files = unitDropIns // {
        # The initrd unit's script: rewrite /etc/systemd/system links to stable paths
        # after /sysroot/usr is mounted and before switch-root (golconda-etc-links.service).
        "/usr/libexec/golconda-etc-links" = {
          text = builtins.readFile ../../scripts/golconda-etc-links;
          mode = "0755";
        };
        "/usr/lib/systemd/timesyncd.conf.d/golconda.conf" = timesyncdConf;
        "/usr/lib/systemd/journald.conf.d/golconda.conf" = journaldConf;
        "/usr/lib/locale.conf" = localeConf;
        "/usr/lib/repart.d/30-root.conf" = rootRepart;
        # dbus.socket unit: dbus-broker doesn't ship it
        "/usr/lib/systemd/system/dbus.socket" = dbusSocketUnit;
        # D-Bus system bus configuration: dbus-broker does not ship it
        "/usr/share/dbus-1/system.conf" = dbusSystemConf;
      };

      links = linksToAttrs (
        dbusUnitLinks
        ++ wantsLinks
        ++ requiresLinks
        ++ shLinks
        ++ toolLinks
        ++ farmLinks
        ++ dlopenLinks
        ++ pamLinks
        ++ caBundleLinks
        ++ zoneinfoLinks
      );

      # The dbus user, if dbus-broker needs it. dbus-broker runs as root by
      # default on most configurations (UID 0 in the unit), but the messagebus
      # user exists for compatibility.
      sysusers = [ "u messagebus - \"D-Bus message bus user\" -" ];

      # merged /usr on the root partition: #!/bin/sh and friends (repart makes the directories,
      # image/repart.nix; the root is read-only until systemd-remount-fs, so switch-root could
      # not make these itself). Plus the CA links: /etc is created by tmpfiles at boot, and an
      # admin file at either path wins (L, not L+).
      tmpfiles = [
        "L /bin - - - - usr/bin"
        "L /sbin - - - - usr/bin"
        "L /lib - - - - usr/lib"
      ]
      ++ caBundleTmpfiles;
    };
}
