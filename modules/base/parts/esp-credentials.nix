# Part of /base (modules/base/default.nix merges it): the ESP's bootstrap credentials hold for one
# boot. golconda-esp-credentials.service removes loader/credentials/*.cred, and any *.cred in a
# UKI's .extra.d/, once the units that apply the first boot's credentials have run
# (docs/design/boot.md, "Bootstrap credentials"). Returns { units; files; links; }.
let
  inherit (import ../../lib/text.nix) lines;

  # every boot, not only the first: a credential put on the ESP later is imported once and goes too.
  # After= the consumers, so a first boot that crashes before they ran keeps the ESP's copy for the
  # next one; network.* credentials are applied by systemd-network-generator at every boot, from
  # this boot's copy in /run, and hold for this boot only
  unit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: remove the bootstrap credentials from the ESP"
    "Documentation=man:systemd-stub(7)"
    "ConditionPathExists=!/etc/initrd-release"
    "ConditionFirmware=uefi"
    "After=systemd-firstboot.service systemd-sysusers.service systemd-tmpfiles-setup.service"
    ""
    "[Service]"
    "Type=oneshot"
    "RemainAfterExit=yes"
    "ExecStart=/usr/lib/golconda/golconda-esp-credentials"
  ];
in
{
  units."golconda-esp-credentials.service" = unit;

  files."/usr/lib/golconda/golconda-esp-credentials" = {
    text = builtins.readFile ../golconda-esp-credentials;
    mode = "0755";
  };

  links."/usr/lib/systemd/system/multi-user.target.wants/golconda-esp-credentials.service" = {
    target = "../golconda-esp-credentials.service";
    kind = "explicit";
  };
}
