# Part of /base (modules/base/default.nix merges it): the trial boot policy, what reboots a boot
# that fails (docs/design/boot.md, "Trial boot"). Returns { units; files; links; }.
#
# Two kinds of failure, two rules:
# - before the machine can be reached (a kernel panic, a PID 1 crash, an initrd that fails or
#   hangs, emergency.target in the host): it reboots on every boot. Nothing could reach it anyway, and on a counted entry the
#   reboot is the next try. A failure that repeats on every boot is the failed-boot counter's
#   (parts/failed-boots.nix): the other slot once, then a boot that reboots on no failure, where
#   both reboot units below skip themselves;
# - after (boot-complete.target failed, or not reached by the deadline): it reboots only on a
#   trial boot, a counted boot that had a try left. golconda-trial-boot-generator decides that at
#   each boot from LoaderBootCountPath and links the drop-in. A blessed entry, or one with no try
#   left, stays up for its operator: a reboot there would start the same entry again, for ever.
#
# The kernel's half, panic= and the lockup detectors' *_panic=, is on the UKI cmdline
# (image/uki.nix); the hardware watchdog is PID 1's (golconda-watchdog.conf).
let
  inherit (import ../../lib/text.nix) lines;
  ini = import ../../lib/ini.nix;
  counting = import ../../../image/boot-counting.nix;

  # PID 1's crash handler, also when the initrd's PID 1 fails to execute the host's (IPE denies
  # an unsigned /usr there): reboot after 10 s instead of freezing (systemd-system.conf(5))
  crashConf = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Manager]"
    "CrashAction=reboot"
  ];

  # PID 1 runs the hardware watchdog (systemd-system.conf(5)): a machine whose PID 1, or whole
  # kernel, stops for 30 s resets, and a reboot that takes 10 min is cut short. The kernel's
  # detectors turn most hangs into a panic first (the UKI cmdline); the watchdog catches the rest.
  # Without a hardware watchdog it is softdog, which a hung kernel stops too
  watchdogConf = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Manager]"
    "RuntimeWatchdogSec=30s"
    "RebootWatchdogSec=10min"
  ];

  # Both failure units write their line to the kernel log: it reaches the serial console, where an
  # operator of a machine that reboots sees it, and the journal. journal+console would not: the
  # journal forwards to tty1 (/base's journald drop-in).
  #
  # The initrd's units fail into emergency.target (OnFailure= of initrd.target and the rest), and
  # so do the host's local-fs.target and systemd-fsck-root.service. emergency.service has no
  # sulogin to start, and no one could log in on the console anyway: this unit reboots instead.
  # In the host, the isolate also cancels the job of boot-complete.target, so the trial boot
  # policy below would not reboot either
  emergencyUnit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: emergency.target reached, reboot"
    "DefaultDependencies=no"
    "ConditionPathExists=!/run/golconda/failed-boots-halt"
    "SuccessAction=reboot"
    "FailureAction=reboot"
    ""
    "[Service]"
    "Type=oneshot"
    "StandardOutput=file:/dev/kmsg"
    "ExecStart=/usr/bin/echo \"golconda-trial-boot: emergency.target reached: rebooting\""
  ];

  # an initrd that hangs (a device that never appears, with no timeout of its own) never fails
  # into emergency.target: its default target gets a deadline. Generous, for a first boot that
  # makes the root file system on a large disk
  initrdTargetConf = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "JobTimeoutSec=10min"
    "JobTimeoutAction=reboot"
  ];

  # boot-complete.target on a trial boot. OnFailure= fires for a job that failed on a
  # dependency (a health unit failed) and for one that timed out (systemd's job.c), so one
  # unit covers both. Only the generator links it into place
  trialConf =
    lines [
      "# Generated by Golconda (/base), docs/design/boot.md; golconda-trial-boot-generator"
      "# links it as boot-complete.target.d/golconda-trial-boot.conf on a trial boot"
    ]
    + ini.render {
      Unit = {
        JobTimeoutSec = "15min";
        OnFailure = "golconda-trial-boot-failed.service";
      };
    };

  trialFailedUnit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: the trial boot failed, reboot to the next try"
    "Documentation=man:systemd-bless-boot.service(8)"
    "DefaultDependencies=no"
    "ConditionPathExists=!/run/golconda/failed-boots-halt"
    "SuccessAction=reboot"
    "FailureAction=reboot"
    ""
    "[Service]"
    "Type=oneshot"
    "StandardOutput=file:/dev/kmsg"
    "ExecStart=/usr/bin/echo \"golconda-trial-boot: boot-complete.target failed or was not reached: rebooting\""
  ];

  generator =
    builtins.replaceStrings
      [ "@tries@" ]
      [
        (toString (counting.triesLeft + counting.triesDone))
      ]
      (builtins.readFile ../golconda-trial-boot-generator);
in
{
  units = {
    "golconda-emergency-reboot.service" = emergencyUnit;
    "golconda-trial-boot-failed.service" = trialFailedUnit;
  };

  files = {
    "/usr/lib/systemd/system.conf.d/golconda-crash.conf" = crashConf;
    "/usr/lib/systemd/system.conf.d/golconda-watchdog.conf" = watchdogConf;
    "/usr/lib/systemd/system/initrd.target.d/golconda-trial-boot.conf" = initrdTargetConf;
    "/usr/lib/golconda/trial-boot.conf" = trialConf;
    "/usr/lib/systemd/system-generators/golconda-trial-boot-generator" = {
      text = generator;
      mode = "0755";
    };
  };

  links = {
    "/usr/lib/systemd/system/emergency.target.wants/golconda-emergency-reboot.service" = {
      target = "../golconda-emergency-reboot.service";
      kind = "explicit";
    };
  };
}
