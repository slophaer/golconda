# Part of /base (modules/base/default.nix merges it): the failed-boot counter, for a failure that
# repeats on every boot, also of a blessed entry that boot counting no longer counts
# (docs/design/boot.md, "Failed boots"). Returns { units; files; links; }.
#
# golconda-failed-boots.service counts each boot early in the initrd;
# golconda-failed-boots-complete.service resets the count once the boot completed. After
# `fallback` boots in a row that did not complete, the next one starts the other slot, which marks
# the failed entry bad once it completes; after `halt`, a boot reboots on no failure (the program,
# ../golconda-failed-boots, says how).
{ fallback, halt }:
let
  inherit (import ../../lib/text.nix) lines;
  program = "/usr/lib/golconda/golconda-failed-boots";

  # before sysinit.target: PID 1 mounts efivarfs before any unit, and nothing that can fail runs
  # this early. After the Secure Boot check (lib/image/initrd.nix): a boot that it halts is not
  # counted
  countUnit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: count this boot until it completes"
    "DefaultDependencies=no"
    "ConditionPathExists=/etc/initrd-release"
    "ConditionFirmware=uefi"
    "After=golconda-secure-boot-required.service"
    "Before=sysinit.target"
    ""
    "[Service]"
    "Type=oneshot"
    "RemainAfterExit=yes"
    "ExecStart=${program} count"
  ];

  # a counted boot completes at boot-complete.target (the program checks that it is active); an
  # uncounted one has no boot-complete.target, and completes at multi-user.target
  completeUnit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: this boot completed, reset the failed-boot count"
    "ConditionPathExists=!/etc/initrd-release"
    "ConditionFirmware=uefi"
    "After=multi-user.target boot-complete.target"
    ""
    "[Service]"
    "Type=oneshot"
    "RemainAfterExit=yes"
    "ExecStart=${program} complete"
  ];
in
assert
  fallback >= 1
  || throw "/base.failedBootsFallback must be 1 or more: the boots in a row that fail before the next starts the other slot";
assert
  halt > fallback
  || throw "/base.failedBootsHalt (${toString halt}) must be more than /base.failedBootsFallback (${toString fallback}): the other slot gets its boot before the machine stops rebooting";
{
  units = {
    "golconda-failed-boots.service" = countUnit;
    "golconda-failed-boots-complete.service" = completeUnit;
  };

  files.${program} = {
    text =
      builtins.replaceStrings
        [ "@fallback@" "@halt@" ]
        [
          (toString fallback)
          (toString halt)
        ]
        (builtins.readFile ../golconda-failed-boots);
    mode = "0755";
  };

  links = {
    "/usr/lib/systemd/system/sysinit.target.wants/golconda-failed-boots.service" = {
      target = "../golconda-failed-boots.service";
      kind = "explicit";
    };
    "/usr/lib/systemd/system/multi-user.target.wants/golconda-failed-boots-complete.service" = {
      target = "../golconda-failed-boots-complete.service";
      kind = "explicit";
    };
  };
}
