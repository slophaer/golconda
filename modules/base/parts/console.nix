# Part of /base (modules/base/default.nix merges it): the screen (tty1) shows the journal.
# journald writes to a console synchronously, so a journalctl process does it instead: a slow
# screen never slows journald or a service that logs. The kernel log reaches both consoles without
# it, and PID 1's status lines reach ttyS0, which is /dev/console (console= in image/uki.nix).
# Returns { units; links; }.
let
  inherit (import ../../lib/text.nix) lines;

  # --boot: only this boot, from its first line (the initrd's too); not every boot of a
  # persistent journal. --priority=info: the host key's fingerprint line is info, and the
  # operator of a cloud console compares it (docs/features/ssh-login.md); debug stays off.
  # --full: a fingerprint is never cut. short-monotonic: the kernel's time stamps, right before
  # the clock is set. The _TRANSPORT= matches skip the kernel's lines: the kernel shows them on
  # tty1 itself. After the flush: a journalctl started before it misses the journal in
  # /var/log/journal, which the first boot creates.
  unit = lines [
    "# Generated by Golconda (/base), docs/design/boot.md"
    "[Unit]"
    "Description=Golconda: show the journal on tty1"
    "Documentation=man:journalctl(1)"
    "DefaultDependencies=no"
    "ConditionPathExists=!/etc/initrd-release"
    "After=systemd-journal-flush.service"
    "Conflicts=shutdown.target"
    "Before=shutdown.target"
    ""
    "[Service]"
    "ExecStart=/usr/bin/journalctl --follow --no-tail --boot --priority=info --full --output=short-monotonic --no-hostname --quiet _TRANSPORT=journal _TRANSPORT=syslog _TRANSPORT=stdout"
    "StandardOutput=tty"
    "TTYPath=/dev/tty1"
    "Restart=always"
    "RestartSec=1s"
  ];
in
{
  units."golconda-console.service" = unit;

  links."/usr/lib/systemd/system/sysinit.target.wants/golconda-console.service" = {
    target = "../golconda-console.service";
    kind = "explicit";
  };
}
