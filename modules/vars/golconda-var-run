#!/bin/sh
# golconda-var-run NAME SECRETS PUBLICS: generate one local var on the machine, once.
# golconda-var-run --admin NAME FILE: seal one file of an admin var, read from stdin.
# golconda-var-run --reseal [--without-pcr7]: seal every credential of the store again.
#
# Local: golconda-var-NAME.service runs it (modules/lib/var.nix). The generator vars.d/NAME.sh
# writes its files in $RUNTIME_DIRECTORY (tmpfs); each SECRET is sealed as the credential
# NAME.SECRET, each PUBLIC is kept in $STATE_DIRECTORY/pub, and the plaintext is removed.
# Admin: `golconda vars push` runs it over ssh. FILE must be a line of vars.d/NAME.admin, so the
# image says what may be pushed; a second push replaces the value.
# Reseal: with the image's policy, or with --without-pcr7 to the signed PCR 11 policy alone, around
# a db rotation or a dbx update (docs/design/trust.md). --without-pcr7 leaves .without-pcr7 in
# the store, and until a --reseal succeeds every seal leaves PCR 7 out.
# GOLCONDA_CREDSTORE and GOLCONDA_VARS_D move the two directories for tests/vars/runner.sh.
set -eu

credstore=${GOLCONDA_CREDSTORE:-/etc/credstore.encrypted}
varsd=${GOLCONDA_VARS_D:-/usr/lib/golconda/vars.d}

# The PCRs bound by value, from the image: vars.d/tpm2-pcrs holds 7 on a Secure Boot image
# (/system.secureBoot), so a boot with Secure Boot off or another db, KEK, PK or dbx unseals
# nothing. Without the file, the signed PCR 11 policy alone.
pcrs=
if [ -f "$varsd/tpm2-pcrs" ] && [ ! -e "$credstore/.without-pcr7" ]; then
  pcrs=$(cat "$varsd/tpm2-pcrs")
fi

# seal ID SOURCE: SOURCE (a file, or - for stdin) as the credential ID.
# --with-key=auto: host+tpm2 when a TPM2 is present, the host key otherwise.
# --name= is the credstore file name, which is also the id the consumer loads
# (LoadCredentialEncrypted=ID): PID 1 checks the embedded name against that id,
# so a sealed file renamed to another credential fails to decrypt.
seal() {
  if ! systemd-creds has-tpm2 --quiet; then
    echo "golconda-var-run: no TPM2: $1 is sealed to the host key alone (docs/features/vars.md)" |
      systemd-cat -t golconda-var-run -p warning
  fi
  mkdir -p "$credstore"
  systemd-creds encrypt --with-key=auto --tpm2-public-key-pcrs=11 ${pcrs:+--tpm2-pcrs="$pcrs"} \
    --name="$1" "$2" "$credstore/.$1.tmp"
  mv "$credstore/.$1.tmp" "$credstore/$1"
}

umask 077

if [ "${1:-}" = --reseal ]; then
  case "$#:${2:-}" in
    1:)
      if [ -f "$varsd/tpm2-pcrs" ]; then
        pcrs=$(cat "$varsd/tpm2-pcrs")
      fi
      ;;
    2:--without-pcr7)
      pcrs=
      mkdir -p "$credstore"
      touch "$credstore/.without-pcr7"
      ;;
    *) echo "usage: golconda-var-run --reseal [--without-pcr7]" >&2; exit 2 ;;
  esac
  plain=$(mktemp -d "${TMPDIR:-/run}/golconda-reseal.XXXXXX")
  trap 'rm -rf -- "$plain"' EXIT
  for f in "$credstore"/*; do
    [ -f "$f" ] || continue
    id=${f##*/}
    systemd-creds decrypt --name="$id" "$f" "$plain/value"
    seal "$id" "$plain/value"
    rm -f -- "$plain/value"
    echo "resealed $id"
  done
  # a reseal with the image's policy: only now is every credential bound to PCR 7 again
  [ "$#" = 2 ] || rm -f -- "$credstore/.without-pcr7"
  exit 0
fi

if [ "${1:-}" = --admin ]; then
  [ $# = 3 ] || { echo "usage: golconda-var-run --admin NAME FILE" >&2; exit 2; }
  name=$2
  file=$3
  for w in "$name" "$file"; do
    case $w in "" | . | .. | */* | *'"'*) echo "golconda-var-run: '$w' is not a word" >&2; exit 2 ;; esac
  done
  [ -f "$varsd/$name.json" ] || { echo "golconda-var-run: no var $name in this image" >&2; exit 1; }
  # NAME.admin: the files of an admin var, one name per line (modules/lib/var.nix). A whole
  # line must match; the image has no grep
  admin=$varsd/$name.admin
  [ -f "$admin" ] || { echo "golconda-var-run: $name is not an admin var" >&2; exit 1; }
  found=
  while IFS= read -r line; do [ "$line" = "$file" ] && found=1; done < "$admin"
  [ -n "$found" ] || { echo "golconda-var-run: $name has no file $file" >&2; exit 1; }
  seal "$name.$file" -
  exit 0
fi

name=$1
secrets=$2
publics=$3
script=$varsd/$name.sh

cd "$RUNTIME_DIRECTORY"
sh -eu "$script"

for f in $secrets; do
  seal "$name.$f" "$f"
done

mkdir -p "$STATE_DIRECTORY/pub"
for f in $publics; do
  cp "$f" "$STATE_DIRECTORY/pub/$f"
done

# RemainAfterExit= keeps the unit active, so systemd removes the runtime
# directory only at stop: remove the plaintext now.
rm -rf -- "${RUNTIME_DIRECTORY:?}"/* "${RUNTIME_DIRECTORY:?}"/.[!.]*
touch "$STATE_DIRECTORY/done"
