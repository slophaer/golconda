# sshd: the OpenSSH daemon as a service value, with its host key as a var.
# Returns one fragment: the host-key generator unit, sshd.service and the
# configuration under /usr/lib/sshd. The privilege-separation user,
# /var/empty and /etc/pam.d/sshd are ambient: /factory provides them, so a
# configuration with sshd adds /factory once.
#
# Authentication is by public key or OpenSSH certificate only. The lines
# that turn off every password path are fixed in the generated sshd_config;
# no option can change them (docs/design/trust.md, "Identity"). PAM stays
# on for account and session (pam_systemd), never for auth. Secrets that a
# machine receives (host certificate, revocation list) are credentials and
# reach sshd as `-o Option=%d/<name>` on the command line: sshd_config
# cannot refer to the credentials directory, and the image carries no
# per-machine value.
{ types, ... }:
let
  s = import ../../lib/service.nix { inherit types; };
  v = import ../../lib/var.nix { inherit types; };
  merge = import ../../lib/merge.nix;

  hostkeyVar = "sshd-hostkey";
  # The admin-supplied host certificate: a credstore entry of this id,
  # signed by the host CA after enrolment (docs/design/trust.md).
  hostCertCredential = "sshd-host-cert";
  filesDir = "/usr/lib/sshd";
in
{
  name = "sshd";

  options = {
    package = {
      type = types.derivation;
      description = "OpenSSH. Not in repkgs yet, so the configuration provides it (its first `bin` is the program).";
    };
    port = {
      type = types.int;
      default = 22;
      description = "Listening port.";
    };
    authorizedKeys = {
      type = types.listOf types.string;
      default = [ ];
      description = "Public keys that may log in as root (${filesDir}/authorized_keys.root). For bootstrap; certificates are the normal path.";
    };
    trustedUserCAKeys = {
      type = types.listOf types.string;
      default = [ ];
      description = "Public keys of the user CAs whose certificates may log in (${filesDir}/trusted_user_ca_keys, TrustedUserCAKeys).";
    };
    principals = {
      type = types.attrsOf (types.listOf types.string);
      default = { };
      description = "User -> certificate principals allowed to log in as that user (${filesDir}/principals.<user>, AuthorizedPrincipalsFile).";
    };
    revokedKeys = {
      type = types.option v.word;
      default = null;
      description = "Name of the admin-supplied credential that holds the key revocation list (KRL); RevokedKeys reads it from the credentials directory.";
    };
    hostCertificate = {
      type = types.bool;
      default = false;
      description = "Present the admin-supplied host certificate (credential ${hostCertCredential}) with the host key (HostCertificate).";
    };
  };

  impl =
    { options }:
    let
      inherit (builtins)
        attrNames
        concatStringsSep
        listToAttrs
        ;
      lines = l: concatStringsSep "\n" l + "\n";
      optional = cond: x: if cond then x else [ ];
      optionalAttrs = cond: x: if cond then x else { };

      # The ed25519 host key, generated on the machine on first boot and
      # sealed to its TPM; the public half stays readable for enrolment.
      hostkey = v.render {
        name = hostkeyVar;
        secrets = [ "key" ];
        publics = [ "key.pub" ];
        script = "ssh-keygen -q -t ed25519 -N '' -f key";
        packages = [ options.package ];
      };

      hasCA = options.trustedUserCAKeys != [ ];
      hasPrincipals = options.principals != { };
      hasKRL = options.revokedKeys != null;

      sshdConfig = lines (
        [
          "# Generated by Golconda (modules/services/sshd). Credentials come on the"
          "# command line: the host key with -h, the rest as -o Option=<path>."
          "Port ${toString options.port}"
          # keys and certificates only; PAM does account and session, not auth
          "PasswordAuthentication no"
          "KbdInteractiveAuthentication no"
          "ChallengeResponseAuthentication no"
          "PermitRootLogin prohibit-password"
          "UsePAM yes"
          # the certificate principal and key id are the audit trail
          "LogLevel VERBOSE"
          "AuthorizedKeysFile .ssh/authorized_keys ${filesDir}/authorized_keys.%u"
        ]
        ++ optional hasCA [ "TrustedUserCAKeys ${filesDir}/trusted_user_ca_keys" ]
        ++ optional hasPrincipals [ "AuthorizedPrincipalsFile ${filesDir}/principals.%u" ]
        ++ [ "PidFile none" ]
      );

      service = s.render {
        name = "sshd";
        app = {
          inherit (options) package;
          argv = [
            "-D"
            "-e"
            "-f"
            (s.file "sshd_config")
          ];
          files = {
            sshd_config = sshdConfig;
          }
          // optionalAttrs (options.authorizedKeys != [ ]) {
            "authorized_keys.root" = lines options.authorizedKeys;
          }
          // optionalAttrs hasCA { trusted_user_ca_keys = lines options.trustedUserCAKeys; }
          // listToAttrs (
            map (u: {
              name = "principals.${u}";
              value = lines options.principals.${u};
            }) (attrNames options.principals)
          );
        };
        extraArgv = [
          "-h"
          (s.credential "hostkey")
        ]
        ++ optional hasKRL [
          "-o"
          (s.credentialArg "RevokedKeys=" options.revokedKeys)
        ]
        ++ optional options.hostCertificate [
          "-o"
          (s.credentialArg "HostCertificate=" "hostcert")
        ];
        credentials = {
          hostkey = v.credentialId hostkeyVar "key";
        }
        // optionalAttrs hasKRL { ${options.revokedKeys} = options.revokedKeys; }
        // optionalAttrs options.hostCertificate { hostcert = hostCertCredential; };
        # sshd runs as root and spawns user sessions, which must see the real
        # system: no sandbox. The privilege-separation user is below.
        user = "root";
        sandbox = "trusted";
        after = [
          "network.target"
          (v.unitName hostkeyVar)
        ];
        wants = [ (v.unitName hostkeyVar) ];
      };

    in
    merge [
      hostkey
      service
    ];
}
