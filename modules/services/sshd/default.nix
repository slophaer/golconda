# sshd: the OpenSSH daemon as a service value, with its host key as a var.
# Returns one fragment: the host-key generator unit, sshd.service, the
# configuration under /usr/lib/sshd and the privilege-separation user.
{ types, ... }:
let
  s = import ../../lib/service.nix { inherit types; };
  v = import ../../lib/var.nix { inherit types; };
  merge = import ../../lib/merge.nix;

  hostkeyVar = "sshd-hostkey";
in
{
  name = "sshd";

  options = {
    package = {
      type = types.derivation;
      description = "OpenSSH. Not in repkgs yet, so the configuration provides it (its first `bin` is the program).";
    };
    port = {
      type = types.int;
      default = 22;
      description = "Listening port.";
    };
    authorizedKeys = {
      type = types.listOf types.string;
      default = [ ];
      description = "Public keys that may log in as root (/usr/lib/sshd/authorized_keys.root).";
    };
  };

  impl =
    { options }:
    let
      inherit (builtins) concatStringsSep;

      # The ed25519 host key, generated on the machine on first boot and
      # sealed to its TPM; the public half stays readable for enrolment.
      hostkey = v.render {
        name = hostkeyVar;
        secrets = [ "key" ];
        publics = [ "key.pub" ];
        script = "ssh-keygen -q -t ed25519 -N '' -f key";
        packages = [ options.package ];
      };

      sshdConfig = ''
        # Generated by Golconda (modules/services/sshd). The host key is the
        # credential ${v.credentialId hostkeyVar "key"}, passed with -h.
        Port ${toString options.port}
        PasswordAuthentication no
        KbdInteractiveAuthentication no
        PermitRootLogin prohibit-password
        AuthorizedKeysFile .ssh/authorized_keys /usr/lib/sshd/authorized_keys.%u
        UsePAM no
        PidFile none
      '';

      service = s.render {
        name = "sshd";
        app = {
          inherit (options) package;
          argv = [
            "-D"
            "-e"
            "-f"
            (s.file "sshd_config")
          ];
          files = {
            sshd_config = sshdConfig;
          }
          // (
            if options.authorizedKeys == [ ] then
              { }
            else
              { "authorized_keys.root" = concatStringsSep "\n" options.authorizedKeys + "\n"; }
          );
        };
        extraArgv = [
          "-h"
          (s.credential "hostkey")
        ];
        credentials.hostkey = v.credentialId hostkeyVar "key";
        # sshd runs as root and spawns user sessions, which must see the real
        # system: no sandbox. The privilege-separation user is below.
        user = "root";
        sandbox = "trusted";
        after = [
          "network.target"
          (v.unitName hostkeyVar)
        ];
        wants = [ (v.unitName hostkeyVar) ];
      };

      privsep = {
        sysusers = [ "u sshd - \"SSH privilege separation\" /var/empty" ];
        tmpfiles = [ "d /var/empty 0755 root root -" ];
      };
    in
    merge [
      hostkey
      service
      privsep
    ];
}
