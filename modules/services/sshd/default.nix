#! OpenSSH daemon as a service, with its host key as a var.
#!
#! Returns one fragment: the host-key generator unit, `sshd.service`, and the
#! wrapped sshd. The privilege-separation user, `/var/empty`, and `/etc/pam.d/sshd`
#! are ambient: `/factory` provides them, so add `/factory` once.
#!
#! Authentication is by public key or OpenSSH certificate only. The lines
#! that turn off every password path are fixed in the generated `sshd_config`;
#! no option can change them (see `docs/design/trust.md`, "Identity").
{ types, ... }:
let
  s = import ../../lib/service.nix { inherit types; };
  v = import ../../lib/var.nix { inherit types; };
  merge = import ../../lib/merge.nix;

  hostkeyVar = "sshd-hostkey";
  # The admin-supplied vars (docs/design/trust.md): the host certificate the
  # host CA signs after enrolment, and the key revocation list. The deploy
  # host pushes them; sshd loads the credentials <name>.<file>.
  hostCertVar = v.admin {
    name = "sshd-host-cert";
    files = [ "cert" ];
  };
  revokedKeysVar = v.admin {
    name = "sshd-revoked-keys";
    files = [ "krl" ];
  };
in
{
  name = "sshd";

  inputs.pkgs.path = "/pkgs";

  options = {
    package = {
      type = types.derivation;
      defaultFunc = { results }: results.pkgs.pkgs.openssh;
      description = "OpenSSH; default repkgs `openssh` from `/pkgs` (its `bin` lists `sshd`).";
    };
    port = {
      type = types.int;
      default = 22;
      description = "Listening port.";
    };
    authorizedKeys = {
      type = types.listOf types.string;
      default = [ ];
      description = "Public keys that may log in as root (authorized_keys.root in the wrapped output). For bootstrap; certificates are the normal path.";
    };
    trustedUserCAKeys = {
      type = types.listOf types.string;
      default = [ ];
      description = "Public keys of the user CAs whose certificates may log in (trusted_user_ca_keys, TrustedUserCAKeys).";
    };
    principals = {
      type = types.attrsOf (types.listOf types.string);
      default = { };
      description = "User -> certificate principals allowed to log in as that user (principals.<user>, AuthorizedPrincipalsFile).";
    };
    revokedKeys = {
      type = types.bool;
      default = false;
      description = "Refuse the keys in the admin-supplied revocation list (admin var sshd-revoked-keys, file krl; RevokedKeys reads the credential).";
    };
    hostCertificate = {
      type = types.bool;
      default = false;
      description = "Present the admin-supplied host certificate (admin var sshd-host-cert, file cert) with the host key (HostCertificate).";
    };
  };

  impl =
    { options, results }:
    let
      inherit (builtins)
        attrNames
        concatStringsSep
        listToAttrs
        ;
      lines = l: concatStringsSep "\n" l + "\n";
      optional = cond: x: if cond then x else [ ];
      optionalAttrs = cond: x: if cond then x else { };

      # The ed25519 host key, generated on the machine on first boot and
      # sealed to its TPM; the public half stays readable for enrolment.
      hostkey = v.render {
        name = hostkeyVar;
        secrets = [ "key" ];
        publics = [ "key.pub" ];
        script = "ssh-keygen -q -t ed25519 -N '' -f key";
        packages = [ options.package ];
      };

      hasCA = options.trustedUserCAKeys != [ ];
      hasPrincipals = options.principals != { };
      hasKRL = options.revokedKeys;

      sshdConfig = lines [
        "# Generated by Golconda (modules/services/sshd). Files come on the"
        "# command line as -o Option=<path>: the host key with -h, the rest"
        "# from the credentials directory or next to this file."
        "Port ${toString options.port}"
        # keys and certificates only; PAM does account and session, not auth
        "PasswordAuthentication no"
        "KbdInteractiveAuthentication no"
        "ChallengeResponseAuthentication no"
        "PermitRootLogin prohibit-password"
        "UsePAM yes"
        # the certificate principal and key id are the audit trail
        "LogLevel VERBOSE"
        "PidFile none"
      ];

      service = s.renderWrapped results.pkgs.wrap {
        name = "sshd";
        app = {
          inherit (options) package;
          program = "sshd";
          argv = [
            "-D"
            "-e"
            "-f"
            (s.file "sshd_config")
            "-o"
            "AuthorizedKeysFile=.ssh/authorized_keys ${s.file "authorized_keys.%u"}"
          ]
          ++ optional hasCA [
            "-o"
            "TrustedUserCAKeys=${s.file "trusted_user_ca_keys"}"
          ]
          ++ optional hasPrincipals [
            "-o"
            "AuthorizedPrincipalsFile=${s.file "principals.%u"}"
          ];
          files = {
            sshd_config = sshdConfig;
          }
          // optionalAttrs (options.authorizedKeys != [ ]) {
            "authorized_keys.root" = lines options.authorizedKeys;
          }
          // optionalAttrs hasCA { trusted_user_ca_keys = lines options.trustedUserCAKeys; }
          // listToAttrs (
            map (u: {
              name = "principals.${u}";
              value = lines options.principals.${u};
            }) (attrNames options.principals)
          );
        };
        extraArgv = [
          "-h"
          (s.credential "hostkey")
        ]
        ++ optional hasKRL [
          "-o"
          (s.credentialArg "RevokedKeys=" "krl")
        ]
        ++ optional options.hostCertificate [
          "-o"
          (s.credentialArg "HostCertificate=" "hostcert")
        ];
        credentials = {
          hostkey = v.credentialId hostkeyVar "key";
        }
        // optionalAttrs hasKRL { krl = v.credentialId "sshd-revoked-keys" "krl"; }
        // optionalAttrs options.hostCertificate { hostcert = v.credentialId "sshd-host-cert" "cert"; };
        # sshd runs as root and spawns user sessions, which must see the real
        # system: no sandbox. The privilege-separation user is in /factory.
        user = "root";
        sandbox = "trusted";
        after = [
          "network.target"
          (v.unitName hostkeyVar)
        ];
        wants = [ (v.unitName hostkeyVar) ];
      };
    in
    merge (
      [
        hostkey
        service
      ]
      ++ optional hasKRL [ revokedKeysVar ]
      ++ optional options.hostCertificate [ hostCertVar ]
    );
}
