#! The seed for `/etc` as symlinks into `/usr/share/factory/etc`.
#!
#! Each factory file is a symlink from `/etc/<path>` to
#! `/usr/share/factory/etc/<path>`. An admin file at the same path (a regular
#! file, not a symlink) wins: tmpfiles `L` (not `L+`) creates only what is
#! missing. `find /etc -type f` lists admin changes.
#!
#! Hostname is not in the factory: it comes from the bootstrap credential
#! `system.hostname`, which PID 1 reads at every boot (see docs/design/boot.md).
#!
#! The factory knows no service: a service owns its user and directories in
#! its own fragment. Only `/etc` content is here, so `pam.d/sshd` is a
#! built-in seed. `mkSystem` adds `/vars` and `/factory` to every system.
{ types, ... }:
let
  inherit (builtins)
    attrNames
    concatStringsSep
    elem
    isString
    listToAttrs
    match
    sort
    ;
  inherit (import ../lib/fragment.nix { inherit types; }) file;
  grammar = import ../lib/grammar.nix;

  factoryDir = "/usr/share/factory/etc";

  # Files the factory must not hold, whoever asks (see the header).
  denied = [
    "passwd"
    "group"
    "shadow"
    "gshadow"
    "machine-id"
    "hostname"
  ];

  # A path under /etc: relative, plain components, none of the denied names.
  etcPath = types.typedef' "etcPath" (
    v:
    if !isString v then
      "Expected a string"
    else if match grammar.etcPath v == null then
      "'${v}' is not a path under /etc: relative components of letters, digits and _ . + -, none . or .."
    else if elem v denied then
      "'${v}' is not a factory file: sysusers or PID 1 or bootstrap credentials write it on the machine (modules/factory)"
    else
      null
  );

  # path under /etc -> file; the key is checked too (attrsOf checks values only)
  etcFiles = types.typedef' "etcFiles" (
    v:
    if !builtins.isAttrs v then
      "Expected type 'etcFiles' (path under /etc -> file)"
    else
      builtins.foldl' (
        err: p:
        if err != null then
          err
        else
          let
            k = etcPath.verify p;
            f = file.verify v.${p};
          in
          if k != null then
            k
          else if f != null then
            "in extraFiles.'${p}': ${f}"
          else
            null
      ) null (attrNames v)
  );

  # An IANA zone name as a path under /usr/share/zoneinfo.
  timezone = types.typedef' "timezone" (
    v:
    if !isString v then
      "Expected a string"
    else if match grammar.timezone v == null then
      "'${v}' is not a time zone name like \"UTC\" or \"Europe/Berlin\""
    else
      null
  );

  lines = l: concatStringsSep "\n" l + "\n";
in
{
  name = "factory";

  options = {
    timezone = {
      type = timezone;
      default = "UTC";
      description = "Time zone name; /etc/localtime links to /usr/share/zoneinfo/<timezone>.";
    };
    extraFiles = {
      type = etcFiles;
      default = { };
      description = "More seeds for /etc: path under /etc -> file (text, or { text; mode; }). A built-in path or a name sysusers owns is an error.";
    };
  };

  impl =
    { options }:
    let
      builtIn = {
        shells = lines [
          "/usr/bin/sh"
          "/usr/bin/dash"
        ];
        "pam.d/other" = lines [
          "# Generated by Golconda (modules/factory): a service without its own"
          "# stack gets nothing."
          "auth required linux-pam/pam_deny.so"
          "account required linux-pam/pam_deny.so"
          "password required linux-pam/pam_deny.so"
          "session required linux-pam/pam_deny.so"
        ];
        "pam.d/sshd" = lines [
          "# Generated by Golconda (modules/factory). Account and session only:"
          "# sshd authenticates by key or certificate; an auth request falls"
          "# through to pam.d/other and is denied. Modules are <package>/<module>"
          "# under /usr/lib/security (/base links the directories)."
          "account required linux-pam/pam_unix.so"
          "session optional systemd/pam_systemd.so"
          "session required linux-pam/pam_unix.so"
        ];
        # systemd's own stack (its lib/pam.d/systemd-user, which libpam would also read from
        # /usr/lib/pam.d) names modules bare; here they are <package>/<module>. No
        # pam_namespace: no namespace.conf is configured, and the module fails without one.
        "pam.d/systemd-user" = lines [
          "# Generated by Golconda (modules/factory): systemd --user (user@.service),"
          "# which pam_systemd starts at a login."
          "account required linux-pam/pam_unix.so no_pass_expiry"
          "# pam_setcred() runs the auth stack; pam_rootok lets it succeed for PID 1"
          "auth required linux-pam/pam_rootok.so"
          "session required linux-pam/pam_loginuid.so"
          "session optional linux-pam/pam_keyinit.so force revoke"
          "session optional linux-pam/pam_umask.so silent"
          "session optional systemd/pam_systemd.so"
        ];
        # p11-kit trust paths and PKCS#11 module configuration (docs/design/trust.md)
        "ssl/anchors/.keep" = "";
        "ssl/blocklist/.keep" = "";
        "pkcs11/.keep" = "";
      };

      clash = builtins.filter (p: builtIn ? ${p}) (attrNames options.extraFiles);
      seeds =
        if clash != [ ] then
          throw "golconda: factory extraFiles redefine built-in [${concatStringsSep ", " clash}]: the factory has one source per path"
        else
          builtIn // options.extraFiles;
      paths = sort (a: b: a < b) (attrNames seeds);

      # Links the tmpfiles lines make under /etc.
      links = {
        "/etc/localtime" = "/usr/share/zoneinfo/${options.timezone}";
        "/etc/os-release" = "../usr/lib/os-release";
      };
      # Tmpfiles lines: L for symlinks into the factory and to the static targets.
      # Each file is a symlink into the factory (L); an admin file in its place wins.
      tmpfilesLines =
        # L /etc/<path> - - - - /usr/share/factory/etc/<path>
        # Uses L (not L+): an existing file (admin override) is left alone.
        map (p: "L /etc/${p} - - - - ${factoryDir}/${p}") paths
        # Symlinks to paths outside the factory (os-release, timezone)
        ++ map (p: "L ${p} - - - - ${links.${p}}") (attrNames links);
    in
    {
      files = listToAttrs (
        map (p: {
          name = "${factoryDir}/${p}";
          value = seeds.${p};
        }) paths
      );
      tmpfiles = tmpfilesLines;
    };
}
