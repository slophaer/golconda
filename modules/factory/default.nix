#! The seed for `/etc` and its manifest.
#!
#! The composer writes files to `/usr/share/factory/etc`; on the machine a
#! tmpfiles `C+` line copies what `/etc` lacks. Nothing replaces an existing
#! file: an admin edit persists, and a later image changes `/etc` only through
#! etc-sync (planned), which reads `/usr/lib/golconda/etc.manifest`.
#!
#! The sshd privilege-separation user and `/var/empty` are ambient like
#! `/etc/pam.d`: add `/factory` once when using `/services/sshd`.
{ types, ... }:
let
  inherit (builtins)
    attrNames
    concatStringsSep
    elem
    hashString
    isString
    listToAttrs
    match
    sort
    ;
  inherit (import ../lib/fragment.nix { inherit types; }) file;
  inherit (import ../lib/var.nix { inherit types; }) word;

  factoryDir = "/usr/share/factory/etc";
  manifestPath = "/usr/lib/golconda/etc.manifest";
  stampPath = "/etc/.golconda-factory-id";

  # Files the factory must not hold, whoever asks (see the header).
  denied = [
    "passwd"
    "group"
    "shadow"
    "gshadow"
    "machine-id"
  ];

  # A path under /etc: relative, plain components, none of the denied names.
  etcPath = types.typedef' "etcPath" (
    v:
    if !isString v then
      "Expected a string"
    else if
      match "[A-Za-z0-9_.+-]+(/[A-Za-z0-9_.+-]+)*" v == null || match "(.*/)?[.][.](/.*)?" v != null
    then
      "'${v}' is not a path under /etc: relative components of letters, digits and _ . + -"
    else if elem v denied then
      "'${v}' is not a factory file: sysusers or PID 1 writes it on the machine (modules/factory)"
    else
      null
  );

  # path under /etc -> file; the key is checked too (attrsOf checks values only)
  etcFiles = types.typedef' "etcFiles" (
    v:
    if !builtins.isAttrs v then
      "Expected type 'etcFiles' (path under /etc -> file)"
    else
      builtins.foldl' (
        err: p:
        if err != null then
          err
        else
          let
            k = etcPath.verify p;
            f = file.verify v.${p};
          in
          if k != null then
            k
          else if f != null then
            "in extraFiles.'${p}': ${f}"
          else
            null
      ) null (attrNames v)
  );

  # An IANA zone name as a path under /usr/share/zoneinfo.
  timezone = types.typedef' "timezone" (
    v:
    if !isString v then
      "Expected a string"
    else if match "[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*" v == null then
      "'${v}' is not a time zone name like \"UTC\" or \"Europe/Berlin\""
    else
      null
  );

  lines = l: concatStringsSep "\n" l + "\n";
  normalize =
    v:
    if isString v then
      {
        text = v;
        mode = "0644";
      }
    else
      {
        inherit (v) text;
        mode = v.mode or "0644";
      };
in
{
  name = "factory";

  options = {
    hostname = {
      type = word;
      default = "golconda";
      description = "The machine's static host name (/etc/hostname).";
    };
    timezone = {
      type = timezone;
      default = "UTC";
      description = "Time zone name; /etc/localtime links to /usr/share/zoneinfo/<timezone>.";
    };
    extraFiles = {
      type = etcFiles;
      default = { };
      description = "More seeds for /etc: path under /etc -> file (text, or { text; mode; }). A built-in path or a name sysusers owns is an error.";
    };
  };

  impl =
    { options }:
    let
      builtIn = {
        hostname = options.hostname + "\n";
        shells = lines [
          "/usr/bin/sh"
          "/usr/bin/dash"
        ];
        "pam.d/other" = lines [
          "# Generated by Golconda (modules/factory): a service without its own"
          "# stack gets nothing."
          "auth required pam_deny.so"
          "account required pam_deny.so"
          "password required pam_deny.so"
          "session required pam_deny.so"
        ];
        "pam.d/sshd" = lines [
          "# Generated by Golconda (modules/factory). Account and session only:"
          "# sshd authenticates by key or certificate; an auth request falls"
          "# through to pam.d/other and is denied."
          "account required pam_unix.so"
          "session optional pam_systemd.so"
          "session required pam_unix.so"
        ];
        # p11-kit trust paths and PKCS#11 module configuration (docs/design/trust.md)
        "ssl/anchors/.keep" = "";
        "ssl/blocklist/.keep" = "";
        "pkcs11/.keep" = "";
      };

      clash = builtins.filter (p: builtIn ? ${p}) (attrNames options.extraFiles);
      seeds =
        if clash != [ ] then
          throw "golconda: factory extraFiles redefine built-in [${concatStringsSep ", " clash}]: the factory has one source per path"
        else
          builtIn // options.extraFiles;
      paths = sort (a: b: a < b) (attrNames seeds);

      # Entries the tmpfiles lines make under /etc, for the manifest.
      links = {
        "/etc/localtime" = "/usr/share/zoneinfo/${options.timezone}";
        "/etc/os-release" = "../usr/lib/os-release";
      };
      dirs = [ "/etc/ssh" ];

      entries =
        map (
          p:
          let
            f = normalize seeds.${p};
          in
          {
            path = "/etc/${p}";
            line = "f ${f.mode} root:root ${hashString "sha256" f.text} /etc/${p}";
          }
        ) paths
        ++ map (p: {
          path = p;
          line = "l - root:root ${links.${p}} ${p}";
        }) (attrNames links)
        ++ map (p: {
          path = p;
          line = "d 0755 root:root - ${p}";
        }) dirs;
      manifest = lines (map (e: e.line) (sort (a: b: a.path < b.path) entries));
      manifestId = hashString "sha256" manifest;
    in
    {
      files =
        listToAttrs (
          map (p: {
            name = "${factoryDir}/${p}";
            value = seeds.${p};
          }) paths
        )
        // {
          ${manifestPath} = manifest;
        };
      tmpfiles = [
        "C+ /etc - - - - ${factoryDir}"
        "f ${stampPath} 0644 root root - ${manifestId}"
      ]
      ++ map (d: "d ${d} 0755 root root -") dirs
      ++ map (p: "L ${p} - - - - ${links.${p}}") (attrNames links)
      ++ [ "d /var/empty 0755 root root -" ];
      sysusers = [ "u sshd - \"SSH privilege separation\" /var/empty" ];
    };
}
