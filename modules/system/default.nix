#! The composer: takes fragments, returns one system.
#!
#! Union with an error on a duplicate key; there is no priority system
#! (see `docs/design/modules.md`). The union itself is `modules/lib/merge.nix`,
#! so a module that returns several fragments applies the same rule.
#!
#! It selects nothing itself: `mkSystem` (`lib/components.nix`) passes the
#! fragments of the selected components as `components`, the built-ins
#! (`/base`, `/network`, `/security`, `/factory`, `/vars`) first, then each
#! optional component the configuration has a table for, then the build's own
#! named fragments (`/image/loader`, `/image/index`). A system with no table still has systemd,
#! dbus-broker, dash, coreutils and the kernel.
#!
#! With `updateSource` it adds the sysupdate transfers and the update timer,
#! and, unless `updateReboot` is null, systemd's reboot timer in that window,
#! behind `golconda-update-pending` (docs/design/updates.md, "Activation").
#! With `secureBoot` it adds `/usr/lib/golconda/vars.d/tpm2-pcrs`, which seals
#! the vars to PCR 7 as well (docs/design/trust.md).
#!
#! Output: `{ name; version; units; files; sysusers; tmpfiles; packages; packageOrigins; origins; links; programs }`,
#! every file as `{ text; mode; }` and `links` one map, path under `/usr` ->
#! `{ target; kind; }`: the fragments' own links (`.wants`, directories to
#! expand, dlopen sonames), with one duplicate check that names both sources of
#! a path. The `/usr/bin` links of the packages are not in it: the `/usr` tree
#! builder makes them from each package's `exports.json`. `units` holds
#! the system manager's units (typed names, `/usr/lib/systemd/system/<name>`).
#!
#! `packageOrigins` answers "why is this package here": package key (its
#! name-version) -> the origins that brought it: a component's module path
#! (`"/base"`, `"/services/sshd"`) or a build fragment's `name`
#! (`"/image/loader"`). `packages` stays one deduped list.
#!
#! `origins` does the same for everything a fragment emits: `{ packages; files;
#! links; units; sysusers; tmpfiles; }`, each a map from the key (package key,
#! path under `/usr`, unit name, line) to the origins that emitted it.
#! `packageOrigins` is an alias of `origins.packages`. `lib/usr-tree.nix`
#! writes the maps to `/usr/lib/golconda/attribution.json`.
{ types, ... }:
let
  ini = import ../lib/ini.nix;
  grammar = import ../lib/grammar.nix;
  versionLib = import ../../lib/version.nix { };
  # /system.updateSource -> /usr/lib/sysupdate.d/*.transfer (image/sysupdate.nix), and the
  # timer that runs them. systemd 257 named the suffix .transfer (.conf still loads, with a
  # warning). systemd 262 renamed systemd-sysupdate.timer to systemd-sysupdate-update.timer
  # and keeps the old name as an alias; the static .wants link enables it without presets
  # (docs/design/layout.md).
  sysupdateFragment =
    options:
    if options.updateSource == null then
      [ ]
    else
      let
        defs = import ../../image/sysupdate.nix {
          imageId = options.name;
          inherit (options) updateSource;
        };
      in
      [
        {
          files = builtins.listToAttrs (
            map (n: {
              name = "/usr/lib/sysupdate.d/${n}.transfer";
              value = {
                text = ini.render defs.${n};
                mode = "0644";
              };
            }) (builtins.attrNames defs)
          );
          links."/usr/lib/systemd/system/timers.target.wants/systemd-sysupdate-update.timer" = {
            target = "../systemd-sysupdate-update.timer";
            kind = "explicit";
          };
        }
      ]
      ++ activationFragment options;
  # /system.updateReboot -> systemd's reboot timer in that window (docs/design/updates.md,
  # "Activation"). systemd-sysupdate-reboot.service runs `systemd-sysupdate reboot`, which reboots
  # when a newer version is installed than the one that runs; golconda-update-pending, its
  # ExecCondition=, adds that systemd-boot must also pick another entry than the running one, so a
  # release that failed its tries and fell back (still installed, and newer) reboots nothing.
  # The timer keeps systemd's RandomizedDelaySec=30min, so machines of one window spread out.
  activationFragment =
    options:
    let
      header = "# Generated by Golconda (/system.updateReboot), docs/design/updates.md\n";
    in
    if options.updateReboot == null then
      [ ]
    else
      [
        {
          files = {
            "/usr/lib/systemd/system/systemd-sysupdate-reboot.timer.d/golconda.conf" = {
              text =
                header
                + ini.render {
                  Timer.OnCalendar = [
                    ""
                    options.updateReboot
                  ];
                };
              mode = "0644";
            };
            "/usr/lib/systemd/system/systemd-sysupdate-reboot.service.d/golconda.conf" = {
              text = header + ini.render { Service.ExecCondition = "/usr/lib/golconda/golconda-update-pending"; };
              mode = "0644";
            };
            "/usr/lib/golconda/golconda-update-pending" = {
              text = builtins.readFile ./golconda-update-pending;
              mode = "0755";
            };
          };
          links."/usr/lib/systemd/system/timers.target.wants/systemd-sysupdate-reboot.timer" = {
            target = "../systemd-sysupdate-reboot.timer";
            kind = "explicit";
          };
        }
      ];
  # /system.secureBoot -> the vars' TPM2 policy: PCR 7 by value besides the signed PCR 11 policy,
  # so a boot with Secure Boot off, or with other Secure Boot keys, unseals no var
  # (modules/vars/golconda-var-run reads the file; docs/design/trust.md)
  secureBootFragment =
    options:
    on options.secureBoot [
      {
        files."/usr/lib/golconda/vars.d/tpm2-pcrs" = {
          text = "7\n";
          mode = "0644";
        };
      }
    ];
  on = import ../lib/on.nix;
  inherit (builtins)
    isString
    match
    ;
  fragmentT = (import ../lib/fragment.nix { inherit types; }).fragment;
  merge = import ../lib/merge.nix;

  # Version format: YYYYMMDD.N (a real calendar date plus a revision within the day).
  # strverscmp orders these correctly. The type accepts what grammar.version matches, the
  # pattern the schema exports; lib/version.nix, whose toEpoch derives the erofs timestamp,
  # gives the reason for a refusal, and nix/tests.nix checks that the two agree.
  version = types.typedef' "version" (
    v:
    if !isString v then
      "Expected a string"
    else if match grammar.version v != null then
      null
    else
      let
        reason = versionLib.error v;
      in
      if reason != null then reason else "'${v}' is not a version: YYYYMMDD.N, such as 20261031.1"
  );
in
{
  name = "system";

  types = {
    fragment = fragmentT;
  };

  options = {
    name = {
      type = types.typedef' "imageName" (
        v:
        if !isString v then
          "Expected a string"
        else if match grammar.imageName v == null then
          "'${v}' is not an image id: use letters, digits and _ . - and start with a letter or digit (the id is os-release ID=, the artifact file name stem and the sysupdate match pattern)"
        else
          null
      );
      description = "Image id, the ID= of os-release and the UKI file name stem.";
    };
    version = {
      type = version;
      description = "Image version (YYYYMMDD.N). Each release must sort higher than the previous; systemd-sysupdate compares with strverscmp.";
    };
    updateSource = {
      type = types.option (
        types.typedef' "updateSource" (
          source:
          if !isString source then
            "Expected a string"
          else if builtins.length (builtins.split "[[:space:][:cntrl:]]" source) > 1 then
            "updateSource must not contain whitespace or a control character: it is a sysupdate Path= value"
          else if builtins.substring 0 1 source == "/" || match ".*://.*" source != null then
            null
          else
            "updateSource must be a URL (https://…) or an absolute path"
        )
      );
      default = null;
      description = "URL or absolute path of the update server. Rendered into /usr/lib/sysupdate.d/. When null (default), no sysupdate transfer is configured.";
    };
    updateReboot = {
      type = types.option (
        types.typedef' "updateReboot" (
          v:
          if !isString v then
            "Expected a string"
          else if v == "" then
            "updateReboot must not be empty: give an OnCalendar= value such as \"04:10\", or null"
          else if builtins.length (builtins.split "[[:cntrl:]]" v) > 1 then
            "updateReboot must not contain a control character or a line break: it is an OnCalendar= value"
          else
            null
        )
      );
      default = "04:10";
      description = "When a machine reboots into an installed update: an OnCalendar= value (systemd.time(7)) for systemd-sysupdate-reboot.timer, which keeps systemd's random delay of up to 30 minutes. The reboot happens only when systemd-boot would start another entry than the running one, so a release that failed its tries and fell back does not reboot the machine again. Default: 04:10, systemd's own. When null, an installed update waits for the operator's reboot. Only with updateSource (docs/design/updates.md, \"Activation\").";
    };
    secureBoot = {
      type = types.bool;
      default = true;
      description = "Whether the host's firmware enforces Secure Boot with the image's db key. When false, the kernel carries the db certificate in its built-in keyring and checks the /usr signature itself; the firmware then checks nothing, so whoever can write the ESP can replace the UKI (docs/design/trust.md). For a host without Secure Boot, such as Hetzner Cloud.";
    };
    secureBootMicrosoftKeys = {
      type = types.bool;
      default = true;
      description = "Whether the Secure Boot keys the disk enrols in Setup Mode include Microsoft's: KEK CA 2011 and KEK 2K CA 2023 in KEK, UEFI CA 2011, UEFI CA 2023 and Option ROM UEFI CA 2023 in db, and Microsoft's dbx. On hardware, option ROMs (graphics, network, storage) and shims are signed by the Microsoft UEFI CA; without it the firmware refuses them. When false, PK, KEK and db hold the deployment's certificates only. Only for an image with secureBoot; the key set's secureboot/auth/microsoft or secureboot/auth/golconda (docs/design/bootloader.md).";
    };
    components = {
      type = types.listOf fragmentT;
      default = [ ];
      description = "The fragments to merge, each with a `name`: the selected components (named by their module paths) and the build's own fragments. mkSystem passes them (lib/components.nix); not configuration data, and the TOML loader refuses it.";
    };
  };

  impl =
    { options, ... }:
    # the selected components and the build's fragments, then the sysupdate definitions
    merge.withOrigins (
      map (
        fragment:
        if fragment ? name then
          {
            origin = fragment.name;
            inherit fragment;
          }
        else
          throw "golconda: /system.components: a fragment needs a `name`, its origin (lib/components.nix sets a component's module path)"
      ) options.components
      ++ map (fragment: {
        origin = "/system";
        inherit fragment;
      }) (sysupdateFragment options ++ secureBootFragment options)
    )
    // {
      inherit (options)
        name
        version
        updateSource
        updateReboot
        secureBoot
        secureBootMicrosoftKeys
        ;
    };
}
