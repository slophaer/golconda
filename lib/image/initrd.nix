# lib/image/initrd.nix: the initrd, a zstd cpio around a minimal /usr tree.
#
# initrdSystem { imageId; version; platform; buildSystem; packagesDir ? null;
#   replaces ? [ ]; sources ? the pins; secureBoot ? true; } → the mkSystem of the initrd: /base
#   (systemd, dash, uutils-coreutils, dbus-broker, lvm2) as lib/system.nix composes it.
#   `secureBoot` is the image's /system.secureBoot: with it the initrd halts when the firmware
#   does not enforce Secure Boot (golconda-secure-boot-required.service).
#   `packagesDir` and `replaces` are the configuration's downstream package directory and its
#   [golconda] replaces, so a replacement reaches the initrd too, under the same opt-in;
#   `sources` are the image's pins, so the initrd's set is the system's.
# initrdTree (the same arguments) → the initrd's /usr tree: that system without the kernel (the
#   UKI carries it); lib/usr-tree.nix builds it as for the system.
#
# initrd { usrTree; imageId; version; buildSystem; pkgs; } → derivation with
#   initrd.cpio.zst
#
# The cpio holds: /usr (the tree), /init -> usr/lib/systemd/systemd, /etc/initrd-release ->
# ../usr/lib/os-release (systemd knows it runs in an initrd by it) with /etc/os-release pointing
# at it, the merged-/usr links /bin /sbin /lib and the empty mount points. lvm2's device-mapper
# udev rules and dmsetup are /base's, as on the host (systemd's libcryptsetup needs them for
# /dev/mapper/usr). No machine-id, no shadow, no
# static /init: systemd itself is PID 1 and finds the /usr partition by usrhash= (its
# veritysetup and gpt-auto generators).
#
# The kernel execs /init, its default. repkgs binaries find ld.so and their libraries
# relative to their own path, and before /proc is mounted that path is AT_EXECFN as the kernel
# spelled it: the fork's crt-interp and glibc resolve its symlinks (/init -> usr/lib/systemd/
# systemd -> the store) without /proc.
_:
let
  inherit (builtins) filter;
  common = import ./common.nix { };
  usrTreeLib = import ../usr-tree.nix { };
  on = import ../../modules/lib/on.nix;
  inherit (import ../../modules/lib/text.nix) lines;

  # A Secure Boot image on firmware that does not enforce Secure Boot: nothing checked the UKI, so
  # the initrd stops before the root is set up, and says why on the console. It halts rather than
  # reboots: the machine stays off the network, the line stays on the screen, and no loop starts;
  # the vars would not unseal anyway (docs/design/trust.md, "PCR 7"). Before sysinit.target, so no
  # unit of the initrd that needs it, and no switch to the root, runs first. halt-force stops no
  # unit: the initrd's TPM measurement units (systemd-pcrosseparator and the rest) conflict with
  # shutdown.target and have FailureAction=reboot-force, so stopping one mid-run would reboot.
  refuseUnit = "golconda-secure-boot-required.service";
  refuseFragment = {
    name = "/image/initrd/secure-boot";
    units.${refuseUnit} = lines [
      "# Generated by Golconda (lib/image/initrd.nix), docs/design/boot.md"
      "[Unit]"
      "Description=Golconda: Secure Boot is off, halt"
      "DefaultDependencies=no"
      "ConditionSecurity=!uefi-secureboot"
      "Before=sysinit.target systemd-repart.service initrd-root-device.target sysroot.mount"
      "SuccessAction=halt-force"
      "FailureAction=halt-force"
      ""
      "[Service]"
      "Type=oneshot"
      # the kernel log reaches the serial console and the screen (as golconda-emergency-reboot's)
      "StandardOutput=file:/dev/kmsg"
      "ExecStart=/usr/bin/echo \"golconda: Secure Boot is off, and this image needs it (/system.secureBoot): halting. Turn Secure Boot on in the firmware setup, with the deployment's keys, and boot again.\""
    ];
    links."/usr/lib/systemd/system/sysinit.target.wants/${refuseUnit}" = {
      target = "../${refuseUnit}";
      kind = "explicit";
    };
  };

  initrdSystem =
    {
      imageId,
      version,
      platform,
      buildSystem,
      packagesDir ? null,
      replaces ? [ ],
      # the pins the image's own system has (chain.nix passes them)
      sources ? import ../../pins,
      # the image's /system.secureBoot (chain.nix passes it), for the refusal alone: the initrd's
      # own /system keeps the default, so its set needs no image keys (lib/system.nix)
      secureBoot ? true,
      ...
    }:
    import ../system.nix {
      inherit sources;
      system = buildSystem;
      platform = platform.name;
      config = {
        "/system" = {
          name = imageId;
          inherit version;
        };
      }
      // (
        if packagesDir == null then
          { }
        else
          {
            golconda = {
              packages = packagesDir;
              inherit replaces;
            };
          }
      );
      # The initrd reaches sockets.target and sysinit.target, which pull networkd (its socket)
      # and timesyncd through /base's .wants links. sysusers does not run in the initrd, so /base
      # gives those units ConditionPathExists=!/etc/initrd-release. resolved is wanted by
      # multi-user.target only, which the initrd does not reach.
      extraFragments = on secureBoot [ refuseFragment ];
    };
in
{
  # the system mkSystem makes of /base alone (lib/system.nix)
  inherit initrdSystem;

  # initrdTree: the initrd system's /usr tree, without the kernel
  initrdTree =
    args@{
      version,
      platform,
      buildSystem,
      sources ? import ../../pins,
      ...
    }:
    let
      sys = initrdSystem args;
    in
    usrTreeLib.usrTree {
      # the kernel is in the UKI, not in the initrd. The initrd's own set: with
      # /system.secureBoot = false the image's kernel is another derivation
      composerOutput = sys.composed // {
        packages = filter (p: p != sys.pkgs.linux-kernel) sys.composed.packages;
      };
      inherit
        platform
        version
        buildSystem
        sources
        ;
    };

  initrd =
    {
      usrTree,
      imageId,
      version,
      buildSystem,
      pkgs,
      sources,
      ... # platform and the rest of the shared argument set
    }:
    common.nuDerivation {
      name = "${imageId}_${version}.initrd";
      inherit buildSystem sources;
      module = "initrd";
      tools = [
        pkgs.gen-init-cpio
        pkgs.zstd
      ];
      attrs = {
        inherit usrTree;
      };
    };
}
