# lib/image/initrd.nix: the initrd, a zstd cpio around a minimal /usr tree (docs/design/boot.md).
#
# initrdComposition { composed; } → the initrd's own composition, from the image's composed system:
#   what the initrd runs of /base (`fromBase`), and the Secure Boot refusal when the image has
#   /system.secureBoot. The packages are the image's, so a downstream replacement holds here too.
# initrdTree { composed; version; platform; buildSystem; sources; } → that composition's /usr tree.
# initrd { usrTree; imageId; version; buildSystem; pkgs; } → derivation with initrd.cpio.zst:
#   the tree, /init -> usr/lib/systemd/systemd, /etc/initrd-release, the merged-/usr links and
#   the empty mount points.
_:
let
  inherit (builtins)
    attrNames
    filter
    head
    listToAttrs
    match
    ;
  common = import ./common.nix { };
  usrTreeLib = import ../usr-tree.nix { };
  merge = import ../../modules/lib/merge.nix;
  on = import ../../modules/lib/on.nix;
  inherit (import ../../modules/lib/text.nix) lines;

  # A Secure Boot image on firmware that does not enforce Secure Boot: nothing checked the UKI, so
  # the initrd stops before the root is set up, and says why on the console. It halts rather than
  # reboots: the machine stays off the network, the line stays on the screen, and no loop starts;
  # the vars would not unseal anyway (docs/design/trust.md, "PCR 7"). Before sysinit.target, so no
  # unit of the initrd that needs it, and no switch to the root, runs first. halt-force stops no
  # unit: the initrd's TPM measurement units (systemd-pcrosseparator and the rest) conflict with
  # shutdown.target and have FailureAction=reboot-force, so stopping one mid-run would reboot.
  refuseUnit = "golconda-secure-boot-required.service";
  refuseFragment = {
    name = "/image/initrd/secure-boot";
    units.${refuseUnit} = lines [
      "# Generated by Golconda (lib/image/initrd.nix), docs/design/boot.md"
      "[Unit]"
      "Description=Golconda: Secure Boot is off, halt"
      "DefaultDependencies=no"
      "ConditionSecurity=!uefi-secureboot"
      "Before=sysinit.target systemd-repart.service initrd-root-device.target sysroot.mount"
      "SuccessAction=halt-force"
      "FailureAction=halt-force"
      ""
      "[Service]"
      "Type=oneshot"
      # the kernel log reaches the serial console and the screen (as golconda-emergency-reboot's)
      "StandardOutput=file:/dev/kmsg"
      "ExecStart=/usr/bin/echo \"golconda: Secure Boot is off, and this image needs it (/system.secureBoot): halting.\""
      "ExecStart=/usr/bin/echo \"golconda: turn Secure Boot on in the firmware setup, with the deployment's keys, and boot again.\""
    ];
    links."/usr/lib/systemd/system/sysinit.target.wants/${refuseUnit}" = {
      target = "../${refuseUnit}";
      kind = "explicit";
    };
  };

  # What the initrd runs of the image's /base, by name (modules/base/initrd.nix)
  fromBase = import ../../modules/base/initrd.nix;

  # a unit drop-in or a PID 1 setting
  isDropIn = p: match "/usr/lib/systemd/(system[.]conf[.]d|system/[^/]+[.]d)/[^/]+" p != null;

  # fromBase, taken from the image's composition, and every drop-in of /base; a name /base does
  # not have stops the build
  baseFragment =
    composed:
    let
      missing =
        what: n:
        throw "golconda: the initrd takes ${what} ${n} from /base, which has none (modules/base/initrd.nix)";
      take =
        field: names:
        listToAttrs (
          map (n: {
            name = n;
            value = composed.${field}.${n} or (missing field n);
          }) names
        );
      dropIns = filter (p: isDropIn p && composed.origins.files.${p} == [ "/base" ]) (
        attrNames composed.files
      );
    in
    {
      packages = map (
        n:
        let
          found = filter (p: (p.pname or null) == n) composed.packages;
        in
        if found == [ ] then missing "the package" n else head found
      ) fromBase.packages;
      units = take "units" fromBase.units;
      files = take "files" (fromBase.files ++ dropIns);
      links = take "links" fromBase.links;
    };

  initrdComposition =
    { composed }:
    merge.withOrigins (
      [
        {
          origin = "/base";
          fragment = baseFragment composed;
        }
      ]
      ++ map (fragment: {
        origin = fragment.name;
        inherit fragment;
      }) (on composed.secureBoot [ refuseFragment ])
    )
    // {
      inherit (composed) name version;
    };
in
{
  inherit initrdComposition;

  # initrdTree: the initrd composition's /usr tree; the kernel is in the UKI
  initrdTree =
    {
      composed,
      version,
      platform,
      buildSystem,
      sources,
      ...
    }:
    usrTreeLib.usrTree {
      composerOutput = initrdComposition { inherit composed; };
      inherit
        platform
        version
        buildSystem
        sources
        ;
    };

  initrd =
    {
      usrTree,
      imageId,
      version,
      buildSystem,
      pkgs,
      sources,
      ... # platform and the rest of the shared argument set
    }:
    common.nuDerivation {
      name = "${imageId}_${version}.initrd";
      inherit buildSystem sources;
      module = "initrd";
      tools = [
        pkgs.gen-init-cpio
        pkgs.zstd
      ];
      attrs = {
        inherit usrTree;
      };
    };
}
