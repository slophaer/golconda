# lib/image/initrd.nix: the initrd, a zstd cpio around a minimal /usr tree (docs/design/boot.md).
#
# initrdSystem { imageId; version; platform; buildSystem; packageSet; sources; secureBoot ? true; }
#   → the mkSystem of the initrd: /base alone, from the image's package set (`packageSet` of its
#   mkSystem) and pins, with the refusal of the image's /system.secureBoot.
# initrdTree (the same arguments) → that system's /usr tree without the kernel (the UKI has it).
# initrd { usrTree; imageId; version; buildSystem; pkgs; } → derivation with initrd.cpio.zst:
#   the tree, /init -> usr/lib/systemd/systemd, /etc/initrd-release, the merged-/usr links and
#   the empty mount points.
_:
let
  inherit (builtins) filter;
  common = import ./common.nix { };
  usrTreeLib = import ../usr-tree.nix { };
  on = import ../../modules/lib/on.nix;
  inherit (import ../../modules/lib/text.nix) lines;

  # A Secure Boot image on firmware that does not enforce Secure Boot: nothing checked the UKI, so
  # the initrd stops before the root is set up, and says why on the console. It halts rather than
  # reboots: the machine stays off the network, the line stays on the screen, and no loop starts;
  # the vars would not unseal anyway (docs/design/trust.md, "PCR 7"). Before sysinit.target, so no
  # unit of the initrd that needs it, and no switch to the root, runs first. halt-force stops no
  # unit: the initrd's TPM measurement units (systemd-pcrosseparator and the rest) conflict with
  # shutdown.target and have FailureAction=reboot-force, so stopping one mid-run would reboot.
  refuseUnit = "golconda-secure-boot-required.service";
  refuseFragment = {
    name = "/image/initrd/secure-boot";
    units.${refuseUnit} = lines [
      "# Generated by Golconda (lib/image/initrd.nix), docs/design/boot.md"
      "[Unit]"
      "Description=Golconda: Secure Boot is off, halt"
      "DefaultDependencies=no"
      "ConditionSecurity=!uefi-secureboot"
      "Before=sysinit.target systemd-repart.service initrd-root-device.target sysroot.mount"
      "SuccessAction=halt-force"
      "FailureAction=halt-force"
      ""
      "[Service]"
      "Type=oneshot"
      # the kernel log reaches the serial console and the screen (as golconda-emergency-reboot's)
      "StandardOutput=file:/dev/kmsg"
      "ExecStart=/usr/bin/echo \"golconda: Secure Boot is off, and this image needs it (/system.secureBoot): halting.\""
      "ExecStart=/usr/bin/echo \"golconda: turn Secure Boot on in the firmware setup, with the deployment's keys, and boot again.\""
    ];
    links."/usr/lib/systemd/system/sysinit.target.wants/${refuseUnit}" = {
      target = "../${refuseUnit}";
      kind = "explicit";
    };
  };

  initrdSystem =
    {
      imageId,
      version,
      platform,
      buildSystem,
      # the image's set and pins (chain.nix passes them): a downstream package replaces here too
      packageSet,
      sources,
      # the image's /system.secureBoot (chain.nix passes it), for the refusal alone: the initrd's
      # own /system keeps the default, so it needs no image keys (lib/system.nix)
      secureBoot ? true,
      ...
    }:
    import ../system.nix {
      inherit sources packageSet;
      system = buildSystem;
      platform = platform.name;
      config."/system" = {
        name = imageId;
        inherit version;
      };
      # The initrd reaches sockets.target and sysinit.target, which pull networkd (its socket)
      # and timesyncd through /base's .wants links. sysusers does not run in the initrd, so /base
      # gives those units ConditionPathExists=!/etc/initrd-release. resolved is wanted by
      # multi-user.target only, which the initrd does not reach.
      extraFragments = on secureBoot [ refuseFragment ];
    };
in
{
  # the system mkSystem makes of /base alone (lib/system.nix)
  inherit initrdSystem;

  # initrdTree: the initrd system's /usr tree, without the kernel
  initrdTree =
    args@{
      version,
      platform,
      buildSystem,
      sources,
      ...
    }:
    let
      sys = initrdSystem args;
    in
    usrTreeLib.usrTree {
      # the kernel is in the UKI, not in the initrd. The initrd's system has no verityCert, so
      # its kernel is the set's own, not the image's variant: neither goes in
      composerOutput = sys.composed // {
        packages = filter (p: p != sys.pkgs.linux-kernel) sys.composed.packages;
      };
      inherit
        platform
        version
        buildSystem
        sources
        ;
    };

  initrd =
    {
      usrTree,
      imageId,
      version,
      buildSystem,
      pkgs,
      sources,
      ... # platform and the rest of the shared argument set
    }:
    common.nuDerivation {
      name = "${imageId}_${version}.initrd";
      inherit buildSystem sources;
      module = "initrd";
      tools = [
        pkgs.gen-init-cpio
        pkgs.zstd
      ];
      attrs = {
        inherit usrTree;
      };
    };
}
