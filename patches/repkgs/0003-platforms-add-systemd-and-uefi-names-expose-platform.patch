From 779fdba121674ad4df1d4f3b12b3fa1c179d6689 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 17:51:45 +0000
Subject: [PATCH] platforms: add systemd and uefi names, expose platform

Image builders name an architecture in two ways the table lacks.
systemd-repart --architecture and the discoverable partition type names
say x86-64 and arm64. The UEFI fallback path and systemd-boot's file say
BOOTX64.EFI and systemd-bootx64.efi, with x64 and aa64 as the suffix.

Add both to names for each cpu. powerpc64le has no UEFI port: its uefi
name is null instead of the cpu name.

Return the elaborated platform from nix/set.nix next to pkgs, so a
consumer reads the same record the packages get without evaluating a
package. default.nix still returns pkgs alone.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 nix/platforms.nix | 13 +++++++++++++
 nix/set.nix       |  5 ++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/nix/platforms.nix b/nix/platforms.nix
index 7fb9048..092b930 100644
--- a/nix/platforms.nix
+++ b/nix/platforms.nix
@@ -58,6 +58,8 @@ let
     x86_64 = {
       names = {
         kernel = "x86";
+        systemd = "x86-64";
+        uefi = "x64";
         go = "amd64";
         gyp = "x64";
         openssl = "linux-x86_64";
@@ -69,6 +71,8 @@ let
     aarch64 = {
       names = {
         kernel = "arm64";
+        systemd = "arm64";
+        uefi = "aa64";
         go = "arm64";
         gyp = "arm64";
         clang = "arm64";
@@ -81,6 +85,8 @@ let
     riscv64 = {
       names = {
         kernel = "riscv";
+        systemd = "riscv64";
+        uefi = "riscv64";
         rust = "riscv64gc";
       };
       # -mno-relax: lld 21 leaves R_RISCV_IRELATIVE addends unadjusted after relaxation, so ld.so
@@ -98,6 +104,8 @@ let
     loongarch64 = {
       names = {
         kernel = "loongarch";
+        systemd = "loongarch64";
+        uefi = "loongarch64";
         go = "loong64";
         gyp = "loong64";
       };
@@ -113,6 +121,8 @@ let
     powerpc64le = {
       names = {
         kernel = "powerpc";
+        systemd = "ppc64-le";
+        uefi = null; # no UEFI port
         go = "ppc64le";
         meson = "ppc64";
         gyp = "ppc64";
@@ -159,6 +169,9 @@ let
         gyp = null;
         clang = null; # apple triples say arm64
         openssl = null;
+        # systemd-repart --architecture and DPS partition type names; BOOTX64.EFI (null: no UEFI)
+        systemd = null;
+        uefi = null;
       };
       name = "${cpu}-linux";
       # three spellings of one platform, named by consumer: clang -target, configure --host
diff --git a/nix/set.nix b/nix/set.nix
index 5ba3e60..de0be4c 100644
--- a/nix/set.nix
+++ b/nix/set.nix
@@ -1,4 +1,5 @@
-# The package set for one platform and what it is made from: { pkgs, bootstrap, buildSystems }.
+# The package set for one platform and what it is made from:
+# { pkgs, platform, bootstrap, buildSystems }.
 # default.nix is `pkgs` alone; nix/checks.nix reads the rest.
 {
   system ? builtins.currentSystem,
@@ -250,6 +251,8 @@ in
     else
       self
   );
+  # the elaborated platform record every package receives
+  platform = plat;
   inherit bootstrap buildSystems toolchain;
   bundle = import ./bundle.nix {
     nu = bootstrap.seed;
-- 
2.55.0

