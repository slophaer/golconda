new file mode 100644
index 0000000..fb66b0e
--- /dev/null
+++ b/tests/builder/propagate-a/src/main.c
@@ -0,0 +1,2 @@
+int b_value();
+int main() { return b_value() == 43 ? 0 : 1; }
diff --git a/tests/builder/propagate-a/test.nu b/tests/builder/propagate-a/test.nu
new file mode 100644
index 0000000..723e828
--- /dev/null
+++ b/tests/builder/propagate-a/test.nu
@@ -0,0 +1,24 @@
+# Test that launcher env follows exports.propagate transitively
+# Package A depends on B. B propagates C. C exports env.FOO and env.C_MARKER.
+# The test passes if A's launch record contains FOO, C_MARKER, and B_MARKER.
+
+use checks.nu *
+
+# Read A's launch record
+let record_path = $"($env.pkg)/bin/.test-propagate-a.launch"
+assert "launch record exists" ($record_path | path exists)
+let record = (open $record_path | from json)
+
+# C exports FOO and C_MARKER - they must reach A via B's propagate
+assert "FOO from C via propagate" ($record.env?.FOO? != null)
+assert "C_MARKER from C via propagate" ($record.env?.C_MARKER? != null)
+
+# B exports B_MARKER directly
+assert "B_MARKER from B directly" ($record.env?.B_MARKER? != null)
+
+# Values must use `default` semantics (user env wins)
+assert "FOO uses default semantics" ($record.env.FOO.default? != null)
+assert "C_MARKER uses default semantics" ($record.env.C_MARKER.default? != null)
+assert "B_MARKER uses default semantics" ($record.env.B_MARKER.default? != null)
+
+done
diff --git a/tests/builder/propagate-b/package.nix b/tests/builder/propagate-b/package.nix
new file mode 100644
index 0000000..93b8f04
--- /dev/null
+++ b/tests/builder/propagate-b/package.nix
@@ -0,0 +1,24 @@
+# Package B: links C, propagates C to dependents
+{ package, pkgs }:
+package {
+  name = "test-propagate-b";
+  version = "1";
+  source = ./src;
+  dependencies = [ pkgs.test-propagate-c ];
+  phases = [
+    {
+      name = "build";
+      run = ''
+        mkdir $"($c.out)/lib" $"($c.out)/include"
+        let c_root = (dep-root "test-propagate-c" "link against C")
+        x cc -shared -fPIC lib.c $"-I($c_root)/include" $"-L($c_root)/lib" -lc_propagate -o $"($c.out)/lib/libb_propagate.so"
+        cp b.h $"($c.out)/include/"
+      '';
+    }
+  ];
+  exports = {
+    propagate = [ pkgs.test-propagate-c ];
+    env.B_MARKER = "from-b";
+  };
+  tests.version = false;
+}
