 tests/builder/propagate-a/package.nix | 20 ++++++++++++++++++++
 tests/builder/propagate-a/src/main.c  |  2 ++
 tests/builder/propagate-a/test.nu     | 24 ++++++++++++++++++++++++
 tests/builder/propagate-b/package.nix | 24 ++++++++++++++++++++++++
 tests/builder/propagate-b/src/b.h     |  1 +
 tests/builder/propagate-b/src/lib.c   |  2 ++
 tests/builder/propagate-c/package.nix | 23 +++++++++++++++++++++++
 tests/builder/propagate-c/src/c.h     |  1 +
 tests/builder/propagate-c/src/lib.c   |  1 +
 10 files changed, 106 insertions(+), 3 deletions(-)
