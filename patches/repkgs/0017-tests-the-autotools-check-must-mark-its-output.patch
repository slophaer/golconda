From 100a24ef89cf33da9b995de4a0b8fc6a9b281b0f Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 05:22:10 +0000
Subject: [PATCH] tests: the autotools check must mark its output

The autoreconf test ran its assertion but never created $out, so the
check derivation failed with "failed to produce output path" although
the program ran. Use the checks library like the other tests: assert,
then done.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 tests/builder/autotools/test.nu | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tests/builder/autotools/test.nu b/tests/builder/autotools/test.nu
index a455cc7..00b2bdb 100644
--- a/tests/builder/autotools/test.nu
+++ b/tests/builder/autotools/test.nu
@@ -1,5 +1,8 @@
 # Test that autoreconf with pkg.m4 and libtool.m4 from build tools works
+
+use checks.nu *
+
 let result = (^$"($env.pkg)/bin/hello" | str trim)
-if not ($result | str starts-with "Hello, autotools! zlib version:") {
-  error make {msg: $"Expected output to start with 'Hello, autotools! zlib version:', got '($result)'"}
-}
+assert "hello built by autoreconf runs and found zlib through pkg.m4" ($result | str starts-with "Hello, autotools! zlib version:")
+
+done
-- 
