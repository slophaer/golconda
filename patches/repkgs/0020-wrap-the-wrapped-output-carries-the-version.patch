From 1a042a1eab60d9f3b040838fe1239653d2b70cb2 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 07:43:51 +0000
Subject: [PATCH] wrap: the wrapped output carries the version

The wrapped derivation was named <pname>-wrap (openssh-wrap), so an
SBOM reading the store path or `name` could not tell versions apart.
Name it <pname>-<version>-wrap. It already inherited pname and
version; it now also exposes `wraps`, the wrapped package, which
Golconda's merge.nix (standsInFor) and app.nix wrapApp read.

tests/builder/wrap checks the name, the store path suffix, that the
launcher exists, and (at eval time) wraps/pname/version.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 nix/wrap.nix               | 15 ++++++++-------
 tests/builder/default.nix  | 16 ++++++++++++++++
 tests/builder/wrap/test.nu |  5 +++++
 3 files changed, 29 insertions(+), 7 deletions(-)
 create mode 100644 tests/builder/wrap/test.nu

diff --git a/nix/wrap.nix b/nix/wrap.nix
index d5ecb8f..472f70b 100644
--- a/nix/wrap.nix
+++ b/nix/wrap.nix
@@ -2,6 +2,7 @@
 # For each bin/<x> of the wrapped package, writes bin/.<x>.launch as a chained record:
 #   { program: "{store}/<hash>-pkg/bin/<x>", args: argv, env: env }
 # Links the rest of the package's trees (share/, lib/, etc.) so the wrapper stands in.
+# The output is named <pname>-<version>-wrap and carries pname, version and wraps.
 # files are written under share/wrap/<name>/ so argv can reference them as {root}/share/wrap/<name>/<file>.
 {
   platform,
@@ -58,13 +59,11 @@ let
           mkdir $share_dir
         }
         mkdir $"($share_dir)/wrap/${package.pname}"
-        ${
-          concatStringsSep "\n" (
-            map (n: ''${toJSON files.${n}} | save -f $"($share_dir)/wrap/${package.pname}/${n}"'') (
-              attrNames files
-            )
+        ${concatStringsSep "\n" (
+          map (n: ''${toJSON files.${n}} | save -f $"($share_dir)/wrap/${package.pname}/${n}"'') (
+            attrNames files
           )
-        }
+        )}
       '';
 
   script = ''
@@ -88,7 +87,7 @@ let
   '';
 
   drv = derivation {
-    name = "${package.pname}-wrap";
+    name = "${package.pname}-${package.version}-wrap";
     inherit (platform) system;
     __structuredAttrs = true;
     __contentAddressed = true;
@@ -118,6 +117,8 @@ in
 drv
 // {
   inherit (package) pname version;
+  # the package this one stands in for (Golconda's merge.nix reads it)
+  wraps = package;
   platform = platform.name;
   supported = package.supported or true;
   unsupportedReason = package.unsupportedReason or null;
diff --git a/tests/builder/default.nix b/tests/builder/default.nix
index fb59516..ad2f011 100644
--- a/tests/builder/default.nix
+++ b/tests/builder/default.nix
@@ -63,5 +63,21 @@ mapAttrs (
       else
         { }
     )
+    // (
+      # nix/wrap.nix: the wrapped output's name carries the version, `wraps` names the package
+      if name == "wrap" then
+        let
+          inner = set.pkgs.test-tz;
+          wrapped = set.wrap { package = inner; };
+        in
+        assert wrapped.wraps == inner && wrapped.version == inner.version && wrapped.pname == inner.pname;
+        {
+          inherit wrapped;
+          wrappedName = wrapped.name;
+          wrappedWant = "${inner.pname}-${inner.version}-wrap";
+        }
+      else
+        { }
+    )
   )
 ) tests
diff --git a/tests/builder/wrap/test.nu b/tests/builder/wrap/test.nu
new file mode 100644
index 0000000..c439fec
--- /dev/null
+++ b/tests/builder/wrap/test.nu
@@ -0,0 +1,5 @@
+use checks.nu *
+assert "wrapped name carries the version" ($env.wrappedName == $env.wrappedWant)
+assert "store path ends with the name" ($env.wrapped | str ends-with $"-($env.wrappedWant)")
+assert "launcher written" ($"($env.wrapped)/bin/.tz.launch" | path exists)
+done
-- 
