From e3f2fa43b8a9ef2a8ab752fb5cac909f5ec52633 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 19:28:51 +0000
Subject: [PATCH 8/8] package: expose bin at evaluation time

A symlink farm that merges many packages' bin/ directories must refuse
two packages that install the same name. Reading exports.json for that
is import-from-derivation; the names are known before the build. Add
`bin` to the derivation's attributes: the spec's `bin` list, else the
package name, the same default finish applies when it writes exports.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 nix/package.nix | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/nix/package.nix b/nix/package.nix
index 3cff1dc..8e66f69 100644
--- a/nix/package.nix
+++ b/nix/package.nix
@@ -620,6 +620,10 @@ drv
 // {
   pname = name;
   platform = platform.name;
+  # the executables the package declares (`bin`, else its name), readable at evaluation time
+  # without IFD; a symlink farm checks duplicates with it. finish writes the same list into
+  # exports.json after seeing what was installed
+  bin = args.bin or [ name ];
   # what package.nix wrote and read, for `variant`
   args = args0;
   sources = sources0;
