From 045abbd92f50065abdb334e04541c7d918d136fe Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 19:22:42 +0000
Subject: [PATCH] closure: tar of a closure with a bin/ profile

Add pkgs.closure { roots; name; } to produce a tarball containing:
- nix/store/<hash>-* for every runtime path of the roots (via exportReferencesGraph)
- bin/ with relative symlinks to the roots' launchers

On any Linux host, 'tar x && PATH=$PWD/bin:$PATH' runs the tools.
Requirements: /proc mounted (for crt-interp and $ORIGIN). Glibc is inside
the closure, so no system libc is needed.

This function does not use nix/bundle.nix because that strips launchers
and expects a host libc. The closure preserves the full repkgs relocation
mechanism: launch records, relative symlinks, and PT_INTERP via crt-interp.

nix/closure.nix: Nix helper that builds the derivation
builder/closure.nu: Builder module that copies closure and creates profile

Signed-off-by: yolobox <yolobox@phaer.org>
---
 builder/closure.nu | 85 ++++++++++++++++++++++++++++++++++++++++++++++
 nix/closure.nix    | 80 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 165 insertions(+)
 create mode 100644 builder/closure.nu
 create mode 100644 nix/closure.nix

diff --git a/builder/closure.nu b/builder/closure.nu
new file mode 100644
index 0000000..e2e407d
--- /dev/null
+++ b/builder/closure.nu
@@ -0,0 +1,85 @@
+# closure: create a tarball of a closure with a bin/ profile.
+# The tarball holds:
+#   nix/store/<hash>-* for every runtime path of the roots
+#   bin/ with relative symlinks to the roots' launchers
+# On any Linux host: tar x && PATH=$PWD/bin:$PATH runs the tools.
+
+use core.nu *
+
+# Read the closure from exportReferencesGraph
+def read-closure []: nothing -> list<string> {
+  let attrs = (open $env.NIX_ATTRS_JSON_FILE)
+  # The closure is in attrs.closure as a list of { path, ... } records
+  $attrs.closure | get path
+}
+
+# Create relative symlink from bin/<name> to the store binary
+def relative-link [from: string, to: string]: nothing -> string {
+  # from: /build/out/bin/<name>
+  # to: /nix/store/<hash>-pkg/bin/<name>
+  # result: ../nix/store/<hash>-pkg/bin/<name>
+  let from_parts = ($from | path split)
+  let to_parts = ($to | path split)
+  # Count common prefix
+  let common = ($from_parts | zip $to_parts | take while { $in.0 == $in.1 } | length)
+  let up = ($from_parts | skip $common | drop 1 | each { ".." })
+  let down = ($to_parts | skip $common)
+  $up ++ $down | path join
+}
+
+# Main entry point
+export def main [roots: list<string>, name: string]: nothing -> nothing {
+  let out = $env.out
+  let closure = (read-closure)
+
+  print -e $"closure: ($closure | length) paths in closure"
+
+  # Create a temporary build directory
+  let build = $"($env.NIX_BUILD_TOP)/closure-build"
+  mkdir $build
+  let store_dir = $"($build)/nix/store"
+  mkdir $store_dir
+
+  # Copy all closure paths
+  for p in $closure {
+    let basename = ($p | path basename)
+    print -e $"closure: copying ($basename)"
+    ^cp -a $p $"($store_dir)/($basename)"
+  }
+
+  # Make everything writable so tar can read it
+  ^chmod -R u+w $build
+
+  # Create bin/ with symlinks to roots' launchers
+  mkdir $"($build)/bin"
+  for root in $roots {
+    let bindir = $"($root)/bin"
+    if not ($bindir | path exists) {
+      continue
+    }
+
+    # Find all launchers (files or symlinks in bin/, not hidden)
+    for f in (ls $bindir | get name | where { ($in | path basename) !~ '^\.' }) {
+      let bname = ($f | path basename)
+      let dest = $"($build)/bin/($bname)"
+
+      if ($dest | path exists) {
+        continue  # skip duplicates
+      }
+
+      # Create relative symlink to the store copy
+      let rel_root = ($root | path basename)
+      let target = $"../nix/store/($rel_root)/bin/($bname)"
+      ^ln -sf $target $dest
+
+      print -e $"closure: bin/($bname) -> ($target)"
+    }
+  }
+
+  # Create the tarball
+  mkdir $out
+  cd $build
+  ^tar -cf $"($out)/($name).tar" nix bin
+
+  print -e $"closure: ($name).tar created"
+}
diff --git a/nix/closure.nix b/nix/closure.nix
new file mode 100644
index 0000000..3583002
--- /dev/null
+++ b/nix/closure.nix
@@ -0,0 +1,80 @@
+# closure { roots; name; }: a tarball of the closure of roots with a bin/ profile.
+# The tarball holds:
+#   <prefix>/nix/store/<hash>-* for every runtime path of the roots
+#   bin/ with relative symlinks to the roots' launchers
+# On any Linux host: tar x && PATH=$PWD/bin:$PATH runs the tools (needs /proc; glibc is inside).
+{
+  platform,
+  launch,
+  baseTools,
+  nu,
+}:
+let
+  inherit (builtins)
+    concatStringsSep
+    map
+    ;
+  tree = builtins.path {
+    path = ../builder;
+    name = "build";
+  };
+  nuArgs = [
+    "--no-config-file"
+    "--include-path=${tree}"
+    "--experimental-options=[cell-path-types]"
+    "-c"
+  ];
+in
+{
+  roots,
+  name,
+}:
+let
+  script = ''
+    use core.nu *
+    use closure.nu
+
+    # parse structured attrs
+    let attrs = (open $env.NIX_ATTRS_JSON_FILE)
+    $env.out = $attrs.outputs.out
+    $env.NIX_STORE = "/nix/store"
+    $env.PATH = $attrs.PATH
+
+    # call the closure builder
+    closure $attrs.roots $attrs.name
+  '';
+
+  drv = derivation {
+    inherit name;
+    inherit (platform) system;
+    __structuredAttrs = true;
+    __contentAddressed = true;
+    outputHashMode = "recursive";
+    outputHashAlgo = "sha256";
+    builder = "${nu}/bin/nu";
+    args = nuArgs ++ [ script ];
+    outputs = [ "out" ];
+    inherit roots;
+    # Nix computes the closure and passes it as a structured reference graph
+    exportReferencesGraph.closure = roots;
+    platform = {
+      inherit (platform)
+        name
+        binfmt
+        ;
+      launch =
+        if platform.binfmt == "elf" then
+          "${launch}/bin/launch"
+        else if platform.os == "windows" then
+          "${launch}/bin/launch.exe"
+        else
+          "";
+    };
+    PATH = concatStringsSep ":" (map (t: "${t}/bin") baseTools.full);
+  };
+in
+drv
+// {
+  pname = name;
+  platform = platform.name;
+}
-- 
