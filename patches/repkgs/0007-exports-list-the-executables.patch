From 25e7e6e08b211491d9e5bf4305b36e7b02733e4c Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 19:27:49 +0000
Subject: [PATCH 7/8] exports: list the executables

Add a 'bin' field to exports.json listing the executable names in bin/
(user-facing launchers, not hidden .foo binaries). A symlink farm can
check for duplicate names at build time.

Note: reading exports.json at Nix eval time requires IFD. For pure eval,
package.nix should expose 'bin' as a passthru attribute from the spec's
bin field (or [name] when unset), and the composer checks duplicates
against that list instead of the store output.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 builder/exports.nu | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/builder/exports.nu b/builder/exports.nu
index 7d83f83..cbf6b47 100644
--- a/builder/exports.nu
+++ b/builder/exports.nu
@@ -57,9 +57,21 @@ export def write-exports [out: string, spec: record, platform: record, deps: lis
   let exports = ($exports | update propagate { $in ++ (required-deps $out $deps $exports) | uniq })
   let rel = {|s| $s | str replace -a $out "{root}" | str replace -a $env.NIX_STORE "{store}" }
   let exports = (if ($exports.dllDirs | is-empty) { $exports | reject dllDirs } else { $exports | update dllDirs { each { do $rel $in } } })
+  # bin: the executable names in bin/ (not hidden launchers)
+  let bin = (list-bin $out $platform)
+  let exports = ($exports | insert bin $bin)
   $exports | to json | save -f $"($out)/exports.json"
 }
 
+# list executable names in bin/ (the user-facing launchers, not .foo hidden binaries)
+def list-bin [out: path, platform: record]: nothing -> list<string> {
+  let bindir = $"($out)/bin"
+  if not ($bindir | path exists) { return [] }
+  let ext = ($platform.ext?.exe? | default "")
+  ls $bindir | get name | where { ($in | path basename) !~ '^\.' }
+  | each { $in | path basename | str replace -r $"($ext)$" "" }
+}
+
 # dependencies our .pc files (Requires) and cmake configs (find_dependency) name: a consumer
 # needs those on its search paths too. Names no dependency provides are optional backends
 # (curl: GnuTLS) or our own sibling .pc files
