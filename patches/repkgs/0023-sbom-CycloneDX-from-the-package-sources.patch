From 3b054d1b61c742dfcb559ea8b91d11a3e8dc593d Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 06:19:40 +0000
Subject: [PATCH] sbom: CycloneDX from the package sources

nix/sbom.nix, exposed by the set as `sbom { roots = [ drv ]; name; }`:
a derivation whose output holds sbom.json (CycloneDX 1.5: bomFormat,
specVersion, metadata, components with type/name/version/purl/hashes,
and the dependency graph). No IFD. The closure is the `dependencies`
attribute of the package derivations (package.nix's list plus [pin] sys
libraries and the build systems' own), walked with genericClosure and
deduplicated by derivation name. Version, purl and hash come from the
package's dir/sources.toml ([upstream] purl, pinned version or tag) and
the source fetch's outputHash. Written with builtins.toJSON.

tests/sbom.nix (also `sbom` in nix/checks.nix) asserts the shape and
that jq lists glibc, jq and oniguruma with purls.

Approximations:
- Toolchain and bootstrap stages have no package.nix/sources.toml. glibc
  is a stage: it is read from pkgs/gl/glibc/sources.toml and added as an
  implicit dependency of every other component (ELF links), not from
  real references. Other dir-less derivations (seed, cc) would get name
  only, a golconda:approximation property and no purl/version/hash.
- Hashes are SHA-256 of the unpacked source tree (the NAR hash the
  fetch fixes), not of the upstream tarball.
- A purl's uptrack query (?url=&regex=) is dropped; the version is
  appended (the tag for github/gitlab purls).
- Build-only dependencies are left out on purpose. The libc entry is
  absent when cross-compiling or off linux.
- Dependencies are the declared graph, not store references: a package
  that links something it does not declare is not seen.

Tested: nix-build tests/sbom.nix (daemon); treefmt via shell.nix.
Signed-off-by: yolobox <yolobox@phaer.org>
---
 nix/checks.nix |   1 +
 nix/sbom.nix   | 189 +++++++++++++++++++++++++++++++++++++++++++++++++
 nix/set.nix    |  14 ++++
 tests/sbom.nix |  68 ++++++++++++++++++
 4 files changed, 272 insertions(+)
 create mode 100644 nix/sbom.nix
 create mode 100644 tests/sbom.nix

diff --git a/nix/checks.nix b/nix/checks.nix
index bbfdad0..6743ae8 100644
--- a/nix/checks.nix
+++ b/nix/checks.nix
@@ -37,6 +37,7 @@ lib.mergeAttrsList (map forPlatform platforms)
 // prefixed "tests-" separateTests
 // prefixed "builder-" (import ../tests/builder { inherit system; })
 // {
+  sbom = import ../tests/sbom.nix { inherit system; };
   treefmt =
     pkgs.runCommand "treefmt-check"
       {
diff --git a/nix/sbom.nix b/nix/sbom.nix
new file mode 100644
index 0000000..d5ed50b
--- /dev/null
+++ b/nix/sbom.nix
@@ -0,0 +1,189 @@
+# A CycloneDX 1.5 SBOM for the runtime closure of some packages, from evaluation alone (no IFD).
+#   sbom { roots = [ pkgs.jq ]; name = "jq"; }   a derivation whose output has sbom.json
+# The closure is the `dependencies` graph of the packages (the attribute nix/package.nix hands to
+# the derivation: package.nix's own list plus [pin] sys libraries and the build systems'), not the
+# store references. Version, purl and source hash come from each package's directory:
+# `dir`/sources.toml `[upstream] purl`, the pinned version (`version`) and the source fetch's
+# `outputHash` (`src`). `libc0` ({ name, dir } or null) is implicit in every ELF link and a bootstrap
+# stage with no package of its own, so it joins as a component read from its directory's
+# sources.toml, and in the dependsOn of each other one.
+#
+# Approximations, all marked with a `golconda:approximation` property on the component:
+#  - a derivation without `dir` (toolchain, bootstrap stages, seed) has no sources.toml: name and
+#    derivation name only, no purl, no version, no hash
+#  - hashes are SHA-256 of the unpacked source tree (the NAR hash of what the fetch yields), not
+#    of the upstream tarball
+#  - a purl's query (uptrack's `?url=…&regex=…` of pkg:generic) is dropped
+#  - build-only tools (`buildDependencies`) are left out on purpose: they are not in the runtime
+#    closure
+{
+  nu,
+  system,
+  libc0 ? null,
+}:
+{
+  roots,
+  name ? "sbom",
+}:
+let
+  inherit (builtins)
+    convertHash
+    elemAt
+    filter
+    fromTOML
+    genericClosure
+    head
+    match
+    pathExists
+    readFile
+    sort
+    split
+    toJSON
+    ;
+
+  # a stand-in package for the libc stage, from its sources.toml
+  libc =
+    if libc0 == null then
+      null
+    else
+      let
+        t = fromTOML (readFile (libc0.dir + "/sources.toml"));
+      in
+      {
+        inherit (libc0) name dir;
+        pname = libc0.name;
+        version = t.pin.version;
+        src.outputHash = (head t.source).hash;
+        dependencies = [ ];
+      };
+
+  key = p: p.name;
+  # `dependencies` of a package; anything that is not a package has none
+  depsOf = p: p.dependencies or (p.args.dependencies or [ ]);
+  withLibc = if libc == null then roots else roots ++ [ libc ];
+  closure = genericClosure {
+    startSet = map (p: {
+      key = key p;
+      inherit p;
+    }) withLibc;
+    operator =
+      n:
+      map (d: {
+        key = key d;
+        p = d;
+      }) (depsOf n.p);
+  };
+  pkgsOf = map (n: n.p) closure;
+
+  tomlOf =
+    p:
+    if p ? dir && pathExists (p.dir + "/sources.toml") then
+      fromTOML (readFile (p.dir + "/sources.toml"))
+    else
+      null;
+
+  # pkg:github/jqlang/jq?x=y -> pkg:github/jqlang/jq@v1.8.1
+  purlOf =
+    p: t:
+    let
+      base = head (split "\\?" t.upstream.purl);
+      type = elemAt (match "pkg:([a-z]+)/.*" base) 0;
+      pin = t.pin or { };
+      v = if type == "github" || type == "gitlab" then pin.tag or p.version else p.version;
+    in
+    "${base}@${v}";
+
+  # sha256-<base64> of the source fetch -> {alg, content hex}; a local source has no outputHash
+  hashesOf =
+    p:
+    let
+      h = (p.src or { }).outputHash or null;
+    in
+    if h == null || match "sha256-.*" h == null then
+      [ ]
+    else
+      [
+        {
+          alg = "SHA-256";
+          content = convertHash {
+            hash = h;
+            toHashFormat = "base16";
+          };
+        }
+      ];
+
+  isLibc = p: libc != null && key p == key libc;
+  ref = p: if p ? version then "${p.pname or p.name}@${p.version}" else key p;
+
+  component =
+    p:
+    let
+      t = tomlOf p;
+      known = t != null && t ? upstream.purl && p ? version;
+      hashes = if t == null then [ ] else hashesOf p;
+    in
+    {
+      type = if builtins.elem p roots then "application" else "library";
+      bom-ref = ref p;
+      name = p.pname or p.name;
+    }
+    // (if p ? version && p.version != "" then { inherit (p) version; } else { })
+    // (if known then { purl = purlOf p t; } else { })
+    // (if hashes == [ ] then { } else { inherit hashes; })
+    // (
+      if known then
+        { }
+      else
+        {
+          properties = [
+            {
+              name = "golconda:approximation";
+              value = "no sources.toml purl: name from the derivation, no purl";
+            }
+          ];
+        }
+    );
+
+  graph = map (p: {
+    ref = ref p;
+    dependsOn = map ref (
+      (if libc != null && !isLibc p then [ libc ] else [ ]) ++ filter (d: !isLibc d) (depsOf p)
+    );
+  }) pkgsOf;
+
+  bom = {
+    bomFormat = "CycloneDX";
+    specVersion = "1.5";
+    version = 1;
+    metadata.component = {
+      type = "application";
+      inherit name;
+      bom-ref = name;
+    };
+    components = sort (a: b: a.bom-ref < b.bom-ref) (map component pkgsOf);
+    dependencies = [
+      {
+        ref = name;
+        dependsOn = map ref roots;
+      }
+    ]
+    ++ sort (a: b: a.ref < b.ref) graph;
+  };
+in
+derivation {
+  name = "${name}-sbom";
+  inherit system;
+  __contentAddressed = true;
+  outputHashMode = "recursive";
+  outputHashAlgo = "sha256";
+  json = builtins.toFile "sbom.json" (toJSON bom);
+  builder = "${nu}/bin/nu";
+  args = [
+    "--no-config-file"
+    "-c"
+    "mkdir $env.out; cp $env.json ($env.out | path join sbom.json)"
+  ];
+}
+// {
+  inherit bom;
+}
diff --git a/nix/set.nix b/nix/set.nix
index bccee39..43d774e 100644
--- a/nix/set.nix
+++ b/nix/set.nix
@@ -265,6 +265,20 @@ in
     inherit launch;
     nu = bootstrap.seed;
   };
+  # sbom { roots = [ pkgs.jq ]; name = "jq"; }: CycloneDX 1.5 of the packages' sources (nix/sbom.nix)
+  sbom = import ./sbom.nix {
+    nu = bootstrap.seed;
+    inherit system;
+    # the stage's libc has no package.nix; its sources.toml is the record
+    libc0 =
+      if plat.cross || os != "linux" then
+        null
+      else
+        {
+          name = "glibc";
+          dir = ../pkgs/gl/glibc;
+        };
+  };
   closure = import ./closure.nix {
     inherit baseTools;
     platform = plat;
diff --git a/tests/sbom.nix b/tests/sbom.nix
new file mode 100644
index 0000000..1071282
--- /dev/null
+++ b/tests/sbom.nix
@@ -0,0 +1,68 @@
+# nix/sbom.nix: the CycloneDX shape and jq's closure, asserted at evaluation, then the file built.
+#   nix-build tests/sbom.nix        (the output is the sbom.json directory)
+{
+  system ? builtins.currentSystem,
+}:
+let
+  set = import ../nix/set.nix { inherit system; };
+  inherit (builtins)
+    all
+    elem
+    isString
+    match
+    ;
+  jq = set.sbom {
+    roots = [ set.pkgs.jq ];
+    name = "jq";
+  };
+  inherit (jq) bom;
+  names = map (c: c.name) bom.components;
+  byName = n: builtins.head (builtins.filter (c: c.name == n) bom.components);
+  hex = h: match "[0-9a-f]{64}" h != null;
+  shaped =
+    c:
+    isString c.name
+    && elem c.type [
+      "application"
+      "library"
+    ]
+    && isString c.version
+    && match "pkg:[a-z]+/.+@.+" c.purl != null
+    && all (h: h.alg == "SHA-256" && hex h.content) c.hashes
+    && c.hashes != [ ];
+  refs = map (c: c.bom-ref) bom.components;
+  graphOk = all (d: all (r: elem r refs) d.dependsOn) (builtins.tail bom.dependencies);
+in
+assert bom.bomFormat == "CycloneDX";
+assert bom.specVersion == "1.5";
+assert
+  names == [
+    "glibc"
+    "jq"
+    "oniguruma"
+  ];
+assert all shaped bom.components;
+assert (byName "jq").purl == "pkg:github/jqlang/jq@jq-${set.pkgs.jq.version}";
+assert (byName "oniguruma").purl == "pkg:github/kkos/oniguruma@v6.9.10";
+assert (byName "glibc").purl == "pkg:gnu/glibc@${(byName "glibc").version}";
+# every edge points at a listed component, and the roots hang off the document
+assert graphOk;
+assert (builtins.head bom.dependencies).dependsOn == [ (byName "jq").bom-ref ];
+# the second pass must not add a component twice
+assert
+  (set.sbom {
+    roots = [
+      set.pkgs.jq
+      set.pkgs.jq
+      set.pkgs.oniguruma
+    ];
+  }).bom.components != [ ]
+  &&
+    map (c: c.name)
+      (set.sbom {
+        roots = [
+          set.pkgs.jq
+          set.pkgs.oniguruma
+        ];
+      }).bom.components == names;
+jq
-- 
