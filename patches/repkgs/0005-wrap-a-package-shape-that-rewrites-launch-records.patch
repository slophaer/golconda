From ec67f4f4b68d73078b7a237390b3369ca9bd82f8 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 19:17:58 +0000
Subject: [PATCH] wrap: a package shape that rewrites launch records

Add pkgs.wrap { package; argv; env; files; } to create wrappers that chain
to another package's launchers. For each bin/<x> of the wrapped package,
writes bin/.<x>.launch as a chained record:

  { program: "{store}/<hash>-pkg/bin/<x>", args: argv, env: env }

The wrapper links the rest of the package's trees (share/, lib/, etc.) so
it stands in for the original. Files in the 'files' attribute are written
under share/wrap/<name>/ and argv can reference them as:

  {root}/share/wrap/<name>/<file>

The output passes repkgs' finish checks:
- No absolute store path in any file (uses placeholders)
- Relative symlinks for lib/share/include (relocatable)
- Relative symlinks to launch binary

Never sets argv0 in a chained record to avoid launch loop.

nix/wrap.nix: Nix helper that builds the derivation
builder/wrap.nu: Builder module that creates launchers and links trees
nix/set.nix: Exports wrap from the set

Signed-off-by: yolobox <yolobox@phaer.org>
---
 builder/wrap.nu | 113 ++++++++++++++++++++++++++++++++++++++++++++++++
 nix/set.nix     |  12 +++++
 nix/wrap.nix    |  99 ++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 224 insertions(+)
 create mode 100644 builder/wrap.nu
 create mode 100644 nix/wrap.nix

diff --git a/builder/wrap.nu b/builder/wrap.nu
new file mode 100644
index 0000000..ae2c0ad
--- /dev/null
+++ b/builder/wrap.nu
@@ -0,0 +1,113 @@
+# wrap: create launch records that chain to a wrapped package's binaries.
+# For each bin/<x> of the package, writes bin/.<x>.launch with:
+#   { program: "{store}/<hash>-pkg/bin/<x>", args: argv, env: env }
+# Links the rest of the package's trees so the wrapper stands in for the original.
+
+use core.nu *
+
+# store paths -> {root}/{store} templates launch expands
+def storerel [p: string, out: string]: nothing -> string {
+  $p | str replace -a $out "{root}" | str replace -a $env.NIX_STORE "{store}"
+}
+
+# link at `from` pointing to `to`, both absolute: the relative target
+def relative-link [from: string, to: string]: nothing -> string {
+  let f = ($from | path split | drop 1 | skip 1)
+  let t = ($to | path split | skip 1)
+  let common = ($f | zip $t | take while { $in.0 == $in.1 } | length)
+  $f | skip $common | each { ".." } | append ($t | skip $common) | path join
+}
+
+# Link directory contents from the package to the wrapper output.
+# Does not link bin/ (we create our own launchers there).
+def link-tree [pkg: string, out: string]: nothing -> nothing {
+  mkdir $out
+  let entries = (ls $pkg | where name !~ '/bin$' | where name !~ '/exports\.json$')
+  for e in $entries {
+    let rel = ($e.name | path relative-to $pkg)
+    let target = $"($out)/($rel)"
+    let link = (relative-link $target $e.name)
+    ^ln -sf $link $target
+  }
+}
+
+# Read the platform record from structured attrs
+def get-platform []: nothing -> record {
+  open $env.NIX_ATTRS_JSON_FILE | get platform
+}
+
+# Main entry point: create launchers for all binaries in the package
+export def main [pkg: string, argv: list<string>, env_spec: record]: nothing -> nothing {
+  let platform = (get-platform)
+  let out = $env.out
+  let bindir = $"($pkg)/bin"
+
+  # Link non-bin trees from the wrapped package
+  link-tree $pkg $out
+
+  # If no bin/ in the package, we're done
+  if not ($bindir | path exists) {
+    return
+  }
+
+  mkdir $"($out)/bin"
+
+  # Find all executables in bin/ (skip hidden files which are already launchers)
+  let entries = (ls $bindir | get name | where { ($in | path basename) !~ '^\.' })
+
+  for f in $entries {
+    let name = ($f | path basename)
+    let exe = $platform.ext?.exe? | default ""
+
+    # The program path in the chained record points to the wrapped package's binary
+    # If the original is already a launcher (symlink to launch), chain to its .name instead
+    let target = (if ($f | path type) == "symlink" and (^readlink $f | path basename) == "launch" {
+      # It's a launcher - chain to the real program
+      $"($bindir)/.($name)"
+    } else {
+      $f
+    })
+
+    # Convert env to the record format: { VAR: { op: value } }
+    # Also apply storerel to values
+    let env_record = ($env_spec | items {|k, v|
+      let ops = ($v | items {|op, val|
+        let expanded = (if ($val | describe) =~ "list" {
+          $val | each { storerel $in $out }
+        } else {
+          storerel $val $out
+        })
+        [$op $expanded]
+      } | into record)
+      [$k $ops]
+    } | into record)
+
+    # Build the launch record
+    # Never set argv0 in a chained record - it would loop
+    let record = {
+      program: (storerel $target $out)
+      args: ($argv | each { storerel $in $out })
+      env: $env_record
+    } | (if ($in.args | is-empty) { reject args } else { $in })
+      | (if ($in.env | is-empty) { reject env } else { $in })
+
+    # Write the launch record
+    $record | to json -r | save -f $"($out)/bin/.($name)($exe).launch"
+
+    # Create the launcher symlink/copy (relative, for relocatability)
+    if $platform.binfmt == "coff" {
+      cp $platform.launch $"($out)/bin/($name)($exe)"
+    } else {
+      let link = (relative-link $"($out)/bin/($name)" $platform.launch)
+      ^ln -sf $link $"($out)/bin/($name)"
+    }
+
+    print -e $"wrap: bin/($name) -> ($target)"
+  }
+
+  # Write exports.json so this package can be a dependency
+  {
+    name: ($pkg | path basename | str substring 33.. | str replace -r '-(x86_64|aarch64|riscv64|loongarch64|powerpc64le)-[\w-]+$' '' | $"($in)-wrap")
+    exports: false
+  } | to json | save -f $"($out)/exports.json"
+}
diff --git a/nix/set.nix b/nix/set.nix
index de0be4c..bccee39 100644
--- a/nix/set.nix
+++ b/nix/set.nix
@@ -259,4 +259,16 @@ in
     tools = [ buildPkgs.formatelf ] ++ baseTools.bootstrap;
     tree = ../builder;
   };
+  wrap = import ./wrap.nix {
+    inherit baseTools;
+    platform = plat;
+    inherit launch;
+    nu = bootstrap.seed;
+  };
+  closure = import ./closure.nix {
+    inherit baseTools;
+    platform = plat;
+    inherit launch;
+    nu = bootstrap.seed;
+  };
 }
diff --git a/nix/wrap.nix b/nix/wrap.nix
new file mode 100644
index 0000000..628bece
--- /dev/null
+++ b/nix/wrap.nix
@@ -0,0 +1,99 @@
+# wrap { package; argv ? []; env ? {}; files ? {}; }: a package that wraps another.
+# For each bin/<x> of the wrapped package, writes bin/.<x>.launch as a chained record:
+#   { program: "{store}/<hash>-pkg/bin/<x>", args: argv, env: env }
+# Links the rest of the package's trees (share/, lib/, etc.) so the wrapper stands in.
+# files are written under share/wrap/<name>/ so argv can reference them as {root}/share/wrap/<name>/<file>.
+{
+  platform,
+  launch,
+  baseTools,
+  nu,
+}:
+let
+  inherit (builtins)
+    concatStringsSep
+    attrNames
+    toJSON
+    map
+    ;
+  tree = builtins.path {
+    path = ../builder;
+    name = "build";
+  };
+  nuArgs = [
+    "--no-config-file"
+    "--include-path=${tree}"
+    "--experimental-options=[cell-path-types]"
+    "-c"
+  ];
+in
+{
+  package,
+  argv ? [ ],
+  env ? { },
+  files ? { },
+}:
+let
+  # write each file to share/wrap/<name>/ at build time
+  filesScript = concatStringsSep "\n" (
+    map (n: ''
+      mkdir $"($env.out)/share/wrap/${package.pname}"
+      ${toJSON files.${n}} | save -f $"($env.out)/share/wrap/${package.pname}/${n}"
+    '') (attrNames files)
+  );
+
+  script = ''
+    use core.nu *
+    use wrap.nu
+
+    # parse structured attrs
+    let attrs = (open $env.NIX_ATTRS_JSON_FILE)
+    $env.out = $attrs.outputs.out
+    $env.NIX_STORE = ($env.out | path dirname)
+    # Set PATH from the derivation attribute
+    $env.PATH = $attrs.PATH
+
+    # make files directory
+    ${filesScript}
+
+    # call the wrap builder
+    let argv = ('${toJSON argv}' | from json)
+    let env_spec = ('${toJSON env}' | from json)
+    wrap $attrs.package $argv $env_spec
+  '';
+
+  drv = derivation {
+    name = "${package.pname}-wrap";
+    inherit (platform) system;
+    __structuredAttrs = true;
+    __contentAddressed = true;
+    outputHashMode = "recursive";
+    outputHashAlgo = "sha256";
+    builder = "${nu}/bin/nu";
+    args = nuArgs ++ [ script ];
+    outputs = [ "out" ];
+    inherit package;
+    platform = {
+      inherit (platform)
+        name
+        binfmt
+        ;
+      ext = platform.ext or { };
+      launch =
+        if platform.binfmt == "elf" then
+          "${launch}/bin/launch"
+        else if platform.os == "windows" then
+          "${launch}/bin/launch.exe"
+        else
+          "";
+    };
+    PATH = concatStringsSep ":" (map (t: "${t}/bin") baseTools.full);
+  };
+in
+drv
+// {
+  inherit (package) pname version;
+  platform = platform.name;
+  supported = package.supported or true;
+  unsupportedReason = package.unsupportedReason or null;
+}
-- 
