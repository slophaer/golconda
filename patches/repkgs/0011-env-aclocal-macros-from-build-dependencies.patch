From 421e8fd7368304bfa39480bfae9d089926217ccb Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 00:34:05 +0000
Subject: [PATCH] env: aclocal macros from build dependencies

Autoconf-based projects use macros from build tools: pkg.m4 from
pkgconf (PKG_CHECK_MODULES), libtool.m4 and ltoptions.m4 from libtool
(LT_INIT), and automake's own macros. These m4 files live in each
tool's share/aclocal and must be in ACLOCAL_PATH for aclocal to find
them.

Before: ACLOCAL_PATH only included runtime dependencies' aclocalDirs.
After:  ACLOCAL_PATH includes build dependencies' aclocalDirs first,
        then runtime dependencies'.

This fixes autoreconf for packages like erofs-utils that use
PKG_CHECK_MODULES and LT_INIT with pkgconf and libtool in
buildDependencies:

  configure.ac:42: error: undefined or overquoted macro: AC_MSG_ERROR
  configure.ac:57: error: undefined or overquoted macro: AS_IF

Now both macros are found from the build tools.

Signed-off-by: helferlein <helferlein@example.com>
---
 builder/env.nu | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/builder/env.nu b/builder/env.nu
index f03b08a..22a8444 100644
--- a/builder/env.nu
+++ b/builder/env.nu
@@ -35,11 +35,14 @@ def store-roots [a: record, deps: list<record>]: nothing -> list<string> {
 # header names map back to, and a prefix map so no build or store path lands in DWARF/__FILE__
 def toolchain [a: record, deps: list<record>]: nothing -> record {
   let mask = {|p: string, under: string| $"($p)=/($under)/($p | path basename | str substring 33..)" }
+  # aclocal macros from build tools (automake, libtool, pkgconf) and runtime deps
+  let build_aclocal = ($a.buildDependencies | each {|p| (exports-of $p).aclocalDirs | each {|d| $"($p)/($d)"} } | flatten)
+  let deps_aclocal = (dep-dirs $deps aclocalDirs)
   {
     CC: cc, CXX: c++, AR: llvm-ar, RANLIB: llvm-ranlib, NM: llvm-nm, STRIP: llvm-strip
     PKG_CONFIG_PATH: (dep-dirs $deps pkgconfigDirs | str join ":")
     CMAKE_PREFIX_PATH: ($deps | get root | str join ";")
-    ACLOCAL_PATH: (dep-dirs $deps aclocalDirs | str join ":")
+    ACLOCAL_PATH: ($build_aclocal ++ $deps_aclocal | str join ":")
     JIG_LOG: $"($env.NIX_BUILD_TOP)/jig.log"
     JIG_LOG_ARGS: $"($env.NIX_BUILD_TOP)/jig-uncached.log"
     JIG_STORE_IDENTITY: content
