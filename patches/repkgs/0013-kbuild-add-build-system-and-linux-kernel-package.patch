+++ b/nix/build-systems.nix
@@ -84,6 +84,18 @@ builtins.mapAttrs
       ];
       tools = [ sh ];
     };
+    kbuild = {
+      # Linux kernel kbuild: configure (defconfig + fragment + olddefconfig + verify),
