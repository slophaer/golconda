+      unsupported = if platform.os != "linux" then "kernel builds only for Linux" else null;
+      phases = [
+        "configure"
+        "build"
+        "install"
+      ];
+      tools = [ sh ];
+    };
     autotools = {
       unsupported =
         if platform.libc == "msvc" then
diff --git a/pkgs/bc/bc/package.nix b/pkgs/bc/bc/package.nix
new file mode 100644
index 0000000..3980c10
--- /dev/null
+++ b/pkgs/bc/bc/package.nix
@@ -0,0 +1,20 @@
+# bc: arbitrary precision calculator language (modern implementation by Gavin Howard)
+# This is a simple, dependency-free implementation that works without readline/ed.
+{ package, buildPkgs }:
+package {
+  name = "bc";
+
+  # Uses custom configure.sh script, not autotools
+  uses = [ "make" ];
+
+  # Configure with POSIX-compliant bc (no GNU extensions needed for kernel)
+  make.configureScript = "./configure.sh";
+  make.configureFlags = [ "--disable-nls" "--disable-history" "--disable-man-pages" ];
+
+  bin = [ "bc" "dc" ];
+  tests.run = false;
+  tests.version = "bc --version";
+
+  # bc strips binaries itself, so disable debug info check
+  debug = false;
+}
diff --git a/pkgs/bc/bc/sources.toml b/pkgs/bc/bc/sources.toml
new file mode 100644
index 0000000..2d60136
--- /dev/null
+++ b/pkgs/bc/bc/sources.toml
@@ -0,0 +1,11 @@
+# Modern bc by Gavin Howard - no dependencies on ed/readline
+[upstream]
+purl = "pkg:github/gavinhoward/bc"
+
+[[source]]
+key = "default"
+url = "https://github.com/gavinhoward/bc/releases/download/{version}/bc-{version}.tar.xz"
+hash = "sha256-CpyzVAbardLE6np9YgqCYdkvRpPiDvsP44BXYGdZhIk="
+
+[pin]
+version = "7.1.0"
diff --git a/pkgs/el/elfutils/package.nix b/pkgs/el/elfutils/package.nix
new file mode 100644
index 0000000..bcc1c90
--- /dev/null
+++ b/pkgs/el/elfutils/package.nix
@@ -0,0 +1,32 @@
+# elfutils: libraries and utilities for handling ELF files
+# Provides libelf which is needed for kernel's objtool
+{ package, buildPkgs }:
+package {
+  name = "elfutils";
+
+  uses = [ "autotools" ];
+
+  # Disable debuginfod (network) and avoid problematic features
+  # Set localedir to . to avoid hardcoded paths
+  autotools.flags = [
+    "--disable-debuginfod"
+    "--disable-libdebuginfod"
+    "--disable-nls"
+    "--localedir=/"
+  ];
+
+  # Disable clang -Werror for const-discard pointer casts
+  cc.cflags = [ "-Wno-error=incompatible-pointer-types-discards-qualifiers" ];
+
+  dependencies = [
+    buildPkgs.zlib
+    buildPkgs.zstd
+  ];
+
+  bin = [ "eu-readelf" "eu-objdump" "eu-nm" "eu-strip" ];
+  tests.run = false;
+  tests.version = "eu-readelf --version";
+
+  # Remove eu-make-debug-archive which has hardcoded paths to other elfutils binaries
+  patches = [ ./relocatable.patch ];
+}
diff --git a/pkgs/el/elfutils/relocatable.patch b/pkgs/el/elfutils/relocatable.patch
