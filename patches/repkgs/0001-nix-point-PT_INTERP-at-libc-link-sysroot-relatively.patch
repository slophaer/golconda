From b8af7a452f3ff9c78b04070069c4000a379de812 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Fri, 30 Oct 2026 15:52:48 +0000
Subject: [PATCH] nix: point PT_INTERP at libc, link sysroot relatively

Every binary's PT_INTERP named ld.so through the sysroot output. The
sysroot is a symlink tree built with `cp -rsf`, and GNU cp -s writes
absolute targets: all 4472 links pointed into /nix/store/<hash>-glibc.
A closure copied to another root failed with "reloc-interp: cannot open
interpreter" because the links left the moved store. The sysroot also
pulled linux-headers, compiler-rt and the runtimes into the closure of
every program.

Name the libc output directly. package.nix and set.nix pass it as
libcOut for ELF packages, and the cc recipe writes it as `libc` in
jig.json, so the linker's interpreter and RUNPATH name it too. Other
binary formats and the stage 0/1 toolchains keep the sysroot.

Rewrite the absolute targets that cp leaves in the sysroot as links
relative to their own directory, so the output holds no absolute store
path. The builder's finish step already does this for package outputs.

Build glibc with -ffile-prefix-map for the compiler-rt and linux-headers
directories. Their -isystem paths reached the debug info of libc and
made the libc output, and so every closure, reference them.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 bootstrap/default.nix      |  5 ++++-
 bootstrap/sysroot.nu       | 15 +++++++++++++++
 nix/package.nix            |  8 ++++++--
 nix/set.nix                |  2 ++
 pkgs/gl/glibc/bootstrap.nu |  5 ++++-
 pkgs/ll/llvm/cc.nu         |  3 ++-
 6 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/bootstrap/default.nix b/bootstrap/default.nix
index f6e4595..c0c54d2 100644
--- a/bootstrap/default.nix
+++ b/bootstrap/default.nix
@@ -250,7 +250,10 @@ let
       ++ extraParts;
       runtimes = if given then null else run [ ] "runtimes" { sysroot = sysroot base; };
       full = sysroot (base ++ [ runtimes ]);
-      cc = run [ ] "cc" ({ sysroot = full; } // ccArgs);
+      cc = run [ ] "cc" ({
+        sysroot = full;
+        libcOut = libc;
+      } // ccArgs);
     in
     {
       inherit
diff --git a/bootstrap/sysroot.nu b/bootstrap/sysroot.nu
index 2e363da..bacb5cb 100644
--- a/bootstrap/sysroot.nu
+++ b/bootstrap/sysroot.nu
@@ -3,11 +3,26 @@
 # SDK) are merged as symlink trees, later parts win (musl and the kernel both ship include/scsi).
 use lib.nu *
 
+# `cp -s` writes absolute targets. The store path is rewritten when the output is added, but a closure
+# copied elsewhere must still resolve: make every link point to its target relative to its own directory
+def relativize-links [out: path]: nothing -> nothing {
+  for l in (^find $out -type l | lines | sort) {
+    let target = (^readlink $l | str trim)
+    if not ($target | str starts-with "/") { continue }
+    let from = ($l | path dirname | path split)
+    let to = ($target | path split)
+    let n = ($from | zip $to | take while {|p| $p.0 == $p.1 } | length)
+    let rel = ([...(0..<(($from | length) - $n) | each { ".." }) ...($to | skip $n)] | str join "/")
+    x ln -sfn $rel $l
+  }
+}
+
 def main []: nothing -> nothing {
   let out = $env.out
   mkdir $"($out)/include" $"($out)/lib"
   for p in ($env.parts | split row " ") { x cp -rsf $"($p)/." $"($out)/" }
   x cp -rs $env.resource $"($out)/lib/clang"
+  relativize-links $out
   # MacOSX.sdk brings a real usr/ (and the SDKSettings.json the darwin driver reads), ELF sysroots alias it
   if not ($"($out)/usr" | path exists) { x ln -s . $"($out)/usr" }
   x ln -s lib $"($out)/lib64"
diff --git a/nix/package.nix b/nix/package.nix
index ad33c89..3cff1dc 100644
--- a/nix/package.nix
+++ b/nix/package.nix
@@ -5,6 +5,8 @@
 {
   platform,
   toolchain,
+  # the libc output: PT_INTERP names it directly, not through the sysroot's symlinks
+  libcOut,
   launch,
   dlaudit,
   buildSystems,
@@ -19,6 +21,8 @@
 }:
 let
   elf = platform.binfmt == "elf";
+  # ld.so lives in the libc output; the sysroot only links to it and would join every closure
+  interpRoot = if elf then libcOut else toolchain.sysroot;
   inherit (lib)
     join
     lines
@@ -107,9 +111,9 @@ let
         hardening
         ;
       inherit (toolchain) sysroot;
-      probe = if platform.cross then "${toolchain.sysroot}/lib/${platform.interp}" else "";
+      probe = if platform.cross then "${interpRoot}/lib/${platform.interp}" else "";
       # `prebuilt`: upstream ELFs get our dynamic linker implanted (true) or via launch ("ldso")
-      interp = "${toolchain.sysroot}/lib/${platform.interp}";
+      interp = "${interpRoot}/lib/${platform.interp}";
       launch =
         if elf then
           "${launch}/bin/launch"
diff --git a/nix/set.nix b/nix/set.nix
index 9c5c7d0..5ba3e60 100644
--- a/nix/set.nix
+++ b/nix/set.nix
@@ -39,6 +39,7 @@ let
         [ ];
   };
   toolchain = stage.cc;
+  libcOut = stage.libc;
   launch = stage.launch or null;
   dlaudit = stage.dlaudit or null;
   buildPkgs =
@@ -99,6 +100,7 @@ let
     relocTools = [ buildPkgs.formatelf ];
     inherit
       toolchain
+      libcOut
       launch
       dlaudit
       buildSystems
diff --git a/pkgs/gl/glibc/bootstrap.nu b/pkgs/gl/glibc/bootstrap.nu
index ba6a1c9..9ec664c 100644
--- a/pkgs/gl/glibc/bootstrap.nu
+++ b/pkgs/gl/glibc/bootstrap.nu
@@ -36,7 +36,10 @@ def patched-source []: nothing -> path {
 # CXX=false: a working c++ would make the build compile a C++ test helper against our headers.
 # The link flags sit in no-unused-arguments because configure probes with `-Werror -S`
 def configure [src: path, rt: string, sh: path]: nothing -> nothing {
-  let cc = $"clang (target | str join ' ') -resource-dir=($rt) --start-no-unused-arguments -rtlib=compiler-rt -unwindlib=none -fuse-ld=lld --end-no-unused-arguments"
+  # -isystem dirs of the headers and compiler-rt would otherwise reach the debug info of every
+  # library and make libc reference them: they are build inputs, not run-time dependencies
+  let maps = ([$rt $env.linuxHeaders] | each {|d| $"-ffile-prefix-map=($d)=/build-input" } | str join ' ')
+  let cc = $"clang (target | str join ' ') ($maps) -resource-dir=($rt) --start-no-unused-arguments -rtlib=compiler-rt -unwindlib=none -fuse-ld=lld --end-no-unused-arguments"
   let vars = {CONFIG_SHELL: $sh, CC: $cc, CXX: "false", BUILD_CC: "cc", LDFLAGS: $"-L($rt)/lib/($env.clangTarget)"} | merge $BINUTILS
   "with-clang = yes\n" | save configparms # sysdeps Makefiles branch on it
   with-env $vars {
diff --git a/pkgs/ll/llvm/cc.nu b/pkgs/ll/llvm/cc.nu
index e5e693b..7450e9c 100644
--- a/pkgs/ll/llvm/cc.nu
+++ b/pkgs/ll/llvm/cc.nu
@@ -44,7 +44,8 @@ def elf-policy [out: string, sysroot: string]: nothing -> record {
   ] | str join "\n" | save stub.ld
   x (lld) -pie --no-dynamic-linker -e __reloc_start -T stub.ld reloc_stub.o -o reloc_stub.elf
   x llvm-objcopy -O binary -j .text reloc_stub.elf $"($out)/lib/reloc_stub.bin"
-  {libc: $sysroot, interp: $env.interp, crt: $"($out)/lib/crt_interp.o", runtimes: $"($sysroot)/lib"}
+  # the libc output holds ld.so and libc.so.6; stage0/1 toolchains have no separate one
+  {libc: ($env.libcOut? | default $sysroot), interp: $env.interp, crt: $"($out)/lib/crt_interp.o", runtimes: $"($sysroot)/lib"}
 }
 
 # hello.c and hello.cc through the finished wrapper. Run only when the target is the build machine
-- 
2.55.0

