From e4ff36b36bd023bb21d2ed5101e7be21696df5b9 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 05:16:51 +0000
Subject: [PATCH] package: a declared install prefix for farm packages

Add the spec field 'prefix' for farm packages (systemd, dbus-broker,
openssh, linux-pam, qemu) that hardcode paths to their own files.

When spec.prefix is set (e.g. "/usr"):
- meson/autotools configure with that prefix
- install uses DESTDIR and copies the prefix subtree to $out
- .pc files are rewritten to use ${pcfiledir} for relocatability
- finish allows the declared prefix to remain in files (the symlink
  farm in the image serves them from that path)

Packages with custom install needs (removing files, extra cleanup) can
still use phases.replace to override the install phase.

Signed-off-by: yolobox <yolobox@phaer.org>
---
 builder/finish.nu            | 12 +++++++++++-
 builder/systems/autotools.nu | 27 ++++++++++++++++++++++-----
 builder/systems/meson.nu     | 25 ++++++++++++++++++++++---
 nix/package.nix              |  1 +
 4 files changed, 56 insertions(+), 9 deletions(-)

diff --git a/builder/finish.nu b/builder/finish.nu
index 491af62..3a87a9d 100644
--- a/builder/finish.nu
+++ b/builder/finish.nu
@@ -69,7 +69,7 @@ def relativize-scripts [prefix: string]: nothing -> nothing {
 }
 
 
-# prefix -> store, anything still naming the prefix is an error
+# prefix -> store, anything still naming the prefix is an error (except for farm packages)
 export def to-store [prefix: string, dest: string, inv: table]: nothing -> nothing {
   ^chmod -R u+w $prefix # some install -m 0444
   relativize-text $prefix pcfiledir ($inv | where type == f and rel =~ '\.pc$' | get path)
@@ -77,6 +77,9 @@ export def to-store [prefix: string, dest: string, inv: table]: nothing -> nothi
   generic-man-prefix $prefix ($inv | where type == f and rel starts-with share/man/ | get path)
   relativize-scripts $prefix
   relativize-links $prefix $dest
+  # farm packages (spec.prefix set) are allowed to have the image prefix in their files: the
+  # symlink farm in the image serves them from that path. The scratch prefix is still rejected
+  let farm_prefix = (ctx).spec.prefix?
   let hits = (^grep -rlF $prefix $prefix | complete | get stdout | lines)
   if ($hits | is-not-empty) {
     let detail = ($hits | first 10 | each {|f|
@@ -90,6 +93,13 @@ export def to-store [prefix: string, dest: string, inv: table]: nothing -> nothi
 ($detail | str join "
 ")($more)"}
   }
+  # farm packages may have their declared prefix in files (e.g. /usr/lib/systemd): allowed
+  if ($farm_prefix | is-not-empty) {
+    let farm_hits = (^grep -rlF $farm_prefix $prefix | complete | get stdout | lines)
+    if ($farm_hits | is-not-empty) {
+      note farm-prefix $"($farm_hits | length) files contain the farm prefix ($farm_prefix)"
+    }
+  }
   # a Windows store (and tar on a runner) holds no symlinks: openssl's 5600 man aliases become copies
   if (ctx).platform.os == "windows" { ^cp -rL $prefix $dest; ^rm -rf $prefix } else { ^mv $prefix $dest }
 }
diff --git a/builder/systems/autotools.nu b/builder/systems/autotools.nu
index 56e2a75..cb8882d 100644
--- a/builder/systems/autotools.nu
+++ b/builder/systems/autotools.nu
@@ -61,7 +61,7 @@ def unrecord-install-tool [out: string]: nothing -> nothing {
 }
 
 # ./configure. Prefix, cache file and INSTALL through the environment (nix/config.site), so
-# configure's recorded argv has no build paths
+# configure's recorded argv has no build paths. Farm packages (spec.prefix) use that prefix
 export def --env configure []: nothing -> nothing {
   let c = (ctx); let o = (options autotools)
   let script = $"(project-dir autotools)/($o.configureScript)"
@@ -72,7 +72,9 @@ export def --env configure []: nothing -> nothing {
   note config.cache (if (build-cache restore $key $cache) { "restored" } else { "cold" })
   backports $c.src
   cp ($nu.current-exe | path dirname | path join install) (install-tool)
-  with-env {PKGS_PREFIX: $c.out, PKGS_CONFIG_CACHE: $cache, INSTALL: $"(install-tool) -c"} {
+  # farm packages configure with their declared prefix (e.g. /usr), otherwise $out
+  let prefix = ($c.spec.prefix? | default $c.out)
+  with-env {PKGS_PREFIX: $prefix, PKGS_CONFIG_CACHE: $cache, INSTALL: $"(install-tool) -c"} {
     (x $env.CONFIG_SHELL $script --disable-nls --disable-dependency-tracking --disable-static --enable-shared
       ...$host_flags ...$o.flags)
   }
@@ -90,8 +92,23 @@ def stub-gnulib-tests [build: string]: nothing -> nothing {
 
 export def build []: nothing -> nothing { let o = (options autotools); make run-build $o.makeFlags $o.buildTarget }
 export def test []: nothing -> nothing { let o = (options autotools); make run-test $o.makeFlags $o.testTarget }
+# install. Farm packages (spec.prefix) install via DESTDIR and copy the prefix subtree to $out
 export def install []: nothing -> nothing {
-  let o = (options autotools)
-  make run-install ($o.makeFlags ++ $o.installFlags) $o.installTarget
-  unrecord-install-tool (ctx).out
+  let c = (ctx); let o = (options autotools)
+  let farm_prefix = $c.spec.prefix?
+  if ($farm_prefix | is-empty) {
+    make run-install ($o.makeFlags ++ $o.installFlags) $o.installTarget
+    unrecord-install-tool $c.out
+  } else {
+    let destdir = $"($c.build)/dest"
+    with-env {DESTDIR: $destdir} { make run-install ($o.makeFlags ++ $o.installFlags) $o.installTarget }
+    # copy prefix subtree (e.g. /usr) to $out
+    let prefix_dir = ($farm_prefix | str trim --left --char '/')
+    ^cp -r $"($destdir)/($prefix_dir)/." $c.out
+    unrecord-install-tool $c.out
+    # .pc files: rewrite prefix to ${pcfiledir}/../.. so dependents find includes/libs
+    for f in (files $"($c.out)/lib/pkgconfig/*.pc") {
+      edit $f { str replace $"prefix=($farm_prefix)" "prefix=${pcfiledir}/../.." }
+    }
+  }
 }
diff --git a/builder/systems/meson.nu b/builder/systems/meson.nu
index 718ef7a..2a89aa4 100644
--- a/builder/systems/meson.nu
+++ b/builder/systems/meson.nu
@@ -48,10 +48,13 @@ def cross-files [c: record]: nothing -> list<string> {
 }
 
 # meson setup with prefix/libdir/buildtype defaults, a generated cross file when cross, then `meson.defs`
+# Farm packages (spec.prefix set, e.g. "/usr") configure with that prefix and install via DESTDIR
 export def configure []: nothing -> nothing {
   let c = (ctx); let o = (options meson)
+  # spec.prefix for farm packages, meson.defs.prefix for manual control, otherwise $out
+  let prefix = ($c.spec.prefix? | default ($o.defs.prefix? | default $c.out))
   let opts = ({
-    prefix: $c.out
+    prefix: $prefix
     libdir: "lib"
     sbindir: "bin"
     buildtype: "plain"  # cc brings -O2 -g itself
@@ -72,5 +75,21 @@ export def test []: nothing -> nothing {
   if ($skip | is-not-empty) and ($names | is-empty) { note meson-test "every test matches meson.skipTests"; return }
   x meson test --no-rebuild --print-errorlogs --num-processes (test-jobs) ...$names
 }
-# meson install
-export def install []: nothing -> nothing { x meson install --no-rebuild }
+# meson install. Farm packages (spec.prefix) install via DESTDIR and copy the prefix subtree to $out
+export def install []: nothing -> nothing {
+  let c = (ctx)
+  let farm_prefix = $c.spec.prefix?
+  if ($farm_prefix | is-empty) {
+    x meson install --no-rebuild
+  } else {
+    let destdir = $"($c.build)/dest"
+    with-env {DESTDIR: $destdir} { x meson install --no-rebuild }
+    # copy prefix subtree (e.g. /usr) to $out, rewriting .pc files to be relative
+    let prefix_dir = ($farm_prefix | str trim --left --char '/')
+    ^cp -r $"($destdir)/($prefix_dir)/." $c.out
+    # .pc files: rewrite prefix=/usr to ${pcfiledir}/../.. so dependents find includes/libs
+    for f in (files $"($c.out)/lib/pkgconfig/*.pc") {
+      edit $f { str replace $"prefix=($farm_prefix)" "prefix=${pcfiledir}/../.." }
+    }
+  }
+}
diff --git a/nix/package.nix b/nix/package.nix
index 8e66f69..0df462d 100644
--- a/nix/package.nix
+++ b/nix/package.nix
@@ -76,6 +76,7 @@ let
     "install"
     "links"
     "completions"
+    "prefix"
   ];
 
   # the part of every derivation that is the same across the set: built once
-- 
2.55.0

