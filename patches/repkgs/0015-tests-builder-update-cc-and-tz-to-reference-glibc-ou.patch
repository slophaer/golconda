From 620ca44bb8f63b71ea0cee28499c6e87d9942242 Mon Sep 17 00:00:00 2001
From: yolobox <yolobox@phaer.org>
Date: Sat, 31 Oct 2026 01:16:58 +0000
Subject: [PATCH] tests/builder: update cc and tz to reference glibc output

After the libc unwind fix, binaries reference glibc directly instead
of sysroot. Update test assertions to match:

- cc/test.nu: check RUNPATH contains "glibc" instead of "sysroot"
- tz/test.nu: glob for "-glibc-" instead of "-sysroot-"

Also add missing test.nu files for propagate-b and propagate-c.
---
 tests/builder/cc/test.nu          | 2 +-
 tests/builder/propagate-b/test.nu | 3 +++
 tests/builder/propagate-c/test.nu | 4 ++++
 tests/builder/tz/test.nu          | 2 +-
 4 files changed, 9 insertions(+), 2 deletions(-)
 create mode 100644 tests/builder/propagate-b/test.nu
 create mode 100644 tests/builder/propagate-c/test.nu

diff --git a/tests/builder/cc/test.nu b/tests/builder/cc/test.nu
index b3a2d2f..bc98bcd 100644
--- a/tests/builder/cc/test.nu
+++ b/tests/builder/cc/test.nu
@@ -6,6 +6,6 @@ assert "upstream ELF untouched" (has-section lib/upstream.so .debug_info)
 assert "install map copies a directory" ($"($env.pkg)/share/data/file" | path exists)
 assert "absolute self symlink made relative" ((^readlink $"($env.pkg)/lib/libabs.so") == "libhello.so")
 assert "copied dependency library left alone, already split" (has-section lib/libcopied.so .gnu_debuglink)
-assert "copied dependency library keeps a RUNPATH that reaches libc" ((^readelf -d $"($env.pkg)/lib/libcopied.so" | str contains "sysroot") )
+assert "copied dependency library keeps a RUNPATH that reaches libc" ((^readelf -d $"($env.pkg)/lib/libcopied.so" | str contains "glibc") )
 assert ".la removed" (not ($"($env.pkg)/lib/libhello.la" | path exists))
 done
diff --git a/tests/builder/propagate-b/test.nu b/tests/builder/propagate-b/test.nu
new file mode 100644
index 0000000..106934e
--- /dev/null
+++ b/tests/builder/propagate-b/test.nu
@@ -0,0 +1,3 @@
+# Package B propagates C. No assertions here; test-propagate-a verifies the chain.
+use checks.nu *
+done
diff --git a/tests/builder/propagate-c/test.nu b/tests/builder/propagate-c/test.nu
new file mode 100644
index 0000000..82dbcef
--- /dev/null
+++ b/tests/builder/propagate-c/test.nu
@@ -0,0 +1,4 @@
+# Package C is a dependency for the propagate tests. No assertions here;
+# test-propagate-a verifies the env propagation chain.
+use checks.nu *
+done
diff --git a/tests/builder/tz/test.nu b/tests/builder/tz/test.nu
index efa408e..1bcc7df 100644
--- a/tests/builder/tz/test.nu
+++ b/tests/builder/tz/test.nu
@@ -6,7 +6,7 @@ use glob.nu [files]
 
 let tz = $"($env.pkg)/bin/tz"
 # the sandbox only holds the closure, so the one libc.so.6 in the store is the binary's
-let libc = (files /nix/store/*-sysroot-*/lib/libc.so.6 | first)
+let libc = (files /nix/store/*-glibc-*/lib/libc.so.6 | first)
 let dirs = (open --raw $libc | decode utf-8 | split row "\u{0}" | where { $in =~ zoneinfo })
 assert $"zoneinfo directories are the system's: ($dirs)" (($dirs | sort) == ["/etc/zoneinfo/%s" "/usr/share/zoneinfo"])
 assert "reads a zone file" ((with-env {TZDIR: $"($env.fixtures)/zoneinfo", TZ: "Test/Zone"} { ^$tz }) == "TST")
-- 
