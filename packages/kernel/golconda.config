# Golconda kernel policy: a fragment merged onto this directory’s typed base (6.18 series).
# The fork's package boots in QEMU; every option here is Golconda's own decision. The build
# verifies each line: one that does not survive olddefconfig fails the kernel build.
# Lines are `CONFIG_X=value` or `# CONFIG_X is not set`; a name appears once.

# --- No modules: one signed image, nothing loaded after boot ---
# A monolithic kernel has no module loader to attack and nothing to sign or pin besides the image.
# CONFIG_MODULES is not set

# --- Integrity of the root image: dm-verity with signature verification ---
# dm-verity verifies /usr block by block; the root hash is signed.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# The root hash is signed; the kernel checks the signature.
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
# Keys for that check live in the secondary keyring, so a rotated signing key needs no new kernel...
CONFIG_SYSTEM_TRUSTED_KEYRING=y
CONFIG_SECONDARY_TRUSTED_KEYRING=y
# ...but only keys signed by a key built into the kernel are accepted there.
CONFIG_SECONDARY_TRUSTED_KEYRING_SIGNED_BY_BUILTIN=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING=y
# Also trust keys from the UEFI platform keyring (Secure Boot db); one cert for UKI and verity.
# Requires INTEGRITY_PLATFORM_KEYRING (populated from db at boot) and LOAD_UEFI_KEYS.
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
# the platform keyring depends on asymmetric integrity keys and the blacklist keyring
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_SYSTEM_BLACKLIST_KEYRING=y
CONFIG_INTEGRITY_PLATFORM_KEYRING=y
CONFIG_LOAD_UEFI_KEYS=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_PLATFORM_KEYRING=y

# --- Root image format: erofs ---
# erofs is the one read-only image format: random access, no unpack step, verity-friendly.
CONFIG_EROFS_FS=y
# Compressed images; LZ4 comes with this option (there is no separate LZ4 switch in 6.18).
CONFIG_EROFS_FS_ZIP=y
# zstd, for the better ratio on the image.
CONFIG_EROFS_FS_ZIP_ZSTD=y
# Extended attributes: file capabilities and security labels live in xattrs.
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# No overlayfs: the root is read-only and state sits on its own mounts; layering adds attack surface
# (a long CVE history) and nothing in the design needs it.
# CONFIG_OVERLAY_FS is not set
# No squashfs: erofs covers the image role; a second read-only format is code we would not use.
# CONFIG_SQUASHFS is not set

# --- TPM: measured boot, sealed keys ---
CONFIG_TCG_TPM=y
# TIS: TPMs on the LPC/SPI bus (most real hardware).
CONFIG_TCG_TIS=y
# CRB: firmware TPMs and the QEMU/swtpm device.
CONFIG_TCG_CRB=y
# Encrypt and authenticate the TPM bus traffic (protects against bus interposers).
CONFIG_TCG_TPM2_HMAC=y
# The TPM as an entropy source.
CONFIG_HW_RANDOM_TPM=y

# --- UEFI boot ---
CONFIG_EFI=y
# The kernel is its own EFI program (a UKI embeds it); no boot loader needed.
CONFIG_EFI_STUB=y
# EFI variables through efivarfs (Boot entries, LoaderEntry, Secure Boot state). The old sysfs
# interface (CONFIG_EFI_VARS) is gone in 6.18.
CONFIG_EFIVAR_FS=y

# --- Security modules: phase 1 = IPE + lockdown + Yama (see docs/design/kernel.md) ---
# The cmdline sets lsm=lockdown,yama,ipe,bpf and lockdown=integrity ipe.enforce=1.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
# Lockdown: integrity mode set by the cmdline (lockdown=integrity), not forced by config.
# FORCE_NONE means the default level is none; the cmdline chooses.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# Yama: ptrace scoping, kernel.yama.ptrace_scope=2 via sysctl.d.
CONFIG_SECURITY_YAMA=y
# IPE: Integrity Policy Enforcement. The boot policy allows execution from the initramfs
# (boot_verified=TRUE) and from dm-verity volumes with a signed root hash (dmverity_signature=TRUE).
# CONFIG_IPE_BOOT_POLICY is set in nix/packages.nix via builtins.toFile, not here.
CONFIG_SECURITY_IPE=y
CONFIG_IPE_PROP_DM_VERITY=y
CONFIG_IPE_PROP_DM_VERITY_SIGNATURE=y
# IPE policy updates can be signed by keys in the secondary or platform keyrings.
CONFIG_IPE_POLICY_SIG_SECONDARY_KEYRING=y
CONFIG_IPE_POLICY_SIG_PLATFORM_KEYRING=y
# BPF LSM: policy as BPF programs. Its dependencies are listed because Kconfig does not select them.
# BTF (DEBUG_INFO_BTF) is left out on purpose: it needs pahole at build time, which costs
# build time and size; programs that need CO-RE BTF wait for that decision (phase 2).
CONFIG_BPF_LSM=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_PERF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_FTRACE=y
CONFIG_KPROBE_EVENTS=y

# --- Networking: nftables, conntrack, WireGuard ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
# WireGuard is the VPN; in-tree, so no out-of-tree module.
CONFIG_WIREGUARD=y
# IPv6 policy routing (ip -6 rule). The defconfig leaves it out. /imds's lock on the IMDS endpoints
# (modules/imds) needs it for IPv6: rules by firewall mark that let systemd-imdsd through and
# prohibit rules for everything else. Without it networkd cannot set an IPv6 rule ("Operation not
# supported"), and the IPv4 rules of the same file are lost with it.
CONFIG_IPV6_MULTIPLE_TABLES=y

# --- Virtual machine guest: the VM test and cloud images ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
# No vsock and no 9p: nothing in the image or the VM test uses a host-to-guest socket or a shared
# directory, and vsock is where systemd's ssh generator would put a second sshd.
# CONFIG_VSOCKETS is not set
# CONFIG_NET_9P is not set

# --- Console ---
# Serial console on ttyS0 (servers, QEMU -nographic).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The screen: the firmware's framebuffer (UEFI GOP) as a DRM device, with the text console on
# it, so tty0 shows what the serial line shows on a cloud whose console is a screen (VNC). UEFI
# has no VGA text mode, and VGA_CONSOLE alone leaves the screen blank.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Storage ---
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y

# --- Network cards ---
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_IGB=y
CONFIG_IXGBE=y

# --- Swap in RAM ---
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- Writable filesystems: state, ESP ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# vfat for the EFI system partition.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- systemd's kernel requirements (systemd README) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
# Pressure stall information: systemd-oomd.
CONFIG_PSI=y
# Bootstrap credentials (system.hostname): PID 1 reads SMBIOS type 11 strings from
# /sys/firmware/dmi/entries and qemu fw_cfg from /sys/firmware/qemu_fw_cfg.
CONFIG_DMI_SYSFS=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
# ORC: the unwinder that works with clang and costs no frame pointers.
CONFIG_UNWINDER_ORC=y

# --- No kexec ---
# kexec boots another kernel from the running one, which skips the measured and verified boot chain
# (UEFI, TPM PCRs, verity). Nothing in the design reboots that way.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set

# --- Hardening that costs little or nothing at run time (KSPP) ---
# Kernel base address randomisation.
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# Kernel text and rodata are read-only, data is not executable.
CONFIG_STRICT_KERNEL_RWX=y
# Zero heap memory on allocation (cheap; init_on_free is not set, it costs more).
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
# Clear caller-used registers on function exit (stops register leaks and shrinks ROP gadgets).
CONFIG_ZERO_CALL_USED_REGS=y
# kCFI, because the kernel is built with clang. In 6.18 the option is CONFIG_CFI;
# CONFIG_CFI_CLANG is only a transitional name and never appears in .config.
CONFIG_CFI=y
# No structure layout randomisation: its seed is random per build, so two builds of the same
# source would differ and the kernel would not be reproducible.
CONFIG_RANDSTRUCT_NONE=y

# --- Oops readability ---
# Symbol names in oopses and stack traces; the cost is a few MB of image.
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
