-#define PCSCLITE_IPC_DIR		"@ipcdir@"
-#define PCSCLITE_RUN_PID		PCSCLITE_IPC_DIR "/pcscd.pid"
+/* PCSCLITE_IPC_DIR in the environment names the directory of the socket and the pid file in
+ * place of the compiled-in one: a daemon that is not root's (a test, a debugging session) has no
+ * /run/pcscd. PCSCLITE_CSOCK_NAME in the environment still names the socket for a client. */
+static inline const char *pcscd_ipc_dir(void)
+{
+	const char *d = getenv("PCSCLITE_IPC_DIR");
+	return d ? d : "@ipcdir@";
+}
+
+static inline const char *pcscd_run_pid(void)
+{
+	static char path[256];
+	(void)snprintf(path, sizeof path, "%s/pcscd.pid", pcscd_ipc_dir());
+	return path;
+}
+
+static inline const char *pcscd_csock_name(void)
+{
+	static char path[256];
+	(void)snprintf(path, sizeof path, "%s/pcscd.comm", pcscd_ipc_dir());
+	return path;
+}
+
+#define PCSCLITE_IPC_DIR		pcscd_ipc_dir()
+#define PCSCLITE_RUN_PID		pcscd_run_pid()
 
-#define PCSCLITE_CSOCK_NAME		PCSCLITE_IPC_DIR "/pcscd.comm"
+#define PCSCLITE_CSOCK_NAME		pcscd_csock_name()
 
