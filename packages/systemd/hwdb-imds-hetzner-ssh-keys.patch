From df2a0fea30ccd17a8bdbe63ec82c5d61f1778daa Mon Sep 17 00:00:00 2001
From: phaer <hello@phaer.org>
Date: Mon, 9 Nov 2026 17:37:01 +0000
Subject: [PATCH] hwdb: import the SSH keys on Hetzner Cloud

Hetzner Cloud provides the SSH keys of the instance only as a JSON
array of strings at /metadata/public-keys, so use the new
IMDS_KEY_SSH_KEY_JSON= for it.

See https://docs.hetzner.cloud/reference/cloud#server-metadata

Assisted-by: Claude Code (claude-opus-5-5)
---
 hwdb.d/40-imds.hwdb | 1 +
 1 file changed, 1 insertion(+)

diff --git a/hwdb.d/40-imds.hwdb b/hwdb.d/40-imds.hwdb
index 839441dff0..ae656d6514 100644
--- a/hwdb.d/40-imds.hwdb
+++ b/hwdb.d/40-imds.hwdb
@@ -81,6 +81,7 @@ dmi:bvnHetzner:*
  IMDS_KEY_REGION=/metadata/region
  IMDS_KEY_ZONE=/metadata/availability-zone
  IMDS_KEY_IPV4_PUBLIC=/metadata/public-ipv4
+ IMDS_KEY_SSH_KEY_JSON=/metadata/public-keys
  IMDS_KEY_USERDATA=/userdata
 
 # https://docs.oracle.com/en-us/iaas/Content/Compute/Tasks/gettingmetadata.htm#metadata-keys
