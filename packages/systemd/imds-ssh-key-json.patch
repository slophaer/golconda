 ]
 
 install_data(
diff --git a/src/imds/test-imds-util.c b/src/imds/test-imds-util.c
new file mode 100644
index 0000000000..a66266954d
--- /dev/null
+++ b/src/imds/test-imds-util.c
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "alloc-util.h"
+#include "imds-util.h"
+#include "tests.h"
+
+TEST(imds_well_known_ssh_key_json) {
+        ASSERT_EQ(imds_well_known_from_string("ssh-key-json"), IMDS_SSH_KEY_JSON);
+        ASSERT_STREQ(imds_well_known_to_string(IMDS_SSH_KEY_JSON), "ssh-key-json");
+        ASSERT_FALSE(imds_well_known_can_suffix(IMDS_SSH_KEY_JSON));
+}
+
+static void test_ssh_keys_from_json_one(const char *json, const char *expected) {
+        _cleanup_free_ char *keys = NULL;
+
+        log_info("/* %s(%s) */", __func__, json);
+
+        ASSERT_OK_EQ(imds_ssh_keys_from_json(json, &keys), !!expected);
+        ASSERT_STREQ(keys, expected);
+}
+
+TEST(imds_ssh_keys_from_json) {
+        /* Hetzner Cloud: each key has a trailing newline */
+        test_ssh_keys_from_json_one(
+                        "[\"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA== one\\n\", \"ssh-rsa AAAAB3NzaC1yc2E= two\\n\"]",
+                        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA== one\n"
+                        "ssh-rsa AAAAB3NzaC1yc2E= two\n");
+
+        /* Without trailing newlines, and with empty entries */
+        test_ssh_keys_from_json_one(
+                        "[\"ssh-ed25519 AAAA one\", \"\", \"  \", \"ssh-ed25519 BBBB two\"]",
+                        "ssh-ed25519 AAAA one\n"
+                        "ssh-ed25519 BBBB two\n");
+
+        /* No keys at all */
+        test_ssh_keys_from_json_one("[]", NULL);
+        test_ssh_keys_from_json_one("[\"\\n\"]", NULL);
+
+        /* An entry which is not a string, or which would turn into more than one line, is skipped */
+        test_ssh_keys_from_json_one(
+                        "[\"ssh-ed25519 AAAA one\", 7, {\"key\":\"ssh-ed25519 CCCC three\"}, \"ssh-ed25519 BBBB two\"]",
+                        "ssh-ed25519 AAAA one\n"
+                        "ssh-ed25519 BBBB two\n");
+        test_ssh_keys_from_json_one(
+                        "[\"ssh-ed25519 AAAA one\\nssh-ed25519 CCCC three\", \"ssh-ed25519 BBBB two\"]",
+                        "ssh-ed25519 BBBB two\n");
+        test_ssh_keys_from_json_one("[null, \"ssh-ed25519 AAAA\\tone\"]", NULL);
+
+        /* Not a JSON array */
+        _cleanup_free_ char *keys = NULL;
+        ASSERT_FAIL(imds_ssh_keys_from_json("", &keys));
+        ASSERT_FAIL(imds_ssh_keys_from_json("ssh-ed25519 AAAA one", &keys));
+        ASSERT_ERROR(imds_ssh_keys_from_json("\"ssh-ed25519 AAAA one\"", &keys), EBADMSG);
+        ASSERT_ERROR(imds_ssh_keys_from_json("{\"key\":\"ssh-ed25519 AAAA one\"}", &keys), EBADMSG);
+        ASSERT_NULL(keys);
+}
+
+DEFINE_TEST_MAIN(LOG_DEBUG);
