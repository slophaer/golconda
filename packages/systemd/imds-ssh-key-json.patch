diff --git a/src/imds/imds-tool.c b/src/imds/imds-tool.c
index c77de0a828..2ea134bcbc 100644
--- a/src/imds/imds-tool.c
+++ b/src/imds/imds-tool.c
@@ -78,7 +78,7 @@ static int parse_argv(int argc, char *argv[]) {
                 OPTION('K', "well-known", "KEY",
                        "Select well-known key/base, one of:"
                        " hostname, region, zone, ipv4-public, ipv6-public, ssh-key,"
-                       " userdata, userdata-base, userdata-base64"): {
+                       " ssh-key-json, userdata, userdata-base, userdata-base64"): {
                         if (isempty(opts.arg)) {
                                 arg_well_known = _IMDS_WELL_KNOWN_INVALID;
                                 break;
@@ -641,16 +641,36 @@ static int import_imds_ssh_key(sd_varlink *link) {
 
         assert(link);
 
-        _cleanup_(iovec_done) struct iovec data = {};
-        r = acquire_imds_key(link, IMDS_SSH_KEY, /* key= */ NULL, &data);
+        /* The well-known "ssh-key" field has keys in authorized_keys format, the "ssh-key-json" field a
+         * JSON array of keys. Import the keys of both. */
+
+        _cleanup_free_ char *keys = NULL;
+        r = acquire_imds_key_as_string(link, IMDS_SSH_KEY, /* key= */ NULL, &keys);
         if (r < 0)
                 return r;
-        if (r == 0 || !iovec_is_set(&data)) {
+        if (!isempty(keys) && !endswith(keys, "\n") && !strextend(&keys, "\n"))
+                return log_oom();
+
+        _cleanup_free_ char *json = NULL;
+        r = acquire_imds_key_as_string(link, IMDS_SSH_KEY_JSON, /* key= */ NULL, &json);
+        if (r < 0)
+                return r;
+        if (!isempty(json)) {
+                _cleanup_free_ char *k = NULL;
+                r = imds_ssh_keys_from_json(json, &k);
+                if (r < 0)
+                        return log_error_errno(r, "Failed to parse SSH keys from IMDS as JSON array of strings: %m");
+
+                if (k && !strextend(&keys, k))
+                        return log_oom();
+        }
+
+        if (isempty(keys)) {
                 log_debug("No SSH key supplied via IMDS, not importing.");
                 return 0;
         }
 
-        r = write_credential("/run/credstore", "ssh.authorized_keys.root", &data);
+        r = write_credential("/run/credstore", "ssh.authorized_keys.root", &IOVEC_MAKE_STRING(keys));
         if (r <= 0)
                 return r;
 
diff --git a/src/imds/imds-util.c b/src/imds/imds-util.c
index 3c67417e4b..6f5557983d 100644
--- a/src/imds/imds-util.c
+++ b/src/imds/imds-util.c
@@ -2,7 +2,12 @@
 
 #include <assert.h>
 
+#include "sd-json.h"
+
+#include "alloc-util.h"
 #include "imds-util.h"
+#include "json-util.h"
+#include "log.h"
 #include "string-table.h"
 #include "string-util.h"
 #include "utf8.h"
@@ -25,6 +30,56 @@ bool imds_key_is_valid(const char *key) {
         return true;
 }
 
+int imds_ssh_keys_from_json(const char *json, char **ret) {
+        int r;
+
+        assert(json);
+        assert(ret);
+
+        /* Some IMDS implementations (e.g. Hetzner Cloud) provide all SSH keys as one JSON array of strings,
+         * each a public key in OpenSSH format. Turn this into authorized_keys(5) format, one key per
+         * line. Entries which are not usable are skipped, so that one bad entry does not cost us the
+         * other keys. Returns 0 and NULL if the array has no usable keys. */
+
+        _cleanup_(sd_json_variant_unrefp) sd_json_variant *v = NULL;
+        r = sd_json_parse(json, /* flags= */ 0, &v, /* reterr_line= */ NULL, /* reterr_column= */ NULL);
+        if (r < 0)
+                return r;
+
+        if (!sd_json_variant_is_array(v))
+                return -EBADMSG;
+
+        _cleanup_free_ char *keys = NULL;
+        sd_json_variant *i;
+        JSON_VARIANT_ARRAY_FOREACH(i, v) {
+                if (!sd_json_variant_is_string(i)) {
+                        log_warning("SSH key in IMDS JSON array is not a string, skipping.");
+                        continue;
+                }
+
+                _cleanup_free_ char *k = strdup(sd_json_variant_string(i));
+                if (!k)
+                        return -ENOMEM;
+
+                /* Hetzner Cloud terminates each key with a newline, drop that */
+                const char *s = strstrip(k);
+                if (isempty(s))
+                        continue;
+
+                /* One array entry must not turn into more than one line */
+                if (string_has_cc(s, /* ok= */ NULL)) {
+                        log_warning("SSH key in IMDS JSON array contains control characters, skipping.");
+                        continue;
+                }
+
+                if (!strextend(&keys, s, "\n"))
+                        return -ENOMEM;
+        }
+
+        *ret = TAKE_PTR(keys);
+        return !!*ret;
+}
+
 static const char* const imds_well_known_table[_IMDS_WELL_KNOWN_MAX] = {
         [IMDS_BASE]            = "base",
         [IMDS_HOSTNAME]        = "hostname",
@@ -33,6 +88,7 @@ static const char* const imds_well_known_table[_IMDS_WELL_KNOWN_MAX] = {
         [IMDS_IPV4_PUBLIC]     = "ipv4-public",
         [IMDS_IPV6_PUBLIC]     = "ipv6-public",
         [IMDS_SSH_KEY]         = "ssh-key",
+        [IMDS_SSH_KEY_JSON]    = "ssh-key-json",
         [IMDS_USERDATA]        = "userdata",
         [IMDS_USERDATA_BASE]   = "userdata-base",
         [IMDS_USERDATA_BASE64] = "userdata-base64",
diff --git a/src/imds/imds-util.h b/src/imds/imds-util.h
index 55ab79510f..5a4b7fb194 100644
--- a/src/imds/imds-util.h
+++ b/src/imds/imds-util.h
@@ -21,6 +21,7 @@ typedef enum ImdsWellKnown {
         IMDS_IPV4_PUBLIC,
         IMDS_IPV6_PUBLIC,
         IMDS_SSH_KEY,
+        IMDS_SSH_KEY_JSON,    /* a JSON array of SSH keys */
         IMDS_USERDATA,
         IMDS_USERDATA_BASE,   /* typically suffixed */
         IMDS_USERDATA_BASE64,
@@ -34,5 +35,7 @@ static inline bool imds_well_known_can_suffix(ImdsWellKnown wk) {
 
 bool imds_key_is_valid(const char *key);
 
+int imds_ssh_keys_from_json(const char *json, char **ret);
+
 DECLARE_STRING_TABLE_LOOKUP(imds_well_known, ImdsWellKnown);
 DECLARE_STRING_TABLE_LOOKUP(imds_network_mode, ImdsNetworkMode);
