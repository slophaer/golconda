@@ -269,6 +269,7 @@ def property_grammar():
         ('IMDS_KEY_IPV4_PUBLIC', name_literal),
         ('IMDS_KEY_IPV6_PUBLIC', name_literal),
         ('IMDS_KEY_SSH_KEY', name_literal),
+        ('IMDS_KEY_SSH_KEY_JSON', name_literal),
