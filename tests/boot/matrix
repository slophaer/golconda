# The boot matrix: the sets that scripts/verify boots when it gets no --boot-set and no
# --boot-args. One set for each line: scripts/boot-test's flags after the disk and --keys. Blank
# lines and lines that start with # are skipped. Words of scripts/verify in a set:
#   @image=ATTR     first word: boot packages.<system>.ATTR, not --image's image
#   @next           the next release: <image>-next, built for the set's own image
#   @next=ATTR      the next release is packages.<system>.ATTR (a set can name several, as
#                   in "--next @next --later @next=image-smoke-test-later")
--secure-boot --ssh-test --tpm --timeout 600
--secure-boot --ssh-test --tpm --timeout 600 --next @next
--secure-boot --ssh-test --tpm --timeout 900 --next @next --fail-health
--secure-boot --ssh-test --tpm --timeout 900 --next @next --fail-initrd
--secure-boot --ssh-test --tpm --timeout 900 --next @next --fail-panic
--secure-boot --ssh-test --tpm --timeout 900 --next @next --fail-pid1
--secure-boot --ssh-test --tpm --timeout 1800 --next @next --fail-blessed --later @next=image-smoke-test-later
--secure-boot --ssh-test --tpm --timeout 600 --next @next --tamper-index
--secure-boot --ssh-test --tpm --timeout 600 --next @next=image-smoke-test-rotated --rotate
--secure-boot --ssh-test --tpm --timeout 900 --secure-boot-off
--secure-boot --ssh-test --tpm --timeout 600 --auto-enrol
--secure-boot --ssh-test --tpm --timeout 600 --auto-enrol --next @next
@image=image-smoke-test-own-keys --secure-boot --ssh-test --tpm --timeout 600 --auto-enrol --no-microsoft-keys
--secure-boot --ssh-test --tpm --timeout 600 --imds
--secure-boot --ssh-test --tpm --timeout 600 --imds --next @next
--secure-boot --ssh-test --factory-reset --timeout 480
@image=image-smoke-test-next --secure-boot --ssh-test --tpm --timeout 600 --certify
@image=image-smoke-test-next --secure-boot --ssh-test --tpm --timeout 600 --certify --factory-reset
@image=image-smoke-test-nosb --ssh-test --timeout 400 --esp-creds
@image=image-smoke-test-nosb --ssh-test --timeout 400 --next @next
@image=image-smoke-test-nosb --ssh-test --timeout 400 --esp-creds --factory-reset
